								<h3 class="text-xl font-bold mb-2 leading-snug" style="font-family: var(--font-serif); color: var(--color-brand);">{visionPost.title}</h3>
								<p class="text-sm mb-4 leading-relaxed line-clamp-3" style="font-family: var(--font-sans); color: var(--color-muted);">{visionPost.excerpt || ''}</p>
								<div class="flex items-center justify-between text-sm" style="color: var(--color-muted); font-family: var(--font-sans);">
									<span>{visionPost.author} · {visionDate}</span>
									<span class="font-semibold group-hover:underline" style="color: var(--color-brand);">Read &rarr;</span>
								</div>
							</div>
						</a>
					)}
					<div class="text-center mt-8">
						<p class="text-3xl md:text-4xl font-light leading-tight" style="font-family: var(--font-serif); color: var(--color-ink);">The Father</p>
						<p class="text-3xl md:text-4xl font-light leading-tight mt-1" style="font-family: var(--font-serif); color: var(--color-brand);">No greater gift or legacy.</p>
					</div>
				</div>
			</div>
		</Section>

		<!-- ═══════════════ PAGE 4 — the Father's vision ═══════════════ -->
		<Section variant="light">
			<div class="max-w-4xl mx-auto">
				<!-- The Father's Vision -->
				<header class="text-center mb-8" data-reveal>
					<p class="text-xs font-semibold tracking-widest uppercase mb-3" style="font-family: var(--font-sans); color: var(--color-gold);">The Father's Vision</p>
					<h2 class="text-3xl md:text-4xl font-light leading-tight" style="font-family: var(--font-serif); color: var(--color-ink);">When His Sons &amp; Daughters Come Home</h2>
					<p class="mt-4 leading-relaxed max-w-2xl mx-auto" style="font-family: var(--font-sans); color: var(--color-muted);">
						This is the legacy — what only the Father restores in a world that has experienced Him as God but not yet Father.
					</p>
				</header>

				<div class="relative grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-5" data-reveal>
					<!-- short arrow pointing right, between the two columns (desktop) -->
					<div class="hidden md:flex absolute left-1/2 top-1/2 items-center justify-center rounded-full" style="width: 46px; height: 46px; transform: translate(-50%, -50%); background: #fff; box-shadow: 0 3px 12px rgba(0,0,0,0.18); z-index: 3;" aria-hidden="true">
						<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--color-brand)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="12" x2="18" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
					</div>
					<!-- Our Pains -->
					<div class="rounded-2xl p-6" style="background: #41454B;">
						<p class="font-bold text-lg" style="font-family: var(--font-serif); color: #fff;">Our Pains</p>
						<p class="text-xs uppercase tracking-wider mb-4" style="font-family: var(--font-sans); color: rgba(255,255,255,0.6);">A world without the Father</p>
						<ul class="space-y-2.5" style="list-style: none; padding: 0; margin: 0;">
							{painsVsFather.map(({ pain }) => (
								<li class="flex gap-2.5 items-start text-sm" style="font-family: var(--font-sans); color: #d6d7d9;">
									<span class="mt-1.5 w-1.5 h-1.5 rounded-full shrink-0" style="background:#fff;"></span>{pain}
								</li>
							))}
						</ul>
					</div>
					<!-- Our Father -->
					<div class="rounded-2xl p-6" style="background: #FFE1E8;">
						<p class="font-bold text-lg" style="font-family: var(--font-serif); color: var(--color-brand-dark, var(--color-brand));">Our Father</p>
						<p class="text-xs uppercase tracking-wider mb-4" style="font-family: var(--font-sans); color: var(--color-brand);">What His children come home to</p>
						<ul class="space-y-2.5" style="list-style: none; padding: 0; margin: 0;">
							{painsVsFather.map(({ father }) => (
								<li class="flex gap-2.5 items-start text-sm" style="font-family: var(--font-sans); color: #4a3d42;">
									<span class="mt-1.5 w-1.5 h-1.5 rounded-full shrink-0" style="background:var(--color-brand);"></span>{father}
								</li>
							))}
						</ul>
					</div>
				</div>
			</div>
		</Section>

		<!-- ═══════════════ PEOPLE BAND (readers with each edition) ═══════════════ -->
		<div class="grid grid-cols-1 sm:grid-cols-3">
			<img src="https://assets.spiritmediapublishing.com/FHB/print/abw-band-plum-v3.webp" alt="A mother and daughter reading the Plum edition of the Father's Heart Bible" width="800" height="800" loading="lazy" decoding="async" class="w-full aspect-square object-cover block" />
			<img src="https://assets.spiritmediapublishing.com/FHB/print/abw-band-charcoal-v3.webp" alt="A father and son reading the Charcoal edition of the Father's Heart Bible" width="800" height="800" loading="lazy" decoding="async" class="w-full aspect-square object-cover block" />
			<img src="https://assets.spiritmediapublishing.com/FHB/print/abw-band-white-v3.webp" alt="Three generations reading the White edition of the Father's Heart Bible" width="800" height="800" loading="lazy" decoding="async" class="w-full aspect-square object-cover block" />
		</div>
	</main>
</Layout>

<script>
	for (const form of document.querySelectorAll<HTMLFormElement>('.legacy-sign-form')) {
		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			const status = form.querySelector<HTMLElement>('.legacy-sign-status');
			const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
			const data = Object.fromEntries(new FormData(form).entries());
			const name = String(data.name || '').trim();
			const email = String(data.email || '').trim();
			if (name.length < 2) {
				if (status) status.textContent = 'Please sign with your name.';
				return;
			}
			if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
				if (status) status.textContent = 'Please enter a valid email address.';
				return;
			}
			if (button) button.disabled = true;
			if (status) status.textContent = 'One moment…';
			try {
				const res = await fetch('/legacy-sign', {
					method: 'POST',
					headers: { 'content-type': 'application/json' },
					body: JSON.stringify({ name, email, website: String(data.website || '') }),
				});
				if (!res.ok) throw new Error(String(res.status));
				form.reset();
				if (status) status.textContent = `Signed, ${name}. Welcome to the Father’s legacy.`;
			} catch {
				if (status) status.textContent = 'Something went wrong — please try again in a moment.';
				if (button) button.disabled = false;
			}
		});
	}
</script>
