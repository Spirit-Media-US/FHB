---
// /tangkhul-bible — the Tangkhul Bible page. DRAFT for Kevin's review (2026-10-02).
//
// SUBJECT: the Tangkhul (nmf) edition of the Father's Heart Bible. Same kind of page as
// /marathi-bible and /telugu-bible (same Layout, section order and schema stack) —
// deliberately NOT CountryBible. Copy is in ENGLISH, like Marathi: Tangkhul readers are
// English-literate and the one measured search term is English ("tangkhul bible").
//
// DEMAND (projects/fhb-nmf-seo/FINDINGS.md, Ahrefs country=in, 2026-09-23):
//   `tangkhul bible` 150/mo KD 6 — the head term · `tangkhul bible app` 60/mo.
//   Search Console: 0 impressions on /read/nmf/ in 28 days to 2026-09-30 (live 2026-09-30).
//   So the chapter list below is NOT measured Tangkhul demand: it is the chapters that lead
//   measured demand in the other Indian editions on this site (Psalm 91, Psalm 23 — Marathi,
//   Telugu) plus Genesis 1 and John 3. INFERRED; replace with nmf GSC data once it exists.
// TRAPS (FINDINGS.md): bare `tangkhul` volume is weather/songs/culture, not Bible intent;
//   `kathara` 600/mo has UNVERIFIED intent — deliberately not used.
//
// TANGKHUL WORDS ON THIS PAGE — ATTESTED ONLY, ALL MARKED FOR THE NATIVE REVIEWER:
//   Laa       = Psalms. Our nmf book name; published Kathara Bible (BSI) reads "Laa lairik"
//               for the book of Psalms (Luke 20:42, Acts 1:20 in the YouVersion 1545 pool).
//   Haokaphok = Genesis. Our nmf book name (src/i18n/nmf.json, from the published Bible).
//   Avā       = Father. Used 363 times in the published-Bible pool; our live nmf UI string.
//   Every other sentence is English on purpose.
//
// NO AUDIO CLAIM. Tangkhul has no published narration.
//
// Canon figures (66 books / 1,189 chapters) are MEASURED from
// /srv/sites/community/src/content/bible-nmf. Native review of the edition is in progress
// (that is what publication on 2026-09-30 was for). The FAQ invites EVERY Tangkhul speaker
// to suggest improvements via the reader's chapter comments (Kevin 2026-10-02, "7").
import AuthorBio from '../components/AuthorBio.astro';
import ReviewLink from '../components/ReviewLink.astro';
import Layout from '../layouts/Layout.astro';

const PAGE_URL = 'https://fathersheartbible.com/tangkhul-bible/'; // trailing slash = the canonical form Layout.astro emits
const TITLE = "Tangkhul Bible — Read the Father's Heart Bible Free Online";
const DESCRIPTION =
	'Tangkhul Bible: read the Father’s Heart Bible free online — all 66 books, 1,189 chapters, in Tangkhul. No account, no app. A fresh translation revealing our Father.';
const PUBLISHED = '2026-10-02';
const MODIFIED = '2026-10-02';

const READ_NMF = 'https://fathersheartbible.com/read/nmf/';

// Contributor bio — Kevin White, verbatim from the FHB metadata sheets (General + Italian Bible: Metadata).
const EDITOR_BIO =
	"Kevin White himself is a beloved son, husband, and father. He is an international best selling author, speaker, and marketplace pastor with decades of experience planting churches, leading nonprofits, starting companies, and developing leaders around the world. Kevin and Shelly, his high school sweetheart and partner in marriage and mission for nearly forty years, co-founded Spirit Media Publishing and are devoted to empowering beloved sons and daughters in revealing our Father's heart to the nations. Kevin and Shelly live in North Carolina with their family.";

const formatDate = (iso: string) =>
	new Date(`${iso}T12:00:00Z`).toLocaleDateString('en-US', {
		year: 'numeric',
		month: 'long',
		day: 'numeric',
	});

const KEVIN_WHITE_AUTHOR = {
	'@type': 'Person',
	'@id': 'https://kevinwhite.us/#person',
	name: 'Kevin White',
	url: 'https://kevinwhite.us',
	jobTitle: 'Founder & CEO, Spirit Media Publishing',
	affiliation: {
		'@type': 'Organization',
		'@id': 'https://spiritmediapublishing.com/#organization',
		name: 'Spirit Media Publishing',
	},
	sameAs: [
		'https://kevinwhite.us',
		'https://kevinwhite.us/about/',
		'https://www.linkedin.com/in/kevinwhiteus/',
		'https://www.youtube.com/@KevinWhiteus',
		'https://spiritmediapublishing.com',
	],
};

// No measured Tangkhul chapter demand yet (see header) — these lead the other editions.
const PSALMS = [
	{
		ch: 91,
		note: 'He who dwells in the shelter of the Most High — the most-read chapter across this site’s Indian editions.',
	},
	{ ch: 23, note: 'The shepherd psalm — six verses, and the one most people come back to.' },
	{ ch: 1, note: 'Like a tree planted by streams of water.' },
	{ ch: 51, note: 'Create in me a clean heart — the prayer for a fresh start.' },
	{ ch: 121, note: 'I lift up my eyes to the hills — where does my help come from?' },
];

// Where most readers start outside the Psalms. Each opens at the chapter named.
const BOOKS = [
	{
		slug: 'genesis',
		ch: 1,
		nmf: 'Haokaphok',
		en: 'Genesis 1',
		note: 'In the beginning — where the whole story starts.',
	},
	{
		slug: 'matthew',
		ch: 6,
		nmf: '',
		en: 'Matthew 6',
		note: 'The prayer Jesus taught His disciples, to our Father.',
	},
	{
		slug: 'john',
		ch: 3,
		nmf: '',
		en: 'John 3',
		note: 'The chapter of John 3:16 — how the Father loved the world.',
	},
	{ slug: 'luke', ch: 15, nmf: '', en: 'Luke 15', note: 'The father who runs to meet his son.' },
];

const FAQS = [
	{
		question: 'Is there a free Tangkhul Bible I can read online?',
		answer:
			"Yes. The Father's Heart Bible™ is free to read online in Tangkhul — all 66 books and 1,189 chapters, with no account, no purchase and no app to install. Open it at fathersheartbible.com/read/nmf/ on any phone or computer.",
	},
	{
		question: "What is the Father's Heart Bible in Tangkhul?",
		answer:
			'A fresh Tangkhul translation of the whole Bible whose distinctive is that it reveals God as our Father — Avā — wherever Scripture reveals Him that way. It is a new translation rather than a revision of the existing Tangkhul Bible, made book by book from Genesis to Revelation.',
	},
	{
		question: 'How do I read Psalm 23 in Tangkhul?',
		answer:
			'Psalm 23 is at fathersheartbible.com/read/nmf/psalms/23/, free and with no sign-in. The book of Psalms is Laa in Tangkhul; the chapter addresses use the English book name, so /read/nmf/psalms/23/ opens the Tangkhul chapter.',
	},
	{
		question: 'Does the Tangkhul Bible have audio?',
		answer:
			"Not yet. Audio narration is currently available on the English edition of the Father's Heart Bible™. The Tangkhul text is complete and free to read today; Tangkhul narration is not published.",
	},
	{
		question: 'Is the whole Bible available in Tangkhul, or only part of it?',
		answer:
			'The whole Bible. The Tangkhul edition publishes all 66 books and every one of their 1,189 chapters — Old Testament and New — not a sample or a selection.',
	},
	{
		question: 'Can Tangkhul speakers suggest improvements to the translation?',
		answer:
			'Every Tangkhul speaker is invited to help make it better. The edition was published in full so that Tangkhul readers can read it and suggest improvements: open any chapter at fathersheartbible.com/read/nmf/, scroll to the comments at the end of the chapter, and post your suggestion — joining the Family is free. Suggestions are read and folded into the text as they come in.',
	},
];

const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: 'Tangkhul Bible: Read the Father’s Heart Bible Free Online',
	description: DESCRIPTION,
	author: KEVIN_WHITE_AUTHOR,
	publisher: {
		'@type': 'Organization',
		'@id': 'https://spiritmediapublishing.com/#organization',
		name: 'Spirit Media Publishing',
		url: 'https://spiritmediapublishing.com',
	},
	url: PAGE_URL,
	mainEntityOfPage: { '@type': 'WebPage', '@id': PAGE_URL },
	datePublished: PUBLISHED,
	dateModified: MODIFIED,
	inLanguage: 'en-US',
	about: { '@type': 'Language', name: 'Tangkhul', alternateName: 'Tangkhul Naga' },
	articleSection: 'Bible Translations',
	keywords: 'tangkhul bible, bible in tangkhul, tangkhul bible online, tangkhul bible app',
};
const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://fathersheartbible.com/' },
		{ '@type': 'ListItem', position: 2, name: 'Tangkhul Bible', item: PAGE_URL },
	],
};
const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: FAQS.map((f) => ({
		'@type': 'Question',
		name: f.question,
		acceptedAnswer: { '@type': 'Answer', text: f.answer },
	})),
};
const jsonLd = [articleSchema, breadcrumbSchema, faqSchema];

const TOC = [
	{ id: 'what-it-is', label: 'What it is' },
	{ id: 'how-it-reads', label: 'How it reads in Tangkhul' },
	{ id: 'psalms', label: 'Laa — the Psalms' },
	{ id: 'books', label: 'Where to start' },
	{ id: 'find-a-chapter', label: 'Finding a chapter' },
	{ id: 'faq', label: 'FAQ' },
];
---

<Layout title={TITLE} description={DESCRIPTION} jsonLd={jsonLd} pageType="article" articleAuthor="Kevin White" articlePublishedTime={PUBLISHED} articleSection="Bible Translations" articleTags={["Tangkhul Bible", "Bible in Tangkhul", "Father's Heart Bible"]}>
	<main id="main-content">
		<section class="px-6 pt-10 pb-2 lg:px-8" style="background-color: var(--color-surface-low);">
			<div class="mx-auto max-w-3xl">
				<nav aria-label="Breadcrumb" class="mb-5 text-sm" style="color: var(--color-muted); font-family: var(--font-sans);">
					<a href="/" class="hover:underline">Home</a><span class="px-1.5" aria-hidden="true">/</span>
					<span style="color: var(--color-ink);">Tangkhul Bible</span>
				</nav>
				<p class="text-xs font-semibold uppercase tracking-widest mb-4" style="color: var(--color-brand); font-family: var(--font-sans);">Tangkhul Bible</p>
				<h1 class="text-4xl md:text-5xl font-light leading-tight" style="font-family: var(--font-serif); color: var(--color-ink);">The Tangkhul Bible</h1>
				<div class="flex items-center gap-3 mt-5 pb-8 text-sm border-b flex-wrap" style="color: var(--color-muted); font-family: var(--font-sans); border-color: var(--color-hairline);">
					<span>By <a href="/the-fathers-heart-bible/leadership/" class="font-semibold hover:underline" style="color: var(--color-ink);">Kevin White</a> &mdash; leading the Father&rsquo;s Heart Bible&trade; translation</span>
					<span aria-hidden="true">&middot;</span><span>{formatDate(PUBLISHED)}</span>
				</div>
			</div>
		</section>

		<section class="px-6 py-10 lg:px-8 lg:py-14" style="background-color: var(--color-surface);">
			<div class="mx-auto max-w-3xl">
				<p class="text-lg leading-relaxed mb-5" style="font-family: var(--font-sans); color: var(--color-muted);">
					<strong style="color: var(--color-ink);">You can read the whole Bible in Tangkhul, free, right now &mdash; all 66 books and 1,189 chapters of the Father&rsquo;s Heart Bible&trade;, with no account, no purchase and no app.</strong> The Tangkhul edition is a fresh translation rather than a revision of an older one, and it carries the distinctive the whole project exists for: wherever Scripture reveals God as a Father &mdash; <span lang="nmf" data-native-review="Ava">Avā</span> &mdash; this Bible says so plainly. <a href={READ_NMF} style="color: var(--color-brand);" class="hover:underline">Open the Tangkhul reader</a> and you can be in Psalm 23 in a few seconds.
				</p>

				<aside class="my-7 px-6 py-5 rounded-2xl" style="background-color: #fdf2f5; border: 1px solid #f9d6e0;">
					<p class="text-xs font-semibold uppercase tracking-widest mb-2" style="color: var(--color-brand); font-family: var(--font-sans);">Key takeaway</p>
					<p class="text-lg leading-relaxed" style="font-family: var(--font-serif); color: var(--color-ink);">The complete Bible in Tangkhul, free online &mdash; a fresh translation that lets Tangkhul readers hear God speak as a Father.</p>
				</aside>

				<nav aria-label="On this page" class="my-8 px-5 py-4 rounded-xl" style="background-color: var(--color-surface-low); border: 1px solid var(--color-hairline);">
					<p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: var(--color-muted); font-family: var(--font-sans);">On this page</p>
					<ul class="flex flex-wrap gap-x-5 gap-y-2 list-none m-0 p-0 text-sm" style="font-family: var(--font-sans);">
						{TOC.map((t) => (<li><a href={`#${t.id}`} class="hover:underline" style="color: var(--color-brand);">{t.label}</a></li>))}
					</ul>
				</nav>

				<h2 id="what-it-is" class="text-2xl md:text-3xl font-light mt-12 mb-4 scroll-mt-28" style="font-family: var(--font-serif); color: var(--color-ink);">What the Tangkhul Father&rsquo;s Heart Bible is</h2>
				<p class="text-lg leading-relaxed mb-4" style="font-family: var(--font-sans); color: var(--color-muted);">It is the complete Bible in Tangkhul: sixty-six books, 1,189 chapters, Genesis through Revelation, published in full rather than as a sample. It lives online and it is free &mdash; no sign-up wall, nothing to buy, nothing to install before you can read. Every chapter has its own permanent address, so a chapter you find today can be bookmarked, sent to someone in a message, or opened again next year at the same link.</p>
				<p class="text-lg leading-relaxed mb-4" style="font-family: var(--font-sans); color: var(--color-muted);">It is a fresh translation, not a re-typeset of the existing Tangkhul Bible. That distinction carries the whole point. What this translation exists to recover is the family language of Scripture: where the text reveals God as a Father to His sons and daughters, the Father&rsquo;s Heart Bible&trade; renders it that way in Tangkhul, rather than flattening it into the vocabulary of a distant ruler. You can read <a href="/the-fathers-heart-bible/" style="color: var(--color-brand);" class="hover:underline">why the translation exists</a>, and see <a href="/a-bible-for-the-whole-world/" style="color: var(--color-brand);" class="hover:underline">the other languages it is being made in</a>.</p>

				<h2 id="how-it-reads" class="text-2xl md:text-3xl font-light mt-12 mb-4 scroll-mt-28" style="font-family: var(--font-serif); color: var(--color-ink);">How this translation reads in Tangkhul</h2>
				<p class="text-lg leading-relaxed mb-4" style="font-family: var(--font-sans); color: var(--color-muted);">Tangkhul readers already have a published Bible in their own language, and many know it well. This edition does not try to replace that. It aims at the Tangkhul a household actually speaks, because the relationship the text describes is a household one &mdash; a Father and His children, not a sovereign and his subjects.</p>
				<p class="text-lg leading-relaxed mb-4" style="font-family: var(--font-sans); color: var(--color-muted);">The books keep their Tangkhul names &mdash; <span lang="nmf" data-native-review="Haokaphok">Haokaphok</span> for Genesis, <span lang="nmf" data-native-review="Laa">Laa</span> for Psalms &mdash; while the chapter addresses use the English book names, the same in every language on this site. Read a few chapters and the difference shows up fast: our Father speaks to His people as His own, and the text lets Him.</p>

				<h2 id="psalms" class="text-2xl md:text-3xl font-light mt-12 mb-4 scroll-mt-28" style="font-family: var(--font-serif); color: var(--color-ink);"><span lang="nmf" data-native-review="Laa">Laa</span> &mdash; the Psalms</h2>
				<p class="text-lg leading-relaxed mb-4" style="font-family: var(--font-sans); color: var(--color-muted);">Across this site&rsquo;s editions, most readers come first to a Psalm, and a small handful account for most of it. These are those chapters &mdash; each a direct link into the Tangkhul text:</p>
				<ul class="space-y-3 mb-4 pl-5 text-lg leading-relaxed" style="font-family: var(--font-sans); color: var(--color-muted); list-style: disc;">
					{PSALMS.map((p) => (
						<li>
							<a href={`${READ_NMF}psalms/${p.ch}/`} style="color: var(--color-brand);" class="hover:underline font-semibold"><span lang="nmf" data-native-review="Laa">Laa</span> {p.ch} &mdash; Psalm {p.ch} in Tangkhul</a>
							<span> &mdash; {p.note}</span>
						</li>
					))}
				</ul>
				<p class="text-lg leading-relaxed mb-4" style="font-family: var(--font-sans); color: var(--color-muted);">If you read one chapter, read <a href={`${READ_NMF}psalms/91/`} style="color: var(--color-brand);" class="hover:underline">Psalm 91</a>. It is the chapter readers open more than any other in this site&rsquo;s Indian editions, and it is a promise of shelter spoken over anyone who will take it.</p>

				<h2 id="books" class="text-2xl md:text-3xl font-light mt-12 mb-4 scroll-mt-28" style="font-family: var(--font-serif); color: var(--color-ink);">Where to start outside the Psalms</h2>
				<p class="text-lg leading-relaxed mb-4" style="font-family: var(--font-sans); color: var(--color-muted);">Beyond the Psalms, these are good first chapters. Each link opens the chapter named, and every chapter of every book is published:</p>
				<ul class="space-y-3 mb-4 pl-5 text-lg leading-relaxed" style="font-family: var(--font-sans); color: var(--color-muted); list-style: disc;">
					{BOOKS.map((b) => (
						<li>
							<a href={`${READ_NMF}${b.slug}/${b.ch}/`} style="color: var(--color-brand);" class="hover:underline font-semibold">{b.nmf ? (<><span lang="nmf" data-native-review={b.nmf}>{b.nmf}</span> {b.ch} &mdash; </>) : null}{b.en} in Tangkhul</a>
							<span> &mdash; {b.note}</span>
						</li>
					))}
				</ul>

				<h2 id="find-a-chapter" class="text-2xl md:text-3xl font-light mt-12 mb-4 scroll-mt-28" style="font-family: var(--font-serif); color: var(--color-ink);">Finding any chapter in the Tangkhul Bible</h2>
				<p class="text-lg leading-relaxed mb-4" style="font-family: var(--font-sans); color: var(--color-muted);">Every Tangkhul chapter has a plain, permanent address made of the book name and the chapter number:</p>
				<ul class="space-y-2 mb-4 pl-5 text-lg leading-relaxed" style="font-family: var(--font-sans); color: var(--color-muted); list-style: disc;">
					<li><code>fathersheartbible.com/read/nmf/psalms/91/</code> &mdash; Psalm 91</li>
					<li><code>fathersheartbible.com/read/nmf/genesis/1/</code> &mdash; Genesis 1</li>
					<li><code>fathersheartbible.com/read/nmf/john/3/</code> &mdash; John 3</li>
				</ul>
				<p class="text-lg leading-relaxed mb-4" style="font-family: var(--font-sans); color: var(--color-muted);">There is nothing to memorise. <a href={READ_NMF} style="color: var(--color-brand);" class="hover:underline">Open the Tangkhul reader</a> and choose the book and chapter from the list, or use the picker inside any chapter to jump straight to a verse.</p>

				<aside class="my-12 px-6 py-10 lg:px-10 lg:py-12 rounded-2xl text-center" style="background-color: #fdf2f5; border: 1px solid #f9d6e0;">
					<p class="text-2xl md:text-3xl font-light leading-tight max-w-2xl mx-auto" style="font-family: var(--font-serif); color: var(--color-ink);">Read the Tangkhul Bible free</p>
					<p class="mt-4 max-w-2xl mx-auto text-base lg:text-lg leading-relaxed" style="font-family: var(--font-sans); color: var(--color-muted);">The whole Bible in Tangkhul, online and free &mdash; a fresh translation revealing God as a loving Father to His sons and daughters.</p>
					<a href={`${READ_NMF}psalms/23/`} class="inline-flex items-center gap-2 mt-7 px-7 py-3 rounded-full text-sm font-semibold no-underline transition-opacity hover:opacity-90" style="background-color: #FFD9E0; color: #4A4A4A; font-family: var(--font-sans);">Open Psalm 23<span aria-hidden="true">&rarr;</span></a>
				</aside>

				<h2 id="faq" class="text-2xl md:text-3xl font-light mt-12 mb-6 scroll-mt-28" style="font-family: var(--font-serif); color: var(--color-ink);">Frequently asked questions</h2>
				<div class="space-y-6">
					{FAQS.map((f) => (<div><h3 class="text-xl font-medium mb-2" style="font-family: var(--font-serif); color: var(--color-ink);">{f.question}</h3><p class="text-lg leading-relaxed" style="font-family: var(--font-sans); color: var(--color-muted);">{f.answer}</p></div>))}
				</div>

				<div class="mt-12 pt-8 border-t" style="border-color: var(--color-hairline);">
					<p class="text-sm leading-relaxed" style="font-family: var(--font-sans); color: var(--color-muted);">
						Keep going: open the <a href={READ_NMF} style="color: var(--color-brand);" class="hover:underline">Tangkhul Bible</a>, the <a href="/marathi-bible/" style="color: var(--color-brand);" class="hover:underline">Marathi Bible</a> or the <a href="/telugu-bible/" style="color: var(--color-brand);" class="hover:underline">Telugu Bible</a>, see <a href="/a-bible-for-the-whole-world/" style="color: var(--color-brand);" class="hover:underline">every language the Father&rsquo;s Heart Bible is being translated into</a>, learn <a href="/the-fathers-heart-bible/" style="color: var(--color-brand);" class="hover:underline">why this translation exists</a>, or read about <a href="/bible-in/india/" style="color: var(--color-brand);" class="hover:underline">the Bible in India</a>. New to Scripture? Start with <a href="/guides/where-to-start-reading-the-bible/" style="color: var(--color-brand);" class="hover:underline">where to start reading the Bible</a>.
					</p>
				</div>
			</div>
		</section>

		<section class="px-6 py-12 lg:px-8 lg:py-16" style="background-color: var(--color-surface-low);">
			<div class="mx-auto max-w-2xl text-center">
				<h2 class="text-2xl md:text-3xl font-light leading-tight" style="font-family: var(--font-serif); color: var(--color-ink);">The whole Bible, in Tangkhul, free</h2>
				<p class="mt-4 text-base lg:text-lg leading-relaxed" style="font-family: var(--font-sans); color: var(--color-muted);">Sixty-six books and 1,189 chapters, online at no cost &mdash; a fresh Tangkhul translation that reveals God as a loving Father.</p>
				<a href={READ_NMF} class="inline-flex items-center gap-2 mt-6 px-7 py-3 rounded-full text-sm font-semibold no-underline transition-colors" style="background-color: var(--color-brand); color: var(--color-on-primary); font-family: var(--font-sans);">Read in Tangkhul<span aria-hidden="true">&rarr;</span></a>
			</div>
		</section>

		<ReviewLink class="mb-10" />

		{/* Kevin 2026-10-02 ("8. Yes"): About the EDITOR, bio verbatim from the FHB metadata sheets (Contributor #2: Kevin White, Editor). */}
		<AuthorBio
			author="Kevin White"
			label="About the editor"
			role="Editor, Father’s Heart Bible™"
			bio={EDITOR_BIO}
		/>
	</main>
</Layout>
