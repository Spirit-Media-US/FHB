---
/* /print/order/ — THE CATALOG ORDER FORM for churches and groups (Kevin 2026-10-03, "1 yes").
 *
 * Every print edition we sell direct, ONE ROW PER EDITION with a binding toggle and one counter
 * (OrderRow), in category accordions that start CLOSED with their item counts, a search box
 * that opens the section holding a match, and a running summary (OrderSummary) that is sticky
 * beside the list on a desktop and a fixed bar on a phone. One Checkout through the existing
 * /dvc-checkout; the volume ladder and the first-order 15% are src/lib/order-pricing.ts, the
 * same rule the server charges. No marketing copy (Kevin: price, not persuasion).
 *
 * The form itself is the shared CatalogOrderForm, the same one /print carries (Kevin 2026-10-04).
 *
 * The eBook is NOT here: it is a download sold through its own checkout (/ebook-checkout), and
 * a physical shipment basket cannot carry it.
 */
import CatalogOrderForm from '../../components/CatalogOrderForm.astro';
import Layout from '../../layouts/Layout.astro';

const breadcrumb = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://fathersheartbible.com/' },
		{
			'@type': 'ListItem',
			position: 2,
			name: 'Print',
			item: 'https://fathersheartbible.com/print/',
		},
		{
			'@type': 'ListItem',
			position: 3,
			name: 'Catalog Order Form',
			item: 'https://fathersheartbible.com/print/order/',
		},
	],
};
---
<Layout
	title="Catalog Order Form — Father's Heart Bible™ Print Editions"
	description="Order any Father's Heart Bible™ print edition in hardback or paperback: general, audience, large print and 26 language editions, with volume pricing for churches and groups."
	jsonLd={breadcrumb}
>
	<main id="main-content" class="cat" style="margin-top: 80px;">
		<div class="cat__wrap">
			<header class="cat__head">
				<p class="cat__crumb"><a href="/print/">Print</a> / Catalog order form</p>
				<h1 class="cat__h1">Catalog Order Form</h1>
				<p class="cat__lede">Every print edition, hardback or paperback. All copies in the order count together toward volume pricing.</p>
			</header>

			<CatalogOrderForm returnPath="/print/order/" />
		</div>
	</main>
</Layout>

<style>
	.cat { background: var(--color-surface); }
	.cat__wrap { max-width: 72rem; margin: 0 auto; padding: 1.5rem 1rem 6.5rem; }
	.cat__crumb { font-family: var(--font-sans); font-size: 0.85rem; color: var(--color-muted); margin: 0; }
	.cat__crumb a { color: #3f3f46; text-decoration: underline; display: inline-flex; align-items: center; min-height: 44px; }
	.cat__h1 { font-family: var(--font-headline); color: var(--color-ink); font-size: 2rem; font-weight: 600; margin: 0.1rem 0 0; line-height: 1.2; }
	.cat__lede { font-family: var(--font-sans); color: var(--color-muted); font-size: 0.95rem; margin: 0.5rem 0 1.25rem; }
	@media (min-width: 1024px) {
		.cat__wrap { padding: 2rem 1.5rem 4rem; }
		.cat__h1 { font-size: 2.4rem; }
	}
</style>
