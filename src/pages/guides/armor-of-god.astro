---
// Guide — /guides/armor-of-god (unit 2or). Target: armor of god, full armor of god,
// shield of faith, sword of the spirit, helmet of salvation. Quotes are verbatim FHB (Ephesians 6, locked canon).
import AuthorBio from '../../components/AuthorBio.astro';
import ReviewLink from '../../components/ReviewLink.astro';
import YouVersionBanner from '../../components/YouVersionBanner.astro';
import Layout from '../../layouts/Layout.astro';

const PAGE_URL = 'https://fathersheartbible.com/guides/armor-of-god/';
const TITLE = 'The Armor of God (Ephesians 6:10-18) — A Simple Guide';
const DESCRIPTION =
	'The armor of God, piece by piece: belt of truth, breastplate of righteousness, shield of faith, helmet of salvation and sword of the Spirit, quoted from Ephesians 6.';
const PUBLISHED = '2026-11-10';
const MODIFIED = '2026-11-10';

const HERO_BASE =
	'https://cdn.sanity.io/images/rusi1hyi/production/6497aa7918fb947fc7b07cc63f3f25658934727b-5472x3462.jpg';
const HERO_ALT = 'An open Bible, ready to read';
const HERO_IMG = `${HERO_BASE}?w=1400&h=620&fit=crop&crop=entropy&fm=webp&q=72`;
const OG_IMG = `${HERO_BASE}?w=1200&h=630&fit=crop&crop=entropy&fm=jpg&q=80`;

const formatDate = (iso: string) =>
	new Date(`${iso}T12:00:00Z`).toLocaleDateString('en-US', {
		year: 'numeric',
		month: 'long',
		day: 'numeric',
	});

const KEVIN_WHITE_AUTHOR = {
	'@type': 'Person',
	'@id': 'https://kevinwhite.us/#person',
	name: 'Kevin White',
	url: 'https://kevinwhite.us',
	jobTitle: 'Founder & CEO, Spirit Media Publishing',
	affiliation: {
		'@type': 'Organization',
		'@id': 'https://spiritmediapublishing.com/#organization',
		name: 'Spirit Media Publishing',
	},
	sameAs: [
		'https://kevinwhite.us',
		'https://kevinwhite.us/about/',
		'https://www.linkedin.com/in/kevinwhiteus/',
		'https://www.youtube.com/@KevinWhiteus',
		'https://spiritmediapublishing.com',
	],
};

const FAQS = [
	{
		question: 'What is the armor of God?',
		answer:
			"The armor of God is the picture Paul uses in Ephesians 6:10-18 for the protection our Father gives believers to stand firm against the devil's schemes. It has six pieces: the belt of truth, the breastplate of righteousness, feet fitted with the gospel of peace, the shield of faith, the helmet of salvation and the sword of the Spirit, which is the word of our Father. Prayer holds it all together.",
	},
	{
		question: 'What is the full armor of God?',
		answer:
			'"Full armor" means wearing every piece, not choosing a favorite. In Father\'s Heart Bible, Ephesians 6:11 reads "Put on our Father\'s full armor, so you can stand against the devil\'s schemes." Verse 13 repeats the command so you can withstand in the evil day and stand firm once you have done everything.',
	},
	{
		question: 'What does the shield of faith do?',
		answer:
			'Ephesians 6:16 says the shield of faith is able to put out all the flaming arrows of the evil one. Faith here is trust in our Father: when accusation, doubt or fear comes flying at you, trust is what you lift up in front of it. A shield is held up actively, which is why the verse says to take it up in every situation.',
	},
	{
		question: 'What is the sword of the Spirit?',
		answer:
			'Ephesians 6:17 names it directly: "the sword of the Spirit—the word of our Father." It is the only offensive piece in the list, and it is Scripture itself. Knowing the Bible well enough to answer lies with what the Father has actually said is how the sword gets used.',
	},
	{
		question: 'What does the helmet of salvation protect?',
		answer:
			'A helmet guards the head, and the helmet of salvation guards your mind with the settled knowledge that you belong to the Father through Jesus Christ. Ephesians 6:17 says to take it up, which means receiving the security that is already yours and standing in it when doubt tells you otherwise.',
	},
	{
		question: 'Is the armor of God only for spiritual leaders?',
		answer:
			'No. Paul writes to the whole church in Ephesus, and the command is for everyone: "be strong in the Lord and in the strength of his might" (6:10). The armor is not your own strength. It is what the Lord supplies, and every believer is meant to put it on.',
	},
];

const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: 'The Armor of God (Ephesians 6:10-18): A Simple Guide',
	description: DESCRIPTION,
	image: OG_IMG,
	author: KEVIN_WHITE_AUTHOR,
	publisher: {
		'@type': 'Organization',
		'@id': 'https://spiritmediapublishing.com/#organization',
		name: 'Spirit Media Publishing',
		url: 'https://spiritmediapublishing.com',
	},
	url: PAGE_URL,
	mainEntityOfPage: { '@type': 'WebPage', '@id': PAGE_URL },
	datePublished: PUBLISHED,
	dateModified: MODIFIED,
	inLanguage: 'en-US',
	articleSection: 'Bible Reading Guides',
	keywords:
		'armor of god, full armor of god, shield of faith, sword of the spirit, helmet of salvation, Ephesians 6',
};
const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://fathersheartbible.com/' },
		{
			'@type': 'ListItem',
			position: 2,
			name: 'Guides',
			item: 'https://fathersheartbible.com/guides/',
		},
		{ '@type': 'ListItem', position: 3, name: 'The Armor of God', item: PAGE_URL },
	],
};
const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: FAQS.map((f) => ({
		'@type': 'Question',
		name: f.question,
		acceptedAnswer: { '@type': 'Answer', text: f.answer },
	})),
};
const jsonLd = [articleSchema, breadcrumbSchema, faqSchema];

const TOC = [
	{ id: 'what-it-is', label: 'What it is' },
	{ id: 'belt', label: 'Belt of truth' },
	{ id: 'breastplate', label: 'Breastplate' },
	{ id: 'feet', label: 'Gospel of peace' },
	{ id: 'shield', label: 'Shield of faith' },
	{ id: 'helmet', label: 'Helmet of salvation' },
	{ id: 'sword', label: 'Sword of the Spirit' },
	{ id: 'prayer', label: 'Prayer' },
	{ id: 'faq', label: 'FAQ' },
];
---

<Layout
	title={TITLE}
	description={DESCRIPTION}
	image={OG_IMG}
	darkHero={true}
	jsonLd={jsonLd}
	pageType="article"
	articleAuthor="Kevin White"
	articlePublishedTime={PUBLISHED}
	articleSection="Bible Reading Guides"
	articleTags={["armor of God", "full armor of God", "Ephesians 6"]}
	preloadImageMobile={HERO_IMG.replace('w=1400', 'w=640')}
	preloadImageDesktop={HERO_IMG}
>
	<main id="main-content">
		<section class="relative w-full overflow-hidden min-h-[600px] lg:min-h-[calc(50vh_+_2in)]">
			<img src={HERO_IMG} srcset={`${HERO_IMG.replace('w=1400', 'w=640')} 640w, ${HERO_IMG} 1400w`} sizes="(max-width: 1023px) 640px, 1400px" alt={HERO_ALT} class="absolute inset-0 w-full h-full object-cover" style="object-position: center top;" fetchpriority="high" decoding="async" />
			<div class="absolute inset-0 z-10" style="background: linear-gradient(to bottom, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.22) 40%, rgba(0,0,0,0.22) 100%);" aria-hidden="true"></div>
		</section>
		<YouVersionBanner />

		<section class="px-6 pt-10 pb-2 lg:px-8" style="background-color: var(--color-surface-low);">
			<div class="mx-auto max-w-3xl">
				<nav aria-label="Breadcrumb" class="mb-5 text-sm" style="color: var(--color-muted); font-family: var(--font-sans);">
					<a href="/" class="hover:underline">Home</a><span class="px-1.5" aria-hidden="true">/</span>
					<a href="/guides/" class="hover:underline">Guides</a><span class="px-1.5" aria-hidden="true">/</span>
					<span style="color: var(--color-ink);">The Armor of God</span>
				</nav>
				<p class="text-xs font-semibold uppercase tracking-widest mb-4" style="color: var(--color-brand); font-family: var(--font-sans);">Bible Reading Guide</p>
				<h1 class="text-4xl md:text-5xl font-light leading-tight" style="font-family: var(--font-serif); color: var(--color-ink);">The Armor of God: A Simple Guide to Ephesians 6:10-18</h1>
				<div class="flex items-center gap-3 mt-5 pb-8 text-sm border-b flex-wrap" style="color: var(--color-muted); font-family: var(--font-sans); border-color: var(--color-hairline);">
					<span>By <a href="/the-fathers-heart-bible/leadership/" class="font-semibold hover:underline" style="color: var(--color-ink);">Kevin White</a> &mdash; Editor, Father&rsquo;s Heart Bible&trade;</span>
					<span aria-hidden="true">&middot;</span><span>{formatDate(PUBLISHED)}</span>
				</div>
			</div>
		</section>

		<section class="px-6 py-10 lg:px-8 lg:py-14" style="background-color: var(--color-surface);">
			<div class="mx-auto max-w-3xl">
				<p class="text-lg leading-relaxed mb-5" style="font-family: var(--font-sans); color: var(--color-muted);"><strong style="color: var(--color-ink);">The armor of God is the protection described in Ephesians 6:10-18: six pieces &mdash; the belt of truth, breastplate of righteousness, gospel-of-peace shoes, shield of faith, helmet of salvation and sword of the Spirit &mdash; that our Father gives so you can stand firm against the devil&rsquo;s schemes.</strong> Paul calls the whole thing our Father&rsquo;s, not ours. Below is each piece in the words of Father&rsquo;s Heart Bible, with what it means for an ordinary day.</p>
				<aside class="my-7 px-6 py-5 rounded-2xl" style="background-color: #fdf2f5; border: 1px solid #f9d6e0;"><p class="text-xs font-semibold uppercase tracking-widest mb-2" style="color: var(--color-brand); font-family: var(--font-sans);">Key takeaway</p><p class="text-lg leading-relaxed" style="font-family: var(--font-serif); color: var(--color-ink);">The armor is not something you build. It is our Father&rsquo;s own armor, given to you. Put on every piece, stand, and pray.</p></aside>
				<nav aria-label="On this page" class="my-8 px-5 py-4 rounded-xl" style="background-color: var(--color-surface-low); border: 1px solid var(--color-hairline);"><p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: var(--color-muted); font-family: var(--font-sans);">On this page</p><ul class="flex flex-wrap gap-x-5 gap-y-2 list-none m-0 p-0 text-sm" style="font-family: var(--font-sans);">{TOC.map((t) => (<li><a href={`#${t.id}`} class="hover:underline" style="color: var(--color-brand);">{t.label}</a></li>))}</ul></nav>

				<h2 id="what-it-is" class="text-2xl md:text-3xl font-light mt-12 mb-4 scroll-mt-28" style="font-family: var(--font-serif); color: var(--color-ink);">What is the full armor of God?</h2>
				<p class="text-lg leading-relaxed mb-4" style="font-family: var(--font-sans); color: var(--color-muted);">Paul opens with where the strength comes from, then gives the command.</p>
				<figure class="my-6 px-6 py-5 rounded-2xl" style="background-color: #fdf2f5; border: 1px solid #f9d6e0;"><p class="text-lg leading-relaxed" style="font-family: var(--font-serif); color: var(--color-ink);">&ldquo;Finally, be strong in the Lord and in the strength of his might.&rdquo;</p><figcaption class="mt-2 text-sm" style="font-family: var(--font-sans); color: var(--color-muted);"><a href="/read/ephesians/6/" style="color: var(--color-brand);" class="hover:underline">Ephesians 6:10</a>, Father&rsquo;s Heart Bible</figcaption></figure>
				<figure class="my-6 px-6 py-5 rounded-2xl" style="background-color: #fdf2f5; border: 1px solid #f9d6e0;"><p class="text-lg leading-relaxed" style="font-family: var(--font-serif); color: var(--color-ink);">&ldquo;Put on our Father's full armor, so you can stand against the devil's schemes.&rdquo;</p><figcaption class="mt-2 text-sm" style="font-family: var(--font-sans); color: var(--color-muted);"><a href="/read/ephesians/6/" style="color: var(--color-brand);" class="hover:underline">Ephesians 6:11</a>, Father&rsquo;s Heart Bible</figcaption></figure>
				<p class="text-lg leading-relaxed mb-4" style="font-family: var(--font-sans); color: var(--color-muted);">Two things stand out. The armor belongs to our Father; you are being clothed in His strength, not manufacturing your own. And &ldquo;full&rdquo; means every piece. Verse 12 names the real opponent: the fight is not against flesh and blood, so people are never the enemy. The goal in verse 13 is modest and clear: stand firm.</p>
				<h2 id="belt" class="text-2xl md:text-3xl font-light mt-12 mb-4 scroll-mt-28" style="font-family: var(--font-serif); color: var(--color-ink);">The belt of truth</h2>
				<figure class="my-6 px-6 py-5 rounded-2xl" style="background-color: #fdf2f5; border: 1px solid #f9d6e0;"><p class="text-lg leading-relaxed" style="font-family: var(--font-serif); color: var(--color-ink);">&ldquo;So stand, having fastened the belt of truth around your waist, and having put on the breastplate of righteousness,&rdquo;</p><figcaption class="mt-2 text-sm" style="font-family: var(--font-sans); color: var(--color-muted);"><a href="/read/ephesians/6/" style="color: var(--color-brand);" class="hover:underline">Ephesians 6:14</a>, Father&rsquo;s Heart Bible</figcaption></figure>
				<p class="text-lg leading-relaxed mb-4" style="font-family: var(--font-sans); color: var(--color-muted);">A soldier&rsquo;s belt held everything else in place. Truth does the same for you: what is true about the Father, about Jesus and about who you are. Lies work by loosening that belt, so the first defense is knowing what our Father has actually said.</p>
				<h2 id="breastplate" class="text-2xl md:text-3xl font-light mt-12 mb-4 scroll-mt-28" style="font-family: var(--font-serif); color: var(--color-ink);">The breastplate of righteousness</h2>
				<p class="text-lg leading-relaxed mb-4" style="font-family: var(--font-sans); color: var(--color-muted);">The breastplate covers the heart and chest. Righteousness here is being right with our Father, a standing given through Christ, together with a life that follows Him. When shame says you are disqualified, you answer from the breastplate, not from your record.</p>
				<h2 id="feet" class="text-2xl md:text-3xl font-light mt-12 mb-4 scroll-mt-28" style="font-family: var(--font-serif); color: var(--color-ink);">Feet fitted with the gospel of peace</h2>
				<figure class="my-6 px-6 py-5 rounded-2xl" style="background-color: #fdf2f5; border: 1px solid #f9d6e0;"><p class="text-lg leading-relaxed" style="font-family: var(--font-serif); color: var(--color-ink);">&ldquo;and your feet fitted with the readiness that comes from the gospel of peace.&rdquo;</p><figcaption class="mt-2 text-sm" style="font-family: var(--font-sans); color: var(--color-muted);"><a href="/read/ephesians/6/" style="color: var(--color-brand);" class="hover:underline">Ephesians 6:15</a>, Father&rsquo;s Heart Bible</figcaption></figure>
				<p class="text-lg leading-relaxed mb-4" style="font-family: var(--font-sans); color: var(--color-muted);">Shoes are what let you stand and move. The gospel of peace, peace with our Father through Jesus, gives you a steady footing and a readiness to go and share it. You can read more in our guide <a href="/guides/what-is-the-gospel/" style="color: var(--color-brand);" class="hover:underline">What Is the Gospel?</a></p>
				<h2 id="shield" class="text-2xl md:text-3xl font-light mt-12 mb-4 scroll-mt-28" style="font-family: var(--font-serif); color: var(--color-ink);">The shield of faith</h2>
				<figure class="my-6 px-6 py-5 rounded-2xl" style="background-color: #fdf2f5; border: 1px solid #f9d6e0;"><p class="text-lg leading-relaxed" style="font-family: var(--font-serif); color: var(--color-ink);">&ldquo;In every situation, take up the shield of faith, able to put out all the flaming arrows of the evil one.&rdquo;</p><figcaption class="mt-2 text-sm" style="font-family: var(--font-sans); color: var(--color-muted);"><a href="/read/ephesians/6/" style="color: var(--color-brand);" class="hover:underline">Ephesians 6:16</a>, Father&rsquo;s Heart Bible</figcaption></figure>
				<p class="text-lg leading-relaxed mb-4" style="font-family: var(--font-sans); color: var(--color-muted);">Faith is trust in our Father, held up in front of you. The flaming arrows are accusations, fears and doubts that arrive without warning, so the verse says &ldquo;in every situation.&rdquo; For verses on trust, see <a href="/verses/faith/" style="color: var(--color-brand);" class="hover:underline">Bible verses about faith</a>.</p>
				<h2 id="helmet" class="text-2xl md:text-3xl font-light mt-12 mb-4 scroll-mt-28" style="font-family: var(--font-serif); color: var(--color-ink);">The helmet of salvation</h2>
				<figure class="my-6 px-6 py-5 rounded-2xl" style="background-color: #fdf2f5; border: 1px solid #f9d6e0;"><p class="text-lg leading-relaxed" style="font-family: var(--font-serif); color: var(--color-ink);">&ldquo;Take the helmet of salvation and the sword of the Spirit—the word of our Father.&rdquo;</p><figcaption class="mt-2 text-sm" style="font-family: var(--font-sans); color: var(--color-muted);"><a href="/read/ephesians/6/" style="color: var(--color-brand);" class="hover:underline">Ephesians 6:17</a>, Father&rsquo;s Heart Bible</figcaption></figure>
				<p class="text-lg leading-relaxed mb-4" style="font-family: var(--font-sans); color: var(--color-muted);">The helmet protects the mind. Salvation is the settled certainty that you belong to the Father through Jesus Christ, who is fully God and fully our Savior. When doubt tells you that you might not be safe, the helmet is what you put on.</p>
				<h2 id="sword" class="text-2xl md:text-3xl font-light mt-12 mb-4 scroll-mt-28" style="font-family: var(--font-serif); color: var(--color-ink);">The sword of the Spirit</h2>
				<p class="text-lg leading-relaxed mb-4" style="font-family: var(--font-sans); color: var(--color-muted);">The same verse names the last piece, and the only one that attacks: the sword of the Spirit is &ldquo;the word of our Father.&rdquo; It is Scripture, spoken and used. Jesus answered temptation in the wilderness with what was written, and that is the pattern. You cannot use a sword you have never picked up, so read and listen: the whole <a href="/read/ephesians/6/" style="color: var(--color-brand);" class="hover:underline">chapter of Ephesians 6</a> is free to read with audio.</p>
				<h2 id="prayer" class="text-2xl md:text-3xl font-light mt-12 mb-4 scroll-mt-28" style="font-family: var(--font-serif); color: var(--color-ink);">Pray in the Spirit at all times</h2>
				<figure class="my-6 px-6 py-5 rounded-2xl" style="background-color: #fdf2f5; border: 1px solid #f9d6e0;"><p class="text-lg leading-relaxed" style="font-family: var(--font-serif); color: var(--color-ink);">&ldquo;Pray in the Spirit at all times, with every prayer and request. Stay alert to this with all perseverance, interceding for all the saints,&rdquo;</p><figcaption class="mt-2 text-sm" style="font-family: var(--font-sans); color: var(--color-muted);"><a href="/read/ephesians/6/" style="color: var(--color-brand);" class="hover:underline">Ephesians 6:18</a>, Father&rsquo;s Heart Bible</figcaption></figure>
				<p class="text-lg leading-relaxed mb-4" style="font-family: var(--font-sans); color: var(--color-muted);">Prayer is not a seventh piece of armor; it is how the whole thing is worn. Notice &ldquo;all the saints&rdquo;: you are not standing alone, and you are asked to stand for others too. If prayer feels hard, begin with <a href="/guides/how-to-pray/" style="color: var(--color-brand);" class="hover:underline">How to Pray</a>.</p>
				<aside class="my-12 px-6 py-10 lg:px-10 lg:py-12 rounded-2xl text-center" style="background-color: #fdf2f5; border: 1px solid #f9d6e0;"><p class="text-2xl md:text-3xl font-light leading-tight max-w-2xl mx-auto" style="font-family: var(--font-serif); color: var(--color-ink);">Read the whole passage</p><p class="mt-4 max-w-2xl mx-auto text-base lg:text-lg leading-relaxed" style="font-family: var(--font-sans); color: var(--color-muted);">Read and listen to Ephesians 6 in Father&rsquo;s Heart Bible, free online.</p><a href="https://fathersheartbible.com/read/ephesians/6/" class="inline-flex items-center gap-2 mt-7 px-7 py-3 rounded-full text-sm font-semibold no-underline transition-opacity hover:opacity-90" style="background-color: #FFD9E0; color: #4A4A4A; font-family: var(--font-sans);">Read &amp; Listen Free<span aria-hidden="true">&rarr;</span></a></aside>


<h2 id="faq" class="text-2xl md:text-3xl font-light mt-12 mb-6 scroll-mt-28" style="font-family: var(--font-serif); color: var(--color-ink);">Frequently asked questions</h2>
				<div class="space-y-6">
					{FAQS.map((f) => (<div><h3 class="text-xl font-medium mb-2" style="font-family: var(--font-serif); color: var(--color-ink);">{f.question}</h3><p class="text-lg leading-relaxed" style="font-family: var(--font-sans); color: var(--color-muted);">{f.answer}</p></div>))}
				</div>

				<div class="mt-12 pt-8 border-t" style="border-color: var(--color-hairline);">
					<p class="text-sm leading-relaxed" style="font-family: var(--font-sans); color: var(--color-muted);">
						Keep going: read <a href="/guides/how-to-pray/" style="color: var(--color-brand);" class="hover:underline">How to Pray</a>, <a href="/guides/how-to-read-the-bible/" style="color: var(--color-brand);" class="hover:underline">How to Read the Bible</a>, or open the <a href="https://fathersheartbible.com/read/" style="color: var(--color-brand);" class="hover:underline">whole Bible free with audio</a>.</p>
				</div>
			</div>
		</section>

		<section class="px-6 py-12 lg:px-8 lg:py-16" style="background-color: var(--color-surface-low);">
			<div class="mx-auto max-w-2xl text-center">
				<h2 class="text-2xl md:text-3xl font-light leading-tight" style="font-family: var(--font-serif); color: var(--color-ink);">Read Father&rsquo;s Heart Bible free</h2>
				<p class="mt-4 text-base lg:text-lg leading-relaxed" style="font-family: var(--font-sans); color: var(--color-muted);">Stand on the Father&rsquo;s word. Read Father&rsquo;s Heart Bible free online with audio &mdash; a translation that reveals God as a loving Father on every page.</p>
				<a href="https://fathersheartbible.com/read/" class="inline-flex items-center gap-2 mt-6 px-7 py-3 rounded-full text-sm font-semibold no-underline transition-colors" style="background-color: var(--color-brand); color: var(--color-on-primary); font-family: var(--font-sans);">Read FHB<span aria-hidden="true">&rarr;</span></a>
			</div>
		</section>

		<ReviewLink class="mb-10" />

		<AuthorBio author="Kevin White" />
	</main>
</Layout>
