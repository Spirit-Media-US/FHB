---
// Guide — /guides/noahs-ark (unit 2ov). Target: noah's ark, noah, noah and the ark, noah's ark story.
// Quotes are verbatim FHB (Genesis 6-9, Matthew 24, 1 Peter 3, locked canon).
import AuthorBio from '../../components/AuthorBio.astro';
import ReviewLink from '../../components/ReviewLink.astro';
import YouVersionBanner from '../../components/YouVersionBanner.astro';
import Layout from '../../layouts/Layout.astro';

const PAGE_URL = 'https://fathersheartbible.com/guides/noahs-ark/';
const TITLE = "Noah's Ark (Genesis 6-9) — The Story and What It Shows";
const DESCRIPTION =
	"Noah's ark in Genesis 6-9: why the flood came, how big the ark was, how long the flood lasted, where it landed and what the rainbow means, quoted from Father's Heart Bible.";
const PUBLISHED = '2026-11-10';
const MODIFIED = '2026-11-10';

