		url: 'https://www.prnewswire.com/news-releases/spirit-media-shakes-up-the-publishing-industry-with-unique-expedited-process-302175618.html',
	},
	{
		date: '2024-08-15',
		title:
			'SpiritMedia.US to Publish The Pyramid Principle by UCLA Superstar and NBA Pro John Vallely',
		url: 'https://www.prnewswire.com/news-releases/spiritmediaus-to-publish-the-pyramid-principle-by-ucla-superstar-and-nba-pro-john-vallely-302223398.html',
	},
].sort((a, b) => b.date.localeCompare(a.date));
const fmtPressDate = (d: string) =>
	new Date(d + 'T12:00:00Z').toLocaleDateString('en-US', {
		year: 'numeric',
		month: 'long',
		day: 'numeric',
		timeZone: 'UTC',
	});
const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'CollectionPage',
		name: TITLE,
		description: DESCRIPTION,
		url: PAGE_URL,
		dateModified: UPDATED,
		inLanguage: 'en-US',
		about: {
			'@type': 'Book',
			'@id': 'https://fathersheartbible.com/#book',
			name: "Father's Heart Bible™",
			bookEdition: `Text Edition ${EDITION}`,
		},
		editor: KEVIN,
		hasPart: DOCS.map((d) => ({
			'@type': 'DigitalDocument',
			name: d.title,
			url: `${R2}/${d.slug}.pdf`,
			encodingFormat: 'application/pdf',
			thumbnailUrl: `${R2}/${d.slug}-thumb.webp`,
			dateModified: UPDATED,
			numberOfPages: d.pages,
			publisher: {
				'@type': 'Organization',
				'@id': 'https://spiritmediapublishing.com/#organization',
				name: 'Spirit Media Publishing',
			},
		})),
	},
	{
		'@context': 'https://schema.org',
		'@type': 'Organization',
		'@id': 'https://spiritmediapublishing.com/#organization',
		name: 'Spirit Media Publishing',
		subjectOf: PRESS.map((r) => ({
			'@type': 'NewsArticle',
			headline: r.title,
			url: r.url,
			datePublished: r.date,
			publisher: {
				'@type': 'Organization',
				name: 'PR Newswire',
				url: 'https://www.prnewswire.com',
			},
		})),
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: FAQ.map(([q, a]) => ({
			'@type': 'Question',
			name: q,
			acceptedAnswer: { '@type': 'Answer', text: plainText(a) },
		})),
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://fathersheartbible.com/' },
			{
				'@type': 'ListItem',
				position: 2,
				name: 'An Overview for Scholars and Partners',
				item: PAGE_URL,
			},
		],
	},
];

const H2 = 'text-2xl md:text-3xl font-light mt-14 mb-5 scroll-mt-28';
const P = 'text-lg leading-relaxed mb-4';
---
<Layout title={fitTitle(TITLE)} description={fitDescription(DESCRIPTION)} jsonLd={jsonLd}>
	<main id="main-content" class="scholars">
		{/* Shared marketing hero (Kevin D123 item 9, "1 and 2 yes add images"): the About page hero photo (Kevin 10-27, addendum Y; no link), pre-sized
		    WebP + mobile file + explicit dims (perf gate). The h1 sits below the image, as on About. */}
		<VideoHeroInner
			imageSrc="https://assets.spiritmediapublishing.com/FHB/print/about-hero-pews.webp"
			imageSrcMobile="https://assets.spiritmediapublishing.com/FHB/print/about-hero-pews-960.webp"
			imageWidth={1902}
			imageHeight={686}
			imagePosition="top"
			heading={TITLE}
			headingBelow
		/>
		<section class="px-6 pt-2 pb-2 lg:px-8" style="background-color: var(--color-surface);">
			<div class="mx-auto max-w-3xl">
				<nav aria-label="Breadcrumb" class="mb-3 text-sm text-center" style="color: var(--color-muted); font-family: var(--font-sans);">
					<a href="/" class="hover:underline">Home</a><span class="px-1.5" aria-hidden="true">/</span>
					<span style="color: var(--color-ink);">An Overview for Scholars and Partners</span>
				</nav>
				<p class="pb-6 text-sm text-center border-b" style="color: var(--color-muted); font-family: var(--font-sans); border-color: var(--color-hairline);">
					Father&rsquo;s Heart Bible&trade; in Divine Voice&trade; Color &middot; Text Edition {EDITION}
				</p>
			</div>
		</section>

		<section class="px-6 py-10 lg:px-8 lg:py-14" style="background-color: var(--color-surface);">
			<div class="mx-auto max-w-3xl" style="font-family: var(--font-sans); color: var(--color-muted);">

				{/* Kevin 2026-10-27: ONE welcome/intro, a confident introduction (approved text, overview-reframe brief C). */}
				<p class={P}>Father&rsquo;s Heart Bible&trade; is a complete translation of the Bible, 66 books and 31,087 verses, from the original Hebrew, Aramaic and Greek. It is printed in Divine Voice&trade; Color: Father&rsquo;s words in <strong style="color:#2563eb">blue</strong>, Son&rsquo;s words in <strong style="color:#c8102e">red</strong>, and Spirit&rsquo;s words in <strong style="color:#6a3fa0">purple</strong>.</p>
				{/* Kevin 2026-10-27 (addendum V): the homepage FATHER / SON / SPIRIT blocks, same component and palette. */}
				<VoiceChips size="1.25rem" class="mb-6" />
				<p class={P}>It is published in 25 audience editions, soon in 80 languages, free to read at <a href="/read/" style="color: var(--color-brand);">fathersheartbible.com/read</a> and on other Bible platforms worldwide through Digital Bible Library partners, and in print worldwide.</p>
				<p class={P}>This overview sets out what we confess, how the translation was made, the texts behind it, how it names God, and how the Divine Voice&trade; Color is decided. All 160 translation rules are in the documents below.</p>

				{/* Kevin 2026-10-27 08:0xZ (addendum M2): "My 3 points lead and need to be combined with your 9 points"; 08:1xZ (N) verbatim; R: sections below follow the list; T 08:4xZ: new item 2 (tag line), 9 items; V: one paragraph, tag line inline italic. */}
				<h2 id="what-makes-it-different" class={H2} style="font-family: var(--font-serif); color: var(--color-ink);">What makes Father&rsquo;s Heart Bible&trade; different</h2>
				<ol class="list-decimal pl-6 space-y-3 mb-10 text-lg leading-relaxed">
					<li set:html={refs('<strong style="color: var(--color-ink);">A Father-first Bible.</strong> Father, Heart, Bible: its name is its order. It reveals our Father, His heart, and His gifts to us: His Son, His Holy Spirit and His written Word. Each reveals that our Father&rsquo;s greatest gift is Himself, as Father.')} />
					<li set:html={refs('<strong style="color: var(--color-ink);">Receiving over reading.</strong> Our tag line reveals our Father&rsquo;s heart: <em>Receive the Father. Hear His Voice. His Heart is For You.</em> It profits no one to carry a Bible and not know our Father.')} />
					<li set:html={refs('<strong style="color: var(--color-ink);">Our Father, named from Genesis 1:1.</strong> &ldquo;In the beginning, our Heavenly Father created the heavens and the earth.&rdquo; Where other Bibles use &ldquo;God&rdquo; and &ldquo;Lord&rdquo; to say what He is, Father&rsquo;s Heart Bible&trade; says who He is.')} />
					<li set:html={refs('<strong style="color: var(--color-ink);">His voice in Divine Voice&trade; Color.</strong> The words of the Father (in <strong style="color:#2563eb">blue</strong>), His Son (in <strong style="color:#c8102e">red</strong>) and His Holy Spirit (in <strong style="color:#6a3fa0">purple</strong>) are each printed in their own color, equipping and empowering readers to hear His voice.')} />
					<li set:html={refs('<strong style="color: var(--color-ink);">Written to carry our Father&rsquo;s heart.</strong> Where the original allows it, the wording carries His personal warmth: His heart goes out to His people, He calls them His children, and the Bible is His story of restoring His beloved sons and daughters to Himself.')} />
					<li set:html={refs('<strong style="color: var(--color-ink);">Divine naming is mapped between the Old and New Testaments where Scripture provides it.</strong> Example: Isaiah saw &ldquo;the Lord Jesus seated on a throne&rdquo; (Isaiah 6:1), because John tells us Isaiah saw Jesus&rsquo; glory (John 12:41).')} />
					<li set:html={refs('<strong style="color: var(--color-ink);">Name and voice identified throughout.</strong> &ldquo;Lord&rdquo; stays with Jesus, apart from the exceptions shown in the names table. Our Father is identified as &ldquo;Sovereign.&rdquo;')} />
					<li set:html={refs('<strong style="color: var(--color-ink);">The speaker shapes the wording.</strong> In Genesis 3 the narrator speaks of &ldquo;our Father,&rdquo; but the serpent will only say &ldquo;God&rdquo;: &ldquo;Did God really say&hellip;?&rdquo; The Hebrew makes the same distinction, and Father&rsquo;s Heart Bible lets every reader hear it. Those who keep Him at a distance call Him only &ldquo;God&rdquo;; His own call Him Father, nearly 7,000 times.')} />
					<li set:html={refs('<strong style="color: var(--color-ink);">A published method.</strong> Modern language technology, held to 160 written translation rules, applies each decision the same way across all 66 books, with a consistency and reach not available to earlier translations. Each book passed through successive faithfulness checks before release, and every rule is published in full.')} />
				</ol>


				<nav aria-label="On this page" class="toc mb-10 px-5 py-4 rounded-xl" style="background-color: var(--color-surface-low); border: 1px solid var(--color-hairline);">
					<p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: var(--color-muted);">On this page</p>
					<ul class="flex flex-wrap gap-x-5 gap-y-2 list-none m-0 p-0 text-sm">
						{TOC.map(([id, label]) => (<li><a href={`#${id}`} class="hover:underline" style="color: var(--color-brand);">{label}</a></li>))}
					</ul>
				</nav>

				<h2 id="documents" class={H2} style="font-family: var(--font-serif); color: var(--color-ink); ">The documents</h2>
				<p class={P}>Two documents, the same text as this page and more. Open one to read it in your browser, or download it.</p>
				<div class="grid grid-cols-1 sm:grid-cols-3 gap-5 mb-4">
					{DOCS.map((d) => (
						<div class="doc-card flex flex-col rounded-xl overflow-hidden" style="background-color: var(--color-surface-low); border: 1px solid var(--color-hairline);">
							<a href={`${R2}/${d.slug}.pdf`} target="_blank" rel="noopener" class="block" style="background:#fff; border-bottom: 1px solid var(--color-hairline);">
								<img src={`${R2}/${d.slug}-thumb.webp`} alt={`First page of ${d.title}`} width="480" height="621" loading="lazy" decoding="async" class="w-full h-auto block" />
							</a>
							<div class="p-4 flex flex-col flex-1">
								<h3 class="text-lg font-medium mb-1" style="font-family: var(--font-serif); color: var(--color-ink);">{d.title}</h3>
								<p class="text-sm mb-2">{d.pages} pages &middot; {UPDATED.slice(0, 4)}</p>
								<p class="text-sm leading-relaxed mb-4 flex-1">{d.blurb}</p>
								<div class="flex gap-2 flex-wrap">
									<a href={`${R2}/${d.slug}.pdf`} target="_blank" rel="noopener" class="inline-flex items-center px-4 py-2 rounded-full text-sm font-semibold no-underline" style="background-color: var(--color-brand); color: var(--color-on-primary);">Read</a>
									<a href={`${R2}/download/${d.slug}.pdf`} class="inline-flex items-center px-4 py-2 rounded-full text-sm font-semibold no-underline" style="border: 1px solid var(--color-brand); color: var(--color-brand);">Download</a>
								</div>
							</div>
						</div>
					))}
				</div>


				<h2 id="confession" class={H2} style="font-family: var(--font-serif); color: var(--color-ink);">What we confess</h2>
				<ol class="list-decimal pl-6 space-y-2 mb-6 text-lg leading-relaxed">
					{CONFESSION.map((c) => (<li>{c}</li>))}
				</ol>
				<h3 class="text-xl font-medium mt-8 mb-3" style="font-family: var(--font-serif); color: var(--color-ink);">You can see it on the page</h3>
				<p class={P}>A translation shows what it believes where the text is most contested. These are the verses a scholar checks first, as Father&rsquo;s Heart Bible&trade; prints them:</p>
				<ul class="space-y-1 mb-5 text-lg leading-relaxed list-none pl-0">
					{ON_THE_PAGE.map(([r, t]) => (<li set:html={`${refs(r)} — ${t}`} />))}
				</ul>
				<p class={P} set:html={refs('At Joel 2:32 our text reads “everyone who calls on the name of the Lord will be saved,” and the note there names Jesus, as Paul does in Romans 10:13.')} />

				<h2 id="names" class={H2} style="font-family: var(--font-serif); color: var(--color-ink);">How Father&rsquo;s Heart Bible&trade; names God</h2>
				<p class={P}>The Hebrew and Greek Scriptures speak of God by many names and titles. Father&rsquo;s Heart Bible&trade; renders each one by the Person it refers to, so the reader hears who is speaking and who is spoken of. Each source name follows one fixed rule, applied the same way through all 66 books. This table shows them side by side, so that anyone reading alongside another Bible can see where the wording differs and why.</p>
				<p class={P} set:html={refs('<strong style="color: var(--color-ink);">Why &ldquo;our Father&rdquo;?</strong> Scripture speaks of one God, revealed in the New Testament as Father, Son and Holy Spirit, and the New Testament shows us which Person is meant. Jesus Himself names the God of Israel as His Father: &ldquo;It is my Father who glorifies me, of whom you say, &lsquo;He is our God&rsquo;&rdquo; (John 8:54). So where the New Testament identifies a passage with the Son or the Spirit, Father&rsquo;s Heart Bible names the Son or the Spirit; everywhere else, the One who speaks and acts is our Father.')} />
				<p class={P} set:html={refs('The New Testament names our Father as the source of creation and the Son as the one through whom it was made: “one God, our Father, all things from him … and one Lord Jesus Christ, all things through him” (1 Corinthians 8:6). So Genesis 1:1 reads “our Heavenly Father created the heavens and the earth,” <a href="/read/genesis/1/#v2" class="sref">1:2</a> names “the Spirit of our Father,” and <a href="/read/genesis/1/#v26" class="sref">1:26</a> keeps the plural: “Let us make humanity in our image…”')} />
				<p class={P} set:html={refs('Where the New Testament sets God beside Christ, “God” names the Father, so Nathanael’s confession reads, “Rabbi, you are the Son of our Father!” (John 1:49). On the lips of those who do not know Him as Father, such as the tempter and the demons, the title stays “the Son of God” (Matthew 4:3), and in every place the title Son stands. Matthew’s “kingdom of heaven” is his reverent way of saying what Mark and Luke call the kingdom of God, and both are rendered as our Father’s kingdom: “Repent, for the kingdom of our Father is near” (Matthew 4:17).')} />
				<p class={P} set:html={refs('Father’s Heart Bible never prints the divine name itself, the four Hebrew letters traditionally printed LORD, in its Bible text. Printed as four letters it says nothing to a modern reader, and a reconstructed pronunciation is a scholarly guess no congregation says aloud; and a Bible written to show that God reveals Himself as Father cannot render His own name as a word that says nothing about who He is. Where a note needs the name to explain a rendering, the note gives it.')} />
				<div class="table-wrap mb-5">
					<table class="names">
						<thead><tr><th scope="col">Hebrew or Greek</th><th scope="col">Usually printed elsewhere</th><th scope="col">Father&rsquo;s Heart Bible&trade;</th><th scope="col">Example</th></tr></thead>
						<tbody>
							{NAMES.map(([src, other, fhb, ex]) => (<tr><th scope="row">{src}</th><td>{other}</td><td>{fhb}</td><td set:html={refs(ex)} /></tr>))}
						</tbody>
					</table>
				</div>
				<p class={P}>Where another Bible prints a title, Father&rsquo;s Heart Bible&trade; usually prints the Person. The Hebrew name has not been dropped; it has been read for who it names. Naming the Father also names the Son and the Holy Spirit beside Him, and the Divine Voice&trade; Color then shows which of them is speaking. Footnotes give the reason wherever a rendering rests on the New Testament&rsquo;s own identification.</p>
				<p class={P}>Every example verse above is quoted from the published text of Father&rsquo;s Heart Bible&trade; at <a href="/read/" style="color: var(--color-brand);">fathersheartbible.com/read</a>.</p>

				<h2 id="divine-voice-color" class={H2} style="font-family: var(--font-serif); color: var(--color-ink);">How the Divine Voice&trade; Color is decided</h2>
				<VoiceChips size="1.25rem" class="mb-6" />
				<p class={P}>Father&rsquo;s Heart Bible&trade; prints the words of each divine person in that person&rsquo;s own color: the Father in <strong style="color:#2563eb">blue</strong>, the Son in <strong style="color:#c8102e">red</strong>, the Holy Spirit in <strong style="color:#6a3fa0">purple</strong>. Red-letter editions have done this for the Son since Louis Klopsch&rsquo;s red-letter New Testament of 1899. We extend the same convention to the other two persons of the Trinity, and we apply one governing rule to all three. To our knowledge, Father&rsquo;s Heart Bible&trade; is the first complete Bible printed with the words of the Father, the Son, and the Holy Spirit each in their own color.</p>
				<p class={P}>The rule: the color marks words a divine person actually spoke. It is an ownership mark, not a quotation mark. The test is a single question asked of every span of text: <strong style="color: var(--color-ink);">Were these words actually spoken by a divine person?</strong></p>
				<p class={P}>It is never &ldquo;who is holding the microphone,&rdquo; and never &ldquo;is the speaker righteous.&rdquo; That one question settles most cases on its own. The principles below settle the rest, and each is applied consistently across the whole canon rather than verse by verse.</p>
				<ol class="list-decimal pl-6 space-y-3 mb-5 text-lg leading-relaxed">
					<li set:html={refs('<strong>Ownership travels.</strong> Words a divine person really spoke keep their color on whatever lips repeat them accurately: a prophet delivering them, a herald carrying them, an apostle quoting them. Paul quoting the Lord Jesus in Acts 20:35 carries the color: the words are still His.')} />
					<li set:html={refs('<strong>Containment — everything inside a divine utterance is His.</strong> Once a divine person begins to speak, every word until He finishes carries the color, including words He is quoting back from someone else. When our Father repeats the people’s own complaint in Ezekiel 33:17 and 33:20, or foretells what passersby will say in 1 Kings 9:8-9 and 2 Chronicles 7:21-22, those words are inside His utterance and are printed in His color. The test is containment, not proximity. A speaker’s own words elsewhere in the same verse stay black: Saul’s “Who are you, Lord?” in Acts 9:5 and Samuel’s “How can I go?” in 1 Samuel 16:2 sit outside the divine utterance, as does the narrator’s frame around it. This matches long-standing red-letter practice, which prints in <strong style="color:#c8102e">red</strong> the Old Testament words Jesus quotes. Our red letter does the same, for example at Mark 7:6 and Matthew 4:7, and at the words He gives others inside His own sayings, as at Luke 12:19, Luke 15:19 and Matthew 25:12.')} />
					<li><strong>Parables are never split.</strong> When the Son tells a parable, the whole parable is His speech, including the words He gives to characters inside it.</li>
					<li><strong>Narration is never colored.</strong> The narrator&rsquo;s frame, such as &ldquo;Then our Father said,&rdquo; is not itself divine speech and stays black. A formula such as &ldquo;declares our Father&rdquo; spoken inside His own words is part of His utterance and carries His color (principle 2).</li>
					<li><strong>Words never spoken are never colored.</strong> Description of a divine person, address to Him, and report about Him are not His speech. Only what was said receives the color.</li>
				</ol>
				<p class={P}>These are not private conventions. The governing rule and its corollaries are written into our translation rule set, published in <a href="#documents" style="color: var(--color-brand);">The Complete Translation Rules</a>, and every chapter is checked against them before publication.</p>

				<h2 id="isaiah-6" class={H2} style="font-family: var(--font-serif); color: var(--color-ink);">Isaiah 5 and Isaiah 6: why &ldquo;the Lord of Hosts&rdquo; is not always the same Person</h2>
				<p class={P}>The title is rendered differently in these two chapters, and the difference is deliberate.</p>
				<p class={P} set:html={refs('In Isaiah 5, “the Lord of Hosts” is rendered the Father of heaven’s armies (verses 7, 9 and 16). In Isaiah 6, the figure on the throne is rendered as the Son: verse 1 reads “I saw the Lord Jesus seated on a throne, high and lifted up,” and verse 5 “my eyes have seen the King, Jesus, the Lord of all heaven’s armies!”')} />
				<p class={P} set:html={refs('The warrant is John 12:41. Having quoted Isaiah 6:10, John states why Isaiah spoke as he did. Our rendering reads: “Isaiah said these things because he saw Jesus’ glory and spoke about him.” Our note at that verse puts it plainly: when Isaiah saw the throne in the temple and the seraphim cried “Holy, holy, holy,” he was seeing the glory of Jesus.')} />
				<p class={P}>The New Testament therefore identifies the occupant of the Isaiah 6 throne, and we follow that identification rather than overriding it. Where the New Testament makes no such identification, as in Isaiah 5, the title is rendered of the Father. The difference between the two chapters is not an inconsistency in our method; it is the result of applying it.</p>
				<p class={P} set:html={refs('Father’s Heart Bible renders the threefold holy as “our Father, Son, and Holy Spirit” because all three Persons are in view in this vision. The New Testament tells us Isaiah saw the glory of Jesus (John 12:41) and that the Holy Spirit spoke through Isaiah (Acts 28:25), and in John’s vision of the throne the same threefold holy is sung to our Father: “Holy, holy, holy is the Sovereign Father Almighty” (Revelation 4:8).')} />
				<p class={P} set:html={refs('The identification settles the color. Because the New Testament identifies the figure on the Isaiah 6 throne as the Son, the speech from that throne is printed in <strong style="color:#c8102e">red</strong>, the Son’s color: “Whom should I send? Who will go for us?” in verse 8, and the commissioning oracle that follows in verses 9 through 13, from “Go, tell this people” to “The holy seed is its stump.” Verses 1 through 7 stay black, the seraphim’s threefold holy among them, because the color marks the words of a divine person and the seraphim are not divine persons.')} />
				<p class={P} set:html={refs('The same words keep the same color wherever the New Testament carries them. Ownership travels, as principle 1 above states, so the oracle is <strong style="color:#c8102e">red</strong> in Isaiah 6, and <strong style="color:#c8102e">red</strong> again at John 12:40 and Acts 28:26-27 where it is quoted. Acts 28:25 names the agent: our rendering reads “The Holy Spirit spoke rightly to your ancestors through Isaiah the prophet.” The two statements stand together rather than competing. Our Lord Jesus is the one who speaks, and He speaks through the Holy Spirit; John 12:41 tells us whose glory Isaiah saw, and Acts 28:25 tells us how that word reached the prophet. One oracle, one owner, one color in all three places.')} />

				<h2 id="how-it-was-made" class={H2} style="font-family: var(--font-serif); color: var(--color-ink);">How it was made</h2>
				<p class={P}>On the familiar spectrum from word-for-word to thought-for-thought, Father&rsquo;s Heart Bible&trade; is a meaning-based translation: it renders the original in clear, contemporary English, and it makes the Father&rsquo;s identity, presence, and voice explicit where the text already carries them.</p>
				<p class={P}>Where the Hebrew or Greek carries the family relationship, the English carries it too. &ldquo;My people&rdquo; may become &ldquo;my children&rdquo; where the passage speaks in family terms, of inheritance, covenant, discipline or planting, and stays &ldquo;my people&rdquo; where national identity is the point. A word may also be read at the depth of the whole story of Scripture, but only where a clear line can be traced from the source word; where it cannot, the standard word stays and the insight goes into a study note.</p>
				<p class={P}>It is not a paraphrase, and it is not an adaptation of any existing English Bible. It is not a study Bible: its notes are written for general readers, and its method is documented for scholars in the <a href="#documents" style="color: var(--color-brand);">companion documents</a>. It is not abridged.</p>
				<p class={P}>Father&rsquo;s Heart Bible&trade; was produced through a structured, rule-governed translation process built for this work, bringing the consistency and reach of modern language technology to the ancient task of translation. Within that process, AI language tools rendered the text and footnotes directly from the original Hebrew, Aramaic, and Greek, guided by a written set of 160 translation rules.</p>
				<p class={P}>The rules and every interpretive decision are the work of Spirit Media Publishing led by Kevin White, Editor.</p>
				<p class={P}>On ordinary lexical and textual questions, our renderings agree with the settled consensus of the major modern translations and of the standard base texts, as most modern translations do. Our own contribution is focused and stated: how the Persons of the Trinity are named, and whose voice is speaking. The rules that govern both are published in full in <a href="#documents" style="color: var(--color-brand);">The Complete Translation Rules</a>.</p>

				<h2 id="base-texts" class={H2} style="font-family: var(--font-serif); color: var(--color-ink);">The base texts</h2>
				<p class={P}>Father&rsquo;s Heart Bible&trade; is translated from the original languages, not from an English predecessor. The Old Testament follows the Masoretic Text of the Leningrad Codex as printed in Biblia Hebraica Stuttgartensia, and the New Testament follows the modern critical text of Nestle-Aland 28 and the UBS fifth edition; our checks against the source are made with the Westminster Leningrad Codex, the digital edition of the same Hebrew manuscript, and the SBL Greek New Testament. The Aramaic portions (Daniel 2:4b&ndash;7:28, Ezra 4:8&ndash;6:18 and 7:12&ndash;26, and Jeremiah 10:11) are translated from the Aramaic.</p>
				<p class={P}>Where the manuscripts differ, it keeps company with the consensus of the modern critical editions. Standard Hebrew and Greek reference works are gratefully acknowledged; the English text, notes, and headings are our own.</p>
				<h3 class="text-xl font-medium mt-8 mb-3" style="font-family: var(--font-serif); color: var(--color-ink);">How the text was produced and checked</h3>
				<p class={P}>In practice, each chapter was translated whole, and the AI tools were never given an English translation as a source. They were required to cite the written rule behind every decision and to flag any decision no rule governs. They worked from their own command of the original-language text rather than from a supplied file of a printed edition, which is why the text is checked against the two editions named above.</p>
				<p class={P}>That check against the source text has two parts, and we describe exactly what each covers. First, the verses in which &ldquo;Father&rdquo; appears two or more times are set beside the Westminster Leningrad Codex or the SBL Greek New Testament, so that each &ldquo;Father&rdquo; in them can be confirmed as the rendering of a divine name or title in the Hebrew or Greek; each flag is confirmed by reading the source before anything is changed. Second, a sample of revised verses is checked against the Hebrew and Greek, and no finding counts unless it cites the source word.</p>
				<p class={P}>Consistency checks run on every chapter before it is published. They check every divine utterance against the rule and confirm that every edition carries its required statements.</p>
				<p class={P}>Verse divisions follow modern English versification. The sixteen verse numbers listed under “Why are some verses missing?” below, which the modern critical editions do not print, are absent from the count.</p>

				<h2 id="how-it-was-reviewed" class={H2} style="font-family: var(--font-serif); color: var(--color-ink);">How it was reviewed</h2>
				<p class={P}>Independent scholars in India, Nepal, the UK, the USA and other countries have reviewed the text, and every book passed through the review stages described above. Each edition carries a version number; this printing is Text Edition {EDITION}. We never stop reviewing, and improvements are always welcome.</p>

				<h2 id="language-editions" class={H2} style="font-family: var(--font-serif); color: var(--color-ink);">The language editions</h2>
				<p class={P}>Every language edition of Father&rsquo;s Heart Bible&trade; is translated from the English Father&rsquo;s Heart Bible&trade; with AI assistance, and every edition carries the same statement of provenance and translator credit, word for word in its own language.</p>
				<p class={P}>Each edition now follows a written profile of the language&rsquo;s own grammar and word order. The English gives the meaning; the language gives the form. A verb-final language keeps its verb at the end, a language that splits a quotation in two may do so, and the result is meant to read as that language is actually spoken, not as English with foreign words.</p>
				<p class={P}>Each edition carries the whole Bible: 66 books and 1,189 chapters, with the footnotes, the book names and the reader interface in its own language. Each carries the Divine Voice&trade; Color: the words of the Father, the Son and the Holy Spirit marked to follow the English, so that a reader in any language hears who is speaking.</p>
				<p class={P}>Before an edition is first published, it must pass the same set of checks: every chapter of every book present and complete; the Divine Voice&trade; Color matching the English, verse by verse; every quotation closed; the language&rsquo;s own script rendered correctly throughout; the statement of provenance and the translator credit present. An edition that fails a check is not published until it is fixed.</p>
				<p class={P}>The checks above prove the form of an edition. Native-speaker review is part of each edition&rsquo;s ongoing care.</p>
				<p class={P}>Father&rsquo;s Heart Bible is being published in these 80 languages, chosen together to cover the world:</p>
				{/* Kevin 2026-10-27 (addendum AN): all 80 by region, typed (fixed target); set checked against /legacy's deduplicated roster (src/data/language-roster.ts). */}
				<ul class="list-disc pl-6 space-y-2 mb-5 text-lg leading-relaxed">
					<li><strong>Languages of India and South Asia:</strong> Bengali, Chokri Naga, Gujarati, Hindi, Inpui Naga, Kannada, Malayalam, Marathi, Nagamese, Nepali, Odia, Punjabi, Sindhi, Tamil, Tangkhul, Telugu, Urdu.</li>
					<li><strong>East and Southeast Asia:</strong> Burmese, Cantonese, Cebuano, Chinese (Simplified), Chinese (Traditional), Filipino, Hiligaynon, Ilocano, Indonesian, Japanese, Javanese, Korean, Malay, Sundanese, Thai, Vietnamese.</li>
					<li><strong>Africa:</strong> Afrikaans, Akan (Twi), Amharic, Anaang, Chichewa, Gikuyu, Hausa, Igbo, Izon, Kinyarwanda, Kipsigis, Kirundi, Kituba, Malagasy, Mangbetu, Nigerian Pidgin, Oromo, Sena, Shona, Somali, Swahili, Tigrinya, Xhosa, Yaka, Yoruba, Zulu.</li>
					<li><strong>The Middle East and Central Asia:</strong> Arabic, Azerbaijani, Kurdish, Pashto, Persian, Turkish, Uzbek.</li>
					<li><strong>Europe and the Americas:</strong> Dutch, English, French, German, Greek, Haitian Creole, Hungarian, Italian, Polish, Portuguese, Romanian, Russian, Spanish, Ukrainian.</li>
				</ul>
				<p class={P}>Country guides for some of these languages: <a href="/bible-in/ukraine/" style="color: var(--color-brand);" class="hover:underline">the Bible in Ukraine</a>, <a href="/bible-in/poland/" style="color: var(--color-brand);" class="hover:underline">Poland</a>, <a href="/bible-in/romania/" style="color: var(--color-brand);" class="hover:underline">Romania</a>, <a href="/bible-in/greece/" style="color: var(--color-brand);" class="hover:underline">Greece</a>, <a href="/bible-in/hungary/" style="color: var(--color-brand);" class="hover:underline">Hungary</a>, <a href="/bible-in/netherlands/" style="color: var(--color-brand);" class="hover:underline">the Netherlands</a> and <a href="/bible-in/south-africa/" style="color: var(--color-brand);" class="hover:underline">South Africa</a>. All countries are on <a href="/bible-in/" style="color: var(--color-brand);" class="hover:underline">the Bible around the world</a>.</p>
				<p class="mb-4">
					<a href="/read/" class="inline-flex items-center px-6 py-3 rounded-full text-sm font-semibold no-underline" style="background-color: var(--color-brand); color: var(--color-on-primary);">Read free at fathersheartbible.com/read</a>
				</p>

				<h2 id="questions" class={H2} style="font-family: var(--font-serif); color: var(--color-ink);">Questions scholars have asked</h2>
				<p class={P}>These are questions scholars and church leaders have asked us, with our answers. We add to this section as new questions come, so that every reader can see what others have asked.</p>
