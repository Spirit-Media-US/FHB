const verses = [
	{
		ref: 'Psalm 34:18',
		slug: 'psalms',
		ch: 34,
		text: 'Our Father is near to the brokenhearted; he saves those crushed in spirit.',
	},
	{
		ref: 'Matthew 11:28',
		slug: 'matthew',
		ch: 11,
		text: 'Come to me, all you who are weary and burdened, and I will give you rest.',
	},
	{
		ref: '1 John 3:1',
		slug: '1-john',
		ch: 3,
		text: 'See what kind of love our Father has given us, that we should be called children of our Father! And we are.',
	},
];

const stats = [
	{ label: 'People', value: 'about 29.7 million' },
	{ label: 'Hindu', value: '81.19% (2021 census)' },
	{ label: 'Buddhist', value: '8.21%' },
	{ label: 'Christian', value: '1.76% — 512,191 people' },
];

const faqs = [
	{
		question: 'How many Christians are there in Nepal?',
		answer: `Nepal's 2021 census counted 512,191 Christians, 1.76% of the population, alongside 81.19% Hindu, 8.21% Buddhist, 5.09% Muslim and 3.17% Kiratist. You can read the Scriptures they treasure free in Father's Heart Bible™ at fathersheartbible.com/read.`,
	},
	{
		question: 'Can I read the Bible online free in Nepali?',
		answer: `Yes. Father's Heart Bible™ is free to read online in Nepali (नेपाली) — all 66 books, no account, no purchase, no app — at fathersheartbible.com/read/ne/. Start with John 3 or Psalm 23. The English edition is free too, with audio.`,
	},
	{
		question: "Is Father's Heart Bible available in Nepali?",
		answer: `Yes. The Nepali edition is free to read at fathersheartbible.com/read/ne/. Nepali is the official language of Nepal and is spoken by about ${sp('ne')} people, in Nepal and in India, Bhutan and the Nepali diaspora.`,
	},
	{
		question: 'Which other languages of Nepal can I read the Bible in here?',
		answer: `English is free to read at fathersheartbible.com/read/, with audio on every chapter. Hindi, widely understood across the border region, is free to read at fathersheartbible.com/read/hi/.`,
	},
	{
		question: 'Is there a free audio Bible I can listen to?',
		answer: `Yes. Every chapter of the English Father's Heart Bible™ comes with free audio, so it can be heard on any phone from Kathmandu to the Terai.`,
	},
];
