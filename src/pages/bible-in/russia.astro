---
// /bible-in/russia — Russian (~258M worldwide, the lingua franca of the former
// Soviet space). Respectful, Father-first. Russia carries a deep Orthodox
// heritage that survived a century of state atheism and is reviving; reveal God
// as a near Father after generations of striving and suffering. Signature
// pains: fatherlessness/orphans + alcoholism + loneliness. Strategic: Russian
// reaches across Central Asia and the Caucasus; wide diaspora. Evergreen, not
// political. Photos: Pexels.
import CountryBible from '../../components/CountryBible.astro';
import { speakersLabel as sp } from '../../data/language-speakers';

const verses = [
	{
		ref: 'Luke 15:20',
		slug: 'luke',
		ch: 15,
		text: '"He got up and went to his father. While he was still far off, his father saw him, and his heart broke with compassion—he ran, threw his arms around him, and kissed him."',
	},
	{
		ref: 'Psalm 68:5',
		slug: 'psalms',
		ch: 68,
		text: 'A father to the fatherless and defender of widows is our Father in his holy dwelling.',
	},
	{
		ref: 'Matthew 11:28',
		slug: 'matthew',
		ch: 11,
		text: 'Come to me, all you who are weary and burdened, and I will give you rest.',
	},
];

const stats = [
	{ label: 'People', value: '144 million' },
	{ label: 'Orthodox heritage', value: '~70% of Russia' },
	{ label: 'Russian', value: `${sp('ru')} worldwide` },
	{ label: 'A reviving faith', value: 'after a century of atheism' },
];

const faqs = [
	{
		question: 'How many Christians are there in Russia?',
		answer:
			"About 70% of Russians identify with Orthodox Christianity — roughly 100 million people — a thousand-year heritage that survived seventy years of state atheism and is reviving today, alongside smaller Protestant and Catholic communities. You can read and hear the Scriptures they treasure free in Father's Heart Bible™ at fathersheartbible.com/read.",
	},
	{
		question: 'Is the Bible legal in Russia?',
		answer:
			"Yes — the Bible is legal to own and read across Russia, and the Russian Synodal Bible is treasured in Orthodox and Protestant churches alike. A 2016 law (the Yarovaya amendments) does restrict evangelism and missionary activity outside registered religious organizations, but personal reading is free. Read Father's Heart Bible™ free online with audio at fathersheartbible.com/read.",
	},
	{
		question: 'Can I read the Bible online free in Russian?',
		answer:
			"Yes. Father's Heart Bible™ is free to read online in Russian — all 66 books, no account, no purchase, no app — at fathersheartbible.com/read/ru/, joining the Scriptures already treasured across the Russian-speaking world. The English edition is free too, with audio.",
	},
	{
		question: 'Is there a free audio Bible I can listen to?',
		answer:
			"Yes. Every chapter of the English Father's Heart Bible™ comes with free audio, so it can be heard on any phone — a quiet, personal way to receive the Father's words.",
	},
	{
		question: 'What is the most popular Bible translation in Russia?',
		answer:
			'The Russian Synodal Bible (Синодальный перевод), completed in 1876, is by far the most widely read and trusted Russian Bible, treasured across Orthodox and Protestant churches alike, alongside newer modern Russian translations.',
	},
	{
		question: "Is Father's Heart Bible available in Russian?",
		answer: `Yes. The complete Russian edition — all 66 books — is free to read at fathersheartbible.com/read/ru/ and published in print (fathersheartbible.com/bibles/russian-bible/). Russian is spoken by some ${sp('ru')} people across Russia, the former Soviet states, and a wide diaspora.`,
	},
];
---

<CountryBible
	slug="russia"
	country="Russia"
	flag="🇷🇺"
	flagImg="/flags/ru.svg"
	countryWikipedia="https://en.wikipedia.org/wiki/Russia"
	lastUpdated="October 2026"
	lastUpdatedIso="2026-10-29"
	colorPrimary="#0039A6"
	colorSecondary="#D52B1E"
	colorAccent="#0039A6"
	tintWarm="#FBE8E7"
	tintCool="#E7EDF8"
	tintBlue="#E7EDF8"
	title="The Bible in Russia — Christianity | Father's Heart Bible™ (FHB)"
	description="How many Christians live in Russia? Read the Bible there free online with audio — Father's Heart Bible™ (FHB) reveals God as a loving Father."
	h1="The Bible in Russia"
	heroSubhead="About 70% of Russians identify as Orthodox Christian, a faith reviving after a century of atheism — and Father's Heart Bible now reveals God as a near and loving Father, a refuge for the weary. Free online, with audio."
	heroBase="https://cdn.sanity.io/images/rusi1hyi/production/8459e8235bba613ec62bbe31d8da4a81a4d49742-1880x1253.jpg"
	heroAlt="Saint Basil's Cathedral in Moscow under a bright sky"
	directAnswerHtml={`<strong style=\"color: var(--color-ink);\">Yes &mdash; the Bible is free to read online, with audio.</strong> About <strong>70% of Russians identify as Orthodox Christian</strong> &mdash; and the Bible is legal to own and read, though a 2016 law restricts evangelism and missionary activity outside registered churches. The <a href=\"https://fathersheartbible.com/read/\" style=\"color: var(--color-brand);\" class=\"hover:underline\">Father&rsquo;s Heart Bible&trade;</a> is free to read and <em>hear</em> on any phone, with no app and no account. The complete <a href=\"https://fathersheartbible.com/read/ru/\" style=\"color: var(--color-brand);\" class=\"hover:underline\"><em>Russian</em> edition</a> is free to read today and <a href=\"/bibles/russian-bible/\" style=\"color: var(--color-brand);\" class=\"hover:underline\">published in print</a> &mdash; for a people whose deep Orthodox faith endured a century of atheism and is reviving, and where a translation can reveal God not as a distant power, but as a near and loving <em>Father</em>.`}
	keyTakeaway="Russia's faith survived a century of state atheism — and Father's Heart Bible™ (FHB) longs to reveal, in Russian, the Father who runs to meet His returning child."
	glanceIntroHtml={`Russia is the largest country on earth &mdash; a land of vast forests and frozen lakes, of golden domes and ancient icons. Its Orthodox faith, more than a thousand years old, endured the long Soviet night and is stirring again across a searching people.`}
	stats={stats}
	knownForHeading="What Russia is known for"
	knownForIntroHtml={`Few nations carry a vaster landscape &mdash; or a deeper spiritual story &mdash; than Russia.`}
	knownFor={[
		{ label: 'A thousand years of faith', text: 'Russian Orthodoxy, with its icons and golden domes, has shaped the nation’s soul for over a millennium.' },
		{ label: 'The largest land on earth', text: 'Russia spans eleven time zones, from the Baltic to the Pacific — forests, steppes, and frozen seas.' },
		{ label: 'Lake Baikal', text: 'The deepest and oldest lake on the planet, holding a fifth of the world’s fresh water.' },
		{ label: 'A literary soul', text: 'Tolstoy, Dostoevsky, and others wrestled with God, suffering, and the human heart like few others.' },
		{ label: 'Saint Basil’s Cathedral', text: 'The brightly domed cathedral on Red Square is one of the most recognizable churches on earth.' },
		{ label: 'Endurance', text: 'Through hardship and history, the Russian people are known for resilience and a deep inner life.' },
	]}
	gallery={[
		{ src: 'https://cdn.sanity.io/images/rusi1hyi/production/8b59adc941f40a7ae4af7b2b9834b853f3b4d575-1880x1253.jpg', alt: 'A Russian family gathered around the table' },
		{ src: 'https://cdn.sanity.io/images/rusi1hyi/production/c6ae7c15074e0d78aebd5a7ef63c1b1377a2dc51-1828x1300.jpg', alt: 'A Russian woman praying in an Orthodox church' },
		{ src: 'https://cdn.sanity.io/images/rusi1hyi/production/820e53541a7378b613252c689f29a51313933869-1880x1253.jpg', alt: 'A cheerful elderly Russian man among birch trees' },
		{ src: 'https://cdn.sanity.io/images/rusi1hyi/production/f628c4fbeb650efc741ad112a0e9aefd49d6e14d-1733x1300.jpg', alt: 'Two children bundled against the snow in the Russian north' },
	]}
	galleryCreditHtml={`Photos via <a href="https://www.pexels.com/" target="_blank" rel="noopener noreferrer" style="color: var(--color-brand);" class="hover:underline">Pexels</a> &amp; <a href="https://commons.wikimedia.org/" target="_blank" rel="noopener noreferrer" style="color: var(--color-brand);" class="hover:underline">Wikimedia Commons</a>.`}
	galleryBottom={[
		{ src: 'https://cdn.sanity.io/images/rusi1hyi/production/b88dc0a1abc9301ef855bef4a0c4289944b9c00c-1880x1253.jpg', alt: 'Frozen Lake Baikal at sunset' },
		{ src: 'https://cdn.sanity.io/images/rusi1hyi/production/344fad47bfabb546d4310c3298c3ab1e6430569c-1755x1300.jpg', alt: "Saint Isaac's Cathedral, Saint Petersburg" },
		{ src: 'https://cdn.sanity.io/images/rusi1hyi/production/4b42c54275db7da113b0a69d6bba88e92bab0e85-1880x1246.jpg', alt: 'The blue star-spangled domes of the Trinity Cathedral, Saint Petersburg' },
		{ src: 'https://cdn.sanity.io/images/rusi1hyi/production/8459e8235bba613ec62bbe31d8da4a81a4d49742-1880x1253.jpg', alt: "Saint Basil's Cathedral, Moscow" },
	]}
	galleryBottomCreditHtml={`Photos via <a href="https://www.pexels.com/" target="_blank" rel="noopener noreferrer" style="color: var(--color-brand);" class="hover:underline">Pexels</a> &amp; <a href="https://commons.wikimedia.org/" target="_blank" rel="noopener noreferrer" style="color: var(--color-brand);" class="hover:underline">Wikimedia Commons</a>.`}
	faithHeading="Faith and the Bible in Russia"
	faithBodyHtml={`<p>Russia&rsquo;s faith runs more than a thousand years deep. About <strong>70% of Russians identify with Orthodox Christianity</strong> &mdash; a heritage of icons, chant, and golden domes that survived seventy years of state atheism and is reviving across the land.</p><p>The Bible is treasured here. The Russian Synodal Bible, completed in 1876, is the Scripture most Russians read, across Orthodox and Protestant churches alike.</p><p>And yet, after a century that tried to erase God, and amid hardship and loss, many know Him more as a distant tradition than as a near <em>Father</em>. The need is not a first faith. It is to know, in the Scripture Russia treasures, the Father who runs to meet His returning child.</p>`}
	sources={[
		{ label: 'World Bank, Population, total (2024) — compiled from UN World Population Prospects 2024 and national statistics offices', url: 'https://data.worldbank.org/indicator/SP.POP.TOTL?locations=RU' },
		{ label: "Pew Research Center, How the Global Religious Landscape Changed From 2010 to 2020 (June 2025), Appendix B religious composition table - Russia 2020: 69.9% Christian", url: "https://www.pewresearch.org/wp-content/uploads/sites/20/2025/06/PR_2025.06.09_global-religious-change_appendix-b.pdf" },
		{ label: "U.S. Department of State, 2023 Report on International Religious Freedom: Russia, Religious Demography (Levada Center poll, May 2023: 72% Orthodox Christian)", url: "https://2021-2025.state.gov/reports/2023-report-on-international-religious-freedom/russia/" },
		{ label: 'Russian Orthodox Church — Britannica', url: 'https://www.britannica.com/topic/Russian-Orthodox-Church' },
		{ label: 'Russia — Encyclopaedia Britannica', url: 'https://www.britannica.com/place/Russia' },
	]}
	painsHeading="What pains Russia"
	painsIntroHtml={`Behind Russia&rsquo;s strength and beauty, families carry quiet, heavy burdens &mdash; and it is into these exact wounds that the Father&rsquo;s heart speaks.`}
	painStats={[
		{ value: 'thousands', label: 'of Russian children have grown up in orphanages and state care' },
		{ value: 'fatherlessness', label: 'high divorce and absent fathers leave many homes without a dad' },
		{ value: 'alcoholism', label: 'has long wounded families and shortened countless lives' },
		{ value: 'a shrinking', label: 'population — loneliness and loss weigh on the nation' },
		{ value: 'grief', label: 'many families carry sorrow and the wounds of hard years' },
		{ value: 'the searching heart', label: 'longing, after every striving, to be truly known and loved' },
	]}
	painsBodyHtml={`<p>Across Russia, thousands of children have grown up without parents; fatherlessness and alcoholism have wounded generations; and a quiet loneliness runs beneath the strength. Beneath the vast land lies a deep ache to be known and loved.</p><p>These are not statistics to a Father. They are sons and daughters He longs to gather. Russia does not need more striving &mdash; it longs to know it is held by a Father who never abandons His children.</p>`}
	painsSources={[
		{ label: 'Orphans in Russia — UNICEF', url: 'https://www.unicef.org/eca/' },
		{ label: 'Russia — Encyclopaedia Britannica', url: 'https://www.britannica.com/place/Russia' },
	]}
	faithsHeading="What “our Father” offers Russia"
	faithsIntroHtml={`Russia has believed for a thousand years. Father&rsquo;s Heart Bible&trade; does not bring a foreign religion &mdash; it answers the deepest cry of a people who have known loss: to be held by a Father who never abandons His children. In this translation, Scripture can reveal God not as a distant tradition, but as a <em>Father</em> near to the suffering.`}
	faithsBlocks={[
		{ heading: 'For the orphan and the fatherless', bodyHtml: `To children raised without parents, Scripture promises <a href="https://fathersheartbible.com/read/psalms/68/" style="color: var(--color-gold);" class="hover:underline">&ldquo;a father to the fatherless&rdquo;</a> &mdash; a Father who gathers the child no one came back for.` },
		{ heading: 'For the one who has wandered', bodyHtml: `To everyone who drifted from God through the long years, Father&rsquo;s Heart Bible&trade; reveals <a href="https://fathersheartbible.com/read/luke/15/" style="color: var(--color-gold);" class="hover:underline">the Father who runs to meet His returning child</a> &mdash; no shame, only welcome.` },
		{ heading: 'For the weary and the grieving', bodyHtml: `To families bearing hardship and sorrow, the Father says, <a href="https://fathersheartbible.com/read/matthew/11/" style="color: var(--color-gold);" class="hover:underline">&ldquo;Come to me, all you who are weary&hellip; and I will give you rest.&rdquo;</a>` },
		{ heading: 'For the one longing to belong', bodyHtml: `Beyond every hardship, the Father calls each person His beloved son or daughter &mdash; a belonging deeper than any loss.` },
	]}
	whyHeading="Why Father's Heart Bible™ for Russia"
	whyBlocks={[
		{ heading: 'God revealed as Father', bodyHtml: `In a land of deep and reviving faith, Father&rsquo;s Heart Bible&trade; reveals God as <em>Father</em> wherever Scripture reveals Him that way &mdash; from <a href="https://fathersheartbible.com/read/genesis/1/" style="color: var(--color-brand);" class="hover:underline">Genesis 1:1</a> onward.` },
		{ heading: 'Free, with audio, on any phone', bodyHtml: `No purchase, no app, no sign-up. The whole Bible is free to <a href="https://fathersheartbible.com/read/" style="color: var(--color-brand);" class="hover:underline">read online</a> with audio on every chapter &mdash; quiet and personal, on the phone in your hand.` },
		{ heading: 'Now in Russian', bodyHtml: `The complete Russian edition &mdash; for some ${sp('ru')} speakers across Russia and beyond &mdash; is published: <a href="https://fathersheartbible.com/read/ru/" style="color: var(--color-brand);" class="hover:underline">read it free</a>, or see the <a href="/bibles/russian-bible/" style="color: var(--color-brand);" class="hover:underline">print edition</a>.` },
	]}
	globalHeading="Russia and the world"
	globalIntroHtml={`Russian is far more than the tongue of one nation &mdash; it is the common language of a vast region and a wide diaspora. To give Russia the Father&rsquo;s heart in Russian is to open a door across many lands.`}
	globalStats={[
		{ value: `${sp('ru')}`, label: 'Russian speakers worldwide the Russian edition reaches' },
		{ value: 'a regional tongue', label: 'Russian links Central Asia, the Caucasus, and Eastern Europe' },
		{ value: 'a wide diaspora', label: 'Russian speakers live across Europe, the Americas, and beyond' },
	]}
	globalBlocks={[
		{ heading: 'A language across many nations', bodyHtml: `Russian is spoken and understood far beyond Russia &mdash; across Central Asia, the Caucasus, and Eastern Europe. A Russian Father&rsquo;s Heart Bible&trade; reaches a whole region in a shared tongue.` },
		{ heading: 'A literary, searching soul', bodyHtml: `Russia&rsquo;s great writers wrestled with God and the human heart. The Father&rsquo;s heart speaks directly to that deep, searching tradition.` },
		{ heading: 'A reviving church', bodyHtml: `After a century of atheism, faith is stirring again. As Russia receives the Father&rsquo;s heart, it can carry it across the Russian-speaking world.` },
		{ heading: 'A wide diaspora', bodyHtml: `Millions of Russian speakers live across Europe, Israel, the Americas, and beyond, carrying language and longing with them.` },
	]}
	wordHeading="His Word will not return void"
	wordBodyHtml={`<p>When our Father said, &ldquo;Let there be light,&rdquo; there was light. His Word accomplishes what He sends it to do. Across the vast forests and frozen lakes, into every home touched by loss, His Word will not return empty &mdash; it will find the orphan and the weary, and it will not fail.</p><p class="mt-4" style="color: var(--color-ink);">&ldquo;&hellip;so will my word be that goes out from my mouth: it will not return to me empty, but will accomplish what I desire and achieve the purpose for which I sent it.&rdquo; <span style="color: var(--color-muted);">&mdash; Isaiah 55:11</span></p>`}
	resourcesHeading="Learn more about Russia"
	resourcesIntroHtml={`Trusted sources for the facts on this page &mdash; and for going deeper into Russia&rsquo;s people, faith, and story.`}
