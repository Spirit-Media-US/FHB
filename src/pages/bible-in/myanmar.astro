	},
	{
		ref: 'Psalm 34:18',
		slug: 'psalms',
		ch: 34,
		text: 'Our Father is near to the brokenhearted; he saves those crushed in spirit.',
	},
	{
		ref: 'Romans 8:15',
		slug: 'romans',
		ch: 8,
		text: 'You did not receive a spirit of slavery, to fall back into fear, but received the Spirit of sonship, by whom we cry, "Abba! Father!"',
	},
];

const stats = [
	{ label: 'People', value: 'about 54.5 million' },
	{ label: 'Buddhist', value: '91.3% (2024 census)' },
	{ label: 'Christian', value: '4.6%' },
	{ label: 'Burmese speakers', value: 'about 43 million worldwide' },
];

const faqs = [
	{
		question: 'How many Christians are there in Myanmar?',
		answer: `Myanmar's 2024 census counted 4.6% of the population as Christian, particularly among the Chin, Kachin and Karen peoples, alongside 91.3% Buddhist, 3.3% Muslim and 0.6% Hindu. You can read the Scriptures they treasure free in Father's Heart Bible™ at fathersheartbible.com/read.`,
	},
