// Facts: every figure on this page is cited in the sources lists below (fetched 2026-10-28).
// Hero photo: Peleș Castle, Sinaia (Wikimedia Commons, CC BY-SA 3.0; file page credited in sources) — hotlinked thumbnails until a Sanity asset can be uploaded (Sanity quota 2026-10-28).
import CountryBible from '../../components/CountryBible.astro';
import { speakersLabel as sp } from '../../data/language-speakers';

const verses = [
	{
		ref: 'Psalm 68:5',
		slug: 'psalms',
		ch: 68,
		text: 'A father to the fatherless and defender of widows is our Father in his holy dwelling.',
	},
	{
		ref: 'Romans 8:15',
		slug: 'romans',
		ch: 8,
		text: 'You did not receive a spirit of slavery, to fall back into fear, but received the Spirit of sonship, by whom we cry, "Abba! Father!"',
	},
	{
		ref: '1 John 3:1',
		slug: '1-john',
		ch: 3,
		text: 'See what kind of love our Father has given us, that we should be called children of our Father! And we are.',
	},
];

const stats = [
	{ label: 'People', value: '19.05 million (2021 census)' },
	{ label: 'Orthodox', value: '85.3% of those declaring a religion' },
	{ label: 'Romanian', value: `${sp('ro')} worldwide` },
	{ label: 'First full Romanian Bible', value: '1688' },
];

const faqs = [
	{
		question: 'How many Christians are there in Romania?',
		answer:
			'Romania is overwhelmingly Christian. In the 2021 census, 85.3% of those who stated a religion were Orthodox, 4.5% Roman Catholic and 2.5% Pentecostal (INS provisional results as reported in January 2023); about 15% of the population did not declare a religion. Romania counted 19,053,815 residents. You can read the Scriptures they treasure free at fathersheartbible.com/read.',
	},
	{
		question: 'Is Christianity declining in Romania?',
		answer:
			'The census counted just under 14 million Orthodox in 2021, down from over 16.3 million in 2011, and the Orthodox share of those declaring fell from 86.5% to 85.3%. Pentecostals were the only church to grow, from about 362,000 to 404,000.',
	},
	{
		question: 'What was the first complete Bible in Romanian?',
		answer:
			'The Bucharest Bible of 1688, sponsored by Prince Șerban Cantacuzino of Wallachia, is described as the first complete translation of the Bible into Romanian.',
	},
	{
		question: 'What is the Cornilescu Bible?',
		answer:
			"Dumitru Cornilescu's Romanian Bible was published in full in 1921, after his Psalms (1920) and New Testament. It became the standard Protestant version in Romania, and the British and Foreign Bible Society adopted it as its Romanian text in 1924.",
	},
	{
		question: 'Can I read the Bible online free in Romanian?',
		answer:
			"Yes. Father's Heart Bible™ is free to read and hear online in Romanian — all 66 books, no account, no purchase, no app — at fathersheartbible.com/read/ro/. The English edition is free too.",
	},
	{
		question: "Is Father's Heart Bible available in Romanian?",
		answer: `Yes. The complete Romanian edition — all 66 books, free — is at fathersheartbible.com/read/ro/ and in print at fathersheartbible.com/bibles/romanian-bible/. Romanian is spoken by some ${sp('ro')} people worldwide.`,
	},
];
