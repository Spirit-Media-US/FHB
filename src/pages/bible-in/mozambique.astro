// a /bible-in page for every live reader language) because Sena had no country page and so no
// crawl path from /bible-in. Sourced facts only: population = World Bank 2024; religion = 2026 Afrobarometer survey (via Religion in Mozambique, Wikipedia); Chichewa in Tete = Chewa language, Wikipedia.
// Pattern = /bible-in/malaysia. Father voice; verse text = the audited FHB quotes. No Scripture edits.
import CountryBible from '../../components/CountryBible.astro';
import { speakersLabel as sp } from '../../data/language-speakers';

const verses = [
	{
		ref: 'John 14:18',
		slug: 'john',
		ch: 14,
		text: 'I will not leave you as orphans; I will come to you.',
	},
	{
		ref: 'Psalm 34:18',
		slug: 'psalms',
		ch: 34,
		text: 'Our Father is near to the brokenhearted; he saves those crushed in spirit.',
	},
	{
		ref: 'Isaiah 41:10',
		slug: 'isaiah',
		ch: 41,
		text: 'Fear not, for I am with you; do not be dismayed, for I am your Father.',
	},
];

const stats = [
	{ label: 'People', value: 'about 34.6 million' },
	{ label: 'Christians', value: '68.6% (2026 survey)' },
	{ label: 'Muslim', value: '21.3%' },
	{ label: 'Sena speakers', value: 'about 2.9 million' },
];

const faqs = [
	{
		question: 'How many Christians are there in Mozambique?',
		answer: `A 2026 Afrobarometer survey found 68.6% of Mozambicans Christian, 21.3% Muslim, 7.7% with no religion and 0.4% following traditional beliefs. Protestants outnumber Catholics. You can read the Scriptures they treasure free in Father's Heart Bible™ at fathersheartbible.com/read.`,
	},
	{
		question: 'Can I read the Bible online free in Sena?',
		answer: `Yes. Father's Heart Bible™ is free to read online in Sena — all 66 books, no account, no purchase, no app — at fathersheartbible.com/read/seh/. The Portuguese and English editions are free too.`,
	},
	{
		question: "Is Father's Heart Bible available in Sena?",
		answer: `Yes. The Sena edition is free to read at fathersheartbible.com/read/seh/. Sena is spoken by about ${sp('seh')} people, along the lower Zambezi in central Mozambique and in neighbouring Malawi.`,
	},
	{
		question: 'Which other languages of Mozambique can I read the Bible in here?',
		answer: `Portuguese, the official language, is free to read at fathersheartbible.com/read/pt/. Chichewa, spoken in Tete province, is free to read at fathersheartbible.com/read/ny/, and English at fathersheartbible.com/read/, with audio on every chapter.`,
	},
	{
		question: 'Is there a free audio Bible I can listen to?',
		answer: `Yes. Every chapter of the English Father's Heart Bible™ comes with free audio, so it can be heard on any phone from Maputo to the Zambezi.`,
	},
];
