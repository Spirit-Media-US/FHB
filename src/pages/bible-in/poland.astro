	faithsBlocks={[
		{ heading: "For the one who has stepped away", bodyHtml: "To anyone who has drifted from church, Scripture shows <a href=\"https://fathersheartbible.com/read/luke/15/\" style=\"color: var(--color-gold);\" class=\"hover:underline\">the Father who runs to meet His returning child</a> &mdash; no lecture first, only welcome." },
		{ heading: "For the one who prays from habit", bodyHtml: "Jesus taught us to pray <a href=\"https://fathersheartbible.com/read/matthew/6/\" style=\"color: var(--color-gold);\" class=\"hover:underline\">&ldquo;Our Father in heaven&rdquo;</a> &mdash; words Poles have prayed for a thousand years, and which can be prayed again as to a real Father." },
		{ heading: "For the tender-hearted", bodyHtml: "<a href=\"https://fathersheartbible.com/read/psalms/103/\" style=\"color: var(--color-gold);\" class=\"hover:underline\">&ldquo;As a father&rsquo;s heart goes out to his children, so our Father&rsquo;s heart goes out&rdquo;</a> &mdash; to those who fear Him, in every generation." },
