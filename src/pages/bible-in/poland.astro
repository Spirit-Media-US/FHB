---
// /bible-in/poland — Polish (~43M worldwide). The most Catholic large nation in Europe by census, now changing; the Bible's Polish story runs from the Brest Bible (1563) to the Millennium Bible (1965). Respectful toward the Church; invites a personal meeting with the Father.
// Facts: every figure on this page is cited in the sources lists below (fetched 2026-10-28).
// Hero photo: Wawel Castle over the Vistula, Kraków, by Jakubhal, CC BY-SA 4.0 (Wikimedia Commons) — hotlinked thumbnails until a Sanity asset can be uploaded (Sanity quota 2026-10-28).
import CountryBible from '../../components/CountryBible.astro';
import { speakersLabel as sp } from '../../data/language-speakers';

const verses = [
	{
		ref: 'Psalm 103:13',
		slug: 'psalms',
		ch: 103,
		text: "As a father's heart goes out to his children, so our Father's heart goes out to those who fear him.",
	},
	{
		ref: 'Luke 15:20',
		slug: 'luke',
		ch: 15,
		text: '"He got up and went to his father. While he was still far off, his father saw him, and his heart broke with compassion—he ran, threw his arms around him, and kissed him."',
	},
	{
		ref: '1 John 3:1',
		slug: '1-john',
		ch: 3,
		text: 'See what kind of love our Father has given us, that we should be called children of our Father! And we are.',
	},
];

const stats = [
	{ label: 'People', value: 'about 38 million' },
	{ label: 'Roman Catholic', value: '71.3% (2021 census)' },
	{ label: 'Polish', value: `${sp('pl')} worldwide` },
	{ label: 'First full Polish Bible', value: '1563' },
];

const faqs = [
	{
		question: 'How many Christians are there in Poland?',
		answer:
			'Poland is overwhelmingly Christian. In the 2021 census by Statistics Poland (GUS), 71.3% of the population — about 27.1 million people — were counted as Roman Catholic; 6.8% said they have no religion and about 20% did not answer. Among those who answered, 89.8% were Catholic. You can read the Scriptures they treasure free at fathersheartbible.com/read.',
	},
	{
		question: 'Is Christianity declining in Poland?',
		answer:
			'Counts are lower than a decade ago: the 2011 census showed about 88% Catholic, the 2021 census 71.3% — though the 2021 figure is also affected by the 20% who did not answer the religion question. Church statistics reported in 2023 put weekly Mass attendance at about 28% of Catholics.',
	},
	{
		question: 'What was the first complete Bible in Polish?',
		answer:
			'The Brest Bible of 1563, commissioned by Mikołaj Radziwiłł ("the Black") and printed at Brest-Litovsk, was the first complete Bible in Polish. The Catholic Wujek Bible followed in 1599 and the Protestant Gdańsk Bible in 1632.',
	},
	{
		question: 'What is the Millennium Bible?',
		answer:
			"The Biblia Tysiąclecia (Millennium Bible) was first published in 1965, for the thousandth anniversary of Poland's baptism in 966. It is the translation many Polish Catholics know best.",
	},
	{
		question: 'Can I read the Bible online free in Polish?',
		answer:
			"Yes. Father's Heart Bible™ is free to read and hear online in Polish — all 66 books, no account, no purchase, no app — at fathersheartbible.com/read/pl/. The English edition is free too.",
	},
	{
		question: "Is Father's Heart Bible available in Polish?",
		answer: `Yes. The complete Polish edition — all 66 books, free — is at fathersheartbible.com/read/pl/ and in print at fathersheartbible.com/bibles/polish-bible/. Polish is spoken by some ${sp('pl')} people worldwide.`,
	},
];
