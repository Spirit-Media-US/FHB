---
import BiblesBooksToggle from '../../components/BiblesBooksToggle.astro';
import BookMirror from '../../components/BookMirror.astro';
import BookOrder from '../../components/BookOrder.astro';
// /books/<slug>/ — one page per Father Heart book (Kevin 2026-11-13, kevin-decisions L1959: "each book needs to be
// treated like each bible edition given it's own page and easy check out ... declare who this book is for ... full
// details and look inside"). DATA-DRIVEN: every fact and every sentence comes from src/data/books.json (sourced from
// spec sheets / the pmpublish data pack, never written here). Adding a book = a books.json row.
// Replaces the hand-built /books/beloved-identity/ page (Kevin 2026-11-10) at the same URL with the same markup,
// order widget and JSON-LD; it posts to the same /dvc-checkout the Bibles use.
// A format whose SKU the checkout does not sell yet (status != "live") shows "ordering opens soon", never a
// button that fails.
import LookInside from '../../components/LookInside.astro';
import Section from '../../components/Section.astro';
import pageAssets from '../../data/book-page-assets.json';
import bookPages from '../../data/book-pages.json';
import bookSkus from '../../data/book-skus.json';
import catalog from '../../data/books.json';
import booksSurface from '../../data/books-surface.json';
import lookinside from '../../data/lookinside.json';
import Layout from '../../layouts/Layout.astro';
import { heroSizes, heroSrcset, heroStyle } from '../../lib/cover-hero.mjs';
import {
	handlingFeeCents,
	handlingLabel,
	landedUnitCost,
	shippingDetailsFor,
} from '../../lib/marginGuard';
import { merchantReturnPolicy } from '../../lib/merchantReturnPolicy';
import { FIRST_ORDER_PCT, isDiscountExempt } from '../../lib/order-pricing';
import { LIVE_COUNTRIES } from '../../lib/shipCountries';

type Format = {
	sku: string;
	format: string;
	schema_format: string;
	isbn: string;
	isbn_display: string;
	list_cents: number;
	pages: number;
	trim: string;
	binding: string;
	landed_key: string;
};
type Book = {
	slug: string;
	status: string;
	title: string;
	subtitle?: string;
	full_title: string;
	author: { name: string; url?: string };
	author_bio?: string;
	age?: string;
	page_title: string;
	short: string;
	who_for: string[];
	long_html: string;
	cover: { jpg: string; w600: string; w300: string; width: number; height: number; alt: string };
	formats: Format[];
	language: string;
	look_inside: string | null;
};

export function getStaticPaths() {
	// BOOKS SURFACE SWITCH (src/data/books-surface.json): while off, only the book pages already live keep building.
	return (catalog.books as Book[])
		.filter((b) => booksSurface.live || booksSurface.liveSlugs.includes(b.slug))
		.map((b) => ({ params: { slug: b.slug }, props: { book: b } }));
}

const { book } = Astro.props as { book: Book };
const URL_ = `https://fathersheartbible.com/books/${book.slug}/`;
const live = book.status === 'live';
const money = (c: number) => `$${(c / 100).toFixed(2)}`;
// 3es F2 (pmseoaeo 2026-11-13): the JSON-LD description is PLAIN text — every HTML entity decoded (&bull; &ndash; sat in
// it raw), no tags, no newlines. scripts/fhb-books.test.mjs fails the build on any entity or tag left in a built page.
const ENTITY: Record<string, string> = {
	amp: '&',
	bull: '•',
	ndash: '–',
	mdash: '—',
	rsquo: '’',
	lsquo: '‘',
	ldquo: '“',
	rdquo: '”',
	hellip: '…',
	nbsp: ' ',
	quot: '"',
	apos: "'",
	lt: '<',
	gt: '>',
	trade: '™',
	copy: '©',
	reg: '®',
};
const LONG_TEXT = book.long_html
	.replace(/<p><br><\/p>/g, '')
	.replace(/<\/p>/g, ' ')
	.replace(/<[^>]+>/g, '')
	.replace(/&#x([0-9a-f]+);/gi, (_: string, h: string) =>
		String.fromCodePoint(Number.parseInt(h, 16)),
	)
	.replace(/&#(\d+);/g, (_: string, d: string) => String.fromCodePoint(Number(d)))
	.replace(/&([a-z]+);/gi, (m: string, n: string) => ENTITY[n.toLowerCase()] ?? m)
	.replace(/\s+/g, ' ')
	.trim();
const hasLook = !!(book.look_inside && (lookinside as Record<string, unknown>)[book.look_inside]);

// Destinations per format: the US, plus every live country with a MEASURED landed cost for that format
// (ship-countries.json landed_cost_usd.<landed_key>), fee from the checkout's own rule (marginGuard.ts).
const SKUS = bookSkus.skus as Record<
	string,
	Omit<Format, 'sku' | 'landed_key'> & { cost_key: string }
>;
const formats = (book.formats as unknown as string[])
	.map((sku) => ({ sku, ...SKUS[sku], landed_key: SKUS[sku].cost_key }))
	.map((f) => {
		// ONE ENGINE (Kevin 2026-11-15): every live country the engine can size (own cost or Bible fallback).
		const dests = LIVE_COUNTRIES.filter(
			(c) =>
				c.code === 'US' ||
				landedUnitCost(f.sku, c.landed_cost_usd as Record<string, unknown> | undefined) != null,
		).map((c) => ({
			code: c.code,
			name: c.name,
			far: c.bulkQuote === true,
			fee: c.code === 'US' ? 0 : handlingFeeCents(f.sku, f.list_cents, c),
			label: c.code === 'US' ? '' : handlingLabel(c.code),
		}));
		return { ...f, dests };
	});
const first = formats[0];

const offerFor = (f: (typeof formats)[number]) => ({
	'@type': 'Offer',
	url: URL_,
	price: (f.list_cents / 100).toFixed(2),
	priceCurrency: 'USD',
	availability: 'https://schema.org/InStock',
	itemCondition: 'https://schema.org/NewCondition',
	seller: { '@type': 'Organization', name: 'Spirit Media Publishing' },
	hasMerchantReturnPolicy: merchantReturnPolicy,
	shippingDetails: shippingDetailsFor(
		{ slug: f.sku, listUsd: f.list_cents / 100 },
		LIVE_COUNTRIES.filter((c) => f.dests.some((d) => d.code === c.code)),
	),
});
// ONE format: the same ['Book','Product'] node with a top-level Offer the hand-built Beloved Identity page carried
// (merchant-listing shape). SEVERAL formats: a Book whose workExample holds one Book+Product per format.
const single = formats.length === 1;
const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': single ? ['Book', 'Product'] : 'Book',
		'@id': `${URL_}#book`,
		url: URL_,
		name: book.full_title,
		inLanguage: book.language,
		image: book.cover.jpg,
		description: LONG_TEXT,
		author: {
			'@type': 'Person',
			name: book.author.name,
			...(book.author.url ? { url: book.author.url } : {}),
		},
		publisher: {
			'@type': 'Organization',
			name: 'Spirit Media Publishing',
			url: 'https://spiritmediapublishing.com',
		},
		...(book.who_for.length
			? { audience: { '@type': 'Audience', audienceType: book.who_for.join(', ') } }
			: {}),
		...(single
			? {
					sku: first.sku,
					isbn: first.isbn,
					gtin13: first.isbn,
					bookFormat: first.schema_format,
					numberOfPages: first.pages,
					brand: { '@type': 'Brand', name: 'Spirit Media Publishing' },
					...(live ? { offers: offerFor(first) } : {}),
				}
			: {}),
		...(single
			? {}
			: {
					workExample: formats.map((f) => ({
						'@type': ['Book', 'Product'],
						'@id': `${URL_}#${f.sku}`,
						name: `${book.full_title} (${f.format})`,
						sku: f.sku,
						isbn: f.isbn,
						gtin13: f.isbn,
						bookFormat: f.schema_format,
						numberOfPages: f.pages,
						image: book.cover.jpg,
						brand: { '@type': 'Brand', name: 'Spirit Media Publishing' },
						...(live ? { offers: offerFor(f) } : {}),
					})),
				}),
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://fathersheartbible.com/' },
			{
				'@type': 'ListItem',
				position: 2,
				name: 'Books',
				item: 'https://fathersheartbible.com/books/',
			},
			{ '@type': 'ListItem', position: 3, name: book.title, item: URL_ },
		],
	},
];

// ── THE RIAB STANDARD (Kevin 2026-11-14 "This is the standard. Meet or exceed it with each page we build." + "Who Am I
// and Beloved Identity on SMP and FHB - they will be the same content but on 2 different sites"). The page object
// (src/data/book-pages.json, identical on SMP) drives the hero and every section below the order area (BookMirror).
const pg = (bookPages as Record<string, any>)[book.slug] ?? null;
const ax = ((pageAssets as Record<string, any>)[book.slug] ?? {}) as {
	hero3d?: { w600: string; w300: string; width: number; height: number };
	headshot?: { src: string; w: number; h: number };
	og?: { src: string; w: number; h: number };
	color?: { title: string; outline: boolean };
};
const OUTLINE =
	'-1px -1px 0 #27272a, 1px -1px 0 #27272a, -1px 1px 0 #27272a, 1px 1px 0 #27272a, 0 1px 0 #27272a, 0 -1px 0 #27272a, 1px 0 0 #27272a, -1px 0 0 #27272a';
const titleStyle = ax.color
	? `color: ${ax.color.title};${ax.color.outline ? ` text-shadow: ${OUTLINE};` : ''}`
	: undefined;
const smallTitleColor = ax.color && !ax.color.outline ? ax.color.title : undefined;
const hero = ax.hero3d
	? {
			src: ax.hero3d.w600,
			w300: ax.hero3d.w300,
			w1200: ax.hero3d.w1200, // the 1200 file of the 3D render, when one exists
			w: ax.hero3d.width,
			h: ax.hero3d.height,
			is3d: true,
		}
	: {
			src: book.cover.w600,
			w300: book.cover.w300,
			w1200: book.cover.w1200,
			w: book.cover.width,
			h: book.cover.height,
			is3d: false,
		};
const headshot = ax.headshot
	? { ...ax.headshot, alt: `${book.author.name}, author of ${book.title}` }
	: undefined;
// the order area: the countries EVERY format ships to (US always), the engine's fee per country, the first-order 15%
const countries = formats[0].dests
	.filter((d) => formats.every((f) => f.dests.some((x) => x.code === d.code)))
	.map((d) => ({ code: d.code, name: d.name }));
const feeCfg = JSON.stringify({
	list: Object.fromEntries(formats.map((f) => [f.sku, f.list_cents])),
	fee: Object.fromEntries(
		countries
			.filter((c) => c.code !== 'US')
			.map((c) => [
				c.code,
				Object.fromEntries(
					formats.map((f) => [f.sku, f.dests.find((d) => d.code === c.code)?.fee ?? 0]),
				),
			]),
	),
});
const firstOrder = formats.some((f) => !isDiscountExempt(f.sku));
const RETURN_DAYS = 30; // the SMP store promise (spiritmediapublishing.com/returns/) — the store these orders go to
// related picks: another FHB book -> /books/<slug>/; an edition slug (<x>-bible) -> /bibles/<slug>/
const editionFiles = import.meta.glob<{ default: { slug: string; title?: string; name?: string } }>(
	'../../data/editions/*.json',
	{ eager: true },
);
const editionTitle = (slug: string) =>
	Object.values(editionFiles)
		.map((m) => m.default)
		.find((e) => e && `${e.slug}-bible` === slug)?.title;
const more = ((pg?.more ?? []) as string[])
	.map((slug) => {
		const b = (catalog.books as Book[]).find((x) => x.slug === slug);
		if (b) return { slug, title: b.title };
		const t = editionTitle(slug);
		return t ? { slug, title: t, href: `/bibles/${slug}/` } : null;
	})
	.filter(Boolean) as { slug: string; title: string; href?: string }[];
const faq = ((pg?.faq ?? []) as { q: string; a: string }[]).filter((f) => f.q && f.a);
const faqLd = faq.length
	? {
			'@context': 'https://schema.org',
			'@type': 'FAQPage',
			mainEntity: faq.map((f) => ({
				'@type': 'Question',
				name: f.q,
				acceptedAnswer: { '@type': 'Answer', text: f.a },
			})),
		}
	: null;
---

<Layout title={book.page_title} description={book.short} image={ax.og?.src ?? book.cover.jpg} imageWidth={ax.og?.w} imageHeight={ax.og?.h} imageAlt={book.cover.alt} jsonLd={faqLd ? [...jsonLd, faqLd] : jsonLd}>
	<main id="main-content">
		{/* HERO = the RIAB hero (itself the FHB grandparents edition hero): 3D cover | eyebrow, title in the cover colour,
		    subtitle, who it is for, chips, Look inside. All from the page object. */}
		<section class="bk-hero">
			<div class="mx-auto max-w-5xl">
				<nav aria-label="Breadcrumb" class="bk__crumb">
					<a href="/">Home</a><span aria-hidden="true">/</span><a href="/books/">Books</a><span aria-hidden="true">/</span><span aria-current="page">{book.title}</span>
				</nav>
				<div class="grid items-start gap-8 md:grid-cols-2 md:gap-10">
					<div class="flex justify-center">
						{/* ONE common cover height, width by its own aspect (Kevin 2026-11-16 "Perfer larger as possible"): the
						    numbers live in src/lib/cover-hero.mjs (mirrors SMP's), checked in scripts/fhb-books.test.mjs */}
						<a href="#order" aria-label={`Order ${book.title}`} class="block w-full">
							<img src={hero.src} srcset={heroSrcset(hero)} sizes={heroSizes(hero.w, hero.h)} width={hero.w} height={hero.h} alt={book.cover.alt} fetchpriority="high" decoding="async" data-hero-cover style={heroStyle(hero.w, hero.h)} class={hero.is3d ? 'book-cover' : 'book-cover rounded shadow-lg'} />
						</a>
					</div>
					<div>
						{pg?.hero?.eyebrow ? <p class="bk-eyebrow">{pg.hero.eyebrow}</p> : <p class="bk-eyebrow">By {book.author.name}</p>}
						<h1 class="bk-title" style={titleStyle}>{book.title}</h1>
						{book.subtitle && <p class="bk-sub">{book.subtitle}</p>}
						{pg?.hero?.audience_line && <p class="bk-aud">{pg.hero.audience_line}</p>}
						{pg?.hero?.tagline && <p class="bk-tag">{pg.hero.tagline}</p>}
						{pg?.hero?.chips?.length > 0 && (
							<div class="mt-4 flex flex-wrap gap-2">
								{(pg.hero.chips as string[]).map((c) => <span class="bk-chip" style={smallTitleColor ? `color: ${smallTitleColor}; border-color: ${smallTitleColor};` : undefined}>{c}</span>)}
							</div>
						)}
						{hasLook && <div class="mt-5"><LookInside slug={book.look_inside!} title={book.title} size="lg" /></div>}
						{!pg && <p class="bk-tag">{book.short}</p>}
					</div>
				</div>
			</div>
		</section>
		{live ? (
			// THE ORDER AREA (the same as the SMP book page and the FHB edition box): offer line, country marquee, the box,
			// Keep shopping. It orders on the SMP store (contract 3fe).
			<section class="bk-order" aria-label={`Order ${book.title}`}>
				<BookOrder slug={book.slug} title={book.title} titleStyle={titleStyle} formats={formats.map((f) => ({ sku: f.sku, format: f.format, list_cents: f.list_cents }))} countries={countries} feeCfg={feeCfg} firstOrder={firstOrder} firstOrderPct={FIRST_ORDER_PCT} returnDays={RETURN_DAYS} />
			</section>
		) : (
			<section class="bk-order">
				<div class="mx-auto max-w-xl px-4"><BiblesBooksToggle current="books" />
					<div id="order" class="bi__order">
						{formats.map((f) => <p class="bi__price">{f.format} {money(f.list_cents)}</p>)}
						<p class="bi__fine">Ordering on this site opens soon.</p>
					</div>
				</div>
			</section>
		)}
		{pg ? (
			<BookMirror hideLookInside={hasLook} page={pg} title={book.title} faq={faq} lang="en" headshot={headshot} titleColor={smallTitleColor} authorName={book.author.name} more={more} />
		) : (
			<Section variant="soft">
				<div class="bi__desc" set:html={book.long_html} />
				{book.author_bio && <p class="bi__desc">{book.author_bio}</p>}
			</Section>
		)}
	</main>
</Layout>

<style>
	.bk-hero { background: #faf8f5; padding: 2rem 1rem; }
	/* HERO COVER (src/lib/cover-hero.mjs HERO_H / HERO_BP): one common height, width = height x the cover's own aspect,
	   never wider than its column. Fixed px, never vh. */
	.book-cover { --hh: 336px; display: block; margin: 0 auto; width: min(100%, calc(var(--hh) * var(--ar, 0.6667))); max-width: 100%; height: auto; }
	@media (min-width: 768px) { .book-cover { --hh: 550px; } }
	@media (min-width: 1024px) { .bk-hero { padding: 3.5rem 2rem; } }
	.bk-order { background: #faf8f5; padding-bottom: 2.5rem; }
	.bk__crumb { margin: 0 0 1.25rem; font-family: var(--font-sans); font-size: 0.875rem; color: #57534e; display: flex; gap: 0.4rem; flex-wrap: wrap; }
	.bk__crumb a { text-decoration: underline; text-underline-offset: 2px; }
	.bk-eyebrow { margin: 0 0 0.5rem; font-family: var(--font-sans); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: #57534e; }
	.bk-title { margin: 0; font-size: 2.1rem; font-weight: 600; line-height: 1.15; color: var(--color-ink); }
	@media (min-width: 1024px) { .bk-title { font-size: 2.7rem; } } /* the edition h1: Epilogue 600 (global h1 font) */
	.bk-sub { margin: 0.5rem 0 0; font-family: var(--font-sans); font-size: 1.15rem; line-height: 1.35; color: var(--color-muted); }
	.bk-aud { margin: 0.75rem 0 0; font-family: var(--font-sans); font-size: 1rem; line-height: 1.65; color: #57534e; }
	.bk-tag { margin: 0.75rem 0 0; font-family: var(--font-sans); font-size: 1rem; line-height: 1.65; color: var(--color-ink); }
	.bk-chip { display: inline-block; padding: 0.35rem 0.8rem; border: 2px solid var(--color-muted); border-radius: 6px; background: #fff; color: var(--color-muted); font-family: var(--font-sans); font-size: 1.05rem; font-weight: 800; letter-spacing: 0.06em; line-height: 1; text-transform: uppercase; }
	.bi__order { margin: 1.4rem auto 0; padding: 1.25rem; background: #fff; border: 1px solid var(--color-hairline); border-radius: 1rem; max-width: 30rem; font-family: var(--font-sans); }
	.bi__price { margin: 0 0 0.9rem; font-size: 1.5rem; font-weight: 800; color: var(--color-ink); }
	.bi__fine { margin: 0.8rem 0 0; font-size: 0.8rem; color: #3f3f46; }
	.bi__desc { max-width: 44rem; margin: 2.5rem auto 0; font-family: var(--font-sans); color: #27272a; line-height: 1.7; }
</style>
