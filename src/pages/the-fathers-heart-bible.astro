---
import ImageGrid from '../components/ImageGrid.astro';
import ScriptureBlock from '../components/ScriptureBlock.astro';
import Section from '../components/Section.astro';
import VideoHeroInner from '../components/VideoHeroInner.astro';
import Layout from '../layouts/Layout.astro';
import { sanityClient, urlFor } from '../lib/sanity';

const [pageData, media, biblePageData, latestPosts] = await Promise.all([
	sanityClient.fetch(`*[_type =="page" && slug =="the-fathers-heart-bible"][0] {
    seoTitle, seoDescription,
    heroHeading, heroSubheading,
    heroPrimaryCtaLabel, heroPrimaryCtaHref,
    heroSecondaryCtaLabel, heroSecondaryCtaHref
  }`),
	sanityClient.fetch(
		`*[_type =="siteSettings"][0] { theThersHeartBiblePageVideo, bookCoverUrl, fhbCoverImage, communityUrl }`,
	),
	sanityClient.fetch(
		`*[_type =="biblePageContent"][0] { distinctives, notItems, milestones, audience, shifts }`,
	),
	sanityClient.fetch(
		`*[_type == "blogPost" && defined(slug.current)] | order(publishDate desc) [0...3] {
      "slug": slug.current,
      title,
      excerpt,
      "image": coalesce(heroImage.asset->url + "?w=600&fm=webp", "/fhb-logo.png"),
      publishDate
    }`,
	),
]);

const seoTitle =
	pageData?.seoTitle || "What Is the Father's Heart Bible™ (FHB)? | Father's Heart Bible™";
const seoDescription =
	pageData?.seoDescription ||
	'Learn what the Father\u2019s Heart Bible is, why it exists, and how this new Bible translation reveals God as Father where Scripture reveals Him.';
const heroHeading = 'What is the Father\u2019s Heart Bible\u2122?';
const heroSubheading =
	'The Father\u2019s Heart Bible\u2122 is a fresh English Bible translation from the original Hebrew, Aramaic, and Greek that reveals God as Father where Scripture reveals Him\u2014and helps readers encounter not only His name, but His heart.';
// Hero CTA: single "Read FHB" (the site's primary CTA). The old "Read Sample
// Passages" button was removed (2026-06-06, Kevin) since Read FHB sat right
// beside it — redundant.
const heroPrimaryCtaLabel = 'Read FHB →';
const heroPrimaryCtaHref = '/read/';
const heroSecondaryCtaLabel = '';
const heroSecondaryCtaHref = '';
const bookCoverUrl = media?.bookCoverUrl || '';

// FHB → Beloved Identity cover — prefer Sanity image, fall back to hardcoded
// The Sanity asset is a true RGBA PNG (alpha-channel transparency);
// Sanity preserves the alpha so the section bg shows through naturally.
const fhbCoverImageFromSanity = media?.fhbCoverImage;
const fhbiCoverUrl = fhbCoverImageFromSanity
	? urlFor(fhbCoverImageFromSanity).width(400).auto('format').url()
	: 'https://cdn.sanity.io/images/rusi1hyi/production/7af29ed50a183320765567ec9cd1e9de2bb218a5-724x1122.png';
const communityUrl = media?.communityUrl || '/join';

// What is published today (replaces the pre-launch "Road Ahead" milestones, Kevin 2026-10-13).
const milestones = [
	{
		milestone: 'The Complete Bible',
		detail: 'All 66 books, Genesis to Revelation — 1,189 chapters, 31,085 verses. Not one missing.',
	},
	{
		milestone: 'Free to Read and Hear',
		detail: 'The whole Bible is free online, with verse-by-verse audio.',
	},
	{
		milestone: 'In Print',
		detail: 'Hardcover and paperback, in audience editions, Large Print, and a journaling Bible.',
	},
	{
		milestone: 'In Many Languages',
		detail: 'Published in dozens of languages, each free to read online.',
	},
];

const shifts = biblePageData?.shifts ?? [
	{ from: 'Information', to: 'Relationship' },
	{ from: 'Distance', to: 'Intimacy' },
	{ from: 'Servant mindset', to: 'Beloved identity' },
];

// FAQ — AEO-optimized question-and-answer pairs that mirror what people
// actually search for. The visible section below renders these; the
// FAQPage JSON-LD below mirrors them for rich-result eligibility.
const faqs = [
	{
		q: "What is the Father's Heart Bible™?",
		a: "The Father's Heart Bible™ (FHB) is an interpretive English Bible translation that reveals God as Father wherever Scripture reveals Him. Where the Hebrew text uses YHWH (the personal covenant name) in a relational context, FHB renders it 'our Father' — recovering the warmth the name carried for Israel and continuing the apostles' own hermeneutic on the page.",
	},
	{
		// The abbreviation needs its own QUESTION, not just a mention inside another answer
		// (Kevin 2026-09-18). NIV, ESV and KJV carry their own search demand; FHB does not yet,
		// so the pairing has to be stated in the form an engine can lift and a person can ask.
		q: 'What does FHB stand for?',
		a: "FHB stands for the Father's Heart Bible™ — an interpretive English Bible translation that reveals God as our Father. It is used the way NIV, ESV or KJV are used: FHB is the translation abbreviation, and Father's Heart Bible is the full name. Every FHB edition carries the same translation; the editions differ only in who they were made for, the print size and the binding.",
	},
	{
		q: "How is the Father's Heart Bible™ different from other translations?",
		a: "Most English translations flatten YHWH and Elohim into 'God' or 'the LORD,' which hides the Trinitarian and relational distinctions already in the original languages. FHB preserves those distinctions: when the text points to the Father, it reads 'our Father'; when the text points to a generic deity (or the serpent's distant 'God'), it reads 'God.' Footnotes document every distinctive choice.",
	},
	{
		q: 'Is the Father’s Heart Bible™ a paraphrase?',
		a: 'No. FHB is an interpretive translation grounded in the original Hebrew, Greek, and Aramaic — not a loosely reworded paraphrase. Translation choices are footnoted and traceable to the source text, and the work follows a documented methodology of canon-wide consistency.',
	},
	{
		q: 'Who translated the Father’s Heart Bible™?',
		a: "Kevin White is leading the translation and publishing process, supported by the Spirit Media Publishing team. Kevin is the author of Father's Heart → Beloved Identity (free download) and CEO of Spirit Media Publishing.",
	},
	{
		q: 'Which books of the Bible are included?',
		a: 'The full canon — Genesis to Revelation, available to read or listen to free online.',
	},
	{
		q: 'Why does FHB render “God” as “our Father” in some places?',
		a: 'The Hebrew uses two distinct divine names — YHWH (personal covenant name) and Elohim (generic word for deity) — and they fall on different lips and in different contexts. The apostles already read these differences and applied them to specific Persons of the Trinity (e.g. Joel 2:32 → Romans 10:13 applies the verse to Jesus). FHB does this work on the page rather than leaving it for the reader to assemble.',
	},
];

const formatDate = (dateString: string) => {
	if (!dateString) return '';
	const d = new Date(dateString);
	return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
};
---

<Layout
	title={seoTitle}
	description={seoDescription}
	image="https://assets.spiritmediapublishing.com/FHB/share/fhb-og-bible.jpg?v=2"
	imageAlt={'Father\'s Heart Bible — "I will be your Father" (Revelation 21:7)'}
	darkHero={true}
	jsonLd={[
		{
			"@context": "https://schema.org",
			"@graph": [
				{ "@type": "WebPage", "name": seoTitle, "description": seoDescription, "url": "https://fathersheartbible.com/the-fathers-heart-bible/" },
				{ "@type": "BreadcrumbList", "itemListElement": [
					{ "@type": "ListItem", "position": 1, "name": "Home", "item": "https://fathersheartbible.com/" },
					{ "@type": "ListItem", "position": 2, "name": "About FHB", "item": "https://fathersheartbible.com/the-fathers-heart-bible/" }
				]}
			]
		},
		// Book schema — establishes FHB as a Bible translation entity for AI engines and search.
		{
			"@context": "https://schema.org",
			"@type": "Book",
			"@id": "https://fathersheartbible.com/#book",
			// Names, edition and description follow the Metadata & Messaging Guidelines
			// verbatim: brand always carries the ™ and never a leading "The"; the full
			// listed title is the alternateName; the description is the approved short
			// blurb. inLanguage is "en" per the brief's Publication facts — the reader's
			// node in community/src/lib/reader-seo.ts MUST stay identical to this, since
			// two values for one @id is precisely the conflict this pass removed.
			"name": "Father's Heart Bible™",
			"alternateName": [
				"Father's Heart Bible",
				"Father's Heart Bible: An Intimate Translation",
				"FHB"
			],
			"bookEdition": "An Intimate Translation",
			"description": "A fresh Bible translation from the original Hebrew, Aramaic, and Greek that reveals God as your Father. Come home to your Father. His heart is for you.",
			"inLanguage": "en",
			"url": "https://fathersheartbible.com",
			"sameAs": [
				"https://www.instagram.com/fathersheartbible/",
				"https://www.youtube.com/channel/UCzgp9q1JnqyyEgz_j--KiQg",
				"https://www.facebook.com/1176654175531729",
				"https://www.tiktok.com/@fathersheartbible",
				"https://www.linkedin.com/company/130004384"
			],
			"image": "https://cdn.sanity.io/images/rusi1hyi/production/8b5d1c39f892218c978d3e3caf5720e09833bbc4-1024x1024.png?w=1200&h=630&fit=crop",
			"editor": {
				"@type": "Person",
				"@id": "https://kevinwhite.us/#person",
				"name": "Kevin White",
				"url": "https://kevinwhite.us"
			},
			"publisher": {
				"@type": "Organization",
				"@id": "https://spiritmediapublishing.com/#organization",
				"name": "Spirit Media Publishing",
				"url": "https://spiritmediapublishing.com"
			},
			"copyrightHolder": { "@type": "Organization", "name": "Spirit Media Inc." },
			"copyrightYear": 2026,
			"datePublished": "2026-06-21",
			"about": [
				{ "@type": "Thing", "name": "Bible translation" },
				{ "@type": "Thing", "name": "Father heart of God" },
				{ "@type": "Thing", "name": "Trinitarian theology" }
			],
			"workExample": [
				{ "@type": "Book", "bookFormat": "https://schema.org/Paperback", "isbn": "979-8-89307-333-1", "name": "Father's Heart Bible: An Intimate Translation (Paperback – Charcoal Edition)", "inLanguage": "en" },
				{ "@type": "Book", "bookFormat": "https://schema.org/Paperback", "isbn": "979-8-89307-334-8", "name": "Father's Heart Bible: An Intimate Translation (Paperback – Plum Edition)", "inLanguage": "en" },
				{ "@type": "Book", "bookFormat": "https://schema.org/Paperback", "isbn": "979-8-89307-335-5", "name": "Father's Heart Bible: An Intimate Translation (Paperback – White Edition)", "inLanguage": "en" },
				{ "@type": "Book", "bookFormat": "https://schema.org/Hardcover", "isbn": "979-8-89307-336-2", "name": "Father's Heart Bible: An Intimate Translation (Hardcover – Charcoal Edition)", "inLanguage": "en" },
				{ "@type": "Book", "bookFormat": "https://schema.org/Hardcover", "isbn": "979-8-89307-337-9", "name": "Father's Heart Bible: An Intimate Translation (Hardcover – Plum Edition)", "inLanguage": "en" },
				{ "@type": "Book", "bookFormat": "https://schema.org/Hardcover", "isbn": "979-8-89307-338-6", "name": "Father's Heart Bible: An Intimate Translation (Hardcover – White Edition)", "inLanguage": "en" },
				{ "@type": "Book", "bookFormat": "https://schema.org/Hardcover", "isbn": "979-8-89307-296-9", "name": "Father's Heart Bible: An Intimate Translation (ComfortLeather™ Edition)", "inLanguage": "en" },
				{ "@type": "Book", "bookFormat": "https://schema.org/EBook", "isbn": "979-8-89307-297-6", "name": "Father's Heart Bible: An Intimate Translation (eBook)", "inLanguage": "en" },
				{ "@type": "Book", "bookFormat": "https://schema.org/AudiobookFormat", "isbn": "979-8-89307-298-3", "name": "Father's Heart Bible: An Intimate Translation (Audiobook)", "inLanguage": "en" }
			]
		},
		// FAQPage schema — AEO citation target.
		{
			"@context": "https://schema.org",
			"@type": "FAQPage",
			"mainEntity": faqs.map((f) => ({
				"@type": "Question",
				"name": f.q,
				"acceptedAnswer": { "@type": "Answer", "text": f.a }
			}))
		}
	]}
>
	<main>

		<!-- ═══════════════════════════════════════════════════════════
		     SECTION 1 — PAGE HERO
		     ═══════════════════════════════════════════════════════════ -->
		<VideoHeroInner
			imageSrc="https://assets.spiritmediapublishing.com/FHB/print/about-hero-pews.webp"
			imageSrcMobile="https://assets.spiritmediapublishing.com/FHB/print/about-hero-pews-960.webp"
			imageWidth={1902}
			imageHeight={686}
			imagePosition="top"
			href="/print/"
			heading={heroHeading}
			subheading={heroSubheading}
			primaryCtaLabel={heroPrimaryCtaLabel}
			primaryCtaHref={heroPrimaryCtaHref}
			secondaryCtaLabel={heroSecondaryCtaLabel}
			secondaryCtaHref={heroSecondaryCtaHref}
		/>


		<!-- ═══════════════════════════════════════════════════════════
		     SECTION 3 — THE BIG SHIFT
		     ═══════════════════════════════════════════════════════════ -->
		<Section variant="scripture">
			<div class="text-center max-w-3xl mx-auto">
				<div class="w-10 h-0.5 mx-auto mb-10" style="background-color: var(--color-gold);"></div>
				<h2
					class="text-3xl md:text-5xl font-light leading-tight mb-8"
					style="font-family: var(--font-serif); color: var(--color-ink);"
				>
					The destination was never merely forgiveness or heaven. The destination has always been the Father.
				</h2>
				<p
					class="text-lg leading-relaxed mb-12"
					style="font-family: var(--font-sans); color: var(--color-muted);"
				>
					The Father's Heart Bible™ is built on one conviction: God has always been reaching toward
					His children, not His servants. And Scripture has always been saying so.
				</p>
				<div class="grid grid-cols-1 sm:grid-cols-3 gap-8 text-left">
					{shifts.map(({ from, to }) => (
						<div class="flex flex-col gap-3">
							<div
								class="text-sm line-through"
								style="font-family: var(--font-sans); color: var(--color-muted); opacity: 0.5;"
							>
								{from}
							</div>
							<div class="h-px w-8" style="background-color: var(--color-gold);"></div>
							<div
								class="text-lg font-medium"
								style="font-family: var(--font-serif); color: var(--color-brand);"
							>
								{to}
							</div>
						</div>
					))}
				</div>
				<div class="w-10 h-0.5 mx-auto mt-10" style="background-color: var(--color-gold);"></div>
			</div>
		</Section>


		<!-- ═══════════════════════════════════════════════════════════
		     SECTION 4 — WHAT IT IS / WHAT IT IS NOT (the Bible's own "About this Translation" lists)
		     ═══════════════════════════════════════════════════════════ -->
		<Section variant="light">
			<div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl mx-auto">
				<div class="p-7 md:p-8" style="background-color: var(--color-surface); border: 1px solid var(--color-hairline); border-top: 3px solid var(--color-gold);">
					<h2 class="text-2xl md:text-3xl font-light mb-5" style="font-family: var(--font-serif); color: var(--color-ink);">What It Is</h2>
					<ul class="space-y-3" style="list-style: none; padding: 0; margin: 0; font-family: var(--font-sans); color: var(--color-muted); line-height: 1.65;">
						<li><strong style="color: var(--color-ink);">A fresh translation</strong> from the original Hebrew, Aramaic, and Greek, governed by 170 written translation rules.</li>
						<li><strong style="color: var(--color-ink);">Complete.</strong> 66 books, 1,189 chapters, 31,085 verses. Not one missing.</li>
						<li><strong style="color: var(--color-ink);">Interpretive.</strong> It renders the meaning of the original in clear, contemporary English, and makes our Father&rsquo;s identity, presence, and voice explicit where the text already carries them.</li>
						<li><strong style="color: var(--color-ink);">First of its kind.</strong> The first Bible in print to show you which words a divine person spoke &mdash; and which person spoke them.</li>
					</ul>
				</div>
				<div class="p-7 md:p-8" style="background-color: var(--color-surface); border: 1px solid var(--color-hairline); border-top: 3px solid var(--color-hairline);">
					<h2 class="text-2xl md:text-3xl font-light mb-5" style="font-family: var(--font-serif); color: var(--color-ink);">What It Is Not</h2>
					<ul class="space-y-3" style="list-style: none; padding: 0; margin: 0; font-family: var(--font-sans); color: var(--color-muted); line-height: 1.65;">
						<li><strong style="color: var(--color-ink);">Not a paraphrase,</strong> and not an adaptation of any existing English Bible.</li>
						<li><strong style="color: var(--color-ink);">Not a study Bible or commentary.</strong> The notes serve the reader, not the scholar.</li>
						<li><strong style="color: var(--color-ink);">Not the work of a committee.</strong> Every rendering and every interpretive decision is our own, and our own responsibility.</li>
						<li><strong style="color: var(--color-ink);">Not abridged.</strong> It reads 131,500 words shorter than the King James because contemporary English says the same thing in fewer words. Every verse. Every book.</li>
					</ul>
				</div>
			</div>
		</Section>


		<!-- ═══════════════════════════════════════════════════════════
		     SECTION 5 — SAMPLE COMPARISON PREVIEW
		     ═══════════════════════════════════════════════════════════ -->
		<Section variant="soft">
			<div class="text-center mb-14">
				<p
					class="text-xs font-semibold tracking-widest uppercase mb-3"
					style="font-family: var(--font-sans); color: var(--color-gold);"
				>
					See the Difference
				</p>
				<h2
					class="text-3xl md:text-4xl font-light"
					style="font-family: var(--font-serif); color: var(--color-ink);"
				>
					Zephaniah 3:17, side by side.
				</h2>
			</div>

			<div class="space-y-16 max-w-3xl mx-auto">

				<!-- Zephaniah 3:17 -->
				<div>
					<p class="text-xs font-semibold tracking-widest uppercase mb-6 text-center" style="font-family: var(--font-sans); color: var(--color-muted);">Zephaniah 3:17</p>
					<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
						<div class="p-6" style="background-color: var(--color-canvas); border: 1px solid var(--color-hairline);">
							<p class="text-xs tracking-widest uppercase mb-4" style="font-family: var(--font-sans); color: var(--color-muted); opacity: 0.6;">Traditional</p>
							<p class="italic leading-relaxed" style="font-family: var(--font-serif); color: var(--color-muted); font-size: 1.05rem;">"The Lord your God is with you, the Mighty Warrior who saves. He will take great delight in you…"
							</p>
						</div>
						<div class="p-6" style="background-color: var(--color-canvas); border: 1px solid var(--color-hairline); border-left: 3px solid var(--color-gold);">
							<p class="text-xs tracking-widest uppercase mb-4" style="font-family: var(--font-sans); color: var(--color-gold);">Father's Heart Bible™</p>
							<p class="italic leading-relaxed" style="font-family: var(--font-serif); color: var(--color-ink); font-size: 1.05rem;">"Your <strong style="font-style: normal; color: var(--color-brand);">Father</strong> is in your midst, a mighty warrior who saves. He will rejoice over you with gladness; he will quiet you by his love; he will exult over you with loud singing."
							</p>
						</div>
					</div>
					<p class="text-sm mt-4 text-center" style="font-family: var(--font-sans); color: var(--color-muted);">A Father who rejoices over you.</p>
				</div>

			</div>

			<div class="text-center mt-14">
				<a
					href="https://fathersheartbible.com/read/"
					class="inline-flex items-center px-8 py-3.5 text-base font-semibold no-underline transition-all duration-200"
					style="font-family: var(--font-sans); background-color: #FFD9E0; color: #4A4A4A;"
					onmouseover="this.style.opacity='0.9'"
					onmouseout="this.style.opacity='1'"
				>
					Read FHB →
				</a>
			</div>
		</Section>


		<!-- ═══════════════════════════════════════════════════════════
		     SECTION 7 — WHAT IS PUBLISHED
		     ═══════════════════════════════════════════════════════════ -->
		<Section variant="soft">
			<div class="text-center mb-12">
				<p
					class="text-xs font-semibold tracking-widest uppercase mb-3"
					style="font-family: var(--font-sans); color: var(--color-gold);"
				>
					Published
				</p>
				<h2
					class="text-3xl md:text-4xl font-light"
					style="font-family: var(--font-serif); color: var(--color-ink);"
				>
					Complete, in print, and free to read.
				</h2>
			</div>
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-4xl mx-auto">
				{milestones.map(({ milestone, detail }) => (
					<div class="p-6 text-center" style="border: 1px solid var(--color-hairline);">
						<div class="w-8 h-0.5 mx-auto mb-4" style="background-color: var(--color-gold);"></div>
						<h3 class="text-lg font-medium mb-3" style="font-family: var(--font-serif); color: var(--color-ink);">{milestone}</h3>
						<p class="text-sm leading-relaxed" style="font-family: var(--font-sans); color: var(--color-muted);">{detail}</p>
					</div>
				))}
			</div>
		</Section>


		<!-- ═══════════════════════════════════════════════════════════
		     SECTION — MEET KEVIN AND SHELLY WHITE
		     ═══════════════════════════════════════════════════════════ -->
		<Section variant="light">
			<div class="text-center max-w-2xl mx-auto">
				<p
					class="text-xs font-semibold tracking-widest uppercase mb-3"
					style="font-family: var(--font-sans); color: var(--color-gold);"
				>
					Behind the Translation
				</p>
				<h2
					class="text-3xl md:text-4xl font-light mb-6"
					style="font-family: var(--font-serif); color: var(--color-ink);"
				>
					Meet Kevin and Shelly White.
				</h2>
				<p
					class="text-lg leading-relaxed mb-10"
					style="font-family: var(--font-sans); color: var(--color-muted);"
				>
					The Father's Heart Bible™ was born from a forty-year journey through Scripture, ministry, and awakening. Learn the story behind the translation.
				</p>
				<a
					href="/the-fathers-heart-bible/leadership/"
					class="inline-flex items-center px-8 py-3.5 text-base font-semibold no-underline border transition-all duration-200"
					style="font-family: var(--font-sans); color: var(--color-brand); border-color: var(--color-brand);"
					onmouseover="this.style.opacity='1'; this.style.color='#fff';"
					onmouseout="this.style.backgroundColor='transparent'; this.style.color='var(--color-brand)';"
				>
					Read Their Story
				</a>
			</div>
		</Section>


		<!-- ═══════════════════════════════════════════════════════════
		     SECTION — PREFACE & A NOTE ON THE TRANSLATION
		     ═══════════════════════════════════════════════════════════ -->
		<Section variant="soft">
			<div class="max-w-3xl mx-auto" style="font-family: var(--font-sans); color: var(--color-muted); line-height: 1.8;">
				<p class="text-xs font-semibold tracking-widest uppercase mb-3" style="color: var(--color-gold);">The Heart Behind It</p>
				<h2 class="text-3xl md:text-4xl font-light mb-8" style="font-family: var(--font-serif); color: var(--color-ink);">Preface</h2>

				<h3 class="text-xl font-semibold mt-8 mb-2" style="font-family: var(--font-serif); color: var(--color-ink);">The destination was always the Father</h3>
				<div class="space-y-4">
					<p>Jesus said, “I am the way, the truth, and the life. No one comes to the Father except through me” (John 14:6). For generations the church heard the way to heaven. He said the way to the Father. The destination was never merely forgiveness, and never merely heaven. It was the Father Himself.</p>
					<p>From the first page to the last, Scripture tells one story: a perfect and loving Father pursuing and restoring His beloved sons and daughters through the blood of His Son and by the Holy Spirit. Father's Heart Bible™ exists for one reason: so you can hear that story in the Father's own voice, and come home.</p>
				</div>

				<h3 class="text-xl font-semibold mt-8 mb-2" style="font-family: var(--font-serif); color: var(--color-ink);">What “God” and “the LORD” concealed</h3>
				<div class="space-y-4">
					<p>The original languages carry distinctions that centuries of English flattened. Hebrew speaks of God by many names: Elohim, El Shaddai, Adonai, the covenant name YHWH, and also, tenderly, as Ab, Father. The translation tradition gathered nearly all of these under “God” and “the LORD.” Something true was preserved, but something true was also lost: a near and personal Father came to sound like a remote and impersonal deity.</p>
					<p>Consider the best-known verse in the Bible. “For God so loved the world that he gave his one and only Son” (John 3:16). The Greek word rendered “God” is theos, and here it plainly means the Father, the One who sends and gives the Son. Father's Heart Bible™ makes it explicit: “For our Father so loved the world that he gave his one and only Son.” The words were always there.</p>
					<p>You will find the same all through Scripture. When Adam and Eve hid in the garden, they hid not from a distant deity but from their Father (Genesis 3:8). When God covered their shame with His own hands, it was the Father who clothed them (Genesis 3:21).</p>
				</div>

				<h3 class="text-xl font-semibold mt-8 mb-2" style="font-family: var(--font-serif); color: var(--color-ink);">Who never calls Him Father</h3>
				<div class="space-y-4">
					<p>Notice who, in Scripture, relates to God only as a distant deity and never as Father. The serpent in Eden, who recast a generous Father as a withholding rival: “Did God really say…?” (Genesis 3:1). The accuser and the arguing friends in Job, who debated a remote and transactional judge, until Job himself moved from hearing about God to seeing Him: “My ears had heard of you, but now my eyes have seen you” (Job 42:5). Pharaoh, who sneered, “Who is the LORD, that I should obey him?” (Exodus 5:2). Even the tempter in the wilderness aimed his attack straight at the bond of sonship: “If you are the Son of God…” (Matthew 4:3).</p>
					<p>The enemy's strategy has never changed since the garden: to make the Father seem distant, demanding, and disappointed. For too long, “God” and “the LORD” left that caricature unchallenged. Father's Heart Bible™ lets the Hebrew and Greek speak the distinction they always made, between a deity to be appeased and a Father to be received.</p>
				</div>

				<h3 class="text-xl font-semibold mt-8 mb-2" style="font-family: var(--font-serif); color: var(--color-ink);">Our lens, and why it is honest</h3>
				<div class="space-y-4">
					<p>Every translation interprets; none is neutral. Ours carries a stated lens: we listen for the Father's voice and name Him where Scripture reveals Him as Father. We want to be honest that this is a lens, and honest about where it comes from.</p>
					<p>We read the whole of Scripture in the light of the whole of Scripture. Three realities now shape how we translate, beginning at the very first verse: first, the incarnation — the Son revealed the Father perfectly (“Anyone who has seen me has seen the Father,” John 14:9); second, Pentecost — the Spirit of sonship was poured out, crying from within His children, “Abba, Father” (Romans 8:15; Galatians 4:6); third, the sealed canon — with the last book written, the whole story finally came into view: one Father, one redemption, one family.</p>
					<p>These are not later ideas read backward into an unwilling text. The Father, the Son, and the Spirit were present and at work in Genesis 1:1. To read Genesis in the light of John is not anachronism; it is reading the first chapter by the same Author who wrote the last. The Father did not become Father at Bethlehem. He has always been Father.</p>
				</div>

				<h3 class="text-xl font-semibold mt-8 mb-2" style="font-family: var(--font-serif); color: var(--color-ink);">The Trinity, rightly seen</h3>
				<div class="space-y-4">
					<p>This recovery does not diminish the Trinity; it clarifies it. The one God exists eternally as Father, Son, and Holy Spirit, three persons in one essence, and Father's Heart Bible™ honors each. The Father initiates, sends, and gives. The Son reveals, redeems, and reconciles us to the Father. The Spirit applies, confirms, and pours the Father's love into our hearts.</p>
					<p>What this translation refuses is a caricature many have unknowingly carried: a gentle Jesus, a powerful Spirit, and behind them an old, distant, disappointed Father. That Father does not exist. The Father is exactly like Jesus, for Jesus is His perfect image.</p>
				</div>

				<h3 class="text-xl font-semibold mt-8 mb-2" style="font-family: var(--font-serif); color: var(--color-ink);">A word about the word “Father”</h3>
				<div class="space-y-4">
					<p>We know that for many, “father” is not a word of comfort. It can carry absence, disappointment, even deep wounds. If that is your story, this Bible is especially for you. The Father revealed in these pages is not a projection of broken human fatherhood. He is the original, the Father from whom every family in heaven and on earth takes its name (Ephesians 3:14–15). Every good thing an earthly father does is a faint echo of His heart; every failure is a departure from it. He is the Father you were made for — the One who will never leave you, and never let you go.</p>
				</div>

				<h3 class="text-xl font-semibold mt-8 mb-2" style="font-family: var(--font-serif); color: var(--color-ink);">Come home</h3>
				<div class="space-y-4">
					<p>From the garden, where the Father walked with His children in the cool of the day, to the final page, where He declares, “I will be their Father, and they will be my sons and daughters” (Revelation 21:7), Scripture tells one unbroken story: a perfect and loving Father pursuing and restoring His beloved through the blood of His Son and by the Holy Spirit.</p>
					<p>You are not an outsider. You are not an orphan. You are not a servant hoping for scraps at the table. You are the Father's beloved child — and He has been waiting for you the whole time.</p>
					<p><em>Welcome to Father's Heart Bible™. Come home.</em></p>
				</div>

				<h2 class="text-3xl md:text-4xl font-light mt-16 mb-8" style="font-family: var(--font-serif); color: var(--color-ink);">About this Translation</h2>
				<h3 class="text-xl font-semibold mt-8 mb-2" style="font-family: var(--font-serif); color: var(--color-ink);">How it renders the divine names</h3>
				<p>Where a word for God stands in a clearly relational or covenantal setting, it is rendered “our Father.” Elsewhere the customary rendering is kept, and Adonai and Kurios are always rendered “Lord.” At Genesis 1:1, “God” (Elohim) is rendered “our Heavenly Father.”</p>
				<h3 class="text-xl font-semibold mt-8 mb-2" style="font-family: var(--font-serif); color: var(--color-ink);">The notes</h3>
				<p>This edition carries 1,354 notes across 777 chapters: 1,075 explain a word, name, custom, or background; 248 mark where the text reveals the Father; 31 record a difference among the manuscripts. Where the original carries no divine name, the note says so.</p>
				<h3 class="text-xl font-semibold mt-8 mb-2" style="font-family: var(--font-serif); color: var(--color-ink);">Its sources</h3>
				<p>Its Old Testament readings are weighed against the Masoretic Hebrew, and its New Testament follows the modern critical text as carried in the major modern translations; where the manuscripts differ, it keeps company with their consensus. Standard Hebrew and Greek reference works are gratefully acknowledged; its English text, notes, and headings are its own.</p>
				<h3 class="text-xl font-semibold mt-8 mb-2" style="font-family: var(--font-serif); color: var(--color-ink);">How it was made</h3>
				<p>Father's Heart Bible™ was produced through a structured, rule-governed translation process built for this work, bringing the consistency and reach of modern language technology to the ancient task of translation. Within that process, AI language tools rendered the text and footnotes directly from the original Hebrew, Aramaic, and Greek, guided by 170 translation rules; each book was then carried through successive passes, its most difficult readings cross-checked against the Hebrew and independent references, before being reviewed and finalized. The rules and every interpretive decision are the work of Kevin White of Spirit Media Publishing, who led the process; other readers reviewed it and offered feedback.</p>
				<h3 class="text-xl font-semibold mt-8 mb-2" style="font-family: var(--font-serif); color: var(--color-ink);">Where it stands</h3>
				<p>We hold the church's other faithful translations in genuine honor; Father's Heart Bible™ is offered alongside them, a further window onto the same enduring Word. This is the First Edition (2026), a living text: each edition carries a version number, and corrections are published as the work is refined.</p>
				<p class="mt-6"><em>Welcome home. His heart is for you.</em></p>

				<p class="mt-10 text-sm" style="color: var(--color-muted);">
					For copyright, ownership, permissions, and how to quote the Father's Heart Bible™, see <a href="/copyright/" style="color: var(--color-brand);" class="hover:underline">Copyright &amp; Permissions</a>.
				</p>
			</div>
		</Section>

