---
import ImageGrid from '../components/ImageGrid.astro';
import ScriptureBlock from '../components/ScriptureBlock.astro';
import Section from '../components/Section.astro';
import VideoHeroInner from '../components/VideoHeroInner.astro';
import VoiceChips from '../components/VoiceChips.astro';
import WaysToReceive from '../components/WaysToReceive.astro';
import { LANGUAGE_EDITION_TOTAL } from '../data/language-editions';
import {
	AUDIENCE_EDITION_TOTAL,
	BOOK_ID,
	LANGUAGE_TOTAL,
	languageItemList,
	topLanguages,
} from '../data/receive';
import Layout from '../layouts/Layout.astro';
import { sanityClient, urlFor } from '../lib/sanity';

const [pageData, media, biblePageData, latestPosts] = await Promise.all([
	sanityClient.fetch(`*[_type =="page" && slug =="the-fathers-heart-bible"][0] {
    seoTitle, seoDescription,
    heroHeading, heroSubheading,
    heroPrimaryCtaLabel, heroPrimaryCtaHref,
    heroSecondaryCtaLabel, heroSecondaryCtaHref
  }`),
	sanityClient.fetch(
		`*[_type =="siteSettings"][0] { theThersHeartBiblePageVideo, bookCoverUrl, fhbCoverImage, communityUrl }`,
	),
	sanityClient.fetch(
		`*[_type =="biblePageContent"][0] { distinctives, notItems, milestones, audience, shifts }`,
	),
	sanityClient.fetch(
		`*[_type == "blogPost" && defined(slug.current)] | order(publishDate desc) [0...3] {
      "slug": slug.current,
      title,
      excerpt,
      "image": coalesce(heroImage.asset->url + "?w=600&fm=webp", "/fhb-logo.png"),
      publishDate
    }`,
	),
]);

// The definitional page: it owns "what is the Father's Heart Bible" and "Father's Heart Bible
// translation". NOTE: the LIVE title/description come from Sanity (page "the-fathers-heart-bible")
// when set there.
const seoTitle =
	pageData?.seoTitle || "What Is the Father's Heart Bible™ (FHB)? The 2026 Bible Translation";
const seoDescription =
	pageData?.seoDescription ||
	`Father's Heart Bible™ (FHB) is the complete Bible, freshly translated to reveal God as our Father, with His words in blue. Free online and in print, ${LANGUAGE_TOTAL} languages.`;
const heroHeading = 'What is the Father\u2019s Heart Bible\u2122?';
// Answer-first: the page's question answered in its opening sentences, in plain text.
const heroSubheading = `Father\u2019s Heart Bible\u2122 (FHB) is the complete Bible in a fresh translation from the original Hebrew, Aramaic, and Greek that reveals God as our Father where Scripture reveals Him. It is the first Bible in print to show which words a divine person spoke \u2014 our Father\u2019s in blue, the Son\u2019s in red, the Spirit\u2019s in purple. Free to read and hear online, and in print in ${LANGUAGE_TOTAL} languages.`;
// Hero CTA: single "Read FHB" (the site's primary CTA). The old "Read Sample
// Passages" button was removed (2026-06-06, Kevin) since Read FHB sat right
// beside it — redundant.
const heroPrimaryCtaLabel = 'Read FHB →';
const heroPrimaryCtaHref = '/read/';
const heroSecondaryCtaLabel = '';
const heroSecondaryCtaHref = '';
const bookCoverUrl = media?.bookCoverUrl || '';

// FHB → Beloved Identity cover — prefer Sanity image, fall back to hardcoded
// The Sanity asset is a true RGBA PNG (alpha-channel transparency);
// Sanity preserves the alpha so the section bg shows through naturally.
const fhbCoverImageFromSanity = media?.fhbCoverImage;
const fhbiCoverUrl = fhbCoverImageFromSanity
	? urlFor(fhbCoverImageFromSanity).width(400).auto('format').url()
	: 'https://cdn.sanity.io/images/rusi1hyi/production/7af29ed50a183320765567ec9cd1e9de2bb218a5-724x1122.png';
const communityUrl = media?.communityUrl || '/join';

// What is published today (replaces the pre-launch "Road Ahead" milestones, Kevin 2026-10-13).
const milestones = [
	{
		milestone: 'The Complete Bible',
		detail: 'All 66 books, Genesis to Revelation — 1,189 chapters, 31,085 verses. Not one missing.',
	},
	{
		milestone: 'Free to Read and Hear',
		detail: 'The whole Bible is free online, with verse-by-verse audio.',
	},
	{
		milestone: 'In Print',
		detail: 'Hardcover and paperback, in audience editions, Large Print, and a journaling Bible.',
	},
	{
		milestone: `In ${LANGUAGE_EDITION_TOTAL + 1} Languages`,
		detail: 'Each one published in print and free to read online.',
	},
];

const shifts = biblePageData?.shifts ?? [
	{ from: 'Information', to: 'Relationship' },
	{ from: 'Distance', to: 'Intimacy' },
	{ from: 'Servant mindset', to: 'Beloved identity' },
];

// FAQ — question-and-answer pairs that mirror what people actually search for. The visible
// section below renders these; the FAQPage JSON-LD mirrors them word for word.
// The divine-name answers quote the Bible's own "About this Translation" statement (shown in
// full further up this page) — do not paraphrase it in terms of single Hebrew names.
const DIVINE_NAMES =
	'Where a word for God stands in a clearly relational or covenantal setting, it is rendered “our Father.” Elsewhere the customary rendering is kept, and Adonai and Kurios are always rendered “Lord.”';
const faqs = [
	{
		q: "What is the Father's Heart Bible™?",
		a: "Father's Heart Bible™ (FHB) is the complete Bible — 66 books, 1,189 chapters, 31,085 verses — in a fresh translation from the original Hebrew, Aramaic, and Greek, governed by 170 written translation rules. It is the first Bible in print to show which words a divine person spoke, and which person spoke them: our Father's words in blue, the Son's in red, the Spirit's in purple.",
	},
	{
		// The abbreviation needs its own QUESTION, not just a mention inside another answer
		// (Kevin 2026-09-18). NIV, ESV and KJV carry their own search demand; FHB does not yet,
		// so the pairing has to be stated in the form an engine can lift and a person can ask.
		q: 'What does FHB stand for?',
		a: "FHB stands for Father's Heart Bible™. It is used the way NIV, ESV or KJV are used: FHB is the translation abbreviation, and Father's Heart Bible is the full name. Every FHB edition carries the same translation; the editions differ only in who they were made for, the print size and the binding.",
	},
	{
		q: "How is the Father's Heart Bible™ different from other translations?",
		a: `In two ways. First, how it renders the divine names: ${DIVINE_NAMES} Second, Divine Voice Color: for a hundred and twenty-five years, red letters have shown the Son speaking. FHB also prints our Father's words in blue — 128,579 words across 5,615 verses — and the Spirit's in purple, so you can see who is speaking.`,
	},
	{
		q: 'Why does FHB render “God” as “our Father” in some places?',
		a: `${DIVINE_NAMES} So John 3:16 reads, “For our Father so loved the world that he gave his one and only Son,” because the One who gives the Son there is the Father. The word “God” is kept wherever Scripture speaks of God as God, and where the original carries no divine name, the note says so.`,
	},
	{
		q: 'Is the Father’s Heart Bible™ a red letter Bible?',
		a: "It is a red letter Bible and more. A red letter Bible prints the words of Jesus in red. FHB prints the Son's words in red (35,725 words), our Father's in blue (128,579 words across 5,615 verses) and the Spirit's in purple (95 words). The color marks who spoke: words a divine person never spoke are never colored, and narration stays black.",
	},
	{
		q: 'Is the Father’s Heart Bible™ a new, easy-to-read translation?',
		a: 'Yes. FHB is a First Edition, published in 2026 — a fresh translation, not an adaptation of any existing English Bible. It renders the meaning of the original in clear, contemporary English, and reads 131,500 words shorter than the King James because contemporary English says the same thing in fewer words. Nothing is abridged: every verse, every book.',
	},
	{
		q: 'Is the Father’s Heart Bible™ a paraphrase?',
		a: 'No. FHB is an interpretive translation from the original Hebrew, Aramaic, and Greek, governed by 170 written translation rules. It is not a paraphrase, and not an adaptation of any existing English Bible. It is also not a study Bible or commentary: the notes serve the reader, not the scholar.',
	},
	{
		q: 'Who translated the Father’s Heart Bible™?',
		a: 'Kevin White of Spirit Media Publishing led the translation and publishing process. The 170 translation rules and every interpretive decision are his work; other readers reviewed it and offered feedback. How the text was produced is set out under “How it was made” on this page. FHB is published by Spirit Media Publishing, which Kevin and Shelly White lead.',
	},
	{
		q: 'Can I read the Father’s Heart Bible™ online for free?',
		a: 'Yes. The whole Bible, Genesis to Revelation, is free to read at fathersheartbible.com/read/ with verse-by-verse audio, and free to hear as an audio Bible on Spotify, Apple Podcasts and YouTube.',
	},
	{
		q: 'What editions and formats does it come in?',
		a: `In print, as hardcover and paperback: ${AUDIENCE_EDITION_TOTAL} audience editions — for men, women, teens, moms, dads, graduates and more, including the general edition in three cover colors, a three-volume Large Print Bible in 14-point type, and a wide-margin 8x10 journaling Bible. It is also published as an eBook and an audiobook, and it is free to read and hear online.`,
	},
	{
		q: 'Is the Father’s Heart Bible™ available in Spanish and other languages?',
		a: `Yes. FHB is published in ${LANGUAGE_TOTAL} languages — English and ${LANGUAGE_EDITION_TOTAL} more, among them ${topLanguages(8).join(', ')}. Each one is published in print and free to read online.`,
	},
];

const formatDate = (dateString: string) => {
	if (!dateString) return '';
	const d = new Date(dateString);
	return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
};
---

<Layout
	title={seoTitle}
	description={seoDescription}
	image="https://assets.spiritmediapublishing.com/FHB/share/fhb-og-bible.jpg?v=2"
	imageAlt={'Father\'s Heart Bible — "I will be your Father" (Revelation 21:7)'}
	darkHero={true}
	jsonLd={[
		{
			"@context": "https://schema.org",
			"@graph": [
				{ "@type": "WebPage", "name": seoTitle, "description": seoDescription, "url": "https://fathersheartbible.com/the-fathers-heart-bible/", "mainEntity": { "@id": BOOK_ID } },
				{ "@type": "BreadcrumbList", "itemListElement": [
					{ "@type": "ListItem", "position": 1, "name": "Home", "item": "https://fathersheartbible.com/" },
					{ "@type": "ListItem", "position": 2, "name": "About FHB", "item": "https://fathersheartbible.com/the-fathers-heart-bible/" }
				]},
				// Mirrors the visible "Read the Bible free online in N languages" list below.
				languageItemList
			]
		},
		// Book schema — establishes FHB as a Bible translation entity for AI engines and search.
		{
			"@context": "https://schema.org",
			"@type": "Book",
			"@id": BOOK_ID,
			// Names, edition and description follow the Metadata & Messaging Guidelines
			// verbatim: brand always carries the ™ and never a leading "The"; the full
			// listed title is the alternateName; the description is the approved short
			// blurb. inLanguage is "en" per the brief's Publication facts — the reader's
			// node in community/src/lib/reader-seo.ts MUST stay identical to this, since
			// two values for one @id is precisely the conflict this pass removed.
			"name": "Father's Heart Bible™",
			"alternateName": [
				"Father's Heart Bible",
				"Father's Heart Bible: An Intimate Translation",
				"FHB"
			],
			"bookEdition": "An Intimate Translation",
			"description": "A fresh Bible translation from the original Hebrew, Aramaic, and Greek that reveals God as your Father. Come home to your Father. His heart is for you.",
			"inLanguage": "en",
			"url": "https://fathersheartbible.com",
			"translationOfWork": { "@type": "Book", "name": "The Holy Bible" },
			"isAccessibleForFree": true,
			"sameAs": [
				"https://www.instagram.com/fathersheartbible/",
				"https://www.youtube.com/channel/UCzgp9q1JnqyyEgz_j--KiQg",
				"https://www.facebook.com/1176654175531729",
				"https://www.tiktok.com/@fathersheartbible",
				"https://www.linkedin.com/company/130004384"
			],
			"image": "https://cdn.sanity.io/images/rusi1hyi/production/8b5d1c39f892218c978d3e3caf5720e09833bbc4-1024x1024.png?w=1200&h=630&fit=crop",
			"editor": {
				"@type": "Person",
				"@id": "https://kevinwhite.us/#person",
				"name": "Kevin White",
				"url": "https://kevinwhite.us"
			},
			"publisher": {
				"@type": "Organization",
				"@id": "https://spiritmediapublishing.com/#organization",
				"name": "Spirit Media Publishing",
				"url": "https://spiritmediapublishing.com"
			},
			"copyrightHolder": { "@type": "Organization", "name": "Spirit Media Inc." },
			"copyrightYear": 2026,
			"datePublished": "2026-06-21",
			"about": [
				{ "@type": "Thing", "name": "Bible translation" },
				{ "@type": "Thing", "name": "Father heart of God" },
				{ "@type": "Thing", "name": "Trinitarian theology" }
			],
			"workExample": [
				{ "@type": "Book", "bookFormat": "https://schema.org/Paperback", "isbn": "979-8-89307-333-1", "name": "Father's Heart Bible: An Intimate Translation (Paperback – Charcoal Edition)", "inLanguage": "en" },
				{ "@type": "Book", "bookFormat": "https://schema.org/Paperback", "isbn": "979-8-89307-334-8", "name": "Father's Heart Bible: An Intimate Translation (Paperback – Plum Edition)", "inLanguage": "en" },
				{ "@type": "Book", "bookFormat": "https://schema.org/Paperback", "isbn": "979-8-89307-335-5", "name": "Father's Heart Bible: An Intimate Translation (Paperback – White Edition)", "inLanguage": "en" },
				{ "@type": "Book", "bookFormat": "https://schema.org/Hardcover", "isbn": "979-8-89307-336-2", "name": "Father's Heart Bible: An Intimate Translation (Hardcover – Charcoal Edition)", "inLanguage": "en" },
				{ "@type": "Book", "bookFormat": "https://schema.org/Hardcover", "isbn": "979-8-89307-337-9", "name": "Father's Heart Bible: An Intimate Translation (Hardcover – Plum Edition)", "inLanguage": "en" },
				{ "@type": "Book", "bookFormat": "https://schema.org/Hardcover", "isbn": "979-8-89307-338-6", "name": "Father's Heart Bible: An Intimate Translation (Hardcover – White Edition)", "inLanguage": "en" },
				{ "@type": "Book", "bookFormat": "https://schema.org/Hardcover", "isbn": "979-8-89307-296-9", "name": "Father's Heart Bible: An Intimate Translation (ComfortLeather™ Edition)", "inLanguage": "en" },
				{ "@type": "Book", "bookFormat": "https://schema.org/EBook", "isbn": "979-8-89307-297-6", "name": "Father's Heart Bible: An Intimate Translation (eBook)", "inLanguage": "en" },
				{ "@type": "Book", "bookFormat": "https://schema.org/AudiobookFormat", "isbn": "979-8-89307-298-3", "name": "Father's Heart Bible: An Intimate Translation (Audiobook)", "inLanguage": "en" }
			]
		},
		// FAQPage schema — AEO citation target.
		{
			"@context": "https://schema.org",
			"@type": "FAQPage",
			"mainEntity": faqs.map((f) => ({
				"@type": "Question",
				"name": f.q,
				"acceptedAnswer": { "@type": "Answer", "text": f.a }
			}))
		}
	]}
>
	<main>

		<!-- ═══════════════════════════════════════════════════════════
		     SECTION 1 — PAGE HERO
		     ═══════════════════════════════════════════════════════════ -->
		<VideoHeroInner
			imageSrc="https://assets.spiritmediapublishing.com/FHB/print/about-hero-pews.webp"
			imageSrcMobile="https://assets.spiritmediapublishing.com/FHB/print/about-hero-pews-960.webp"
			imageWidth={1902}
			imageHeight={686}
			imagePosition="top"
			href="/print/"
			heading={heroHeading}
			headingBelow
		/>
		{/* The h1 and its answer sit below the hero image (Kevin 2026-10-14): each voice named in
		     its own colour, then the FATHER / SON / SPIRIT blocks. Inline styles: under the hero. */}
		<section style="background-color: var(--color-canvas); padding: 2rem 1rem 3rem;">
			<div style="max-width: 42rem; margin: 0 auto; text-align: center;">
				<p style="font-family: var(--font-body); color: var(--color-muted); font-size: 1.2rem; line-height: 1.7; margin: 0 0 1.75rem;">
					Father&rsquo;s Heart Bible&trade; (FHB) is the complete Bible in a fresh translation from the original Hebrew, Aramaic, and Greek that reveals God as our Father where Scripture reveals Him. It is the first Bible in print to show which words a divine person spoke &mdash; <span style="color: #2563eb; font-weight: 600;">our Father&rsquo;s in blue</span>, <span style="color: #c8102e; font-weight: 600;">the Son&rsquo;s in red</span>, <span style="color: #6a3fa0; font-weight: 600;">the Spirit&rsquo;s in purple</span>. Free to read and hear online, and in print in {LANGUAGE_TOTAL} languages.
				</p>
				<VoiceChips class="mb-8" />
				<a href={heroPrimaryCtaHref} style="display: inline-flex; align-items: center; padding: 0.875rem 2rem; font-family: var(--font-body); font-size: 1rem; font-weight: 600; text-decoration: none; background: #FFD9E0; color: #4A4A4A;">{heroPrimaryCtaLabel}</a>
			</div>
		</section>


		<!-- ═══════════════════════════════════════════════════════════
		     SECTION 3 — THE BIG SHIFT
		     ═══════════════════════════════════════════════════════════ -->
		<Section variant="scripture">
			<div class="text-center max-w-3xl mx-auto">
				<div class="w-10 h-0.5 mx-auto mb-10" style="background-color: var(--color-gold);"></div>
				<h2
					class="text-3xl md:text-5xl font-light leading-tight mb-8"
					style="font-family: var(--font-serif); color: var(--color-ink);"
				>
					The destination was never merely forgiveness or heaven. The destination has always been the Father.
				</h2>
				<p class="text-2xl leading-relaxed mb-3" style="font-family: var(--font-serif); color: #c8102e; font-weight: 600;">
					I am the way, and the truth, and the life. No one comes to the Father except through me.
				</p>
				<p class="mb-10" style="font-family: var(--font-sans); font-size: 0.9rem;">
					<a href="/read/john/14/#v6" style="color: var(--color-brand); font-weight: 600; text-decoration: none;">John 14:6 (FHB)</a>
				</p>
				<p
					class="text-lg leading-relaxed mb-12"
					style="font-family: var(--font-sans); color: var(--color-muted);"
				>
					The Father's Heart Bible™ is built on one conviction: God has always been reaching toward
					His children, not His servants. And Scripture has always been saying so.
				</p>
				<div class="grid grid-cols-1 sm:grid-cols-3 gap-8 text-left">
					{shifts.map(({ from, to }) => (
						<div class="flex flex-col gap-3">
							<div
								class="text-sm line-through"
								style="font-family: var(--font-sans); color: var(--color-muted); opacity: 0.5;"
							>
								{from}
							</div>
							<div class="h-px w-8" style="background-color: var(--color-gold);"></div>
							<div
								class="text-lg font-medium"
								style="font-family: var(--font-serif); color: var(--color-brand);"
							>
								{to}
							</div>
						</div>
					))}
				</div>
				<div class="w-10 h-0.5 mx-auto mt-10" style="background-color: var(--color-gold);"></div>
			</div>
		</Section>


		<!-- ═══════════════════════════════════════════════════════════
		     FATHER IS HIS NAME — condensed from the Preface (Kevin 2026-10-13)
		     ═══════════════════════════════════════════════════════════ -->
		<Section variant="light">
			<div class="text-center max-w-2xl mx-auto">
				<h2 class="text-3xl md:text-4xl font-light mb-6" style="font-family: var(--font-serif); color: var(--color-ink);">Father is His Name</h2>
				<p class="text-xl leading-relaxed mb-4" style="font-family: var(--font-serif); color: var(--color-ink);">&ldquo;God&rdquo; is not a name. It is what He is. Father is who He is.</p>
				<p class="text-lg leading-relaxed mb-4" style="font-family: var(--font-sans); color: var(--color-muted);">At the center of the Trinity is a Father &mdash; not a role God plays. Father is the name Jesus came to reveal: &ldquo;I revealed your name to those you gave me from the world&rdquo; (<a href="/read/john/17/" style="color: var(--color-brand); text-decoration: none; font-weight: 600;">John 17:6</a>).</p>
				<p class="text-lg leading-relaxed mb-6" style="font-family: var(--font-sans); color: var(--color-muted);">He placed the desire for Him in you before the creation of the world. He is your Father, and you are His beloved son or daughter.</p>
				<a href="/#receive" class="inline-flex items-center px-8 py-3.5 text-base font-semibold no-underline" style="font-family: var(--font-sans); background-color: #FFD9E0; color: #4A4A4A;">Open your heart to our Father &rarr;</a>
			</div>
		</Section>


		<!-- ═══════════════════════════════════════════════════════════
		     SECTION 4 — WHAT IT IS / WHAT IT IS NOT (the Bible's own "About this Translation" lists)
		     ═══════════════════════════════════════════════════════════ -->
		<Section variant="light">
			<div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl mx-auto">
				<div class="p-7 md:p-8" style="background-color: var(--color-surface); border: 1px solid var(--color-hairline); border-top: 3px solid var(--color-gold);">
					<h2 class="text-2xl md:text-3xl font-light mb-5" style="font-family: var(--font-serif); color: var(--color-ink);">What It Is</h2>
					<ul class="space-y-3" style="list-style: none; padding: 0; margin: 0; font-family: var(--font-sans); color: var(--color-muted); line-height: 1.65;">
						<li><strong style="color: var(--color-ink);">A fresh translation</strong> from the original Hebrew, Aramaic, and Greek, governed by 170 written translation rules.</li>
						<li><strong style="color: var(--color-ink);">Complete.</strong> 66 books, 1,189 chapters, 31,085 verses. Not one missing.</li>
						<li><strong style="color: var(--color-ink);">Interpretive.</strong> It renders the meaning of the original in clear, contemporary English, and makes our Father&rsquo;s identity, presence, and voice explicit where the text already carries them.</li>
						<li><strong style="color: var(--color-ink);">First of its kind.</strong> The first Bible in print to show you which words a divine person spoke &mdash; and which person spoke them.</li>
					</ul>
				</div>
				<div class="p-7 md:p-8" style="background-color: var(--color-surface); border: 1px solid var(--color-hairline); border-top: 3px solid var(--color-hairline);">
					<h2 class="text-2xl md:text-3xl font-light mb-5" style="font-family: var(--font-serif); color: var(--color-ink);">What It Is Not</h2>
					<ul class="space-y-3" style="list-style: none; padding: 0; margin: 0; font-family: var(--font-sans); color: var(--color-muted); line-height: 1.65;">
						<li><strong style="color: var(--color-ink);">Not a paraphrase,</strong> and not an adaptation of any existing English Bible.</li>
						<li><strong style="color: var(--color-ink);">Not a study Bible or commentary.</strong> The notes serve the reader, not the scholar.</li>
						<li><strong style="color: var(--color-ink);">Not the work of a committee.</strong> Every rendering and every interpretive decision is our own, and our own responsibility.</li>
						<li><strong style="color: var(--color-ink);">Not abridged.</strong> It reads 131,500 words shorter than the King James because contemporary English says the same thing in fewer words. Every verse. Every book.</li>
					</ul>
				</div>
			</div>
		</Section>


		<!-- ═══════════════════════════════════════════════════════════
		     SECTION 5 — SAMPLE COMPARISON PREVIEW
		     ═══════════════════════════════════════════════════════════ -->
		<Section variant="soft">
			<div class="text-center mb-14">
				<p
					class="text-xs font-semibold tracking-widest uppercase mb-3"
					style="font-family: var(--font-sans); color: var(--color-gold);"
				>
					See the Difference
				</p>
				<h2
					class="text-3xl md:text-4xl font-light"
					style="font-family: var(--font-serif); color: var(--color-ink);"
				>
					Zephaniah 3:17, side by side.
				</h2>
			</div>

