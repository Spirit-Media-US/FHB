---
import CTASection from '../../components/CTASection.astro';
import ScriptureBlock from '../../components/ScriptureBlock.astro';
import Section from '../../components/Section.astro';
import VideoHeroInner from '../../components/VideoHeroInner.astro';
import WaysToReceive from '../../components/WaysToReceive.astro';
import Layout from '../../layouts/Layout.astro';
import { sanityClient } from '../../lib/sanity';

const [pageData, media, kevinProfile] = await Promise.all([
	sanityClient.fetch(`*[_type =="page" && slug =="about"][0] {
    seoTitle, seoDescription
  }`),
	sanityClient.fetch(
		`*[_type =="siteSettings"][0] { kevinPortraitUrl, communityUrl, donateUrl, leadTranslatorPageVideo }`,
	),
	sanityClient.fetch(
		`*[_type =="personProfile"] | order(order asc)[0] { portraitUrl, portrait { asset->{ url } } }`,
	),
]);

// NOTE: the LIVE title/description come from Sanity (page "about") when set there.
const seoTitle =
	pageData?.seoTitle || "Kevin and Shelly White — Leadership | Father's Heart Bible™ (FHB)";
const seoDescription =
	pageData?.seoDescription ||
	"Meet Kevin and Shelly White of Spirit Media Publishing, who lead the Father's Heart Bible™ (FHB). Kevin led the translation; this is the forty-year story behind it.";
const kevinPortraitUrl =
	kevinProfile?.portraitUrl || kevinProfile?.portrait?.asset?.url || media?.kevinPortraitUrl || '';
const communityUrl = media?.communityUrl || '#join';
const heroVideoUrl =
	media?.leadTranslatorPageVideo ||
	'https://assets.spiritmediapublishing.com/fathers-heart-bible/read-book.mp4';
---

<Layout
  title={seoTitle}
  description={seoDescription}
  darkHero={true}
  jsonLd={{
    "@context": "https://schema.org",
    "@graph": [
      { "@type": "WebPage", "name": seoTitle, "description": seoDescription, "url": "https://fathersheartbible.com/the-fathers-heart-bible/leadership/" },
      {
        "@type": "Person",
        "@id": "https://kevinwhite.us/#person",
        "name": "Kevin White",
        "jobTitle": "Founder & CEO, Spirit Media Publishing",
        "description": "Kevin White led the translation and publishing process of the Father's Heart Bible™. An author, speaker, and marketplace pastor, he leads Spirit Media Publishing with his wife, Shelly White.",
        // Shelly White is named here, on Kevin's entity, rather than as a second top-level Person:
        // scripts/aeo-validate.mjs requires three real external profile URLs for every top-level
        // Person, and none are on record for her. Add her own Person node when they are.
        "spouse": {
          "@type": "Person",
          "name": "Shelly White",
          "description": "Shelly White leads Spirit Media Publishing and Father's Heart Bible™ with her husband, Kevin White.",
          "worksFor": { "@id": "https://spiritmediapublishing.com/#organization" }
        },
        "image": kevinPortraitUrl,
        "worksFor": { "@type": "Organization", "name": "Spirit Media Publishing", "url": "https://spiritmediapublishing.com" },
        "url": "https://fathersheartbible.com/the-fathers-heart-bible/leadership/",
        "sameAs": [
          "https://kevinwhite.us",
          "https://kevinwhite.us/about/",
          "https://www.linkedin.com/in/kevinwhiteus/",
          "https://www.youtube.com/@KevinWhiteus",
          "https://thekevinwhiteshow.podbean.com/",
          "https://www.amazon.com/stores/author/B08LZYTR2B"
        ]
      },
      { "@type": "BreadcrumbList", "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://fathersheartbible.com/" },
        { "@type": "ListItem", "position": 2, "name": "About FHB", "item": "https://fathersheartbible.com/the-fathers-heart-bible/" },
        { "@type": "ListItem", "position": 3, "name": "Leadership", "item": "https://fathersheartbible.com/the-fathers-heart-bible/leadership/" }
      ]}
    ]
  }}
>
  <main>

    <!-- ═══════════════════════════════════════════════════════════
         SECTION 1 — HERO
         ═══════════════════════════════════════════════════════════ -->
    <VideoHeroInner
      imageSrc="https://assets.spiritmediapublishing.com/FHB/print/leadership-hero.webp"
      href="/print/"
      heading="A forty-year journey to the Father's heart"
      subheading="Kevin and Shelly White lead Spirit Media Publishing, the publisher of the Father's Heart Bible™. Kevin led the translation. It was not born from novelty, but from a long journey through Scripture, ministry, longing, and awakening."
      primaryCtaLabel="Read FHB →"
      primaryCtaHref="/read/"
    />


    <!-- ═══════════════════════════════════════════════════════════
         SECTION 2 — KEVIN PORTRAIT
         ═══════════════════════════════════════════════════════════ -->
    <Section variant="soft">
      <!-- Photo beside the letter on desktop (it stays in view while the letter is read); stacked on phones -->
      <div class="max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] gap-0 lg:gap-14 items-start">
        <div class="max-w-sm mx-auto lg:mx-0 lg:sticky lg:top-28">
          <img
            src="https://cdn.sanity.io/images/rusi1hyi/production/1f2d78cb6ac852866c53878bd80ee44743595160-1264x1638.jpg?w=800&auto=format"
            alt="Kevin and Shelly White, leading the Father's Heart Bible™ (FHB) translation and partners in ministry"
            class="w-full"
            style="border: 1px solid var(--color-outline-variant);"
          />
          <p
            class="text-center mt-3 text-sm"
            style="font-family: var(--font-body); color: var(--color-muted);"
          >
            Kevin and Shelly White
          </p>
        </div>
        <!-- A Message from Kevin & Shelly — the letter from the Bible's front matter, word for word
             (Kevin 2026-10-13). Our Father's words are set in italics. -->
        <div class="max-w-2xl mx-auto lg:mx-0 mt-12 lg:mt-0">
          <p
            class="text-xs font-semibold tracking-widest uppercase mb-3 text-center lg:text-left"
            style="font-family: var(--font-sans); color: var(--color-gold);"
          >
            From the opening pages of the Father&rsquo;s Heart Bible&trade;
          </p>
          <h2
            class="text-3xl md:text-4xl font-light mb-8 text-center lg:text-left"
            style="font-family: var(--font-serif); color: var(--color-ink);"
          >
            A Message from Kevin &amp; Shelly
          </h2>
          <div class="space-y-4 text-lg" style="font-family: var(--font-body); color: var(--color-muted);">
            <p class="leading-relaxed">
              Before there was a translation, there was a question we could not put down. Every time we read the Bible
              we kept hearing our Father ask: <em style="color: var(--color-ink);">Where is my voice?</em> And we kept
              hearing Him say: <em style="color: var(--color-ink);">I want my voice heard.</em>
            </p>
            <p class="leading-relaxed">We did not set out to publish a Bible. We set out to answer that.</p>
            <p class="leading-relaxed">
              The translation had to come first &mdash; you cannot show someone our Father&rsquo;s voice in a text that
              keeps calling Him a distant God. That work took time. But the day we first saw His words set apart on the
              page, in His own color, we understood what He had been asking for the whole time.
              <em style="color: var(--color-ink);">Finally, they can hear my voice.</em>
            </p>
            <p class="leading-relaxed">
              That is what you are holding. Not a book about our Father. His voice, made visible, so you can know it
              when He speaks. Hearing His voice is imperative to receiving Him.
            </p>
            <p class="leading-relaxed">
              He has been speaking the whole time. We simply published it to where it could be heard.
            </p>
            <p class="leading-relaxed">Now you too can hear Him say:</p>
            <p class="leading-relaxed text-center text-xl" style="font-family: var(--font-serif); color: var(--color-ink);">
              <em>I give you me! I am your Father. You are my beloved. I delight in you.</em>
            </p>
            <p class="leading-relaxed">
              As priceless as His gifts of Jesus, the Holy Spirit, the forgiveness of sin, and eternal life are, knowing
              Him as Father is the greatest gift He can ever give to you.
            </p>
            <p class="leading-relaxed">Sharing Him as Father is the greatest legacy you will ever have.</p>
            <p class="leading-relaxed" style="color: var(--color-ink);">
              Welcome home,<br />
              <strong>Kevin and Shelly White</strong><br />
              Spirit Media Publishing
            </p>
          </div>
        </div>
      </div>
    </Section>


    <!-- ═══════════════════════════════════════════════════════════
         SECTION 3 — KEVIN'S STORY
         ═══════════════════════════════════════════════════════════ -->
    <Section variant="light">
      <div class="max-w-2xl mx-auto">
        <p
          class="text-xs font-semibold tracking-widest uppercase mb-4"
          style="font-family: var(--font-body); color: var(--color-primary);"
        >
          The Story
        </p>
        <h2
          class="text-3xl md:text-4xl font-light mb-8"
          style="font-family: var(--font-headline); color: var(--color-ink);"
        >
          From Servant to Son
        </h2>

        <div class="space-y-4" style="font-family: var(--font-body); color: var(--color-muted);">
          <p class="leading-relaxed">
            Kevin White is an author, speaker, and marketplace pastor who has invested his life in planting churches,
            leading nonprofits, starting companies, and developing leaders around the world. Married to his high school
            sweetheart, Shelly, for nearly forty years, they lead <a href="https://spiritmediapublishing.com" target="_blank" rel="noopener noreferrer" class="no-underline font-semibold transition-colors duration-200" style="color: var(--color-primary);">Spirit Media Publishing</a> and <a href="/" class="no-underline font-semibold transition-colors duration-200" style="color: var(--color-primary);">Father&rsquo;s Heart Bible&trade;</a> &mdash; empowering beloved sons and daughters worldwide with the Father&rsquo;s heart. Kevin and Shelly live in North Carolina with their family.
          </p>
          <p class="leading-relaxed">
            For over forty years, Kevin read the Bible faithfully. He loved Scripture, honored Jesus, and sought
            to walk with God. But through much of that journey, he related to God more as a servant to a master than
            as a beloved son to a Father.
          </p>
          <p class="leading-relaxed">
            That shift did not happen all at once. It came through revelation and prayer, and the growing realization
            that Jesus did not merely come to get people to heaven. He came to bring them to the Father.
          </p>
          <p class="leading-relaxed">
            Once that was seen, everything began to change. Passages that had long felt familiar began to open in new ways.
            Scripture no longer read primarily as a system of truth to master or a command to perform. It began to read
            like the story of a Father restoring His children to Himself.
          </p>
          <p class="leading-relaxed">
            The Father&rsquo;s Heart Bible was born out of that realization.
          </p>
        </div>
      </div>
    </Section>


    <!-- ═══════════════════════════════════════════════════════════
         SECTION 4 — WHY THIS BIBLE WAS BORN
         ═══════════════════════════════════════════════════════════ -->
    <Section variant="soft">
      <div class="max-w-2xl mx-auto">
        <p
          class="text-xs font-semibold tracking-widest uppercase mb-4"
          style="font-family: var(--font-body); color: var(--color-primary);"
        >
          The Vision
        </p>
        <h2
          class="text-3xl md:text-4xl font-light mb-8"
          style="font-family: var(--font-headline); color: var(--color-ink);"
        >
          Why This Bible Was Born
        </h2>

        <div class="space-y-4" style="font-family: var(--font-body); color: var(--color-muted);">
          <p class="leading-relaxed">
            Kevin finally opened his heart to become the beloved son of our perfect and loving Heavenly Father. Even as
            a Christian minister, he had lived as an orphan carrying around a Bible. Now, every day, he sits under the pour of our Heavenly Father&rsquo;s love.
          </p>
          <p class="leading-relaxed">
            Becoming a beloved son wrecked how he read the Bible. Every day he sensed our Father impressing upon him to
            replace &ldquo;God&rdquo; with &ldquo;Father,&rdquo; to hear His voice, and to experience His heart. This went
            on for months.
          </p>
          <p class="leading-relaxed">
            Then he sensed our Father wake him in the middle of the night three nights in a row. On the third
            night, he finally committed to translate the Father&rsquo;s Heart Bible. Instructions came faster than he
            could type &mdash; and the sense of urgency has increased every day since.
          </p>
          <p class="leading-relaxed">
            At its core, this is not a publishing project. It is a desire to help people know the Father — to discover
            that their identity is not servant, but son or daughter. That they are not working to be loved — they already are.
          </p>
        </div>
      </div>
    </Section>


    <!-- ═══════════════════════════════════════════════════════════
         SECTION 6 — SCRIPTURE
         ═══════════════════════════════════════════════════════════ -->
    <Section variant="scripture">
      <ScriptureBlock
        text='I will be a Father to you, and you will be sons and daughters to me, says our Father, the Almighty.'
        reference="2 Corinthians 6:18"
        translation="Father's Heart Bible™"
      />
    </Section>


    <!-- ═══════════════════════════════════════════════════════════
         SECTION 7 — THE ORGANIZATION
         ═══════════════════════════════════════════════════════════ -->
    <Section variant="light">
      <div class="max-w-2xl mx-auto">
        <p
          class="text-xs font-semibold tracking-widest uppercase mb-4"
          style="font-family: var(--font-body); color: var(--color-primary);"
        >
          The Work
        </p>
        <h2
          class="text-3xl md:text-4xl font-light mb-8"
          style="font-family: var(--font-headline); color: var(--color-ink);"
        >
          Published and Accountable
        </h2>

        <div class="space-y-4" style="font-family: var(--font-body); color: var(--color-muted);">
          <p class="leading-relaxed">
            Father's Heart Bible™ is published by Spirit Media Publishing.
          </p>
          <p class="leading-relaxed">
            Spirit Media Publishing is dedicated to creating resources that help people encounter our Father more
            deeply. The complete Bible — all 66 books — is in print, free to read and hear online, and published in
            dozens of languages.
          </p>
          <p class="leading-relaxed">
            The work is careful and accountable. It stands within historic, Trinitarian Christian belief, alongside the
            church&rsquo;s other faithful translations. Each edition carries a version number, and corrections are
            published as the text is refined.
            <a href="/the-fathers-heart-bible/" style="color: var(--color-primary);" class="font-semibold no-underline">About the translation &rarr;</a>
          </p>
        </div>
      </div>
    </Section>


    <!-- ═══════════════════════════════════════════════════════════
         SECTION 9 — CTA
         ═══════════════════════════════════════════════════════════ -->
    <CTASection
      headline="The Father's heart has always been toward you."
      body="Read or listen to the whole Bible free — or hold it in print."
      primaryLabel="Read FHB →"
      primaryHref="/read/"
      secondaryLabel="Join the FH Family"
      secondaryHref="https://fathersheartbible.com/login?error=join-to-interact"
      dark={true}
    />


    <!-- ═══════════════════════════════════════════════════════════
         SECTION 10 — IMAGE GRID
         ═══════════════════════════════════════════════════════════ -->
    <Section variant="light">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <a href="/print/" class="block" style="text-decoration:none">
						<img src="https://assets.spiritmediapublishing.com/FHB/print/people-1.webp" alt="A woman reading the Father's Heart Bible by a sunlit window" width="800" height="800" loading="lazy" decoding="async" class="w-full aspect-square object-cover" /></a>
        <a href="/print/" class="block" style="text-decoration:none">
						<img src="https://assets.spiritmediapublishing.com/FHB/print/people-2.webp" alt="A father and son reading the Father's Heart Bible together" width="800" height="800" loading="lazy" decoding="async" class="w-full aspect-square object-cover" /></a>
        <a href="/print/" class="block" style="text-decoration:none">
						<img src="https://assets.spiritmediapublishing.com/FHB/print/people-3.webp" alt="A grandmother and granddaughter reading the Father's Heart Bible" width="800" height="800" loading="lazy" decoding="async" class="w-full aspect-square object-cover" /></a>
      </div>
    </Section>

  </main>
</Layout>
