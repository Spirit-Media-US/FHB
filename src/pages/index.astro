							alt="Three friends on a city rooftop at dusk, reading the Divine Voice Color edition of the Father's Heart Bible together"
							class="w-full aspect-[3/2] object-cover"
							loading="lazy"
							decoding="async"
							width="1200"
							height="800"
						/></a>
					)}
					{photo3 && (
						<a href="/print/" class="block" style="text-decoration:none">
						<img
							src={photo3}
							alt="Three college students on campus, smiling at each other and holding the Teen, Chosen and Peace editions of the Father's Heart Bible"
							class="w-full aspect-[3/2] object-cover"
							loading="lazy"
							decoding="async"
							width="1200"
							height="800"
