---
import CoverMarquee from '../components/CoverMarquee.astro';
import ImageGrid from '../components/ImageGrid.astro';
import ScriptureBlock from '../components/ScriptureBlock.astro';
import Section from '../components/Section.astro';
import Layout from '../layouts/Layout.astro';
import { sanityClient, urlFor } from '../lib/sanity';

// Language list for the Organization JSON-LD `knowsLanguage` below — same
// source as /glossary-review/ so the two can never drift. (The homepage
// reviewer-invitation band that also rendered it was removed, Kevin 2026-09-24.)
const glossaryModules = import.meta.glob('../data/glossary-review/*.json', { eager: true });
const reviewLangs = Object.entries(glossaryModules)
	.map(([path, m]: [string, any]) => ({
		code:
			path
				.split('/')
				.pop()
				?.replace(/\.json$/, '') ?? '',
		language: (m as any).default?.language ?? '',
		endonym: (m as any).default?.endonym ?? '',
	}))
	.sort((a, b) => a.language.localeCompare(b.language));

// Fetch page content + media from Sanity (all values have hardcoded fallbacks)
const [pageData, media, biblePageData] = await Promise.all([
	sanityClient.fetch(`*[_type =="page" && slug =="home"][0] {
    seoTitle, seoDescription,
    heroHeading, heroSubheading,
    heroPrimaryCtaLabel, heroPrimaryCtaHref,
    heroSecondaryCtaLabel, heroSecondaryCtaHref
  }`),
	sanityClient.fetch(`*[_type =="siteSettings"][0] {
    heroVideoUrl, heroPosterUrl, bookCoverUrl, bibleCoverImage,
    fhbCoverImage,
    homePageHeroVideos,
    peoplePhoto1Url, peoplePhoto2Url, peoplePhoto3Url,
    communityUrl,
    logo
  }`),
	sanityClient.fetch(`*[_type =="biblePageContent"][0] { audience }`),
]);

// "Is This For You?" audience list — shared with /the-fathers-heart-bible,
// same Sanity source + fallback so both pages stay in sync.
const audience = biblePageData?.audience ?? [
	'You have read Scripture for years and sense something is still missing.',
	'You long for deeper intimacy with God, not just more knowledge about Him.',
	'You are awakening to your identity as a beloved child of the Father.',
	'You want to hear His voice — not just His instructions.',
	'You are hungry for a Bible that feels like an encounter, not a document.',
	"You want to give someone a Bible that reveals the Father's love clearly.",
];

// Generic-first per the SEO strategy (Part 3): lead with the high-volume
// "Read the Bible Free Online with Audio" phrase so the home surfaces for
// everyday Bible searches, brand second. NOTE: the LIVE value comes from
// Sanity (pageData.seoTitle) when set — update it there to match.
const seoTitle =
	pageData?.seoTitle || "Read the Bible Free Online with Audio — Father's Heart Bible™ (FHB)";
const seoDescription =
	pageData?.seoDescription ||
	"Read the Bible free online with verse-by-verse audio — the Father's Heart Bible™ (FHB) reveals God as a loving Father. Now being prepared in 24 world languages. No app, no account.";
// Hero copy retired from the photo 2026-09-24 (Kevin: no title or text on the
// hero image). heroSubheading still feeds the intro section below.
const heroSubheading =
	'The complete Father\u2019s Heart Bible\u2122 \u2014 Genesis to Revelation \u2014 is free to read online, with verse-by-verse audio.';
// The hero/section "Read FHB →" CTAs were removed (2026-06-02) — the nav now
// carries the Read FHB entry point. The Free Book + Join/Partner CTAs remain.
const heroVideoSrc =
	media?.heroVideoUrl ||
	'https://assets.spiritmediapublishing.com/fathers-heart-bible/woman-holding-bible-sky.mp4';
// Hero poster → R2 (v4 Phase 2C). Base64 inlining removed (11KB HTML bloat +
// 2.3s emulated CPU decode delay on Lighthouse mobile). R2 URLs preloaded via
// fetchpriority=high in Layout.astro, promoted to HTTP/2 103 Early Hints by
// CF Pages via _headers Link: directive. Sanity hero fields ignored here.
// A03 (Kevin 2026-09-24), 2400x920. Phones/tablets <1024 get 960w, desktop 1920w;
// 1600/2400 are also on R2. hero-print2-* stay on R2 for a cheap revert.
const heroMobile = 'https://assets.spiritmediapublishing.com/FHB/hero-a03-960.webp';
const heroDesktop = 'https://assets.spiritmediapublishing.com/FHB/hero-a03-1920.webp';

// Helper — append Sanity CDN transforms to any cdn.sanity.io URL safely
function sanityTransform(url: string, w: number, q = 75): string {
	if (!url) return url;
	if (!url.includes('cdn.sanity.io')) return url;
	const base = url.split('?')[0];
	return `${base}?w=${w}&fm=webp&q=${q}&auto=format`;
}

// Bible cover — prefer Sanity image, fall back to hardcoded (both go through webp transform).
// Responsive widths: mobile=512 (w-64 at DPR2), tablet=640 (w-80 at DPR2).
// The Sanity asset is an RGBA PNG with transparent corners (Photoshop-style
// transparency-indicator checkerboard removed 2026-05-29). Sanity preserves
// the alpha channel through WebP, so the parent section background shows
// through naturally — no .bg() needed, no edge mismatch.
const bibleCoverImageFromSanity = media?.bibleCoverImage;
// Print-edition portrait (D001, Kevin 2026-09-24). Hardcoded to the R2 asset on purpose — this
// slot now shows the print photo regardless of the Sanity bibleCoverImage field.
const bookCoverUrl = 'https://assets.spiritmediapublishing.com/FHB/print/portrait-d001-512.webp';
const bookCoverUrl640 = 'https://assets.spiritmediapublishing.com/FHB/print/portrait-d001-640.webp';
const bookCoverSrcset = `${bookCoverUrl} 512w, ${bookCoverUrl640} 640w`;
const bookCoverSizes = '(max-width: 767px) 256px, 320px';

// FHB → Beloved Identity cover — prefer Sanity image, fall back to hardcoded.
// The Sanity asset is a true RGBA PNG with alpha=0 corners, so Sanity
// preserves the alpha through WebP and the section background shows
// through naturally — no .bg() needed.
const fhbCoverSanity = media?.fhbCoverImage;
const fhbiCoverUrl = fhbCoverSanity
	? urlFor(fhbCoverSanity).width(576).format('webp').quality(75).auto('format').url()
	: sanityTransform(
			'https://cdn.sanity.io/images/rusi1hyi/production/7af29ed50a183320765567ec9cd1e9de2bb218a5-724x1122.png',
			576,
		);

// Hero video array — prefer Sanity, fall back to hardcoded
const heroVideosFromSanity = media?.homePageHeroVideos;
// People + FHB print photos (hardcoded to R2 — this band now shows the print
// edition in real hands regardless of the Sanity peoplePhoto fields).
const photo1 = 'https://assets.spiritmediapublishing.com/FHB/print/people-ds005-1200.webp';
const photo2 = 'https://assets.spiritmediapublishing.com/FHB/print/people-d010-1200.webp';
const photo3 = 'https://assets.spiritmediapublishing.com/FHB/print/people-ds004-1200.webp';
const communityUrl = media?.communityUrl || '/join';
const heroLogoUrl = media?.logo ? urlFor(media.logo).width(160).url() : null;
---

<Layout
	youtube
	title={seoTitle}
	description={seoDescription}
	image="https://assets.spiritmediapublishing.com/FHB/share/v3/fhb-og-home.jpg"
	imageAlt="Father's Heart Bible — Encounter God as Your Father"
	darkHero={true}
	preloadImageMobile={heroMobile}
	preloadImageDesktop={heroDesktop}
	jsonLd={{
		"@context": "https://schema.org",
		"@graph": [
			{
				"@type": "Organization",
				"@id": "https://fathersheartbible.com/#organization",
				"name": "Father's Heart Bible",
				"url": "https://fathersheartbible.com",
				"logo": "https://fathersheartbible.com/fhb-logo.png",
				// Publisher/imprint is Spirit Media Publishing; Spirit Media Inc. is its PARENT
				// (Metadata & Messaging Guidelines, Publication facts). Reference the canonical
				// @id that Layout.astro already emits on this page — the previous inline copy
				// named the parent and carried no @id, creating a second, unlinked publisher
				// entity on the same page that engines could not merge.
				"publisher": { "@id": "https://spiritmediapublishing.com/#organization" },
				"description": "A new Bible translation revealing God as Father where Scripture reveals Him — published in English and being prepared in 24 world languages, from Spanish and Hindi to Swahili and Mandarin.",
				"knowsLanguage": ["en", ...reviewLangs.map((l) => l.code)]
			},
			{
				"@type": "WebSite",
				"@id": "https://fathersheartbible.com/#website",
				"url": "https://fathersheartbible.com",
				"name": "Father's Heart Bible",
				"publisher": { "@id": "https://fathersheartbible.com/#organization" }
			},
			{
				"@type": "WebPage",
				"@id": "https://fathersheartbible.com/",
				"url": "https://fathersheartbible.com/",
				"name": seoTitle,
				"description": seoDescription,
				"isPartOf": { "@id": "https://fathersheartbible.com/#website" },
				"about": { "@id": "https://fathersheartbible.com/#organization" }
			}
		]
	}}
>
	<main>

		<!-- ═══════════════════════════════════════════════════════════
		     HERO — A03, the photo alone (Kevin 2026-09-24: no title or text on it).
		     A03 was made to the band's own 2400x920 ratio, so the section takes the
		     image's aspect ratio at every width: edge to edge, nothing cropped, every
		     head whole, no vh. Phones get the same whole photo (the /print ruling).
		     One LCP image; each breakpoint preloads the file it serves (Layout).
		     The header is FIXED + transparent over this page (darkHero), so the photo
		     starts below it: over the image, the nav sat on back-row heads at 1024 and
		     the logo at 390. Padding = measured header height per breakpoint (72 /
		     91.5 at 1024-1279 where the nav wraps / 74.75); re-measure if the header changes.
		     ═══════════════════════════════════════════════════════════ -->
		<style is:inline>
			#hero-section { padding-top: 72px; }
			@media (min-width: 1024px) { #hero-section { padding-top: 92px; } }
			@media (min-width: 1280px) { #hero-section { padding-top: 75px; } }
		</style>
		<section id="hero-section" style="background-color: var(--color-deep); margin-top: -1px; line-height: 0;">
			<h1 style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;">Father&rsquo;s Heart Bible&trade; &mdash; Now in Print</h1>
			<picture>
				<source media="(min-width: 1024px)" srcset={heroDesktop} width="1920" height="736" />
				<img
					id="hero-poster"
					src={heroMobile}
					alt="Thirteen friends outside a stone church, each holding a different edition of the Father’s Heart Bible"
					width="960"
					height="368"
					fetchpriority="high"
					decoding="async"
					style="display:block;width:100%;height:auto;aspect-ratio:2400/920;"
				/>
			</picture>
		</section>

		<!-- ═══════════════════════════════════════════════════════════
		     COVER MARQUEE — title + scrolling covers + FATHER|SON|SPIRIT + tagline.
		     Kevin 2026-09-24 placed this DIRECTLY BELOW THE FOLD (not above it), so
		     the hero above keeps the LCP and the PSI score. First thing on scroll.
		     ═══════════════════════════════════════════════════════════ -->
		<CoverMarquee />

		<!-- intro + CTAs — Kevin 2026-09-24: the FHB back-cover copy, verbatim,
		     minus its closing tagline. The three colour words use the VoiceChips
		     palette. Then the two original buttons, then the tagline as the section's
		     closing line (Kevin 2026-09-24: below the buttons; it appears ONCE).
		     Rhythm with CoverMarquee: 2rem between every part, 1rem between
		     paragraphs, 3rem / 4rem (lg) clear space above and below the group.
		     Ported from the SMP homepage 2026-09-24. SMP's type-body-lg / btn classes
		     don't exist here, so it wears this page's own body-copy and CTA styles.
		     The tagline is NOT repeated here: this site's CoverMarquee still renders
		     it, and it must appear once (pending Kevin's call on where it lives). -->
		<div class="mx-auto max-w-3xl text-center px-6 pt-8 pb-12 lg:pb-16">
			<p class="text-xl leading-relaxed" style="font-family: var(--font-body); color: var(--color-muted);">For a hundred and twenty-five years, red letters have shown you the Son speaking. Our Father speaks more than three times as often — 128,579 words across 5,615 verses. Father's Heart Bible is the first Bible in print where you can see who is speaking.</p>
			<p class="mt-4 text-xl leading-relaxed" style="font-family: var(--font-body); color: var(--color-muted);">Our Father's words in <strong style="color:#2563eb">BLUE</strong>. The Son's in <strong style="color:#c8102e">RED</strong>. The Spirit's in <strong style="color:#6a3fa0">PURPLE</strong>.</p>
			<p class="mt-4 text-xl leading-relaxed" style="font-family: var(--font-body); color: var(--color-muted);">More than one word in four of the Bible is a divine voice speaking. This is not a study Bible about our Father. It is His voice, made visible, so you can hear it.</p>
			<div class="mt-8 flex flex-wrap justify-center gap-4">
				<a
					href="/print"
					class="inline-flex items-center px-8 py-3.5 text-base font-semibold no-underline transition-all duration-200"
					style="font-family: var(--font-sans); background-color: #FFD9E0; color: #4A4A4A; border: 1px solid #FFD9E0;"
					onmouseover="this.style.opacity='0.9'"
					onmouseout="this.style.opacity='1'"
				>Get It in Print</a>
				<a
					href="/read"
					class="inline-flex items-center px-8 py-3.5 text-base font-semibold no-underline transition-all duration-200"
					style="font-family: var(--font-sans); background-color: transparent; color: #4A4A4A; border: 1px solid #4A4A4A;"
					onmouseover="this.style.opacity='0.8'"
					onmouseout="this.style.opacity='1'"
				>Read &amp; Listen Free</a>
			</div>
		</div>

		<!-- ═══════════════════════════════════════════════════════════
		     DESKTOP HERO SUBTEXT — appears below the desktop hero only
		     (mobile subtitle + CTAs already rendered in the mobile hero above)
		     ═══════════════════════════════════════════════════════════ -->
		{/* Critical above-fold layout for the intro section. These dimensions
		    otherwise come from the DEFERRED Tailwind stylesheet (we can't use a
		    critical-CSS extractor — Beasties is incompatible with Tailwind v4),
		    so without this the section paints as a full-width stack then snaps to
		    the 2-col grid (+ facade resize) when the deferred CSS lands (~165ms) =
		    ~0.15 CLS. Values mirror the Tailwind classes exactly, so applying the
		    deferred copy is a no-op (no shift). */}
		<style is:inline>
			#home-intro { padding: 2.5rem 1.5rem; }
			#home-intro-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2rem; align-items: center; max-width: 64rem; margin-left: auto; margin-right: auto; }
			#home-intro-copy { order: 2; }
			#home-intro-video { order: 1; }
			#home-intro-cta { display: flex; }
			#fhb-video-facade { display: block; width: 100%; }
			@media (min-width: 768px) { #home-intro { padding: 3.5rem 1.5rem; } }
			@media (min-width: 1024px) {
				#home-intro-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 3rem; }
				#home-intro-copy { order: 1; }
				#home-intro-video { order: 2; }
				#home-intro-cta { display: inline-flex; }
			}
		</style>
		<section id="home-intro" style="background-color: var(--color-canvas);" class="py-10 md:py-14 px-6">
			<div id="home-intro-grid" class="max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center">
				<!-- Copy (left on desktop; on mobile it sits BELOW the video via order). -->
				<div id="home-intro-copy" class="order-2 lg:order-1">
					<h2
						class="text-3xl font-medium leading-snug tracking-tight mb-4"
						style="font-family: var(--font-headline); color: var(--color-ink);"
					>
						It&rsquo;s here &mdash; the Father&rsquo;s Heart Bible&trade; is live
					</h2>
					<p
						class="text-xl leading-relaxed"
						style="font-family: var(--font-body); color: var(--color-muted);"
					>
						{heroSubheading}
					</p>
					<a
						href="/read"
						id="home-intro-cta"
						class="flex lg:inline-flex w-fit mx-auto lg:mx-0 items-center justify-center mt-6 px-8 py-3.5 text-base font-semibold no-underline transition-all duration-200"
						style="font-family: var(--font-sans); background-color: #FFD9E0; color: #4A4A4A;"
						onmouseover="this.style.opacity='0.9'"
						onmouseout="this.style.opacity='1'"
					>
						Read FHB &rarr;
					</a>
				</div>
				<!-- Video (right on desktop; on mobile it sits ABOVE the copy via order).
				     One click-to-load facade for ALL viewports (unified 2026-06-13 to
				     keep YouTube's JS off the initial load everywhere — it was the
				     intermittent mobile TBT/LCP spike). Desktop: one click autoplays.
				     Mobile: tap loads the player, then YouTube's own play button. -->
				<div id="home-intro-video" class="order-1 lg:order-2">
					<button
						type="button"
						id="fhb-video-facade"
						class="group relative block w-full overflow-hidden rounded-xl shadow-lg"
						style="aspect-ratio: 16 / 9; border: 1px solid var(--color-hairline);"
						aria-label="Play the Father's Heart Bible invitation video"
						data-video-id="Ld4_H5XxrLk"
					>
						<img
							src="https://assets.spiritmediapublishing.com/FHB/home-video-poster.webp"
							alt="An invitation to read the Father's Heart Bible (FHB)"
							width="640"
							height="360"
							loading="eager"
							fetchpriority="high"
							class="absolute inset-0 w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
						/>
						<span aria-hidden="true" class="absolute inset-0" style="background: rgba(36,27,23,0.12);"></span>
						<span
							aria-hidden="true"
							class="absolute left-1/2 top-1/2 flex items-center justify-center rounded-full transition-all duration-300 group-hover:scale-110"
							style="width: 4.5rem; height: 4.5rem; transform: translate(-50%,-50%); background: rgba(255,255,255,0.92); border: 2px solid #FFFFFF; box-shadow: 0 4px 18px rgba(0,0,0,0.4);"
						>
							<svg width="26" height="26" viewBox="0 0 24 24" fill="var(--color-brand)" style="margin-left: 3px;"><path d="M8 5v14l11-7z"/></svg>
						</span>
					</button>
				</div>
			</div>
		</section>

		<script is:inline>
			// Lazy YouTube facade — swap the poster button for an autoplaying
			// iframe only when the user clicks. Keeps third-party JS off the
			// initial load so the homepage perf score is untouched.
			(() => {
				const btn = document.getElementById('fhb-video-facade');
				if (!btn) return;
				btn.addEventListener('click', () => {
					const id = btn.dataset.videoId;
					const iframe = document.createElement('iframe');
					iframe.style.cssText = 'display:block;width:100%;aspect-ratio:16/9;height:auto;border:0;border-radius:0.75rem;';
					iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
					iframe.allowFullscreen = true;
					iframe.title = "Father's Heart Bible™ invitation";
					iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
					btn.replaceWith(iframe);
				}, { once: true });
			})();
		</script>

		<script define:vars={{ heroVideosFromSanity }} is:inline>
			// Mobile bail-out — desktop-only video carousel. On mobile, the
			// hero section is display:none (`hidden lg:flex`), so allocating
			// the heroVideos array, doing 3 getElementById lookups, and
			// defining applyTheme/mkVideo/startVideos closures is all wasted
			// CPU. Bail before any of that.
			if (!window.matchMedia('(min-width: 1024px)').matches) { /* mobile no-op */ } else {
			// Hero videos from Sanity (or hardcoded fallback)
			const R2 = 'https://assets.spiritmediapublishing.com/fathers-heart-bible';
			const heroVideos = heroVideosFromSanity || [
				// Curated loop (all MP4/H.264 — Chrome rejects .mov/quicktime in <video>).
				// Initial video set to index 0 via Sanity heroVideoUrl so the loop is seamless.
				{ url: `${R2}/man-reading-on-couch.mp4`, theme: 'light' },
				{ url: `${R2}/friends-reading-on-beach-sunset.mp4`, theme: 'light' },
				{ url: `${R2}/reading-on-pier.mp4`, theme: 'light' },
				{ url: `${R2}/woman-reads-under-tree.mp4`, theme: 'light' },
			];

			function applyTheme(theme) {
				// Title stays neon pink on all video backgrounds

			}

			const poster = document.getElementById('hero-poster');
			const slot = document.getElementById('hero-video-slot');
			const heroSection = document.getElementById('hero-section');
			const dataHeroSrc = slot ? slot.dataset.heroSrc : '';
			if (slot && heroSection) {
				const PLAYBACK_RATE = 0.75;
				const FADE_DURATION = 1500;
				const CLIP_DURATION = 7000; // each clip shows 7s, then crossfade to the next; repeat
				const VIDEO_STYLE = 'position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:opacity 1.5s ease;opacity:0';

				let heroIdx = 0;
				let vA = null, vB = null;
				let curr = null, next = null;
				let fading = false;
				let started = false;

				function mkVideo(initialSrc) {
					const v = document.createElement('video');
					v.muted = true;
					v.playsInline = true;
					v.loop = true;
					v.preload = 'none';
					v.setAttribute('aria-hidden', 'true');
					v.style.cssText = VIDEO_STYLE;
					if (initialSrc) v.src = initialSrc;
					return v;
				}

				function startVideos() {
					if (started) return;
					started = true;
					vA = mkVideo(dataHeroSrc || heroVideos[0].url);
					vB = mkVideo('');
					heroSection.insertBefore(vA, slot);
					heroSection.insertBefore(vB, slot);
					slot.remove();
					curr = vA; next = vB;
					vA.load();
					vA.playbackRate = PLAYBACK_RATE;
					vA.play().then(() => {
						vA.style.opacity = '1';
						// Fully retire the poster so it can never reappear over the loop.
						if (poster) { setTimeout(() => { poster.style.opacity = '0'; }, 300); setTimeout(() => poster.remove(), 2000); }
						next.src = heroVideos[1].url;
						next.load();
						// Fixed 7s-per-clip rotation, then repeats through the array.
						setInterval(beginCrossfade, CLIP_DURATION);
						// Resilience: if the visible clip ever pauses (power-saving, tab
						// blur, stall), resume it so the hero never freezes on a still frame.
						setInterval(() => { if (curr && curr.paused && !fading) curr.play().catch(() => {}); }, 1000);
						document.addEventListener('visibilitychange', () => {
							if (!document.hidden && curr && !fading) curr.play().catch(() => {});
						});
					}).catch(() => { /* autoplay blocked — poster remains */ });
				}

				const triggers = ['scroll', 'pointerdown', 'keydown', 'touchstart', 'mousemove'];
				function kickoff() {
					triggers.forEach(e => window.removeEventListener(e, kickoff));
					startVideos();
				}
				triggers.forEach(e => window.addEventListener(e, kickoff, { once: true, passive: true }));
				setTimeout(() => { if (!started) startVideos(); }, 10000);
					// Returning via back/forward (bfcache restore): resume/restart the loop
					// instead of leaving the still poster showing.
					window.addEventListener('pageshow', (e) => {
						if (!e.persisted) return;
						if (!started) startVideos();
						else if (curr && curr.paused && !fading) curr.play().catch(() => {});
					});

				function beginCrossfade() {
					if (fading) return;
					fading = true;
					heroIdx = (heroIdx + 1) % heroVideos.length;
					applyTheme(heroVideos[heroIdx].theme);
					next.play().then(() => {
						next.playbackRate = PLAYBACK_RATE;
						next.style.opacity = '1';
						curr.style.opacity = '0';
						const outgoing = curr;
						curr = next;
						next = outgoing;
						setTimeout(() => {
							next.pause();
							next.currentTime = 0;
							const preloadIdx = (heroIdx + 1) % heroVideos.length;
							next.src = heroVideos[preloadIdx].url;
							next.load();
							fading = false;
						}, FADE_DURATION + 200);
					}).catch(() => {
						curr.currentTime = 0;
						curr.play();
						fading = false;
					});
				}
			}
			} // end mobile-bail-out else
		</script>

