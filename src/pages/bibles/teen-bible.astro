// color the COLOUR WORDS, not the sentence around them (Kevin 2026-08-23). The claim is
// "our Father's words in BLUE" — so BLUE is what should be blue. coloring the whole line
// makes it decoration; coloring the one word makes it a demonstration. Applied to every
// paragraph, so it works for the standalone lines and for the sentence that runs them
// together mid-prose.
const COLOUR_WORD: Record<string, string> = {
	BLUE: VOICE.father,
	RED: VOICE.son,
	PURPLE: VOICE.spirit,
};
function colorWords(text: string): string {
	return text.replace(
		/\b(BLUE|RED|PURPLE)\b/g,
		(w) => `<span style="color:${COLOUR_WORD[w]};font-weight:800;">${w}</span>`,
	);
}

