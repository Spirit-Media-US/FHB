---
import Section from '../../components/Section.astro';
// /bibles/teen-bible — PRODUCT page for one Divine Voice Color edition.
//
// Why this exists alongside /bible-for/teenagers: that page answers a PASTORAL search
// ("bible verses for teenagers") and this one answers a PURCHASE search ("teen bible",
// "confirmation gift bible"). They target different intent and link to each other rather
// than competing for the same query.
//
// Every fact here — ISBN, price, page count, BISAC, keywords, descriptions — is lifted from
// the edition's Drive metadata sheet, the same source the Ingram listing uses, so the site
// and the trade record cannot drift apart. This is the template for the other fifteen.
import Layout from '../../layouts/Layout.astro';

const ASSETS = 'https://assets.spiritmediapublishing.com/FHB/print';
const READ_URL = 'https://fathersheartbible.com/read';
const SITE = 'https://fathersheartbible.com';

const ed = {
	slug: 'teen',
	name: 'Teen Bible',
	title: 'Father’s Heart Bible — Teen Bible',
	audience: 'For Teens, Teenagers, Youth Group, Confirmation, and Graduation Gifts, Ages 13-19',
	isbn: '979-8-89307-326-3',
	price: 99.99,
	pages: 876,
	trim: '6 x 9 in',
	binding: 'Hardcover, case laminate',
	published: '2026-09-01',
	bisac: [
		'BIB018070 — BIBLES / Other English Translations / Youth & Teen',
		'BIB018000 — BIBLES / Other English Translations / General',
		'REL012070 — RELIGION / Christian Living / Personal Growth',
	],
	keywords: [
		'bible for teens',
		'teen bible',
		'bible for teenage boys',
		'bible for teenage girls',
		'youth group bible',
		'confirmation gift bible',
		'graduation gift bible',
		'color coded bible',
		'three color bible',
		'red letter blue letter purple letter',
	],
};

// The verse that carries this edition's opening page — a teenager our Father spoke to
// before He spoke to the priest.
const verse = {
	ref: '1 Samuel 3:10',
	href: '/read/1-samuel/3#v10',
	text: 'Then our Father came, stood there, and called as before: “Samuel! Samuel!” Samuel said, “Speak, for your servant is listening.”',
	father: ['“Samuel! Samuel!”'],
};

const VOICE = { father: '#3563ae', son: '#f04933', spirit: '#91278f' };
function mark(text: string, spans: string[], colour: string): string {
	let out = text;
	for (const s of spans)
		if (s && out.includes(s))
			out = out.replace(s, `<span style="color:${colour};font-weight:600;">${s}</span>`);
	return out;
}

const listing = {
	sections: [
		{
			h: 'Receive The Father. Hear His Voice. His Heart Is For You.',
			body: [
				'You have wanted a Father your whole life. Not a doctrine about Him. Not a distant power. A Father, His voice, His heart turned toward you.',
				"Father's Heart Bible is a fresh translation from the original Hebrew, Aramaic, and Greek that lets you hear God as He truly is, not a distant deity but your Father. And for the first time in print, you can see which words are His.",
				'For a hundred and twenty-five years, red letters have shown the Son speaking. Our Father speaks more than three times as often, and every one of those words has been printed in the same black ink as the genealogies. He has been speaking the whole time.',
			],
		},
		{
			h: 'See Who Is Speaking',
			body: [
				"Our Father's words in BLUE",
				"The Son's words in RED",
				"The Spirit's words in PURPLE",
				'Not verses about Him, but the words He actually spoke. The color is a mark of ownership, not of quotation. His words stay His on any lips that carry them faithfully, and words He never spoke are never colored.',
				'Our Father speaks 125,457 words here, across 5,623 verses. The Son speaks 39,936. More than one word in four of this Bible is a divine person speaking.',
			],
		},
		{
			h: 'He Called The Kid By Name',
			body: [
				'Samuel was still a boy when our Father called his name in the night, three times, before he knew who was speaking. Our Father went to the kid, not the priest, and He said the name He already knew.',
				'That is what this Bible was made to do. Not to tell you about a Father who speaks, but to show you where He already has.',
			],
		},
		{
			h: 'Father Is His Name',
			body: [
				'God is our Father. Not a role He plays. Father is who He is, and Father is His name, the name Jesus came to reveal: "I revealed your name to those you gave me from the world" (John 17:6).',
				'Notice who, in Scripture, speaks of Him only as a distant deity and never as Father: the serpent in Eden, Pharaoh, the accusers in Job, the tempter in the wilderness. This translation lets the Hebrew and Greek speak the distinction they always made, between a deity to be appeased and a Father to be received.',
				'If the word father is not a word of comfort for you, this Bible is especially for you. The Father revealed in these pages is not a projection of broken human fatherhood. He is the original, the Father from whom every family in heaven and on earth takes its name.',
				'You are His beloved child, and He delights in you.',
			],
		},
	],
	features: [
		'Opening pages on Intimacy, Identity, Inheritance, and Hearing His Voice',
		'An introduction to each of the 66 books',
		"A Father's note closing every book, with a short prayer",
		'1,354 study notes, including 31 on manuscript differences',
		'6 x 9 hardcover with dust jacket, full color throughout',
		'A presentation page for their name',
	],
	about: [
		'It is an interpretive translation with a stated emphasis: the revelation of God as Father. It is not a paraphrase. Its Old Testament readings are weighed against the Masoretic Hebrew and its New Testament follows the modern critical text. Complete: 66 books, 1,189 chapters, 31,085 verses. Governed by 170 written translation rules.',
		"Father's Heart Bible was created by Spirit Media Publishing, with Kevin White leading the translation and publishing process, bringing modern AI language tools to the ancient task of translation under human-authored rules and careful human review. It holds the church's other faithful translations in genuine honor.",
		'Receive the Father. Hear His voice. His heart is for you.',
	],
	short350: [
		'You have wanted a Father your whole life. Not a doctrine about Him. Not a distant power. A Father — His voice, His heart turned toward you.',
		"Father's Heart Bible is the first Bible in print where you can see who is speaking.",
		"Our Father's words in BLUE. The Son's in RED. The Spirit's in PURPLE.",
		'For a hundred and twenty-five years, red letters have shown the Son speaking. Our Father speaks more than three times as often — 125,457 words across 5,623 verses — and every one of them has been printed in the same black ink as the genealogies. More than one word in four of the Bible is a divine person speaking. The color marks ownership, not quotation: His words stay His on any lips that carry them faithfully, words He never spoke are never colored, and narration stays black.',
		'Samuel was still a boy when our Father called his name in the night, three times, before he knew who was speaking. Our Father went to the kid, not the priest, and He said the name He already knew.',
		'That is what this Bible was made to do. Not to tell you about a Father who speaks, but to show you where He already has.',
		'He is not distant. He is not disappointed. He is your Heavenly Father, and He delights in you as His beloved child. If father is not a word of comfort for you, this Bible is especially for you: the Father revealed here is no projection of broken human fatherhood, but the original, from whom every family in heaven and on earth takes its name.',
		"An introduction opens each book, a Father's note closes each with a short prayer, and 1,354 notes serve the reader, not the scholar. A presentation page carries their name. Six by nine, hardcover, full color throughout.",
		'A fresh translation from the original Hebrew, Aramaic, and Greek — complete, 66 books and 31,085 verses. A gift, a keepsake, an heirloom.',
		'Receive the Father. Hear His voice. His heart is for you.',
	],
	keywords: [
		'bible for teens',
		'bible for teenage girls',
		'teen bible',
		'bible for teenage boys',
		'youth group bible',
		'confirmation gift bible',
		'color coded bible',
		'color coded study bible',
		'divine voice color bible',
		'hardcover bible for teens',
		'single volume complete bible',
		'red letter bible',
		'devotional bible',
		'daily bible reading',
		'god as father',
		'abba father',
		'heavenly father',
		'child of god',
		'identity in christ',
		'intimacy with god',
		'first bible of my own',
		'three color bible',
		'red letter blue letter purple letter',
		'purple letter bible',
	],
	bisac: [
		'BIB018070  BIBLES / Other English Translations / Youth & Teen',
		'BIB018000  BIBLES / Other English Translations / General',
		'REL012070  RELIGION / Christian Living / Personal Growth',
	],
	publisher:
		"Spirit Media Publishing is a Christian publishing and marketing company with a vision to reveal our Father's heart to all nations. Born from holy conviction and built for global impact, Spirit Media Publishing offers full-service book creation and publishing in paperback, hardback, digital, and audiobook formats, along with children's titles, compact Express Books, website design and SEO, and podcast and video production. Spirit Media Publishing is honored to share Father's Heart Bible: An Intimate Translation — a fresh translation from the original Hebrew, Aramaic, and Greek crafted so readers can encounter God as He truly is: their Father.",
	bio: "Kevin White himself is a beloved son, husband, and father. He is an international best selling author, speaker, and marketplace pastor with decades of experience planting churches, leading nonprofits, starting companies, and developing leaders around the world. Kevin and Shelly, his high school sweetheart and partner in marriage and mission for nearly forty years, co-founded Spirit Media Publishing and are devoted to empowering beloved sons and daughters in revealing our Father's heart to the nations. Kevin and Shelly live in North Carolina with their family.",
};

// The three colour lines in the long description are the product claim; rendering them in
// black states the claim while contradicting it. Colour them in their own voice.
const VOICE_LINE: Record<string, string> = {
	'Our Father’s words in BLUE': VOICE.father,
	"Our Father's words in BLUE": VOICE.father,
	'The Son’s words in RED': VOICE.son,
	"The Son's words in RED": VOICE.son,
	'The Spirit’s words in PURPLE': VOICE.spirit,
	"The Spirit's words in PURPLE": VOICE.spirit,
};

const faq = [
	{
		q: 'What makes the Teen Bible different from the other editions?',
		a: 'Nothing in the text. Every Divine Voice Color edition is the identical translation and the identical 876 pages. The Teen Bible differs in its cover, one opening page written for teenagers, and three section headings. It is the whole Bible, not a selection or a devotional.',
	},
	{
		q: 'What age is the Teen Bible for?',
		a: 'Ages 13–19. It reads at the same level as every other edition — a fresh translation in clear contemporary English — so it carries a teenager through into adulthood rather than being outgrown.',
	},
	{
		q: 'Is this a good confirmation or graduation gift?',
		a: 'It is made for it. A complete hardcover Bible with a presentation page for their name, in a cover designed for a teenager rather than a children’s Bible or a generic pew edition.',
	},
	{
		q: 'What is Divine Voice Color?',
		a: 'For a hundred and twenty-five years red letters have shown the Son speaking. Our Father speaks more than three times as often — 125,457 words across 5,623 verses. In Divine Voice Color you see who is speaking: our Father’s words in blue, the Son’s in red, the Spirit’s in purple, Genesis to Revelation.',
	},
];

const productSchema = {
	'@context': 'https://schema.org',
	'@type': 'Book',
	'@id': `${SITE}/bibles/teen-bible#book`,
	name: ed.title,
	alternateName: ed.name,
	bookFormat: 'https://schema.org/Hardcover',
	numberOfPages: ed.pages,
	isbn: ed.isbn,
	inLanguage: 'en',
	datePublished: ed.published,
	description: `${ed.audience}. The complete Bible in Divine Voice Color — our Father's words in blue, the Son's in red, the Spirit's in purple.`,
	image: `${ASSETS}/dvc-${ed.slug}-1200.webp`,
	url: `${SITE}/bibles/teen-bible`,
	publisher: { '@type': 'Organization', name: 'Spirit Media Publishing' },
	author: { '@type': 'Organization', name: 'Spirit Media Publishing' },
	translationOfWork: { '@type': 'Book', name: 'The Holy Bible' },
	keywords: ed.keywords.join(', '),
	offers: {
		'@type': 'Offer',
		price: ed.price.toFixed(2),
		priceCurrency: 'USD',
		availability: 'https://schema.org/InStock',
		url: `${SITE}/print`,
		seller: { '@type': 'Organization', name: 'Spirit Media Publishing' },
		shippingDetails: {
			'@type': 'OfferShippingDetails',
			shippingRate: { '@type': 'MonetaryAmount', value: '0', currency: 'USD' },
		},
	},
};
const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faq.map((f) => ({
		'@type': 'Question',
		name: f.q,
		acceptedAnswer: { '@type': 'Answer', text: f.a },
	})),
};
---

<Layout
	title={`Teen Bible | ${ed.audience.split(' - ')[0]} | Father's Heart Bible™`}
	description={`The Teen Bible — the complete Bible in Divine Voice Color, where you can see who is speaking. Our Father's words in blue, the Son's in red, the Spirit's in purple. Hardcover, 876 pages, free shipping.`}
>
	<script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

	<main>
		<Section variant="light">
			<div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center max-w-5xl mx-auto">
				<!-- Hover swaps to the back cover, the way a listing lets you turn the book over. -->
				<div class="flex justify-center">
					<div class="dvc-flip" style="position: relative; max-width: 340px; width: 100%;">
						<img src={`${ASSETS}/dvc-${ed.slug}-1200.webp`} alt={`${ed.name} front cover — Father's Heart Bible in Divine Voice Color`} width="1200" height="1528" fetchpriority="high" decoding="async" class="block w-full h-auto dvc-front" />
						<img src={`${ASSETS}/dvc-${ed.slug}-back-1200.webp`} alt={`${ed.name} back cover`} width="1200" height="1528" loading="lazy" decoding="async" class="block w-full h-auto dvc-back" style="position: absolute; inset: 0; opacity: 0; transition: opacity 0.25s ease;" />
					</div>
				</div>
				<div>
					<p style="font-family: var(--font-sans); color: #71717a; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; margin: 0 0 0.5rem;">Divine Voice Color</p>
					<h1 style="font-family: var(--font-headline); color: var(--color-ink); font-size: 2.4rem; font-weight: 600; margin: 0 0 0.6rem;">{ed.name}</h1>
					<p style="font-family: var(--font-body); color: var(--color-muted); font-size: 1rem; line-height: 1.55; margin: 0 0 1.2rem;">{ed.audience}</p>
					<div class="flex flex-wrap items-center gap-2 mb-5">
						<span style={`font-family: var(--font-sans); font-weight: 800; font-size: 1.1rem; letter-spacing: 0.06em; color: ${VOICE.father}; background: #fff; border: 2px solid ${VOICE.father}; padding: 0.35rem 0.8rem; border-radius: 6px; line-height: 1;`}>FATHER</span>
						<span style={`font-family: var(--font-sans); font-weight: 800; font-size: 1.1rem; letter-spacing: 0.06em; color: ${VOICE.son}; background: #fff; border: 2px solid ${VOICE.son}; padding: 0.35rem 0.8rem; border-radius: 6px; line-height: 1;`}>SON</span>
						<span style={`font-family: var(--font-sans); font-weight: 800; font-size: 1.1rem; letter-spacing: 0.06em; color: ${VOICE.spirit}; background: #fff; border: 2px solid ${VOICE.spirit}; padding: 0.35rem 0.8rem; border-radius: 6px; line-height: 1;`}>SPIRIT</span>
					</div>
					<p style="font-family: var(--font-headline); color: var(--color-ink); font-size: 1.6rem; font-weight: 700; margin: 0 0 0.3rem;">${ed.price.toFixed(2)}</p>
					<p style="font-family: var(--font-sans); color: #3f3f46; font-size: 0.9rem; font-weight: 600; margin: 0 0 1.2rem;">Free shipping — a $15 value.</p>
					<a href="/print" class="inline-flex items-center justify-center rounded-full font-semibold" style="font-family: var(--font-sans); background: #3f3f46; color: #fff; padding: 0.8rem 1.8rem; text-decoration: none; font-size: 1rem;">Order direct from SMP →</a>
					<p style="font-family: var(--font-sans); color: #71717a; font-size: 0.8rem; margin: 1rem 0 0;">Hover the cover to see the back.</p>
				</div>
			</div>
		</Section>

		<Section variant="warm">
			<div class="max-w-3xl mx-auto">
				<h2 style="font-family: var(--font-headline); color: var(--color-ink); font-size: 1.8rem; font-weight: 600; margin: 0 0 1rem;">He spoke to a teenager before He spoke to the priest</h2>
				<div class="rounded-2xl p-7" style="background: #fff; border: 1px solid var(--color-hairline);">
					<p style="font-family: var(--font-serif); font-size: 1.1rem; line-height: 1.7; color: var(--color-ink); margin: 0;" set:html={mark(verse.text, verse.father, VOICE.father)}></p>
					<a href={verse.href} style="display: inline-block; font-family: var(--font-sans); font-weight: 700; font-size: 0.78rem; letter-spacing: 0.03em; color: #71717a; margin: 1rem 0 0; text-decoration: underline;">{verse.ref} (FHB)</a>
				</div>
				<p style="font-family: var(--font-body); color: var(--color-muted); font-size: 1rem; line-height: 1.65; margin: 1.5rem 0 0;">Samuel was young enough that he didn’t recognise the voice at first. It called his name three times in the night before anyone told him who was speaking. Your Father spoke to a kid before He spoke to the priest — He knows your name, and He isn’t waiting for you to grow up first.</p>
			</div>
		</Section>

		<!-- The full listing — the same copy the Ingram/Amazon record carries, not a summary
		     of it. Kevin 2026-08-23: "you have a full page to describe this bible, but you are
		     only given 10% of what we gave Ingram." -->
		<Section variant="light">
			<div class="max-w-3xl mx-auto">
				{listing.sections.map((sec) => (
					<div class="mb-8">
						<h2 style="font-family: var(--font-headline); color: var(--color-ink); font-size: 1.5rem; font-weight: 600; margin: 0 0 0.8rem;">{sec.h}</h2>
						{sec.body.map((para) => (
							VOICE_LINE[para] ? (
								<p style={`font-family: var(--font-sans); color: ${VOICE_LINE[para]}; font-size: 1.15rem; font-weight: 700; line-height: 1.6; margin: 0 0 0.35rem;`}>{para}</p>
							) : (
								<p style="font-family: var(--font-body); color: var(--color-ink); font-size: 1.02rem; line-height: 1.7; margin: 0 0 0.9rem;">{para}</p>
							)
						))}
					</div>
				))}
			</div>
		</Section>

		<!-- What's inside + product details, laid out as a retail listing rather than a list -->
		<Section variant="soft">
			<div class="max-w-4xl mx-auto">
				<h2 style="font-family: var(--font-headline); color: var(--color-ink); font-size: 1.8rem; font-weight: 600; margin: 0 0 1.4rem;">What’s inside</h2>
				<div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-3 mb-10">
					{listing.features.map((f) => (
						<div class="flex items-start gap-3">
							<span aria-hidden="true" style="color: #3f3f46; font-weight: 700; line-height: 1.6;">·</span>
							<span style="font-family: var(--font-body); color: var(--color-ink); font-size: 1rem; line-height: 1.6;">{f}</span>
						</div>
					))}
				</div>

				<h3 style="font-family: var(--font-headline); color: var(--color-ink); font-size: 1.25rem; font-weight: 600; margin: 0 0 0.9rem;">Product details</h3>
				<div class="rounded-2xl overflow-hidden" style="border: 1px solid var(--color-hairline); background: #fff;">
					{[
						['Publisher', 'Spirit Media Publishing'],
						['Publication date', 'September 2026'],
						['Language', 'English'],
						['Translation', 'Father’s Heart Bible™ — An Intimate Translation'],
						['Print length', `${ed.pages} pages`],
						['Binding', 'Hardcover, case laminate with dust jacket'],
						['Dimensions', '6 x 9 in'],
						['Interior', 'Full colour throughout'],
						['ISBN-13', ed.isbn],
						['Subject codes', null],
					].map(([k, v], n) => (
						<div class="flex flex-wrap gap-2 px-5 py-3" style={`font-family: var(--font-sans); font-size: 0.9rem; ${n % 2 ? 'background: #fafafa;' : ''}`}>
							<span style="color: #71717a; min-width: 10rem;">{k}</span>
							{v === null ? (
								<span style="color: var(--color-ink); font-weight: 600; flex: 1;">
									{listing.bisac.map((b) => (<span style="display: block;">{b}</span>))}
								</span>
							) : (
								<span style="color: var(--color-ink); font-weight: 600; flex: 1;">{v}</span>
							)}
						</div>
					))}
				</div>
			</div>
		</Section>

		<!-- About the translation, and who made it -->
		<Section variant="light">
			<div class="max-w-3xl mx-auto">
				<h2 style="font-family: var(--font-headline); color: var(--color-ink); font-size: 1.8rem; font-weight: 600; margin: 0 0 1rem;">About this translation</h2>
				{listing.about.map((para) => (
					<p style="font-family: var(--font-body); color: var(--color-ink); font-size: 1.02rem; line-height: 1.7; margin: 0 0 0.9rem;">{para}</p>
				))}

				<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-8 mb-8">
					{[
						['Translated by', 'Spirit Media Publishing'],
						['Edited by', 'Kevin White'],
						['Published by', 'Spirit Media Publishing'],
					].map(([k, v]) => (
						<div class="rounded-xl p-4" style="background: #fff; border: 1px solid var(--color-hairline);">
							<p style="font-family: var(--font-sans); color: #71717a; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; margin: 0 0 0.3rem;">{k}</p>
							<p style="font-family: var(--font-sans); color: var(--color-ink); font-weight: 600; margin: 0;">{v}</p>
						</div>
					))}
				</div>

				<h3 style="font-family: var(--font-headline); color: var(--color-ink); font-size: 1.2rem; font-weight: 600; margin: 0 0 0.6rem;">Kevin White</h3>
				<p style="font-family: var(--font-body); color: var(--color-muted); font-size: 0.98rem; line-height: 1.65; margin: 0 0 1.6rem;">{listing.bio}</p>
				<h3 style="font-family: var(--font-headline); color: var(--color-ink); font-size: 1.2rem; font-weight: 600; margin: 0 0 0.6rem;">Spirit Media Publishing</h3>
				<p style="font-family: var(--font-body); color: var(--color-muted); font-size: 0.98rem; line-height: 1.65; margin: 0;">{listing.publisher}</p>
			</div>
		</Section>

		<!-- In brief, and the searches this edition is for -->
		<Section variant="warm">
			<div class="max-w-3xl mx-auto">
				<h2 style="font-family: var(--font-headline); color: var(--color-ink); font-size: 1.8rem; font-weight: 600; margin: 0 0 1rem;">In brief</h2>
				{listing.short350.map((para) => (
					<p style="font-family: var(--font-body); color: var(--color-ink); font-size: 1.02rem; line-height: 1.7; margin: 0 0 0.9rem;">{para}</p>
				))}
				<h3 style="font-family: var(--font-headline); color: var(--color-ink); font-size: 1.1rem; font-weight: 600; margin: 2rem 0 0.7rem;">Also known as</h3>
				<div class="flex flex-wrap gap-2">
					{listing.keywords.map((k) => (
						<span style="font-family: var(--font-sans); font-size: 0.82rem; color: #3f3f46; background: #fff; border: 1px solid var(--color-hairline); border-radius: 999px; padding: 0.3rem 0.75rem;">{k}</span>
					))}
				</div>
			</div>
		</Section>

		<Section variant="soft">
			<div class="max-w-3xl mx-auto">
				<h2 style="font-family: var(--font-headline); color: var(--color-ink); font-size: 1.8rem; font-weight: 600; margin: 0 0 1.2rem;">Questions</h2>
				<div class="space-y-3">
					{faq.map((f) => (
						<details class="faq-item rounded-2xl" style="background-color: #fff; border: 1px solid var(--color-hairline);">
							<summary class="flex items-center justify-between gap-4 px-5 py-4 font-semibold" style="font-family: var(--font-sans); color: var(--color-ink);">
								<span>{f.q}</span>
							</summary>
							<div class="px-5 pb-5 -mt-1">
								<p style="font-family: var(--font-body); color: var(--color-muted); font-size: 0.95rem; line-height: 1.6;">{f.a}</p>
							</div>
						</details>
					))}
				</div>
				<p style="font-family: var(--font-body); color: var(--color-muted); font-size: 0.95rem; margin: 1.75rem 0 0;">
					Looking for scripture rather than a copy to hold? Read <a href="/bible-for/teenagers" style="color: #3f3f46; text-decoration: underline;">Bible verses for teenagers</a>, or read the whole Bible free at <a href={READ_URL} style="color: #3f3f46; text-decoration: underline;">fathersheartbible.com/read</a>. See <a href="/print" style="color: #3f3f46; text-decoration: underline;">all sixteen Divine Voice Color editions</a>.
				</p>
			</div>
		</Section>
	</main>
</Layout>

