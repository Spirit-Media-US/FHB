---
import fs from 'node:fs';
import path from 'node:path';
import EditionOrder from '../../components/EditionOrder.astro';
import LangCover from '../../components/LangCover.astro';
import LookInside from '../../components/LookInside.astro';
import MailtoLink from '../../components/MailtoLink.astro';
import Section from '../../components/Section.astro';
import { cardUrl, hasLangCard } from '../../data/card-art';
import coverColors from '../../data/cover-colors.json';
import frontmatter from '../../data/editions/frontmatter.json';
import shared from '../../data/editions/shared.json';
import googleBooks from '../../data/google-books-listings.json';
import isbnList from '../../data/isbn-list.json';
import { langSlug, orderableLanguages } from '../../data/language-editions';
import { catalogRows } from '../../data/print-catalog';
import readerEntry from '../../data/reader-entry-links.json';
import readerLanguages from '../../data/reader-languages.json';
import youversion from '../../data/youversion-versions.json';
// /bibles/<slug>-bible — the PRODUCT page for every Divine Voice™ Color edition.
//
// Why this exists alongside /bible-for/<audience>: those pages answer a PASTORAL search
// ("bible verses for teenagers") and this one answers a PURCHASE search ("teen bible",
// "confirmation gift bible"). They target different intent and link to each other rather
// than competing for the same query.
//
// Every fact here — ISBN, price, page count, BISAC, keywords, descriptions — is lifted from
// the edition's Drive metadata sheet, the same source the Ingram listing uses, so the site
// and the trade record cannot drift apart.
//
// THE DATA BOUNDARY, which is the whole point of this file:
//   src/data/editions/<slug>.json   — what is TRUE OF THIS EDITION ONLY (audience, hook,
//                                     listing copy, FAQ, ISBN). See SCHEMA.md.
//   src/data/editions/shared.json   — what is IDENTICAL IN ALL SIXTEEN (the preface, the
//                                     hearing-His-voice pages, the bios, the translation
//                                     description). Written once, never copied sixteen times.
//   src/data/editions/frontmatter.json — extracted from the shipping interiors: the audience
//                                     page and the three pillar pages. Read, never retyped.
import Layout from '../../layouts/Layout.astro';
import { alternatesFrom, bcp47 } from '../../lib/bibles-hreflang.mjs';
import { faqTokenValues, fillFaqTokens } from '../../lib/faq-tokens.mjs';
import { FHB_ORG_ID } from '../../lib/fhb-org';
import { shippingDetailsFor } from '../../lib/marginGuard';
import { merchantReturnPolicy } from '../../lib/merchantReturnPolicy';
import { FIRST_ORDER_PCT, firstOrderUnit } from '../../lib/order-pricing';
import { formatUsd, ORDER_STRINGS, orderLangFor, tr as trOrder } from '../../lib/orderStrings';
import { fitDescription, fitTitle } from '../../lib/seoFit';
import { LIVE_COUNTRIES } from '../../lib/shipCountries';
import { shipsOnPublication } from '../../lib/storeEngine';
import { tblEdition } from '../../lib/tbl.mjs';

const ASSETS = 'https://assets.spiritmediapublishing.com/FHB/print';
const READ_URL = 'https://fathersheartbible.com/read/';
const SITE = 'https://fathersheartbible.com';

// The journaling edition is `journaling` on /print and in the asset names, but its front
// matter was extracted under the interior's own name, `divinevoice`. Alias, don't rename:
// the asset paths and the /print cart keys are live.
const FM_ALIAS: Record<string, string> = { journaling: 'divinevoice' };

type Edition = {
	slug: string;
	name: string;
	title: string;
	sub: string;
	isbn: string;
	price: number;
	pages?: number;
	published: string;
	datePublished?: string;
	trim?: string;
	binding?: string;
	/** Asset/data keys, when they differ from `slug` (which drives the URL).
	 *  The General Audience lines are sold by colour, so their cover art and sample
	 *  pages are filed under the LINE, not under the page's slug. */
	coverImage?: string;
	lookInsideKey?: string;
	frontmatterKey?: string;
	audienceNoun: string;
	audienceSingular?: string;
	hook: {
		h2: string;
		ref: string;
		href: string;
		text: string;
		father?: string[];
		son?: string[];
		spirit?: string[];
		note: string;
	};
	relatedGuide?: { href: string; label: string };
	listing: {
		short350: string[];
		long: { h: string; body: string[] }[];
		features: string[];
		keywords: string[];
		keywordsSchema?: string[];
		bisac: [string, string][];
	};
	faq: { q: string; a: string }[];
	/** LANGUAGE editions (Kevin 2026-10-03). `lang` is the BCP-47 code of the book's text. */
	kind?: 'audience' | 'language';
	lang?: string;
	dir?: 'rtl';
	english?: string;
	/** The verse as printed in THIS edition's language, from its canon, shown above the FHB English. */
	hookNative?: { text: string; father?: string[]; son?: string[]; spirit?: string[] };
	/** Kevin 2026-10-01: the ONE sentence every language edition states about its source. */
	translationStatement?: string;
	/** false = no ISBN assigned yet (build_language_pages.py, sheet "Pending Bowker"). Kevin
	 *  2026-10-30: "ALL editions and languages need full details page ... The full details can be
	 *  added NOW". The page states the facts and offers a reserve-by-email in place of the order
	 *  form — never an offer the checkout cannot fulfil, and no Offer in the structured data. */
	orderable?: boolean;
	/** true = no ISBN yet but SOLD NOW as a pre-order (Kevin 2026-10-30, kevin-decisions L1197: "All
	 *  languages cards can offer a Buy now · free shipping button ... By the time people notice these
	 *  will be published"). The order form sells lang-<code>; fulfilled on publication. Still no ISBN,
	 *  date, GTIN or Offer in the structured data (a merchant Offer needs a GTIN). */
	preorder?: boolean;
	seo?: {
		title?: string;
		description?: string /** description is the edition's own language (2jw) */;
		native?: boolean;
	};
};

export async function getStaticPaths() {
	// One page per edition data file. A file that has not landed yet simply has no page —
	// the route is driven by the data, so the fifteen arrive as their JSON does.
	const files = import.meta.glob<{ default: Edition }>('../../data/editions/*.json', {
		eager: true,
	});
	const editions = Object.entries(files)
		.filter(([path]) => /\/[a-z0-9-]+\.json$/.test(path))
		.map(([, mod]) => mod.default)
		.filter((e) => e && typeof e.slug === 'string' && e.listing && e.hook);
	return editions.map((ed) => ({
		params: { slug: `${ed.slug}-bible` },
		props: {
			ed,
			alternates: alternatesFrom(editions, ed.slug),
			// Kevin 2026-11-14: link the other AUDIENCE editions (not languages, not single Large Print volumes).
			siblings: editions
				.filter((x) => !x.lang && x.slug !== ed.slug && !/^lp-vol/.test(x.slug))
				.map((x) => ({ slug: x.slug, name: x.name })),
		},
	}));
}

const {
	ed,
	alternates,
	siblings = [],
} = Astro.props as {
	ed: Edition;
	alternates: { hreflang: string; href: string }[];
	siblings?: { slug: string; name: string }[];
};
// FAQ answers may carry {{READ_COUNT}}: the number of languages live in the /read reader, from the
// generated reader-languages.json, so no typed count goes stale (Kevin 2026-11-10: 80 everywhere).
// {{AUDIO_COUNT}} is the languages with a complete narration (lang-audio.json, via the same file).
// fillFaqTokens throws on any token left unfilled, so a stale source fails the build (unit 2pv).

const fm = (frontmatter as Record<string, { pages?: number; pillars?: Pillar[] }>)[
	ed.frontmatterKey ?? FM_ALIAS[ed.slug] ?? ed.slug
];
type Pillar = { title: string; line: string; verses: [string, string][] };
const pillars: Pillar[] = fm?.pillars ?? [];
// cardUrl decides the location: a card re-rendered to a NEW key resolves there, and one
// that has not been re-rendered (journaling's 8x10, D166) keeps the key it has. The old
// `?v=` is gone with it — a new key has nothing cached against it to bust.
const isLang = ed.kind === 'language';
// A language edition whose case is not built yet has no card (Kevin 2026-10-29: all 80 listed, each
// cover as it is built): the hero shows LangCover's cover-pending tile, and the share/schema image is
// the site's branded card rather than a URL that 404s or another edition's cover.
const langCode = isLang ? (ed.coverImage ?? '').replace(/^lang-/, '') : '';
const hasCover = !isLang || hasLangCard(langCode);
const coverUrl = hasCover
	? cardUrl(ed.coverImage ?? `dvc-${ed.slug}`, 1200)
	: 'https://assets.spiritmediapublishing.com/FHB/share/v5/fhb-og-family.jpg';
const coverAlt = ed.name.startsWith('Father')
	? `${ed.name} in Divine Voice™ Color`
	: `${ed.name} — Father's Heart Bible (FHB) in Divine Voice™ Color`;
// Image search (unit 2rl): the cover is an ImageObject, not a bare URL, so Google Images can show
// creator / credit / copyright. copyrightNotice is the site footer's own line (Footer.astro, wired in
// Layout.astro) verbatim; width/height are omitted because cover files differ (1200x1528, one 1200x1451,
// and the og-family fallback) — never guess. license + acquireLicensePage (unit 2rm, Kevin 2026-11-12 delegated to pmseoaeo, option A) point at the
// existing Copyright & Permissions page, which states all rights reserved and how to request permission.
const coverImageObject = {
	'@type': 'ImageObject',
	url: coverUrl,
	contentUrl: coverUrl,
	caption: coverAlt,
	creator: {
		'@type': 'Organization',
		'@id': 'https://spiritmediapublishing.com/#organization',
		name: 'Spirit Media Publishing',
	},
	creditText: 'Spirit Media Publishing',
	license: 'https://fathersheartbible.com/copyright/',
	acquireLicensePage: 'https://fathersheartbible.com/copyright/',
	copyrightNotice: `© ${new Date().getFullYear()} Spirit Media Publishing, the imprint of Spirit Media Inc. All rights reserved.`,
};
// THE ORDER FORM under the header, on EVERY edition (Kevin 2026-10-05; language pages since
// 2026-10-03). It sells this edition's catalog row(s) from print-catalog.ts — the same record
// /print's rows and dvc-checkout.ts use: lang-<code> for a language, the slug itself for an
// audience or Large Print edition, and the three cover colours for the General edition, whose
// page sells "Charcoal, Plum or White". A page with no catalog row FAILS THE BUILD: an edition
// page that cannot be ordered is the defect this replaced.
const langEd = isLang ? orderableLanguages.find((l) => langSlug(l) === ed.slug) : undefined;
// Chapters of THIS language to read free (full-site audit M6): the page passes its
// trust to the language's own chapters, and their native book names make each edition
// page its own text rather than a 53%-shared template (M8). Generated, live-guarded.
const entryLinks: { href: string; label: string }[] = isLang
	? ((readerEntry.languages as Record<string, { href: string; label: string }[]>)[
			(ed.lang ?? '').toLowerCase()
		] ?? [])
	: [];
const orderIds = langEd
	? [`lang-${langEd.code}`]
	: ed.slug === 'fathers-heart'
		? catalogRows.filter((r) => r.category === 'general').map((r) => r.id)
		: [ed.slug];
// No ISBN yet = nothing the checkout can sell: an empty order set, by declaration, not by accident.
const reserveOnly = ed.orderable === false;
const orderRows = reserveOnly ? [] : catalogRows.filter((r) => orderIds.includes(r.id));
// Kevin 2026-11-20 RULE: no address in the page source — MailtoLink builds the mailto: at load.
const RESERVE_SUBJECT = `Reserve: ${ed.english ?? ed.name} Father's Heart Bible`;
if (!orderRows.length && !reserveOnly)
	throw new Error(
		`/bibles/${ed.slug}-bible/: no print-catalog row for [${orderIds.join(', ')}] — this edition page would have no order form`,
	);
// The order flow speaks the edition's language when we have it (unit 2kz; 'en' otherwise).
const orderLang = isLang ? orderLangFor(langEd?.code ?? ed.lang) : 'en';
const orderT = (k: string) => trOrder(ORDER_STRINGS[orderLang], k);
const orderHeading = langEd
	? orderLang === 'en'
		? `the ${ed.english ?? langEd.english} Edition`
		: ed.name
	: ed.name;
// A language edition whose interior is still being built has NO page count yet: never fall
// back to the English 888 for it.
const pages = isLang ? (ed.pages ?? null) : (ed.pages ?? fm?.pages ?? 888);
const trim = ed.trim ?? '6 x 9 in';
// Sourced per edition from the metadata sheet; the fallback matches what those
// sheets say. It previously read "with dust jacket", which no sheet supports —
// the journaling sheet says outright "No dust jacket: not offered at 8 x 10".
const binding = ed.binding ?? 'Paperback or Hardback';
// Kevin 2026-11-14 ("1A"): the edition title in the colour of its cover, wherever the title is used. The colours
// are MEASURED per cover (src/data/cover-colors.json says how): a pale cover keeps its true colour with a thin dark
// outline (W3C technique G18), which is legible on the big headings only; small text (the Product details row)
// stays ink for those. No entry = ink.
const cc = (coverColors as Record<string, { title: string; outline: boolean } | string>)[ed.slug];
const coverTitle = typeof cc === 'object' ? cc : undefined;
const titleColor: string = coverTitle?.title ?? 'var(--color-ink)';
const titleOutline = coverTitle?.outline ?? false;
const OUTLINE_SHADOW =
	'-1px -1px 0 #27272a, 1px -1px 0 #27272a, -1px 1px 0 #27272a, 1px 1px 0 #27272a, 0 1px 0 #27272a, 0 -1px 0 #27272a, 1px 0 0 #27272a, -1px 0 0 #27272a';
const titleStyle = `color: ${titleColor};${titleOutline ? ` text-shadow: ${OUTLINE_SHADOW};` : ''}`;
const smallTitleColor = titleOutline ? 'var(--color-ink)' : titleColor;

// "Intimacy for Teens" -> "for Teens". The pillar titles are uniform across the interiors,
// so the audience phrase the printed book uses is the one the page uses too — no second
// place to keep it in sync.
const pillarSuffix = pillars[0]?.title.replace(/^\S+\s+/, '') ?? '';

const MONTHS = [
	'January',
	'February',
	'March',
	'April',
	'May',
	'June',
	'July',
	'August',
	'September',
	'October',
	'November',
	'December',
];
function isoDate(display: string): string {
	const m = /^([A-Za-z]+)\s+(\d{4})$/.exec(display.trim());
	if (!m) return display;
	const i = MONTHS.indexOf(m[1]);
	return i < 0 ? display : `${m[2]}-${String(i + 1).padStart(2, '0')}-01`;
}
const datePublished =
	ed.datePublished ?? (reserveOnly || ed.preorder ? undefined : isoDate(ed.published));

// `title` is the long JSON-LD name ("Father's Heart Bible — Dad's Bible"); `name` is the h1.
// Tolerate a data file that set them equal rather than emitting a Book whose name and
// alternateName are the same string.
const englishSchemaName = ed.title === ed.name ? `Father’s Heart Bible — ${ed.name}` : ed.title;
// 2jw: a language edition whose metadata is native (seo.native, from build_language_pages.py
// --native-meta) names itself by its own edition title in structured data; the English long title
// stays as an alternateName so the entity still resolves. html lang is NOT changed — the body is English.
const nativeMeta = isLang && ed.seo?.native === true && !!ed.lang;
const schemaName = nativeMeta ? ed.name : englishSchemaName;
// BCP-47 casing for schema.org inLanguage (zh-hans -> zh-Hans); en for non-language editions.
const inLang = ed.lang ? bcp47(ed.lang) : 'en';

// "Also known as" is a READER-FACING list, not the keyword field (Kevin 2026-09-18). The
// sheet's 500-byte Ingram line opens with fhb;fhb bible;father's heart bible fhb — correct
// there, because on a retailer those are invisible backend terms and repeating the brand is
// free. Rendered as chips on a product page they read as keyword stuffing. The full line
// still goes to JSON-LD via keywordsSchema; only the visible chips are filtered.
const BRAND_KEYWORDS = new Set([
	'fhb',
	'fhb bible',
	"father's heart bible fhb",
	'father’s heart bible fhb',
]);
// Kevin 2026-11-14 item 8 (best practice, SEO/AEO audit): "Also known as" shows only WHOLE names for this
// Bible: phrases that name a Bible (not gift-keyword fragments like "day gifts"), plus "Bible for <audience>"
// and, for a language edition, "<Language> Bible". The sheet's keyword line is untouched (it feeds Ingram and is
// checked against the sheet by fhb-edition-metadata.py); only what the page and its JSON-LD show is filtered.
// Paragraphs shown in the short summary are not shown again in the long listing (Kevin 2026-11-14 item 9),
// compared after decoding the few entities the sheet text carries (&trade; etc.) and collapsing spaces.
const paraKey = (p: string) =>
	p
		.replace(/&trade;/g, '™')
		.replace(/&amp;/g, '&')
		.replace(/&rsquo;|&#39;/g, '’')
		.replace(/&mdash;/g, '—')
		.replace(/<[^>]+>/g, '')
		.replace(/\s+/g, ' ')
		.trim();
const shortSet = new Set(ed.listing.short350.map(paraKey));
const ALIAS_RE = /\b(bible|biblia|bibel|bijbel|bíblia)\b/i;
// Kevin 2026-11-14 "Seems like you stripped too many": keep every WHOLE phrase (two or more words that read as a
// complete search), drop single words and the broken fragments a split keyword line leaves behind ("day gifts",
// "great gifts", "first time gifts", "grandpa be gifts", "verses anxiety").
const isFragment = (k: string) =>
	k.trim().split(/\s+/).length < 2 ||
	/^(day|great|first|time|new|best|good) gifts$/i.test(k.trim()) ||
	/^first time gifts$/i.test(k.trim()) ||
	/\bbe gifts$/i.test(k) ||
	/^verses\b/i.test(k) ||
	/^(what|how|why|where|when)\b/i.test(k);
const visibleKeywords = [
	...new Map(
		[
			`Bible for ${ed.audienceNoun}`,
			...(isLang ? [] : [`${ed.audienceNoun} Bible`]),
			...(isLang && ed.english ? [`${ed.english} Bible`] : []),
			...ed.listing.keywords.filter(
				(k) =>
					!BRAND_KEYWORDS.has(k.toLowerCase()) &&
					(ALIAS_RE.test(k) ? !/^(what|how|why|where|when)\b/i.test(k) : !isFragment(k)),
			),
		].map((k) => [k.toLowerCase(), k]),
	).values(),
].slice(0, 30);

// shared.json is what is IDENTICAL IN ALL EDITIONS. One preface paragraph is not: it counts
// this edition's notes and chapters ("1,355 notes across 777 chapters"), which are the 6x9
// single-volume figures. Inherited by every page, it contradicted the Large Print set on its
// own page — 777 chapters in one sentence and 1,189 in another (Kevin 2026-09-18). A count
// is edition-specific by definition, so it is dropped from the shared preface rather than
// duplicated per edition. The figures themselves live in each edition's listing copy.
const editionSpecificNote = (p: string) => /\bnotes across\b.*\bchapters\b/.test(p);

// SCREEN divine-voice palette — the same values /read has always used, adopted here so a
// visitor sees one red on the product page and on the reader. Print ink is unchanged:
// the interiors keep 3563ae / f04933 / 91278f. Kevin approved screen-only, 2026-08-24.
// f04933 measures hue 7deg (vermilion) at 3.7:1 on white, below the contrast floor;
// c8102e sits at 350deg and 5.9:1, and reads redder in context precisely because it is
// not fighting the page.
const VOICE = { father: '#2563eb', son: '#c8102e', spirit: '#6a3fa0' };
function mark(text: string, spans: string[], color: string): string {
	let out = text;
	for (const s of spans)
		if (s && out.includes(s))
			out = out.replace(s, `<span style="color:${color};font-weight:600;">${s}</span>`);
	return out;
}
let hookHtml = mark(ed.hook.text, ed.hook.father ?? [], VOICE.father);
hookHtml = mark(hookHtml, ed.hook.son ?? [], VOICE.son);
hookHtml = mark(hookHtml, ed.hook.spirit ?? [], VOICE.spirit);
const hn = ed.hookNative;
let hookNativeHtml = hn ? mark(hn.text, hn.father ?? [], VOICE.father) : '';
if (hn)
	hookNativeHtml = mark(
		mark(hookNativeHtml, hn.son ?? [], VOICE.son),
		hn.spirit ?? [],
		VOICE.spirit,
	);

// color the COLOUR WORDS, not the sentence around them (Kevin 2026-08-23). The claim is
// "our Father's words in BLUE" — so BLUE is what should be blue. coloring the whole line
// makes it decoration; coloring the one word makes it a demonstration. Applied to every
// paragraph, so it works for the standalone lines and for the sentence that runs them
// together mid-prose.
const COLOUR_WORD: Record<string, string> = {
	BLUE: VOICE.father,
	RED: VOICE.son,
	PURPLE: VOICE.spirit,
};
function colorWords(text: string): string {
	return colourInlineQuotes(
		text.replace(
			/\b(BLUE|RED|PURPLE)\b/g,
			(w) => `<span style="color:${COLOUR_WORD[w]};font-weight:800;">${w}</span>`,
		),
	);
}

// QUOTED SCRIPTURE IN DIVINE VOICE COLOUR (Kevin 2026-11-14: "Can any of the scriptures shown be blue, red, or
// purple?"). Extends mark() above: the coloured spans are not typed here (the homepage's hand-copied lists can
// drift); they are READ from the locked English canon at build (src/content/bible/<book>/<ccc>.json, rebuilt by
// sync-translations): fatherWords = blue, jesusWords/sonWords = red, spiritWords = purple. Only words the canon
// records as SPOKEN by a divine person are coloured (rules/fhb-divine-voice.md); narration, the serpent, Pharaoh
// and the tempter carry no field and stay plain. No canon file or no match = text unchanged (never a guess).
const VOICE_FIELDS: [string, string][] = [
	['fatherWords', VOICE.father],
	['jesusWords', VOICE.son],
	['sonWords', VOICE.son],
	['spiritWords', VOICE.spirit],
];
const canonCache = new Map<string, { verse: number; [k: string]: unknown }[] | null>();
function canonSpans(ref: string): { text: string; color: string }[] {
	const m = ref.trim().match(/^((?:[1-3] )?[A-Za-z][A-Za-z ]*?) (\d+):(\d+)(?:[-–](\d+))?$/);
	if (!m) return [];
	const book = m[1]
		.toLowerCase()
		.replace(/^psalm$/, 'psalms')
		.replace(/\s+/g, '-');
	const key = `${book}/${m[2].padStart(3, '0')}`;
	if (!canonCache.has(key)) {
		try {
			// The /read app's copy is what readers see and carries every voice field (rules/fhb-divine-voice.md:
			// "read the verse in /srv/sites/community/src/content/bible"); this repo's synced copy is the fallback.
			const file = [
				path.join('/srv/sites/community/src/content/bible', `${key}.json`),
				path.resolve('src/content/bible', `${key}.json`),
			].find((f) => fs.existsSync(f));
			if (!file) throw new Error('no canon');
			const d = JSON.parse(fs.readFileSync(file, 'utf8'));
			canonCache.set(key, Array.isArray(d.verses) ? d.verses : null);
		} catch {
			canonCache.set(key, null);
		}
	}
	const verses = canonCache.get(key);
	if (!verses) return [];
	const from = Number(m[3]);
	const to = m[4] ? Number(m[4]) : from;
	const out: { text: string; color: string }[] = [];
	for (const v of verses) {
		if (v.verse < from || v.verse > to) continue;
		for (const [field, color] of VOICE_FIELDS) {
			const list = v[field];
			if (Array.isArray(list))
				for (const t of list) if (typeof t === 'string' && t.trim()) out.push({ text: t, color });
		}
	}
	return out;
}
// Curly and straight quotes are one character each, so the normalised copy keeps every index.
const qNorm = (x: string) => x.replace(/[“”]/g, '"').replace(/[‘’]/g, "'");
const qCore = (x: string) => qNorm(x).replace(/^[\s"']+|[\s"'.,;:!?]+$/g, '');
/** `text` (HTML-safe) with the canon's divine words for `ref` coloured; unchanged when none apply. */
function colourVerse(ref: string, text: string): string {
	const n = qNorm(text);
	const shown = qCore(text);
	const paint = (i: number, len: number, color: string) =>
		`${text.slice(0, i)}<span style="color:${color};font-weight:600;">${text.slice(i, i + len)}</span>${text.slice(i + len)}`;
	for (const { text: span, color } of canonSpans(ref)) {
		const c = qCore(span);
		if (!c) continue;
		// the quote shown sits inside a divine utterance: colour the quote
		if (shown && c.includes(shown) && n.indexOf(shown) >= 0)
			return paint(n.indexOf(shown), shown.length, color);
		// the divine words sit inside a longer quote (narration around them): colour only those words
		if (n.indexOf(c) >= 0) return paint(n.indexOf(c), c.length, color);
	}
	return text;
}
/** Inline quotes in prose: “…” followed by a reference, e.g. “I am the way…” (John 14:6). */
function colourInlineQuotes(html: string): string {
	return html.replace(
		/“([^”<]+)”(\s*\(?)((?:[1-3] )?[A-Z][a-z]+(?: of [A-Z][a-z]+)? \d+:\d+(?:[-–]\d+)?)/g,
		(all, quote: string, gap: string, ref: string) => {
			const coloured = colourVerse(ref, quote);
			return coloured === quote ? all : `“${coloured}”${gap}${ref}`;
		},
	);
}
const escHtml = (x: string) => x.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

// The front matter every copy carries, before Genesis 1:1. Shared for every edition except
// the pillars line, which names this edition's own reader — and which the journaling
// edition does not have at all, so it is spliced in rather than blanked out.
const frontMatterParts: [string, string][] = [...(shared.frontMatterParts as [string, string][])];
if (pillars.length) {
	const p = shared.pillarsFrontMatter;
	frontMatterParts.splice(p.index, 0, [p.name, p.what.replace('{suffix}', pillarSuffix)]);
}

const url = `${SITE}/bibles/${ed.slug}-bible/`;
// Visible Bible.com link (Kevin 2026-11-08): only when this language has a line in youversion-versions.json.
const yvUrl = ed.lang ? (youversion.versions as Record<string, string>)[ed.lang] : undefined;

// ONE PRODUCT PER BINDING, for Google's free merchant listings (Kevin 2026-10-22, master plan W5).
// Each binding is its own book with its own ISBN and price, so each gets its own Product +
// Offer: the price is the catalog row's (the same row this page's order form sells and
// pricing-verify checks against dvc-checkout.ts), the GTIN is that binding's ISBN from
// src/data/isbn-list.json (generated from the ISBN master), and the offer points at THIS page,
// where the buyer orders it. Shipping: free, United States only — what /print says and what the
// checkout collects (allowed_countries US). NO return policy is declared: the site's only
// wording is "reach out and we'll make it right", which states no window or method, and a
// policy is never invented to fill a schema field.
type IsbnPair = { hb?: string; pb?: string; colour?: string };
const il = isbnList as unknown as Record<string, IsbnPair | IsbnPair[]>;
const isbnPairs: IsbnPair[] = [
	'general',
	'audience',
	'journaling',
	'largePrint',
	'languages',
].flatMap((k) => {
	const v = il[k];
	return Array.isArray(v) ? v : v ? [v] : [];
});
const pairFor = (rowId: string): IsbnPair | undefined => {
	const colour = /^general-[a-z]+-([a-z]+)$/.exec(rowId)?.[1];
	if (colour)
		return ((il.general as IsbnPair[]) ?? []).find((p) => p.colour?.toLowerCase() === colour);
	return ed.isbn ? isbnPairs.find((p) => p.hb === ed.isbn || p.pb === ed.isbn) : undefined;
};
// This edition's own two ISBNs, for Product details (Kevin 2026-11-14: "edition title at the top with both ISBNs").
const isbnPair: IsbnPair | undefined = ed.isbn
	? isbnPairs.find((p) => p.hb === ed.isbn || p.pb === ed.isbn)
	: undefined;
const BIND = {
	hb: { label: 'Hardcover', format: 'https://schema.org/Hardcover' },
	pb: { label: 'Paperback', format: 'https://schema.org/Paperback' },
} as const;
// A pre-order (no ISBN yet) sells through the form but declares no Product/Offer: no GTIN to give.
const preorder = ed.preorder === true && !ed.isbn;
// SHIPS ON PUBLICATION (pmshipping 2026-11-25 option 2; Kevin 10-29 L1126 direct sale stands): a direct-sale edition with an
// ISBN that is not on sale yet sells now and ships when Ingram can print it; the form says so with the EXISTING pre-order
// line (o.preorder, every order language). Same source as the Stripe line: the store engine's shipsOnPublication.
const awaitingPublication =
	!preorder &&
	orderRows.some((r) => shipsOnPublication(`${r.id}-hb`) || shipsOnPublication(`${r.id}-pb`));
const variants = (preorder ? [] : orderRows).flatMap((r) => {
	const pair = pairFor(r.id);
	return (['hb', 'pb'] as const).map((b) => ({
		sku: `${r.id}-${b}`,
		binding: b,
		price: b === 'hb' ? r.hb : r.pb,
		isbn: pair?.[b],
		title: orderRows.length > 1 ? r.title : schemaName,
	}));
});
// Google Books listing for a binding, by its ISBN-13 (unit 3kq). Id form only; empty when none is known.
const gbUrlFor = (isbn?: string): string[] => {
	const id = isbn
		? (googleBooks.listings as Record<string, string>)[isbn.replace(/-/g, '')]
		: undefined;
	return id ? [`https://books.google.com/books?id=${id}`] : [];
};
const offerFor = (v: (typeof variants)[number]) => ({
	'@type': 'Offer',
	price: v.price.toFixed(2),
	priceCurrency: 'USD',
	// PreOrder for a direct-sale edition not yet on sale at Ingram (its Stripe line says "ships on publication"), so
	// product snippets never read it as in stock (pmseoaeo 2026-11-25). Same source as the checkout: shipsOnPublication.
	availability: shipsOnPublication(v.sku)
		? 'https://schema.org/PreOrder'
		: 'https://schema.org/InStock',
	itemCondition: 'https://schema.org/NewCondition',
	url,
	sku: v.sku,
	hasMerchantReturnPolicy: merchantReturnPolicy,
	...(v.isbn ? { gtin13: v.isbn.replace(/-/g, '') } : {}),
	// FHB sells its own Bibles (Kevin 2026-11-08): the seller is Father's Heart Bible itself.
	seller: {
		'@type': 'Organization',
		'@id': FHB_ORG_ID,
		name: "Father's Heart Bible",
		url: 'https://fathersheartbible.com/',
	},
	// One OfferShippingDetails per live country, from src/data/ship-countries.json (unit 2js).
	// US today: free, 2–3 + 5–7 business days = /print's "7–10 days" promise (PM ruling 2026-10-27).
	shippingDetails: shippingDetailsFor({ slug: v.sku, listUsd: v.price }),
});
// The page's own Book node is the binding its ISBN names (hardback for every edition today);
// the other binding(s) hang off it as workExample editions, each a Product with its own offer.
const mainVariant = variants.find((v) => v.isbn && v.isbn === ed.isbn) ?? variants[0];
const otherVariants = variants.filter((v) => v !== mainVariant);
// A reserve-only edition (no ISBN yet) is a Book, not a Product: no SKU, no Offer, no GTIN.
const commerce = mainVariant
	? {
			'@type': ['Book', 'Product'],
			bookFormat: BIND[mainVariant.binding].format,
			...(mainVariant.isbn ? { gtin13: mainVariant.isbn.replace(/-/g, '') } : {}),
			sku: mainVariant.sku,
		}
	: { '@type': 'Book' };
// Every binding carries the same description: Google's merchant listings flag a Product with none
// (Search Console 2026-10-27, "Missing field description" on the workExample bindings).
const productDescription = `${ed.sub}. The complete Bible in Divine Voice™ Color — our Father's words in blue, the Son's in red, the Spirit's in purple.`;
const productSchema = {
	'@context': 'https://schema.org',
	'@id': `${url}#book`,
	name: schemaName,
	// FHB has no established search demand the way NIV or ESV does, so the abbreviation has
	// to be TEACHABLE to an engine: the Book entity declares both the edition name and the
	// abbreviation as alternate names (Kevin approved 2026-09-18). Other pages already do
	// this; the 22 edition pages — the ones carrying the SKUs — did not.
	alternateName: nativeMeta ? [englishSchemaName, 'FHB'] : [ed.name, 'FHB'],
	...commerce,
	...(pages ? { numberOfPages: pages } : {}),
	brand: { '@type': 'Brand', name: "Father's Heart Bible" },
	// The Large Print SET carries no ISBN of its own — Kevin assigned numbers per volume, as
	// lp-set.json's _isbnNote records. An empty string is not an ISBN, so the property is
	// omitted rather than emitted blank, which is invalid structured data.
	...(ed.isbn ? { isbn: ed.isbn } : {}),
	inLanguage: nativeMeta ? inLang : (ed.lang ?? 'en'),
	...(datePublished ? { datePublished } : {}),
	description: productDescription,
	image: coverImageObject,
	url,
	// The same edition on YouVersion, when fhb-partner-link-watch has FOUND it (one map, one line per language).
	...(() => {
		const same = [
			...(ed.lang && (youversion.versions as Record<string, string>)[ed.lang]
				? [(youversion.versions as Record<string, string>)[ed.lang]]
				: []),
			...gbUrlFor(mainVariant?.isbn ?? ed.isbn),
		];
		return same.length ? { sameAs: same } : {};
	})(),
	publisher: {
		'@type': 'Organization',
		'@id': 'https://spiritmediapublishing.com/#organization',
		name: 'Spirit Media Publishing',
	},
	author: {
		'@type': 'Organization',
		'@id': 'https://spiritmediapublishing.com/#organization',
		name: 'Spirit Media Publishing',
	},
	// Kevin's absolute rule (2026-10-03): the translator is ALWAYS Spirit Media Publishing.
	translator: {
		'@type': 'Organization',
		'@id': 'https://spiritmediapublishing.com/#organization',
		name: 'Spirit Media Publishing',
	},
	translationOfWork: { '@type': 'Book', name: 'The Holy Bible' },
	// Visible credit "Edited by Kevin White" (shared.credits); the Person node lives on /the-fathers-heart-bible/leadership/.
	editor: { '@type': 'Person', '@id': 'https://kevinwhite.us/#person', name: 'Kevin White' },
	isPartOf: { '@id': 'https://fathersheartbible.com/#website' },
	keywords: ["Father's Heart Bible", 'FHB', ...visibleKeywords].join(', '),
	...(mainVariant ? { offers: offerFor(mainVariant) } : {}),
	// The other binding(s): each its own book, ISBN and offer (Google: one product per GTIN).
	workExample: otherVariants.map((v) => ({
		'@type': ['Book', 'Product'],
		name: `${v.title} (${BIND[v.binding].label})`,
		bookFormat: BIND[v.binding].format,
		...(v.isbn ? { isbn: v.isbn, gtin13: v.isbn.replace(/-/g, '') } : {}),
		sku: v.sku,
		description: productDescription,
		image: coverImageObject,
		inLanguage: nativeMeta ? inLang : (ed.lang ?? 'en'),
		brand: { '@type': 'Brand', name: "Father's Heart Bible" },
		...(gbUrlFor(v.isbn).length ? { sameAs: gbUrlFor(v.isbn) } : {}),
		offers: offerFor(v),
	})),
};
const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
		{ '@type': 'ListItem', position: 2, name: 'Print Editions', item: `${SITE}/print/` },
		{ '@type': 'ListItem', position: 3, name: ed.name, item: `${SITE}/bibles/${ed.slug}-bible/` },
	],
};
// Two buyer questions every edition gets (Kevin 2026-11-14 "do everything"), answered from this edition's own
// data and the live shipping data, never typed per page: is it large print, and how soon does it arrive.
const usShip = LIVE_COUNTRIES.find((c) => c.code === 'US');
const isLargePrint = /^lp-/.test(ed.slug);
const generatedFaq: { q: string; a: string }[] = [];
if (!isLargePrint && pages)
	generatedFaq.push({
		q: `Is the ${ed.name} large print?`,
		a: `No. The ${ed.name} is a ${ed.trim ?? '6 x 9 in'} edition of ${pages.toLocaleString('en-US')} pages. For bigger type, the Father's Heart Bible™ Large Print edition sets the complete Bible in 14-point, single-column type across three volumes.`,
	});
if (usShip)
	generatedFaq.push({
		q: `How soon will the ${ed.name} arrive if I order it as a gift?`,
		a: `Each copy is printed to order. In the United States, free standard shipping arrives in about ${usShip.handlingDays[0] + usShip.transitDays[0]}–${usShip.handlingDays[1] + usShip.transitDays[1]} business days${usShip.fast ? `, and paid Expedited delivery in about ${usShip.fast.handlingDays[0] + usShip.fast.transitDays[0]}–${usShip.fast.handlingDays[1] + usShip.fast.transitDays[1]}` : ''}. Other countries see their own delivery estimate at checkout.`,
	});
const faqList = [...ed.faq, ...generatedFaq].map((f) => ({
	...f,
	a: fillFaqTokens(f.a, faqTokenValues(readerLanguages), `${ed.slug} faq`),
}));
const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqList.map((f) => ({
		'@type': 'Question',
		name: f.q,
		// Schema text is plain: strip <a> wrappers (keep their words); the visible FAQ keeps its links (W8-FIX-2).
		acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<a\s[^>]*>(.*?)<\/a>/gi, '$1') },
	})),
};
// Meta description, 140-165 chars on English pages (house AEO spec A12): when the sheet text is cut short at a
// sentence, a true closing line is added if it fits. Language pages keep their native text (<=160, native-meta test).
const metaBase = fitDescription(
	ed.seo?.description ??
		`The ${ed.name} — the complete Bible in Divine Voice™ Color. Hardcover, ${pages} pages.`,
	isLang ? 160 : 165,
);
const metaDescription =
	!isLang && metaBase.length < 140 && `${metaBase} 15% off first order.`.length <= 165
		? `${metaBase} 15% off first order.`
		: metaBase;
// Layout props (moved out of the tag: a // line inside a tag becomes attributes, which set <title> to "true"):
//  - title: audience editions = name + brand; language editions keep their native titles ending | FHB (Kevin 2026-11-14 item 6).
//  - image: 1200x630 JPG share card for every edition (model page approved as the standard, Kevin 2026-11-15);
//    the cover stays the Book/Product image in JSON-LD.
//  - preload: the cover is the LCP element on every width (SEO/AEO audit 2026-11-14).
---

<Layout
	pageType="book"
	alternates={alternates}
	ogAlternates={false}
	ogLang={nativeMeta ? ed.lang : undefined}
	bookIsbn={ed.isbn || undefined}
	bookReleaseDate={datePublished}
	title={fitTitle(isLang ? (ed.seo?.title ?? `${ed.name} | Father's Heart Bible™ (FHB)`) : `${ed.name} | Father's Heart Bible™ (FHB)`)}
	description={metaDescription}
	image={`https://assets.spiritmediapublishing.com/FHB/og/editions/v3/${ed.slug}-bible-og.jpg`}
	preloadImageMobile={coverUrl}
	preloadMobileIsLcp
	preloadImageDesktop={coverUrl}
	imageAlt={`${ed.name} — Father's Heart Bible in Divine Voice™ Color`}
>
	<script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
	{/* House AEO spec A9: Organization + WebSite on every page (SEO/AEO audit 2026-11-14). */}
	<script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebSite', '@id': 'https://fathersheartbible.com/#website', name: "Father's Heart Bible™", alternateName: 'FHB', url: 'https://fathersheartbible.com/', publisher: { '@id': 'https://spiritmediapublishing.com/#organization' } })} />

	<main>
		<Section variant="light">
			<div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-start max-w-5xl mx-auto">
				<!-- Front and back toggle, the way a retail listing does it (Kevin 2026-08-23).
				     Hover was wrong for this: it is undiscoverable, and it does not exist at all
				     on a phone, where most of this traffic lands. -->
				<div class="flex flex-col items-center">
					<div style="max-width: 340px; width: 100%;">
						<a href="#order" aria-label={`Order ${ed.name}`} class="cover-link" style="display: block;">
						{isLang ? (
							<LangCover code={langCode} name={ed.name} english={ed.english ?? ''} rtl={ed.dir === 'rtl'} variant="page" />
						) : (
							<img id="cover-main" src={coverUrl} alt={coverAlt} width="1200" height="1528" fetchpriority="high" decoding="async" class="block w-full h-auto" />
						)}
						</a>
					</div>
				</div>
				<div>
					<p style="font-family: var(--font-sans); color: #71717a; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; margin: 0 0 0.5rem;">{/* Kevin 2026-11-14: the label is the product name, not the colour feature alone. */}{isLang ? `${ed.english} edition · Father’s Heart Bible™ + Divine Voice™ Color` : 'Father’s Heart Bible™ + Divine Voice™ Color'}</p>
					<h1 lang={isLang ? ed.lang : undefined} dir={isLang ? ed.dir : undefined} style={`font-family: var(--font-headline); ${titleStyle} font-size: 2.4rem; font-weight: 600; margin: 0 0 0.6rem;`}>{ed.name}</h1>
					<p style="font-family: var(--font-body); color: var(--color-muted); font-size: 1rem; line-height: 1.55; margin: 0 0 0.6rem;">{ed.sub}</p>
					{/* Kevin 2026-11-14 item 9 (AEO): one plain answer to "what is it and who is it for" near the top. */}
					<p style="font-family: var(--font-body); color: var(--color-ink); font-size: 1rem; line-height: 1.55; margin: 0 0 1.2rem;">{`${ed.name} is the complete Father’s Heart Bible™ in Divine Voice™ Color, made for ${ed.audienceNoun}: our Father’s words in blue, the Son’s in red and the Spirit’s in purple.`}</p>
					<div class="flex flex-wrap items-center gap-2 mb-5">
						<span style={`font-family: var(--font-sans); font-weight: 800; font-size: 1.1rem; letter-spacing: 0.06em; color: ${VOICE.father}; background: #fff; border: 2px solid ${VOICE.father}; padding: 0.35rem 0.8rem; border-radius: 6px; line-height: 1;`}>FATHER</span>
						<span style={`font-family: var(--font-sans); font-weight: 800; font-size: 1.1rem; letter-spacing: 0.06em; color: ${VOICE.son}; background: #fff; border: 2px solid ${VOICE.son}; padding: 0.35rem 0.8rem; border-radius: 6px; line-height: 1;`}>SON</span>
						<span style={`font-family: var(--font-sans); font-weight: 800; font-size: 1.1rem; letter-spacing: 0.06em; color: ${VOICE.spirit}; background: #fff; border: 2px solid ${VOICE.spirit}; padding: 0.35rem 0.8rem; border-radius: 6px; line-height: 1;`}>SPIRIT</span>
					</div>
					{/* No price up here (Kevin 2026-10-05, B14a): it is the first thing a phone shows. The
					     price line leads the order form below, which "Order" jumps to. */}

					<div class="flex flex-wrap items-center gap-3">
						{/* Kevin 2026-11-14: "Seems useless to have order button directly above the order box" - removed; the box follows. */}
						<LookInside slug={ed.lookInsideKey ?? ed.slug} title={ed.name} size="lg" />
						{yvUrl && (
							<a href={yvUrl} target="_blank" rel="noopener" class="inline-flex items-center justify-center rounded-full font-semibold" style="font-family: var(--font-sans); background: #fff; color: #3f3f46; border: 2px solid #3f3f46; padding: 0.7rem 1.6rem; text-decoration: none; font-size: 1rem;">Read on Bible.com<span class="xsite-sr"> (opens in a new tab)</span></a>
						)}
					</div>
				</div>
			</div>
			{reserveOnly ? (
				<div id="order" class="max-w-3xl mx-auto rounded-2xl p-6 md:p-7 mt-10 text-center" style="background: #fff; border: 1px solid var(--color-hairline); scroll-margin-top: 90px;">
					<h2 style="font-family: var(--font-headline); color: var(--color-ink); font-size: 1.5rem; font-weight: 600; margin: 0 0 0.5rem;">Order the {ed.english} Edition direct</h2>
					<p style="font-family: var(--font-body); color: var(--color-muted); font-size: 1rem; line-height: 1.6; margin: 0 0 1.1rem;">This edition is in preparation: its ISBN, page count and price are assigned when the book is typeset. Reserve a copy now and we will write to you the day it can be ordered, direct from us with free shipping.</p>
					<MailtoLink email="hello@spiritmediapublishing.com" subject={RESERVE_SUBJECT} class="inline-flex items-center justify-center rounded-full font-semibold" style="font-family: var(--font-sans); background: var(--color-primary, #b60057); color: #fff; padding: 0.75rem 1.6rem; text-decoration: none; font-size: 0.95rem;">Reserve a copy by email</MailtoLink>
				</div>
			) : tblEdition(`${ed.slug}-bible`) ? (
				// TBL switch-over (src/lib/tbl.mjs tblEdition, kevin seat 2026-11-26 23:42Z, L3147): the edition is SOLD on The
				// Believer's Library (one store, SMP the seller); this page stays on FHB and its order box becomes one same-tab
				// Buy now to the edition's TBL page. The prices shown are the same engine prices TBL charges.
				<div id="order" class="max-w-xl mx-auto rounded-2xl p-6 md:p-7 mt-10 text-center" style="background: #fff; border: 1px solid var(--color-hairline); scroll-margin-top: 90px;" data-tbl-order>
					<h2 style="font-family: var(--font-headline); color: var(--color-ink); font-size: 1.5rem; font-weight: 600; margin: 0 0 0.75rem;">{orderHeading}</h2>
					{/* the same price line EditionOrder shows (paperback, then hardback; first-order unit + regular), read back by
					    scripts/pricing-verify.mjs against the server */}
					<div data-price-line>
						{[
							{ binding: orderT('p.paperback'), sku: `${orderRows[0].id}-pb`, usd: orderRows[0].pb },
							{ binding: orderT('p.hardback'), sku: `${orderRows[0].id}-hb`, usd: orderRows[0].hb },
						].map((l) => (
							<p data-line-sku={l.sku} style="font-family: var(--font-sans); color: var(--color-ink); font-size: 1rem; margin: 0 0 0.35rem;">
								<b>{l.binding}</b>{' '}<span data-first>{formatUsd(orderLang, firstOrderUnit(Math.round(l.usd * 100)))}</span>{' '}{orderLang === 'en' ? 'on your first order' : `· ${trOrder(ORDER_STRINGS[orderLang], 'p.firstOrder', { pct: FIRST_ORDER_PCT })}`}{' '}<s style="color: var(--color-muted);" data-reg>{formatUsd(orderLang, Math.round(l.usd * 100))}</s>
							</p>
						))}
					</div>
					<a href={tblEdition(`${ed.slug}-bible`)} data-tbl class="inline-flex items-center justify-center rounded-full font-semibold" style="font-family: var(--font-sans); background: var(--color-primary-fixed, #ffd9e0); color: var(--color-ink, #1a1c1c); border: 1.5px solid var(--color-primary, #b60057); min-height: 44px; padding: 0.5rem 1.6rem; text-decoration: none; font-size: 1rem; margin-top: 0.6rem;">{orderT('o.buyNow')}</a>
					{(preorder || awaitingPublication) && <p data-preorder-note style="font-family: var(--font-sans); color: var(--color-ink); font-size: 0.9rem; margin: 0.7rem 0 0;">{orderT('o.preorder')}</p>}
					<p style="font-family: var(--font-sans); color: var(--color-muted); font-size: 0.85rem; margin: 0.8rem 0 0;">{orderLang === 'en' || !orderLang ? `15% off first order + free standard shipping to ${LIVE_COUNTRIES.length} countries` : orderT('hero.freeShipValue')}</p>
				</div>
			) : (
				<EditionOrder offerLine={orderLang === 'en' || !orderLang ? `15% off first order + free standard shipping to ${LIVE_COUNTRIES.length} countries` : orderT('hero.freeShipValue')} titleStyle={coverTitle ? titleStyle : undefined} rows={orderRows} heading={orderHeading} returnPath={`/bibles/${ed.slug}-bible/`} lang={orderLang} note={preorder || awaitingPublication ? orderT('o.preorder') : undefined} />
			)}
		</Section>
		<Section variant="warm">
			<div class="max-w-3xl mx-auto">
				<h2 style="font-family: var(--font-headline); color: var(--color-ink); font-size: 1.8rem; font-weight: 600; margin: 0 0 1rem;">{ed.hook.h2}</h2>
				<div class="rounded-2xl p-7" style="background: #fff; border: 1px solid var(--color-hairline);">
					{hn && (
						<p lang={ed.lang} dir={ed.dir} style="font-family: var(--font-serif); font-size: 1.2rem; line-height: 1.8; color: var(--color-ink); margin: 0 0 1rem;" set:html={hookNativeHtml}></p>
					)}
					<p style="font-family: var(--font-serif); font-size: 1.1rem; line-height: 1.7; color: var(--color-ink); margin: 0;" set:html={hookHtml}></p>
					<a href={ed.hook.href} style="display: inline-block; font-family: var(--font-sans); font-weight: 700; font-size: 0.78rem; letter-spacing: 0.03em; color: var(--color-brand); margin: 1rem 0 0; text-decoration: none;">{ed.hook.ref} (FHB)</a>
				</div>
				<p style="font-family: var(--font-body); color: var(--color-muted); font-size: 1rem; line-height: 1.65; margin: 1.5rem 0 0;">{ed.hook.note}</p>
			</div>
		</Section>
		<!-- In brief, and the searches this edition is for -->
		<Section variant="light">
			<div class="max-w-3xl mx-auto">
				<h2 style="font-family: var(--font-headline); color: var(--color-ink); font-size: 1.8rem; font-weight: 600; margin: 0 0 1rem;">What makes this a Bible for {ed.audienceNoun}</h2>
				{ed.listing.short350.map((para) => (
					<p dir={isLang ? 'auto' : undefined} style="font-family: var(--font-body); color: var(--color-ink); font-size: 1.02rem; line-height: 1.7; margin: 0 0 0.9rem;" set:html={colorWords(para)}></p>
				))}
			</div>
		</Section>
		<!-- What this reader actually gets that no other edition has. "From the front matter"
		     named a location in the book; this names the value. (Kevin 2026-08-23) -->
		{!isLang && (<Section variant="soft">
			<div class="max-w-3xl mx-auto">
				<h2 style="font-family: var(--font-headline); color: var(--color-ink); font-size: 1.8rem; font-weight: 600; margin: 0 0 0.4rem;">{pillars.length ? `Identity, intimacy, and inheritance ${pillarSuffix.toLowerCase()}` : 'What every copy opens with'}</h2>
				<p style="font-family: var(--font-body); color: var(--color-muted); font-size: 0.98rem; line-height: 1.65; margin: 0 0 2rem;">Every copy opens with these pages, written for {ed.audienceSingular ?? ed.audienceNoun}, before Genesis 1:1.</p>

				<div class="grid gap-x-8 gap-y-4" style="grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); margin: 0 0 2.6rem;">
					{frontMatterParts.map(([name, what]) => (
						<div>
							<h3 style="font-family: var(--font-sans); color: var(--color-ink); font-size: 0.88rem; font-weight: 800; letter-spacing: 0.01em; margin: 0 0 0.2rem;">{name}</h3>
							<p style="font-family: var(--font-body); color: var(--color-muted); font-size: 0.92rem; line-height: 1.55; margin: 0;" set:html={colourInlineQuotes(escHtml(what))}></p>
						</div>
					))}
				</div>

				{pillars.map((pil) => (
					<div style="margin: 0 0 2.2rem;">
						<h3 style="font-family: var(--font-headline); color: var(--color-ink); font-size: 1.25rem; font-weight: 600; margin: 0 0 0.15rem;">{pil.title}</h3>
						<p style="font-family: var(--font-body); color: var(--color-muted); font-size: 0.97rem; font-style: italic; margin: 0 0 0.9rem;">{pil.line}</p>
						<dl style="margin: 0;">
							{pil.verses.map(([ref, text]) => (
								<div style="display: flex; gap: 0.75rem; align-items: baseline; padding: 0.4rem 0; border-top: 1px solid var(--color-hairline);">
									<dt style="font-family: var(--font-sans); font-size: 0.8rem; font-weight: 700; color: #3f3f46; white-space: nowrap; min-width: 7.5rem;">{ref}</dt>
									<dd style="font-family: var(--font-body); font-size: 0.97rem; line-height: 1.6; color: var(--color-ink); margin: 0;" set:html={colourVerse(ref, escHtml(text))}></dd>
								</div>
							))}
						</dl>
					</div>
				))}
				<div style="margin: 2.6rem 0 0;">
					<h3 style="font-family: var(--font-headline); color: var(--color-ink); font-size: 1.25rem; font-weight: 600; margin: 0 0 0.15rem;">{shared.hearing.title}</h3>
					<p style="font-family: var(--font-body); color: var(--color-muted); font-size: 0.97rem; font-style: italic; margin: 0 0 1.2rem;">{shared.hearing.line}</p>
					{shared.hearing.groups.map((g, gi) => (
						<div style={`margin: 0 0 ${gi === shared.hearing.groups.length - 1 ? '0' : '1.6rem'};`}>
							<h4 style="font-family: var(--font-sans); color: var(--color-ink); font-size: 0.98rem; font-weight: 800; margin: 0 0 0.35rem;">{g.h}</h4>
							<p style="font-family: var(--font-body); color: var(--color-ink); font-size: 0.99rem; line-height: 1.65; margin: 0 0 0.6rem;">{g.p}</p>
							<dl style="margin: 0;">
								{g.verses.map(([ref, text]) => (
								<div style="display: flex; gap: 0.75rem; align-items: baseline; padding: 0.4rem 0; border-top: 1px solid var(--color-hairline);">
									<dt style="font-family: var(--font-sans); font-size: 0.8rem; font-weight: 700; color: #3f3f46; white-space: nowrap; min-width: 7.5rem;">{ref}</dt>
									<dd style="font-family: var(--font-body); font-size: 0.97rem; line-height: 1.6; color: var(--color-ink); margin: 0;" set:html={colourVerse(ref, escHtml(text))}></dd>
								</div>
								))}
							</dl>
						</div>
					))}
				</div>

			</div>
		</Section>)}
		<!-- What's inside + product details, laid out as a retail listing rather than a list.
		     Warm background (Kevin 2026-11-14: "needs different background") so it does not run into the section above. -->
		<Section variant="warm">
			<div class="max-w-4xl mx-auto">
				<h2 style="font-family: var(--font-headline); color: var(--color-ink); font-size: 1.8rem; font-weight: 600; margin: 0 0 1.4rem;">What’s inside</h2>
				<div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-3 mb-10">
					{ed.listing.features.map((f) => (
						<div class="flex items-start gap-3">
							<span aria-hidden="true" style="color: #3f3f46; font-weight: 700; line-height: 1.6;">·</span>
							<span style="font-family: var(--font-body); color: var(--color-ink); font-size: 1rem; line-height: 1.6;">{f}</span>
						</div>
					))}
				</div>

				<h3 style="font-family: var(--font-headline); color: var(--color-ink); font-size: 1.25rem; font-weight: 600; margin: 0 0 0.9rem;">Product details</h3>
				<div class="rounded-2xl overflow-hidden" style="border: 1px solid var(--color-hairline); background: #fff;">
					{[
						// Kevin 2026-11-14: "put edition title at the top with both ISBNs."
						['Edition', ed.name],
						...(isbnPair?.pb || isbnPair?.hb
							? [
									['Paperback ISBN', isbnPair?.pb ?? ''],
									['Hardback ISBN', isbnPair?.hb ?? ''],
								]
							: [['ISBN-13', ed.isbn]]),
						['Publisher', 'Spirit Media Publishing'],
						['Publication date', ed.published],
						['Language', isLang ? ed.english : 'English'],
						// Language editions only: their page counts differ per language and come from each sheet.
						['Pages', isLang ? (pages ? String(pages) : 'Being set — final page count to come') : ''],
						['Translation', 'Father’s Heart Bible™ + Divine Voice™ Color'],
						// the trim size is on Dimensions (Kevin 2026-11-14: "Don't need 6x9 on binding")
						['Binding', binding.replace(/\(\s*jacketed\s*\)/i, '(jacketed)').replace(/,?\s*\d+(\.\d+)?\s*x\s*\d+(\.\d+)?(\s*in)?\s*$/i, '').trim()],
						['Dimensions', trim],
						['Interior', 'Full color throughout'],
						// (ISBNs now lead the table with the edition title; empty values are dropped below,
						// e.g. the Large Print SET, which has no ISBN of its own.)
						// BISAC codes are OFF the storefront (Kevin 2026-09-18). They are the book
						// trade's shelf classification and belong in the metadata sheet and the ONIX
						// feed, where retailers read them. A shopper has never heard of BISAC, and a
						// raw code like REL012160 reads as an error on a product page. Same rule as
						// "case laminate": trade vocabulary stays in the trade fields. The codes are
						// still carried in ed.listing.bisac for the feed — just not rendered here.
					]
						.filter(([, v]) => v)
						.map(([k, v], n) => (
						<div class="flex flex-wrap gap-2 px-5 py-3" style={`font-family: var(--font-sans); font-size: 0.9rem; ${n % 2 ? 'background: #fafafa;' : ''}`}>
							<span style="color: #71717a; min-width: 7.5rem;">{k}</span>
							{k === 'Publisher' ? (
								<a href="https://spiritmediapublishing.com" style="flex: 1; line-height: 0;"><img src="https://assets.spiritmediapublishing.com/spirit-media-publishing/smp-logo.webp" alt="" width="200" height="20" loading="lazy" decoding="async" style="width: 200px; max-width: 100%; height: auto;" /><span class="sr-only">Spirit Media Publishing</span><span class="xsite-line" style="margin-top: 0.25rem; color: #52525b; font-size: 0.85rem;"><span class="xsite-dest"> <span aria-hidden="true">·</span> spiritmediapublishing.com</span></span></a>
							) : (
								<span style={`color: ${k === 'Edition' ? smallTitleColor : 'var(--color-ink)'}; font-weight: 600; flex: 1;${k.includes('ISBN') ? ' white-space: nowrap;' : ''}`}>{v}</span>
							)}
						</div>
					))}
				</div>
			</div>
		</Section>
		<!-- The full listing — the same copy the Ingram record carries, not a summary
		     of it. Kevin 2026-08-23: "you have a full page to describe this bible, but you are
		     only given 10% of what we gave Ingram." -->
		<Section variant="light">
			<div class="max-w-3xl mx-auto">
				{ed.listing.long.map((sec) => ({ ...sec, body: sec.body.filter((p) => !shortSet.has(paraKey(p))) })).filter((sec) => sec.body.length).map((sec) => (
					<div class="mb-8">
						{sec.h && (<h2 dir={isLang ? 'auto' : undefined} style="font-family: var(--font-headline); color: var(--color-ink); font-size: 1.5rem; font-weight: 600; margin: 0 0 0.8rem;">{sec.h}</h2>)}
						{sec.body.map((para) => (
							<p dir={isLang ? 'auto' : undefined} style="font-family: var(--font-body); color: var(--color-ink); font-size: 1.02rem; line-height: 1.7; margin: 0 0 0.9rem;" set:html={colorWords(para)}></p>
						))}
					</div>
				))}
			</div>
		</Section>
		<!-- About the translation, and who made it -->
		<Section variant="warm">
			<div class="max-w-3xl mx-auto">
				<h2 style="font-family: var(--font-headline); color: var(--color-ink); font-size: 1.8rem; font-weight: 600; margin: 0 0 1rem;">About this translation</h2>
				{ed.translationStatement && (
					<p style="font-family: var(--font-body); color: var(--color-ink); font-size: 1.02rem; line-height: 1.7; margin: 0 0 0.9rem; font-weight: 600;">{ed.translationStatement}</p>
				)}
				{shared.about.map((para) => (
					<p style="font-family: var(--font-body); color: var(--color-ink); font-size: 1.02rem; line-height: 1.7; margin: 0 0 0.9rem;">{para}</p>
				))}

				<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-8 mb-8">
					{shared.credits.map(([k, v]) => (
						<div class="rounded-xl p-4" style="background: #fff; border: 1px solid var(--color-hairline);">
							<p style="font-family: var(--font-sans); color: #71717a; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; margin: 0 0 0.3rem;">{k}</p>
							{k === 'Published by' && v === 'Spirit Media Publishing' ? (
								/* Kevin 2026-11-14: "use smp logo ... here: Published by Spirit Media Publishing" */
								<a href="https://spiritmediapublishing.com" style="display: inline-block; line-height: 0;"><img src="https://assets.spiritmediapublishing.com/spirit-media-publishing/smp-logo.webp" alt="" width="220" height="22" loading="lazy" decoding="async" style="width: 220px; max-width: 100%; height: auto;" /><span class="sr-only">Spirit Media Publishing</span><span class="xsite-line" style="margin-top: 0.25rem; color: #52525b; font-size: 0.85rem;"><span class="xsite-dest"> <span aria-hidden="true">·</span> spiritmediapublishing.com</span></span></a>
							) : (
								<p style="font-family: var(--font-sans); color: var(--color-ink); font-weight: 600; margin: 0;">{v}</p>
							)}
						</div>
					))}
				</div>

				<h3 style="font-family: var(--font-headline); color: var(--color-ink); font-size: 1.2rem; font-weight: 600; margin: 0 0 0.6rem;">Kevin White</h3>
				<p style="font-family: var(--font-body); color: var(--color-muted); font-size: 0.98rem; line-height: 1.65; margin: 0 0 1.6rem;">{shared.bio}</p>
				<h3 style="font-family: var(--font-headline); color: var(--color-ink); font-size: 1.2rem; font-weight: 600; margin: 0 0 0.6rem;">Spirit Media Publishing</h3>
				<p style="font-family: var(--font-body); color: var(--color-muted); font-size: 0.98rem; line-height: 1.65; margin: 0;">{shared.publisher}</p>
			</div>
		</Section>

		<!-- The preface itself — the translation's own account of why it exists. -->
		<Section variant="light">
			<div class="max-w-3xl mx-auto">
				<h2 style="font-family: var(--font-headline); color: var(--color-ink); font-size: 1.8rem; font-weight: 600; margin: 0 0 1.4rem;">Why this translation exists</h2>
				{shared.preface.map((sec) => (
					<div style="margin: 0 0 1.7rem;">
						<h3 style="font-family: var(--font-sans); color: var(--color-ink); font-size: 0.98rem; font-weight: 800; margin: 0 0 0.5rem;">{sec.h}</h3>
						{sec.p.filter((para) => !editionSpecificNote(para)).map((para) => (
							<p style="font-family: var(--font-body); color: var(--color-ink); font-size: 1rem; line-height: 1.7; margin: 0 0 0.7rem;" set:html={colorWords(para)}></p>
						))}
					</div>
				))}
				<h3 style="font-family: var(--font-headline); color: var(--color-ink); font-size: 1.1rem; font-weight: 600; margin: 2.6rem 0 0.7rem;">Also known as</h3>
				<div class="flex flex-wrap gap-2">
					{visibleKeywords.map((k) => (
						<span lang={isLang && (/[^\x00-\x7F]/.test(k) || /\b(biblia|bibel|bijbel|bíblia)\b/i.test(k)) ? ed.lang : undefined} style="font-family: var(--font-sans); font-size: 0.82rem; color: #52525b; background: #fbe7f0; border: 1px solid #f0c4d8; border-radius: 999px; padding: 0.3rem 0.75rem;">{k}</span>
					))}
				</div>
			</div>
		</Section>
		<Section variant="soft">
			<div class="max-w-3xl mx-auto">
				{!isLang && siblings.length > 0 && (
					<nav aria-label="More Father’s Heart Bible editions" style="margin: 0 0 2.4rem;">
						{/* Kevin 2026-11-14 (SEO/AEO audit 14): link the other editions for the whole family. */}
						<h2 style="font-family: var(--font-headline); color: var(--color-ink); font-size: 1.4rem; font-weight: 600; margin: 0 0 0.8rem;">More Father’s Heart Bible editions</h2>
						<ul class="flex flex-wrap gap-2" style="list-style: none; padding: 0; margin: 0;">
							{siblings.map((x) => (
								<li><a href={`/bibles/${x.slug}-bible/`} style="display: inline-flex; align-items: center; min-height: 44px; padding: 0 0.95rem; font-family: var(--font-sans); font-size: 0.88rem; font-weight: 600; color: #52525b; background: #fbe7f0; border: 1px solid #f0c4d8; border-radius: 999px; text-decoration: none;">{x.name}</a></li>
							))}
						</ul>
					</nav>
				)}
				<h2 style="font-family: var(--font-headline); color: var(--color-ink); font-size: 1.8rem; font-weight: 600; margin: 0 0 1.2rem;">Questions</h2>
				<div class="space-y-3">
					{faqList.map((f) => (
						<details class="faq-item rounded-2xl" style="background-color: #fff; border: 1px solid #c4c4cc; overflow: hidden;">
							{/* Kevin 2026-11-14: gray text on white with a gray frame, like the order choices */}
							<summary class="flex items-center justify-between gap-4 px-5 py-4 font-semibold" style="font-family: var(--font-sans); color: #3f3f46; background: #fff;">
								<span>{f.q}</span>
							</summary>
							<div class="px-5 pb-5 -mt-1">
								<p style="font-family: var(--font-body); color: var(--color-muted); font-size: 0.95rem; line-height: 1.6;" set:html={colorWords(f.a)}></p>
							</div>
						</details>
					))}
				</div>
				<p style="font-family: var(--font-body); color: var(--color-muted); font-size: 0.95rem; margin: 1.75rem 0 0;">
					Looking for scripture rather than a copy to hold? {ed.relatedGuide && (<Fragment>Read <a href={ed.relatedGuide.href} style="color: var(--color-brand); font-weight: 600; text-decoration: none;">{ed.relatedGuide.label}</a>, or read</Fragment>)}{!ed.relatedGuide && 'Read'} the whole Bible free at <a href={READ_URL} style="color: var(--color-brand); font-weight: 600; text-decoration: none;">fathersheartbible.com/read</a>. See <a href="/print/" style="color: var(--color-brand); font-weight: 600; text-decoration: none;">every Divine Voice™ Color edition</a>.
				</p>
				{entryLinks.length > 0 && (
					<nav aria-label={`Read the ${ed.english} Bible free online`} style="margin: 1.5rem 0 0;">
						<h2 style="font-family: var(--font-headline); color: var(--color-ink); font-size: 1.25rem; font-weight: 600; margin: 0 0 0.75rem;">Read the {ed.english} Bible free online</h2>
						<ul lang={ed.lang} dir={ed.dir} style="display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; list-style: none; padding: 0; margin: 0; font-family: var(--font-body); font-size: 1rem;">
							{entryLinks.map((l) => (
								<li><a href={l.href} style="color: var(--color-brand); font-weight: 600; text-decoration: none;">{l.label}</a></li>
							))}
						</ul>
					</nav>
				)}
			</div>
		</Section>
	</main>
</Layout>


<style>
	.faq-item > summary { cursor: pointer; list-style: none; }
	.faq-item > summary::-webkit-details-marker { display: none; }
	.faq-item > summary::after { content: '+'; flex: none; font-size: 1.25rem; font-weight: 400; color: #71717a; }
	.faq-item[open] > summary::after { content: '−'; }
</style>
