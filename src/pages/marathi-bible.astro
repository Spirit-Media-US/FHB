---
// /marathi-bible — the Marathi Bible page.
//
// SUBJECT: the Marathi edition of the Father's Heart Bible. Same kind of page as
// /telugu-bible and the /guides/* series (same Layout, section order and schema
// stack) — deliberately NOT CountryBible, which answers demographic questions
// about a nation.
//
// EVERY CHAPTER LINKED HERE WAS CHOSEN FROM MEASURED DEMAND:
//   - Search Console, 90 days to 2026-09-16, pages containing /read/mr/:
//     psalm 91 in marathi (273 impressions, pos 6.2), psalm 23 in marathi (138),
//     stotrasahita 91 in marathi (122), psalm 91 marathi (84),
//     psalms 23 in marathi (57), stotrasahita 23 in marathi (54),
//     psalm 1 in marathi (45), deuteronomy in marathi (44),
//     स्तोत्रसंहिता 91 (38), psalm 51 in marathi (37),
//     ecclesiastes in marathi (33), psalm 100 in marathi (30),
//     samuel in marathi (25), matthew in marathi (21), daniel in marathi (18),
//     isaiah in marathi (16), प्रेषितांची कृत्ये (16).
//   - Ahrefs (projects/fhb-mr-seo/STUDY.md): `marathi bible` 2,800/mo KD 0,
//     `psalm 91 in marathi` 600, `psalm 23 in marathi` 350,
//     `स्तोत्रसंहिता 91` 150, `psalm 51 in marathi` 70, `psalm 121 in marathi` 50.
//
// TWO MEASURED TRAPS, deliberately not served (STUDY.md §2-3):
//   - `proverbs in marathi` (900) is मराठी म्हणी, folk sayings, not the book.
//   - `yohan` (1,100) is the personal name, not the Gospel of John.
// And the Latin-script form Marathi searchers use is the ENGLISH book name
// ("psalm 91 in marathi"), never a transliteration — which is why the chapter
// list below reads that way and the URLs use English book slugs.
//
// NO AUDIO CLAIM. src/lib/audio-reader.ts narrates English only; Marathi has no
// published narration.
//
// Canon figures (66 books / 1,189 chapters) are MEASURED from
// /srv/sites/community/src/content/bible-mr.
import AuthorBio from '../components/AuthorBio.astro';
import ReviewLink from '../components/ReviewLink.astro';
import Layout from '../layouts/Layout.astro';

const PAGE_URL = 'https://fathersheartbible.com/marathi-bible/'; // trailing slash = the canonical form Layout.astro emits
const TITLE = "Marathi Bible — Read the Father's Heart Bible Free Online";
const DESCRIPTION =
	'Marathi Bible: read the Father’s Heart Bible free online — all 66 books, 1,189 chapters, in Marathi. No account, no app. A fresh translation revealing our Father.';
const PUBLISHED = '2026-09-19';
const MODIFIED = '2026-09-19';

const READ_MR = 'https://fathersheartbible.com/read/mr/';

const formatDate = (iso: string) =>
	new Date(`${iso}T12:00:00Z`).toLocaleDateString('en-US', {
		year: 'numeric',
		month: 'long',
		day: 'numeric',
	});

const KEVIN_WHITE_AUTHOR = {
	'@type': 'Person',
	'@id': 'https://kevinwhite.us/#person',
	name: 'Kevin White',
	url: 'https://kevinwhite.us',
	jobTitle: 'Founder & CEO, Spirit Media Publishing',
	affiliation: {
		'@type': 'Organization',
		'@id': 'https://spiritmediapublishing.com/#organization',
		name: 'Spirit Media Publishing',
	},
	sameAs: [
		'https://kevinwhite.us',
		'https://kevinwhite.us/about/',
		'https://www.linkedin.com/in/kevinwhiteus/',
		'https://www.youtube.com/@KevinWhiteus',
		'https://spiritmediapublishing.com',
	],
};

// Marathi chapter demand is almost entirely Psalms (स्तोत्रसंहिता), in that order.
const PSALMS = [
	{
		ch: 91,
		note: 'He who dwells in the shelter of the Most High — the most-read chapter in Marathi on this site, by a wide margin.',
	},
	{ ch: 23, note: 'The Lord is my shepherd — six verses, and the one most people come back to.' },
	{ ch: 1, note: 'Like a tree planted by streams of water.' },
	{ ch: 51, note: 'Create in me a clean heart — the prayer for a fresh start.' },
	{ ch: 100, note: 'Enter His gates with thanksgiving.' },
];

// The books Marathi readers ask for by name, outside the Psalms. Each opens at
// chapter one.
const BOOKS = [
	{
		slug: 'deuteronomy',
		mr: 'अनुवाद',
		en: 'Deuteronomy',
		note: 'Moses’ last words to a people about to go home.',
	},
	{
		slug: 'ecclesiastes',
		mr: 'उपदेशक',
		en: 'Ecclesiastes',
		note: 'The honest book — everything under the sun, weighed.',
	},
	{
		slug: '1-samuel',
		mr: '१ शमुवेल',
		en: '1 Samuel',
		note: 'A boy who hears his name called in the night.',
	},
	{ slug: 'matthew', mr: 'मत्तय', en: 'Matthew', note: 'The Gospel that opens the New Testament.' },
	{ slug: 'isaiah', mr: 'यशया', en: 'Isaiah', note: 'Comfort, comfort my people.' },
	{
		slug: 'daniel',
		mr: 'दानीएल',
		en: 'Daniel',
		note: 'Faithfulness in exile, and a fourth man in the fire.',
	},
	{
		slug: 'acts',
		mr: 'प्रेषितांची कृत्ये',
		en: 'Acts',
		note: 'How the family spread from one room to the world.',
	},
];

const FAQS = [
	{
		question: 'Is there a free Marathi Bible I can read online?',
		answer:
			"Yes. The Father's Heart Bible™ is free to read online in Marathi — all 66 books and 1,189 chapters, with no account, no purchase and no app to install. Open it at fathersheartbible.com/read/mr/ on any phone or computer.",
	},
	{
		question: "What is the Father's Heart Bible in Marathi?",
		answer:
			'पित्याच्या हृदयाचे बायबल — a fresh Marathi translation of the whole Bible whose distinctive is that it reveals God as our Father wherever Scripture reveals Him that way. It is a new translation rather than a revision of an existing Marathi Bible, made book by book from Genesis to Revelation.',
	},
	{
		question: 'How do I read Psalm 91 in Marathi?',
		answer:
			'Psalm 91 — स्तोत्रसंहिता 91 — is at fathersheartbible.com/read/mr/psalms/91/, free and with no sign-in. It is the most-read chapter of the Marathi edition; Psalm 23, Psalm 1, Psalm 51 and Psalm 100 follow it.',
	},
	{
		question: 'What is the book of Psalms called in Marathi?',
		answer:
			'स्तोत्रसंहिता (stotrasanhita). Most people searching in Latin script still type the English name — "psalm 91 in marathi" rather than a transliteration — so both work on this site: /read/mr/psalms/91/ opens the Marathi chapter.',
	},
	{
		question: 'Does the Marathi Bible have audio?',
		answer:
			"Not yet. Audio narration is currently available on the English edition of the Father's Heart Bible™. The Marathi text is complete and free to read today; Marathi narration is not yet published.",
	},
	{
		question: 'Is the whole Bible available in Marathi, or only part of it?',
		answer:
			'The whole Bible. The Marathi edition publishes all 66 books and every one of their 1,189 chapters — Old Testament and New — not a sample or a selection.',
	},
];

const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: 'Marathi Bible: Read the Father’s Heart Bible Free Online',
	description: DESCRIPTION,
	author: KEVIN_WHITE_AUTHOR,
	publisher: {
		'@type': 'Organization',
		'@id': 'https://spiritmediapublishing.com/#organization',
		name: 'Spirit Media Publishing',
		url: 'https://spiritmediapublishing.com',
	},
	url: PAGE_URL,
	mainEntityOfPage: { '@type': 'WebPage', '@id': PAGE_URL },
	datePublished: PUBLISHED,
	dateModified: MODIFIED,
	inLanguage: 'en-US',
	about: { '@type': 'Language', name: 'Marathi', alternateName: 'मराठी' },
	articleSection: 'Bible Translations',
	keywords:
		'marathi bible, bible in marathi, marathi bible online, psalm 91 in marathi, stotrasanhita',
};
const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://fathersheartbible.com/' },
		{ '@type': 'ListItem', position: 2, name: 'Marathi Bible', item: PAGE_URL },
	],
};
const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: FAQS.map((f) => ({
		'@type': 'Question',
		name: f.question,
		acceptedAnswer: { '@type': 'Answer', text: f.answer },
	})),
};
const jsonLd = [articleSchema, breadcrumbSchema, faqSchema];

const TOC = [
	{ id: 'what-it-is', label: 'What it is' },
	{ id: 'how-it-reads', label: 'How it reads in Marathi' },
	{ id: 'psalms', label: 'स्तोत्रसंहिता — the Psalms' },
	{ id: 'books', label: 'Books people ask for' },
	{ id: 'find-a-chapter', label: 'Finding a chapter' },
	{ id: 'faq', label: 'FAQ' },
];
---

<Layout title={TITLE} description={DESCRIPTION} jsonLd={jsonLd} pageType="article" articleAuthor="Kevin White" articlePublishedTime={PUBLISHED} articleSection="Bible Translations" articleTags={["Marathi Bible", "Bible in Marathi", "Father's Heart Bible"]}>
	<main id="main-content">
		<section class="px-6 pt-10 pb-2 lg:px-8" style="background-color: var(--color-surface-low);">
			<div class="mx-auto max-w-3xl">
				<nav aria-label="Breadcrumb" class="mb-5 text-sm" style="color: var(--color-muted); font-family: var(--font-sans);">
					<a href="/" class="hover:underline">Home</a><span class="px-1.5" aria-hidden="true">/</span>
					<span style="color: var(--color-ink);">Marathi Bible</span>
				</nav>
				<p class="text-xs font-semibold uppercase tracking-widest mb-4" style="color: var(--color-brand); font-family: var(--font-sans);" lang="mr">मराठी बायबल</p>
				<h1 class="text-4xl md:text-5xl font-light leading-tight" style="font-family: var(--font-serif); color: var(--color-ink);">The Marathi Bible</h1>
				<div class="flex items-center gap-3 mt-5 pb-8 text-sm border-b flex-wrap" style="color: var(--color-muted); font-family: var(--font-sans); border-color: var(--color-hairline);">
					<span>By <a href="/the-fathers-heart-bible/leadership/" class="font-semibold hover:underline" style="color: var(--color-ink);">Kevin White</a> &mdash; leading the Father&rsquo;s Heart Bible&trade; translation</span>
					<span aria-hidden="true">&middot;</span><span>{formatDate(PUBLISHED)}</span>
				</div>
			</div>
		</section>

		<section class="px-6 py-10 lg:px-8 lg:py-14" style="background-color: var(--color-surface);">
			<div class="mx-auto max-w-3xl">
				<p class="text-lg leading-relaxed mb-5" style="font-family: var(--font-sans); color: var(--color-muted);">
					<strong style="color: var(--color-ink);">You can read the whole Bible in Marathi, free, right now &mdash; all 66 books and 1,189 chapters of the Father&rsquo;s Heart Bible&trade;, with no account, no purchase and no app.</strong> The Marathi edition, <span lang="mr">पित्याच्या हृदयाचे बायबल</span>, is a fresh translation rather than a revision of an older one, and it carries the distinctive the whole project exists for: wherever Scripture reveals God as a Father, this Bible says so plainly. <a href={READ_MR} style="color: var(--color-brand);" class="hover:underline">Open the Marathi reader</a> and you can be in <span lang="mr">स्तोत्रसंहिता</span> 91 in a few seconds.
				</p>

				<aside class="my-7 px-6 py-5 rounded-2xl" style="background-color: #fdf2f5; border: 1px solid #f9d6e0;">
					<p class="text-xs font-semibold uppercase tracking-widest mb-2" style="color: var(--color-brand); font-family: var(--font-sans);">Key takeaway</p>
					<p class="text-lg leading-relaxed" style="font-family: var(--font-serif); color: var(--color-ink);">The complete Bible in Marathi, free online &mdash; a fresh translation that lets Marathi readers hear God speak as a Father.</p>
				</aside>

				<nav aria-label="On this page" class="my-8 px-5 py-4 rounded-xl" style="background-color: var(--color-surface-low); border: 1px solid var(--color-hairline);">
					<p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: var(--color-muted); font-family: var(--font-sans);">On this page</p>
					<ul class="flex flex-wrap gap-x-5 gap-y-2 list-none m-0 p-0 text-sm" style="font-family: var(--font-sans);">
						{TOC.map((t) => (<li><a href={`#${t.id}`} class="hover:underline" style="color: var(--color-brand);">{t.label}</a></li>))}
					</ul>
				</nav>

				<h2 id="what-it-is" class="text-2xl md:text-3xl font-light mt-12 mb-4 scroll-mt-28" style="font-family: var(--font-serif); color: var(--color-ink);">What the Marathi Father&rsquo;s Heart Bible is</h2>
				<p class="text-lg leading-relaxed mb-4" style="font-family: var(--font-sans); color: var(--color-muted);">It is the complete Bible in Marathi: sixty-six books, 1,189 chapters, Genesis through Revelation, published in full rather than as a sample. It lives online and it is free &mdash; no sign-up wall, nothing to buy, nothing to install before you can read. Every chapter has its own permanent address, so a chapter you find today can be bookmarked, sent to someone in a message, or opened again next year at the same link.</p>
				<p class="text-lg leading-relaxed mb-4" style="font-family: var(--font-sans); color: var(--color-muted);">It is a fresh translation, not a re-typeset of an existing Marathi Bible. That distinction carries the whole point. What this translation exists to recover is the family language of Scripture: where the text reveals God as a Father to His sons and daughters, the Father&rsquo;s Heart Bible&trade; renders it that way in Marathi, rather than flattening it into the vocabulary of a distant ruler. You can read <a href="/the-fathers-heart-bible/" style="color: var(--color-brand);" class="hover:underline">why the translation exists</a>, and see <a href="/a-bible-for-the-whole-world/" style="color: var(--color-brand);" class="hover:underline">the other languages it is being made in</a>.</p>

				<h2 id="how-it-reads" class="text-2xl md:text-3xl font-light mt-12 mb-4 scroll-mt-28" style="font-family: var(--font-serif); color: var(--color-ink);">How this translation reads in Marathi</h2>
				<p class="text-lg leading-relaxed mb-4" style="font-family: var(--font-sans); color: var(--color-muted);">Marathi has carried Scripture for a long time, in language that is often formal and dignified. This edition does not try to out-formalise it. It aims at the Marathi a household actually speaks, because the relationship the text describes is a household one &mdash; a Father and His children, not a sovereign and his subjects.</p>
				<p class="text-lg leading-relaxed mb-4" style="font-family: var(--font-sans); color: var(--color-muted);">The books keep their Marathi names &mdash; <span lang="mr">उत्पत्ति</span> for Genesis, <span lang="mr">स्तोत्रसंहिता</span> for Psalms, <span lang="mr">योहान</span> for John, <span lang="mr">प्रेषितांची कृत्ये</span> for Acts &mdash; while the chapter addresses use the English book names, because that is what Marathi readers searching in Latin script actually type. Read a few chapters and the difference shows up fast: our Father speaks to His people as His own, and the text lets Him.</p>

				<h2 id="psalms" class="text-2xl md:text-3xl font-light mt-12 mb-4 scroll-mt-28" style="font-family: var(--font-serif); color: var(--color-ink);"><span lang="mr">स्तोत्रसंहिता</span> &mdash; the Psalms Marathi readers open most</h2>
				<p class="text-lg leading-relaxed mb-4" style="font-family: var(--font-sans); color: var(--color-muted);">Nearly everyone who comes to the Marathi Bible comes to a Psalm, and a small handful account for most of it. These are those chapters, in the order they are actually read &mdash; each a direct link into the Marathi text:</p>
				<ul class="space-y-3 mb-4 pl-5 text-lg leading-relaxed" style="font-family: var(--font-sans); color: var(--color-muted); list-style: disc;">
					{PSALMS.map((p) => (
						<li>
							<a href={`${READ_MR}psalms/${p.ch}/`} style="color: var(--color-brand);" class="hover:underline font-semibold"><span lang="mr">स्तोत्रसंहिता</span> {p.ch} &mdash; Psalm {p.ch} in Marathi</a>
							<span> &mdash; {p.note}</span>
						</li>
					))}
				</ul>
				<p class="text-lg leading-relaxed mb-4" style="font-family: var(--font-sans); color: var(--color-muted);">If you read one chapter, read <a href={`${READ_MR}psalms/91/`} style="color: var(--color-brand);" class="hover:underline"><span lang="mr">स्तोत्रसंहिता</span> 91</a>. It is the chapter Marathi readers open more than any other here, and it is a promise of shelter spoken over anyone who will take it.</p>

				<h2 id="books" class="text-2xl md:text-3xl font-light mt-12 mb-4 scroll-mt-28" style="font-family: var(--font-serif); color: var(--color-ink);">The books Marathi readers ask for by name</h2>
				<p class="text-lg leading-relaxed mb-4" style="font-family: var(--font-sans); color: var(--color-muted);">Beyond the Psalms, these are the books most often looked up in Marathi. Each link opens at chapter one, and every chapter of each is published:</p>
				<ul class="space-y-3 mb-4 pl-5 text-lg leading-relaxed" style="font-family: var(--font-sans); color: var(--color-muted); list-style: disc;">
					{BOOKS.map((b) => (
						<li>
							<a href={`${READ_MR}${b.slug}/1/`} style="color: var(--color-brand);" class="hover:underline font-semibold"><span lang="mr">{b.mr}</span> &mdash; {b.en} in Marathi</a>
							<span> &mdash; {b.note}</span>
						</li>
					))}
				</ul>

				<h2 id="find-a-chapter" class="text-2xl md:text-3xl font-light mt-12 mb-4 scroll-mt-28" style="font-family: var(--font-serif); color: var(--color-ink);">Finding any chapter in the Marathi Bible</h2>
				<p class="text-lg leading-relaxed mb-4" style="font-family: var(--font-sans); color: var(--color-muted);">Every Marathi chapter has a plain, permanent address made of the book name and the chapter number:</p>
				<ul class="space-y-2 mb-4 pl-5 text-lg leading-relaxed" style="font-family: var(--font-sans); color: var(--color-muted); list-style: disc;">
					<li><code>fathersheartbible.com/read/mr/psalms/91/</code> &mdash; Psalm 91</li>
					<li><code>fathersheartbible.com/read/mr/genesis/1/</code> &mdash; Genesis 1</li>
					<li><code>fathersheartbible.com/read/mr/john/3/</code> &mdash; John 3</li>
				</ul>
				<p class="text-lg leading-relaxed mb-4" style="font-family: var(--font-sans); color: var(--color-muted);">There is nothing to memorise. <a href={READ_MR} style="color: var(--color-brand);" class="hover:underline">Open the Marathi reader</a> and choose the book and chapter from the list, or use the picker inside any chapter to jump straight to a verse.</p>

				<aside class="my-12 px-6 py-10 lg:px-10 lg:py-12 rounded-2xl text-center" style="background-color: #fdf2f5; border: 1px solid #f9d6e0;">
					<p class="text-2xl md:text-3xl font-light leading-tight max-w-2xl mx-auto" style="font-family: var(--font-serif); color: var(--color-ink);">Read the Marathi Bible free</p>
					<p class="mt-4 max-w-2xl mx-auto text-base lg:text-lg leading-relaxed" style="font-family: var(--font-sans); color: var(--color-muted);">The whole Bible in Marathi, online and free &mdash; a fresh translation revealing God as a loving Father to His sons and daughters.</p>
					<a href={`${READ_MR}psalms/91/`} class="inline-flex items-center gap-2 mt-7 px-7 py-3 rounded-full text-sm font-semibold no-underline transition-opacity hover:opacity-90" style="background-color: #FFD9E0; color: #4A4A4A; font-family: var(--font-sans);">Open <span lang="mr">स्तोत्रसंहिता</span> 91<span aria-hidden="true">&rarr;</span></a>
				</aside>

				<h2 id="faq" class="text-2xl md:text-3xl font-light mt-12 mb-6 scroll-mt-28" style="font-family: var(--font-serif); color: var(--color-ink);">Frequently asked questions</h2>
				<div class="space-y-6">
					{FAQS.map((f) => (<div><h3 class="text-xl font-medium mb-2" style="font-family: var(--font-serif); color: var(--color-ink);">{f.question}</h3><p class="text-lg leading-relaxed" style="font-family: var(--font-sans); color: var(--color-muted);">{f.answer}</p></div>))}
				</div>

				<div class="mt-12 pt-8 border-t" style="border-color: var(--color-hairline);">
					<p class="text-sm leading-relaxed" style="font-family: var(--font-sans); color: var(--color-muted);">
						Keep going: open the <a href={READ_MR} style="color: var(--color-brand);" class="hover:underline">Marathi Bible</a> or the <a href="/telugu-bible/" style="color: var(--color-brand);" class="hover:underline">Telugu Bible</a>, see <a href="/a-bible-for-the-whole-world/" style="color: var(--color-brand);" class="hover:underline">every language the Father&rsquo;s Heart Bible is being translated into</a>, learn <a href="/the-fathers-heart-bible/" style="color: var(--color-brand);" class="hover:underline">why this translation exists</a>, or read about <a href="/bible-in/india/" style="color: var(--color-brand);" class="hover:underline">the Bible in India</a>. New to Scripture? Start with <a href="/guides/where-to-start-reading-the-bible/" style="color: var(--color-brand);" class="hover:underline">where to start reading the Bible</a>.
					</p>
				</div>
			</div>
		</section>

		<section class="px-6 py-12 lg:px-8 lg:py-16" style="background-color: var(--color-surface-low);">
			<div class="mx-auto max-w-2xl text-center">
				<h2 class="text-2xl md:text-3xl font-light leading-tight" style="font-family: var(--font-serif); color: var(--color-ink);">The whole Bible, in Marathi, free</h2>
				<p class="mt-4 text-base lg:text-lg leading-relaxed" style="font-family: var(--font-sans); color: var(--color-muted);">Sixty-six books and 1,189 chapters, online at no cost &mdash; a fresh Marathi translation that reveals God as a loving Father.</p>
				<a href={READ_MR} class="inline-flex items-center gap-2 mt-6 px-7 py-3 rounded-full text-sm font-semibold no-underline transition-colors" style="background-color: var(--color-brand); color: var(--color-on-primary); font-family: var(--font-sans);">Read in Marathi<span aria-hidden="true">&rarr;</span></a>
			</div>
		</section>

		<ReviewLink class="mb-10" />

		<AuthorBio author="Kevin White" />
	</main>
</Layout>
