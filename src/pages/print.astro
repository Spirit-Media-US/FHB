---
import BuyControls from '../components/BuyControls.astro';
import CatalogOrderForm from '../components/CatalogOrderForm.astro';
import LookInside from '../components/LookInside.astro';
import Section from '../components/Section.astro';
import VideoHeroInner from '../components/VideoHeroInner.astro';
import VoiceChips from '../components/VoiceChips.astro';
// GENERATED from the SMP bookstore's Sanity documents by scripts/sync-amazon-links.mjs —
// the bookstore is the one master for an Amazon link and no ASIN is typed into this page.
// An edition absent from this file keeps its "coming soon" state, so a listing appearing
// later needs a re-run of the sync, not an edit here.
import amazonLinks from '../data/amazon-links.json';
import { cardUrl } from '../data/card-art';
import digital from '../data/digital-listings.json';
import { dvcEditions as dvcEditionList } from '../data/dvc-editions';
import {
	comingSoonEditions,
	LANG_HB,
	LANG_PB,
	LANGUAGE_EDITION_TOTAL,
	langSlug,
	languageEditions,
} from '../data/language-editions';
import lookinsideData from '../data/lookinside.json';
import Layout from '../layouts/Layout.astro';

// THE DIVINE VOICE COLOR LINE — 15 targeted 6x9 editions + the 8x10 journaling
// edition. Every subtitle in the trade metadata ends with the same tail ("Red Letter -
// Blue Letter - Purple Letter - Three-Color Divine Voice - Complete Bible"), so the cards
// carry only the part that is UNIQUE to each Bible and the shared tail is stated once,
// under the page header (Kevin 2026-08-23: "Don't need to repeat same things over and
// over each card"). Copy is lifted from the metadata sheets so the site and the trade
// listings cannot drift apart.
// The spec, stated once for all sixteen. Concrete facts rather than "premium" — every
// Bible on the shelf claims premium; 6x9 case-laminate hardback, full color and
// 888 pages is checkable and does more selling (Kevin asked 2026-08-23; the figure was
// 876 until Kevin approved the 888pp set on 2026-09-14, D67 — the argument is unchanged).
const DVC_TAIL = 'Full Color Throughout · 6×9 · Hardback or Paperback';
const DVC_TAIL2 =
	'Red Letter \u00b7 Blue Letter \u00b7 Purple Letter \u00b7 Three-Color Divine Voice \u00b7 Complete Bible';
// The audience editions and their spec helpers live in src/data/dvc-editions.ts (shared with /print/order/).
// Runtime value used in the template below (biome cannot see .astro template use, keep this line).
const dvcEditions = dvcEditionList;
// Kevin 2026-10-10 (3b): every card in the section counts, the 8x10 journaling edition included.
const AUDIENCE_TOTAL = dvcEditionList.length;

// Digital editions. Every eBook / audiobook store link comes from src/data/digital-listings.json —
// the one master, each entry added only after its store page answered with the right title
// (2026-10-10). The English eBook is also sold direct here ($7.49, our own fulfillment). Apple
// Books and Nook were removed 2026-10-10: both listings 404 since D2D refused distribution.
const digitalEn = digital.en;
const EBOOK_COVER =
	'https://assets.spiritmediapublishing.com/FHB/print/fhb-ebook-cover-2026-6-600.webp';
const EBOOK_COVER_2X =
	'https://assets.spiritmediapublishing.com/FHB/print/fhb-ebook-cover-2026-6-1200.webp';
const storeLogo = (store: string) =>
	store === 'Kindle'
		? ('amazon' as const)
		: store === 'Kobo'
			? ('kobo' as const)
			: ('google' as const);
const EBOOK_DIRECT = '$7.49';

// ───────────────────────── GENERAL AUDIENCE ─────────────────────────
// The same Divine Voice Color Bible without an audience on the cover, in three cover
// colours and two bindings, in Regular and Large Print. Added 2026-08-29.
//
// ORDER ON THE PAGE — targeted editions FIRST, then these. Kevin ruled it and the search
// data backs it: Amazon autocomplete for "bible for" returns nine AUDIENCE terms and zero
// translations, and "large print bible" completes to "large print bibles for seniors" then
// ESV/NIV/KJV/NLT — so large print demand is itself audience-shaped and its remaining slots
// belong to acronyms we cannot outrank. Leading with these would open on our weakest lane.
// Do not reorder without new measurements.
//
// One CARD per colour carrying both binding prices, rather than six near-identical cards
// per line — twelve more covers directly under the sixteen targeted ones reads as noise.
// Card art comes from `cardUrl` (src/data/card-art.ts). There is no CARD_V any more: the
// general covers needed one because an earlier re-render was written over the same R2 keys
// and the edge kept serving the withdrawn art. The re-rendered cards went to NEW keys
// instead, which needs no cache-buster and leaves what is live untouched.
// The Large Print volume cards are new keys (lp-vol1/2/3, lp-set), so nothing is cached for
// them yet — but they get their own cache-buster because they are re-rendered on their own
// schedule, and they are not in the card-art set.
// The Large Print cards moved to a NEW PREFIX, FHB/print/lp/v2/, rebuilt in the flat
// house style (Kevin 2026-09-17: "Just need new LPs to match"). New keys, so there is
// nothing cached to bust and LP_CARD_V is gone — the old angled cards stay untouched at
// their own keys, which makes the swap reversible by changing this one path back.
//
// v3 (Kevin 2026-09-17, on seeing Vol 3 live: "are NOT like the others"). v2 was built by
// build_lp_flat_cards.py, which had drifted from the house renderer: it cut a real spine
// strip from each case PDF and scaled its width by the volume's measured thickness, so the
// LP cards carried a wide gradient-shaded spine block, a hard outline and no cast shadow —
// a different product family beside the sixteen DVC cards, and worst on Vol 3, whose Mist
// Blue cover is nearest the grey wash. v3 renders through lifted_from_wrap.py, the same flat
// house renderer behind the live cards, via mockups/build_lp_house_cards.py. Asked whether
// the LP spine should show true thickness, Kevin chose the house look exactly — the card
// sells the cover, the listing sells the book, so a 680pp and a 1,142pp volume get the same
// board edge. New prefix again per D165: v2 is untouched and this reverts by path alone.
// v4 (2026-09-17): v3 composited the book onto OPAQUE WHITE and saved RGB, so every LP
// card carried a white square where the sixteen house cards let the tile's warm grey show
// through — Kevin saw it as "white background instead of gray". v4 is the same render on a
// TRANSPARENT frame, saved RGBA. Verified by the corner pixel's alpha, not by eye.
const LP_CARDS = 'https://assets.spiritmediapublishing.com/FHB/print/lp/v4';
const GENERAL_TAIL = 'Full Color Throughout · 6×9 Paperback or Hardback';
const LP_TAIL = 'Large Print · Full Color Throughout · 6×9 Paperback or Hardback';
const generalColors = [
	{ key: 'charcoal', name: 'Charcoal' },
	{ key: 'plum', name: 'Plum' },
	{ key: 'white', name: 'White' },
];
// Prices in dollars; ISBNs are per binding. MUST match functions/dvc-checkout.ts EDITIONS.
//
// THE COLOUR ISBNs, not the B&W ones (Kevin 2026-09-11): a black-and-white ISBN cannot carry
// a full-colour edition, so 291-4/292-1/293-8/294-5/295-2/306-5 are RETIRED and replaced by
// the six below. Authority is projects/fhb-print-bible/editions/ISBNS.json — never retype a
// number from memory; scripts/pricing-verify.mjs fails the build if these drift from it.
//
// LARGE PRINT IS NO LONGER A LINE HERE. It is three volumes, not three cover colours of one
// book, so it has its own block below.
const generalLines = [
	{
		line: 'regular',
		label: 'Regular Print',
		tail: GENERAL_TAIL,
		pb: 79.99,
		hb: 99.99,
		isbn: {
			charcoal: { pb: '979-8-89307-333-1', hb: '979-8-89307-336-2' },
			plum: { pb: '979-8-89307-334-8', hb: '979-8-89307-337-9' },
			white: { pb: '979-8-89307-335-5', hb: '979-8-89307-338-6' },
		},
	},
];

// ───────────────────────── LARGE PRINT — THREE VOLUMES ─────────────────────────
// The single-volume Large Print is RETIRED (ISBNs 307-2/308-9/309-6/310-2/311-9/312-6). It
// was an ABRIDGED book — 30 books in full text, the other 36 as selected passages — because
// the complete text at 14pt does not fit one binding. The set is the whole Bible: one cover
// colour per volume, 2,956 pages across three books (Kevin 2026-09-11 and 2026-09-14,
// "Large Print Colour IS the 3-volume set").
// Page counts are MEASURED from current/fhb-interior-lp-vol{1,2,3}.pdf; prices are Kevin's,
// from ISBNS.json — Vol 3 is about half the size of Vols 1 and 2 and is priced accordingly.
const lpVolumes = [
	{
		key: 'lp-vol1',
		vol: 1,
		range: 'Genesis–Esther',
		color: 'Wheat',
		pages: 1134,
		pb: 99.99,
		hb: 114.99,
		isbn: { pb: '979-8-89307-339-3', hb: '979-8-89307-343-0' },
	},
	{
		key: 'lp-vol2',
		vol: 2,
		range: 'Job–Malachi',
		color: 'Sage',
		pages: 1142,
		pb: 99.99,
		hb: 114.99,
		isbn: { pb: '979-8-89307-340-9', hb: '979-8-89307-345-4' },
	},
	{
		key: 'lp-vol3',
		vol: 3,
		range: 'New Testament',
		color: 'Mist Blue',
		pages: 680,
		pb: 79.99,
		hb: 99.99,
		isbn: { pb: '979-8-89307-341-6', hb: '979-8-89307-344-7' },
		// Its Amazon buttons went live 2026-09-24 once both listings appeared (D164 said leave
		// them inactive UNTIL then); the links come from amazon-links.json like every volume.
	},
];
// THE STRUCK-THROUGH LIST PRICE IS COMPUTED, NEVER TYPED. It is the sum of the three volume
// prices, so it moves by itself if a volume price moves — which is the whole point. Typing
// "$329.97" would go stale silently and advertise a saving we do not give.
const lpListPb = lpVolumes.reduce((s, v) => s + v.pb, 0);
const lpListHb = lpVolumes.reduce((s, v) => s + v.hb, 0);
// The only Large Print figures we SET (Kevin 2026-09-16). The set is a normal product on the
// same ladder as every edition — no better-of rule, no stacking rule, no special case. Its
// threshold weight is ONE PRODUCT (Kevin 2026-09-17: "A 3 book set is 1 product not 12
// products when selling 4 sets, but 4 sets = 4 products"), so it climbs the ladder exactly
// as every other SKU does. MUST stay in step with `books` in functions/dvc-checkout.ts.
const lpSetPb = 249.99;
const lpSetHb = 299.99;
const lpTotalPages = lpVolumes.reduce((s, v) => s + v.pages, 0);

// Interior sample excerpts (Genesis) — direct PDF, hosted on R2.
const SAMPLE_REGULAR =
	'https://assets.spiritmediapublishing.com/FHB/print-samples/FHB-Genesis-sample-regular-7.5pt.pdf';
const SAMPLE_LP =
	'https://assets.spiritmediapublishing.com/FHB/print-samples/FHB-Genesis-sample-largeprint-14pt.pdf';

// Print FAQ — rendered as a no-JS <details> accordion + FAQPage JSON-LD (AEO).
const READ_URL = '/read/';
const CAMPAIGN_URL = '/a-bible-for-the-whole-world/';
// Neutral: the only color between the header and the footer is the three voices and
// the cover art (Kevin 2026-08-23).
const LINK = 'color: #3f3f46; text-decoration: underline;';
// Only link "Full details" where the product page exists. The pages come from a dynamic
// route (src/pages/bibles/[slug].astro) driven by src/data/editions/<slug>.json, so the
// presence of the DATA file — not of an .astro file — is what says a page will be built.
// Tolerant by design: an edition whose data has not landed yet just loses the link.
const editionData = import.meta.glob<{ default?: { slug?: string } }>('../data/editions/*.json', {
	eager: true,
});
const builtPages = new Set(
	Object.entries(editionData)
		.filter(([f]) => !/\/(frontmatter|shared)\.json$/.test(f))
		.map(([f, m]) => m?.default?.slug ?? f.split('/').pop()?.replace('.json', ''))
		.filter(Boolean)
		.map((slug) => `${slug}-bible`),
);
// A language card shows Look inside only once its sample pages are in lookinside.json.
// Runtime value used in the template below (biome cannot see .astro template use, keep this line).
const langCards = languageEditions;
type DigitalLink = { store: string; url: string; price: string; label?: string };
const langDigital = (code: string) => {
	const d = (
		digital as unknown as Record<string, { ebook?: DigitalLink[]; audiobook?: DigitalLink[] }>
	)[code];
	return [
		...(d?.ebook ?? []).map((x) => ({ ...x, kind: 'eBook' })),
		...(d?.audiobook ?? []).map((x) => ({ ...x, kind: 'Audiobook' })),
	];
};
const langHasLi = (l: (typeof languageEditions)[number]) =>
	Boolean((lookinsideData as Record<string, { pages?: unknown[] }>)[langSlug(l)]?.pages?.length);
const TRANSLATION_URL = '/the-fathers-heart-bible/translation-philosophy/';
const CONTACT = 'mailto:hello@spiritmediapublishing.com?subject=Father%27s%20Heart%20Bible%20print';
// SCREEN divine-voice palette — the same values /read has always used, adopted here so a
// visitor sees one red on the product page and on the reader. Print ink is unchanged:
// the interiors keep 3563ae / f04933 / 91278f. Kevin approved screen-only, 2026-08-24.
// f04933 measures hue 7deg (vermilion) at 3.7:1 on white, below the contrast floor;
// c8102e sits at 350deg and 5.9:1, and reads redder in context precisely because it is
// not fighting the page.
const VOICE = { father: '#2563eb', son: '#c8102e', spirit: '#6a3fa0' };
const printFaq = [
	{
		q: 'Are the different editions different Bibles?',
		a: `No. Unless otherwise stated, every edition is the complete Father's Heart Bible™ in Divine Voice Color — all 66 books, 1,189 chapters, 31,085 verses, nothing abridged, the same fresh translation from the original Hebrew, Aramaic and Greek. What changes is who it was made for: the cover, the opening pages written for that reader, and the passages chosen for where they are. Buy the Teen Bible for a teenager and the Soldier's Bible for a soldier — each one arrives looking and sounding like it was meant for them, and each one carries the whole Bible. Prefer no audience on the cover? The General Audience editions are the same Bible in three cover colors, and in Large Print if you'd like the type set larger.`,
	},
	{
		q: 'Can I return my order?',
		// KEVIN'S WORDING, AND IT IS HIS 21:54:56 REVISION — NOT the 21:52:04 first pass.
		// He wrote "follow Amazon's return policy" at 21:52 and replaced it two minutes later
		// with "follow THEIR return policy" (A1a, J1). The sentence's own subject is the
		// reason: it already says "or other retailers", so naming Amazon in the predicate
		// contradicts it — a Barnes & Noble buyer does not follow Amazon's policy.
		// This shipped wrong once because it was checked against the superseded sentence
		// quoted in an earlier brief, found present, and read as confirmation. Matching the
		// wrong authority returns a true answer to the wrong question. The task register
		// carries the quote WITH its timestamp; that is the authority, not a brief.
		a: `Yes. For orders placed directly with us, <a href="${CONTACT}" style="${LINK}">reach out</a> and we'll make it right. Copies bought on Amazon or other retailers follow their return policy.`,
	},
	{
		q: 'How is the Father’s Heart Bible™ different from other translations?',
		a: `It is a fresh translation from the original Hebrew, Aramaic, and Greek — not an adaptation of any existing English Bible — made so you can hear God as He truly is: not a distant deity, but your Father. Complete at 66 books, 1,189 chapters and 31,085 verses, governed by 170 written translation rules. And it is the first Bible in print to show you which words a divine person spoke, and which person spoke them. Read about <a href="${TRANSLATION_URL}" style="${LINK}">our translation approach</a>, or start reading free at <a href="${READ_URL}" style="${LINK}">fathersheartbible.com/read</a>.`,
	},
	{
		q: 'How long does shipping take?',
		a: `Order direct from us today and shipping is free — most orders arrive in 7–10 days, and larger bulk orders in 3–4 weeks. The Divine Voice Color editions are on Amazon now, and every card above links to its listing. Ordering direct from us includes free shipping. <a href="${CONTACT}" style="${LINK}">Reach out</a> if you need them by a particular date.`,
	},
	{
		q: 'Is the color throughout the whole Bible?',
		a: `Yes — Genesis to Revelation, every divine voice, in full color on every page. Not a red-letter New Testament with a black Old Testament, and not a study section at the back. You can see it for yourself free at <a href="${READ_URL}" style="${LINK}">fathersheartbible.com/read</a>.`,
	},
	{
		q: 'Is there a cheaper version?',
		a: `The whole Bible is already free. Every word of the Father’s Heart Bible™ can be read online at no cost, by anyone, anywhere in the world, in twenty-five languages — with English and Telugu also free to listen to, and more languages being recorded. Nobody has to buy anything to receive our Father’s voice. As for print: the Father’s Heart Bible™ is currently printed on demand on premium white paper, as the industry requires — and with paper costs up about 25% over the last two years and 888 pages to a complete Bible, the cost per copy runs high. More affordable offset-printed editions will be added in the future. Read it all today at <a href="${READ_URL}" style="${LINK}">fathersheartbible.com/read</a>.`,
	},
	{
		q: 'What is Divine Voice Color?',
		// ROUNDED, AND ROUNDED DOWNWARD (Kevin 2026-09-17, ruling R2 — storefront prose only;
		// the metadata sheets, JSON-LD and Ingram/Bowker records keep the exact figures).
		// "More than 128,000" stays true in the direction the number actually MOVES: the canon
		// is still being corrected and the count rises, so "nearly 130,000" would expire the
		// day it passes 130,000 and invite rounding up again.
		a: `For a hundred and twenty-five years red letters have shown the Son speaking. Our Father speaks more than three times as often — more than 128,000 words across more than 5,500 verses — and until now those words were printed in the same black ink as the genealogies. In Divine Voice Color you see who is speaking: our Father's words in <strong style="color:${VOICE.father};">BLUE</strong>, the Son's in <strong style="color:${VOICE.son};">RED</strong>, the Spirit's in <strong style="color:${VOICE.spirit};">PURPLE</strong>. More than one word in four of the Bible is a divine person speaking. The color is a mark of ownership, not of quotation — His words stay His on any lips that carry them faithfully, and words He never spoke are never colored.`,
	},
	{
		q: 'What’s included in each edition?',
		// THE NOTE CATEGORIES ARE DESCRIBED, NOT COUNTED (Kevin 2026-09-17: "Keep this simple.
		// Do not make us have to update this again in the future."). The old sentence said
		// "1,075 explaining … 248 marking … 31 recording", which summed to 1,354 against a
		// master total of 1,355 — the sentence contradicted itself — and 1,075 and 248 had no
		// master anywhere: the sheets publish only the total and the 31 manuscript notes.
		// A sentence stating parts that must add to a whole is a maintenance trap: every note
		// added breaks it silently. The richness is kept, the arithmetic is gone.
		a: `The complete Bible in Divine Voice Color with full color throughout — 888 pages at 6×9; in Large Print the same complete text runs to 2,956 pages and comes as a three-volume set. Every edition comes in both hardback and paperback. A presentation page for the reader's name. Opening pages on intimacy, identity, inheritance and hearing His voice. An introduction to every one of the 66 books, and a Father's note closing each one with a short prayer. Over 1,300 study notes — explaining a word, name, custom or background, marking where the text reveals the Father, and recording differences among the manuscripts.`,
	},
	{
		q: 'Which languages can I read it in?',
		a: `Twenty-five, free, right now: English, Spanish, Portuguese, French, German, Russian, Turkish, Arabic, Persian, Urdu, Hindi, Bengali, Punjabi, Marathi, Tamil, Telugu, Indonesian, Filipino, Vietnamese, Japanese, Korean, Mandarin, Cantonese, Swahili and Nigerian Pidgin — reaching roughly three-quarters of humanity. English and Telugu can also be listened to, and more languages are being recorded. Print editions are English for now. Our Bible for the Whole World campaign continues until every one of the 8+ billion souls on earth can hold a Father's Heart Bible in their hands.`,
		link: { href: CAMPAIGN_URL, label: 'Full details →' },
	},
	{
		q: 'Why are you charging for the Father’s Heart Bible™?',
		a: `We aren't, for the text itself — it is free to read at <a href="${READ_URL}" style="${LINK}">fathersheartbible.com/read</a> and in time will be free on every major digital Bible platform. Print editions are priced only to cover the real costs of printing and distribution, and a portion of every copy sold helps fund our Bible for the Whole World campaign.`,
		link: { href: CAMPAIGN_URL, label: 'Learn more →' },
	},
	{
		q: 'Why is the Father’s Heart Bible™ thicker than other bibles?',
		a: `A complete Bible in readable type runs 888 pages here, and print-on-demand uses a premium, heavier white paper — the thin, opaque bible paper you know from other editions comes from offset printing at volume, which we will move to in future. Slimmer thinline editions will follow.`,
	},
];
// Plain-text answers for FAQPage JSON-LD.
const stripHtml = (s: string) => s.replace(/<[^>]+>/g, '');
const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: printFaq.map((f) => ({
		'@type': 'Question',
		name: f.q,
		acceptedAnswer: { '@type': 'Answer', text: stripHtml(f.a) },
	})),
};

// Book + Offer structured data — the /print page is the commerce surface, so the
// purchasable price range lives here: ebook direct $7.49 → the journaling 8x10 at $124.99.
// NOT "Large Print hardback $124.99", as this line read until 2026-09-17: the LP hardbacks
// are $114.99 here and in dvc-checkout.ts, and Ingram's US retail drops to $114.99 effective
// 18-SEP-26 (Kevin). $124.99 is the journaling edition's price, and always was.
// The high end was $44.99, left behind by the DVC line; corrected 2026-08-29 when the
// General Audience editions landed. offerCount counts the distinct purchasable products:
// 16 targeted + 12 general (3 colours x 2 bindings x 2 line) + ebook.
const bookSchema = {
	'@context': 'https://schema.org',
	'@type': 'Book',
	name: "Father's Heart Bible: An Intimate Translation",
	url: 'https://fathersheartbible.com/print/',
	inLanguage: 'en-US',
	author: { '@type': 'Person', name: 'Kevin White', url: 'https://kevinwhite.us' },
	publisher: {
		'@type': 'Organization',
		name: 'Spirit Media Publishing',
		url: 'https://spiritmediapublishing.com',
	},
	image: 'https://assets.spiritmediapublishing.com/FHB/share/fhb-og-print-group.jpg',
	offers: {
		'@type': 'AggregateOffer',
		priceCurrency: 'USD',
		lowPrice: '7.49',
		highPrice: '124.99',
		offerCount: 29,
		availability: 'https://schema.org/InStock',
		url: 'https://fathersheartbible.com/print/',
	},
};
const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://fathersheartbible.com/' },
		{
			'@type': 'ListItem',
			position: 2,
			name: 'Now in Print',
			item: 'https://fathersheartbible.com/print/',
		},
	],
};

// FHB scripture cards — the Father's voice from first page to last (text pulled
// from the reader content).
// DIVINE VOICE COLOR verses, straight from the locked canon with the same voice spans
// the printed book and /read use \u2014 fatherWords / sonWords / spiritWords. Nothing is
// retyped here, so a verse on this page cannot disagree with the Bible it advertises.
// One column per voice, each headed by the same colored block used at the top of the
// page \u2014 the demo repeated where the proof is. Two passages each, in that voice's color,
// straight from the canon's own spans.
const dvcVerses = [
	{
		key: 'father',
		label: 'FATHER',
		verses: [
			{
				ref: 'Genesis 1:3',
				href: '/read/genesis/1/#v3',
				text: 'Then our Father said, "Let there be light," and there was light.',
				father: ['"Let there be light,"'],
				son: [],
				spirit: [],
			},
			{
				ref: 'Jeremiah 29:11',
				href: '/read/jeremiah/29/#v11',
				text: 'For I know the plans I have for you, declares your Father — plans for peace, not disaster, to give you a future and hope.',
				father: [
					'For I know the plans I have for you,',
					'plans for peace, not disaster, to give you a future and hope.',
				],
				son: [],
				spirit: [],
			},
		],
	},
	{
		key: 'son',
		label: 'SON',
		verses: [
			{
				ref: 'Matthew 11:28',
				href: '/read/matthew/11/#v28',
				text: 'Come to me, all you who are weary and burdened, and I will give you rest.',
				father: [],
				son: ['Come to me, all you who are weary and burdened, and I will give you rest.'],
				spirit: [],
			},
			{
				ref: 'John 14:6',
				href: '/read/john/14/#v6',
				text: 'Jesus told him, "I am the way, and the truth, and the life. No one comes to the Father except through me."',
				father: [],
				son: [
					'"I am the way, and the truth, and the life. No one comes to the Father except through me."',
				],
				spirit: [],
			},
		],
	},
	{
		key: 'spirit',
		label: 'SPIRIT',
		verses: [
			{
				ref: 'Acts 8:29',
				href: '/read/acts/8/#v29',
				text: 'And the Holy Spirit said to Philip, "Go over and catch up with that chariot."',
				father: [],
				son: [],
				spirit: ['"Go over and catch up with that chariot."'],
			},
			{
				ref: 'Acts 10:15',
				href: '/read/acts/10/#v15',
				text: 'The voice came to him again, a second time: "What I have made clean, don\'t call common."',
				father: [],
				son: [],
				spirit: ['"What I have made clean, don\'t call common."'],
			},
		],
	},
];

// Wrap each voice's spans in its own color. Longest-first so a span that contains
// another cannot be half-replaced.
function markVoices(v: {
	text: string;
	father: string[];
	son: string[];
	spirit: string[];
}): string {
	let out = v.text;
	const spans: { s: string; c: string }[] = [
		...v.father.map((s) => ({ s, c: VOICE.father })),
		...v.son.map((s) => ({ s, c: VOICE.son })),
		...v.spirit.map((s) => ({ s, c: VOICE.spirit })),
	].sort((a, b) => b.s.length - a.s.length);
	for (const { s, c } of spans) {
		if (!s || !out.includes(s)) continue;
		out = out.replace(s, `<span style="color:${c};font-weight:600;">${s}</span>`);
	}
	return out;
}
