							>Amazon — coming soon</span>
							<button
								type="button"
								data-add={e.slug}
								class="inline-flex items-center justify-center rounded-full font-semibold"
								style="font-family: var(--font-sans); background: #fff; color: #3f3f46; border: 1.5px solid #3f3f46; padding: 0.55rem 1rem; font-size: 0.8rem; cursor: pointer;"
							>Direct from SMP · ${e.price.toFixed(2)}</button>
