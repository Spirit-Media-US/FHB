						<p style="font-family: var(--font-body); color: var(--color-muted); font-size: 0.76rem; line-height: 1.45; margin: 0 0 0.9rem;">{e.sub}</p>
						<div class="flex flex-col gap-2 w-full mt-auto">
							<div class="flex items-center justify-center gap-2 flex-wrap" style="margin: 0 0 0.2rem;">
								{builtPages.has(`${e.slug}-bible`) && (
									<a href={`/bibles/${e.slug}-bible`} style="font-family: var(--font-sans); font-size: 0.82rem; font-weight: 700; color: #3f3f46; text-decoration: underline; text-underline-offset: 2px;">Full details</a>
								)}
								{builtPages.has(`${e.slug}-bible`) && <span aria-hidden="true" style="color: #a1a1aa;">·</span>}
								<LookInside slug={e.slug} title={e.title} variant="link" label="Look inside" />
							</div>
							<span
								aria-disabled="true"
								class="inline-flex items-center justify-center rounded-full font-semibold"
