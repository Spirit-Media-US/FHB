						     listing, so those two words are the only information it carries.
						     Blanking it to satisfy a literal "zero occurrences of coming soon"
						     check would leave an empty button. Do not "fix" this later. */}
						<div class="flex flex-col gap-2 w-full mx-auto" style="max-width: 15rem;">
							<span class="inline-flex items-center justify-center rounded-full font-semibold" style="font-family: var(--font-sans); background: #f3f3f3; color: var(--color-muted); border: 1.5px solid var(--color-hairline); padding: 0.75rem 1.4rem; font-size: 0.92rem; cursor: default;">Coming soon</span>
						</div>
						<p style="font-family: var(--font-sans); font-size: 0.75rem; color: var(--color-muted); margin: 0.6rem 0 0;">Coming to Spotify, Apple, Google Play — and here, direct.</p>
					</div>
				</div>
			</Section>

			<!-- ═══════════════ FAQ ═══════════════ -->
			<Section variant="soft">
				<div class="max-w-3xl mx-auto">
					<div class="text-center mb-8">
						<p style="font-family: var(--font-sans); color: #71717a; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; margin: 0 0 0.5rem;">Frequently Asked Questions</p>
						<h2 style="font-family: var(--font-headline); color: var(--color-ink); font-size: 2rem; font-weight: 600; margin: 0;">Good questions, honest answers</h2>
					</div>
					<div class="space-y-3">
						{printFaq.map(({ q, a, link }) => (
							<details class="faq-item rounded-2xl" style="background-color: #fff; border: 1px solid var(--color-hairline);">
								<summary class="flex items-center justify-between gap-4 px-5 py-4 font-semibold" style="font-family: var(--font-sans); color: var(--color-ink);">
									<span>{q}</span>
									<svg class="faq-chev shrink-0" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#71717a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
								</summary>
								<div class="px-5 pb-5 -mt-1">
									<p style="font-family: var(--font-body); color: var(--color-muted); font-size: 0.95rem; line-height: 1.6;" set:html={a}></p>
									{link && (
										<a href={link.href} class="inline-flex items-center mt-3 font-semibold no-underline hover:underline" style="font-family: var(--font-sans); color: #3f3f46; font-size: 0.9rem;">{link.label}</a>
									)}
								</div>
							</details>
						))}
					</div>
				</div>
			</Section>

		<!-- ═══════════════ PEOPLE BAND (variety of readers with FHB) ═══════════════ -->
		<div class="grid grid-cols-1 sm:grid-cols-3">
			<img src="https://assets.spiritmediapublishing.com/FHB/print/print-band-white.webp" alt="A man reading the White edition of the Father's Heart Bible in a cafe" width="800" height="800" loading="lazy" decoding="async" class="w-full aspect-square object-cover block" />
			<img src="https://assets.spiritmediapublishing.com/FHB/print/people-2.webp" alt="A father and son reading the Father's Heart Bible together" width="800" height="800" loading="lazy" decoding="async" class="w-full aspect-square object-cover block" />
			<img src="https://assets.spiritmediapublishing.com/FHB/print/people-3.webp" alt="A grandmother and granddaughter reading the Father's Heart Bible" width="800" height="800" loading="lazy" decoding="async" class="w-full aspect-square object-cover block" />
		</div>
	</main>
</Layout>

