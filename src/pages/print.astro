const RETAIL = '$99.99';
const RETAIL_8 = '$124.99';

// Interior sample excerpts (Genesis) — direct PDF, hosted on R2.
const SAMPLE_REGULAR =
	'https://assets.spiritmediapublishing.com/FHB/print-samples/FHB-Genesis-sample-regular-7.5pt.pdf';
const SAMPLE_LP =
	'https://assets.spiritmediapublishing.com/FHB/print-samples/FHB-Genesis-sample-largeprint-14pt.pdf';

// Print FAQ — rendered as a no-JS <details> accordion + FAQPage JSON-LD (AEO).
const READ_URL = '/read';
const CAMPAIGN_URL = '/a-bible-for-the-whole-world/';
// Neutral: the only color between the header and the footer is the three voices and
// the cover art (Kevin 2026-08-23).
const LINK = 'color: #3f3f46; text-decoration: underline;';
// Only link "Full details" where the product page exists. The pages come from a dynamic
// route (src/pages/bibles/[slug].astro) driven by src/data/editions/<slug>.json, so the
// presence of the DATA file — not of an .astro file — is what says a page will be built.
// Tolerant by design: an edition whose data has not landed yet just loses the link.
const editionData = import.meta.glob<{ default?: { slug?: string } }>('../data/editions/*.json', {
	eager: true,
});
