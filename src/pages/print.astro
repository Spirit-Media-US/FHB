</style>

<script is:inline>
	(() => {
		const root = document.querySelector('[data-bulk]');
		if (!root) return;
		// Prices and tiers are mirrored here for live totals only — functions/dvc-checkout.ts
		// is authoritative, so a tampered browser cannot change what Stripe charges.
		const PRICE = {
			// Targeted editions — BOTH bindings (Kevin 2026-09-17). Prices are ISBNS.json's,
			// which pricing-verify compares against on every build.
			'chosen-hb': 99.99, 'chosen-pb': 79.99, 'couples-hb': 99.99, 'couples-pb': 79.99, 'dads-hb': 99.99, 'dads-pb': 79.99,
			'first-responders-hb': 99.99, 'first-responders-pb': 79.99, 'mens-hb': 99.99, 'mens-pb': 79.99, 'moms-hb': 99.99, 'moms-pb': 79.99,
			'pastors-hb': 99.99, 'pastors-pb': 79.99, 'peace-hb': 99.99, 'peace-pb': 79.99, 'presidents-hb': 99.99, 'presidents-pb': 79.99,
			'recovery-hb': 99.99, 'recovery-pb': 79.99, 'seekers-hb': 99.99, 'seekers-pb': 79.99, 'seventeen-hb': 99.99, 'seventeen-pb': 79.99,
			'soldiers-hb': 99.99, 'soldiers-pb': 79.99, 'teen-hb': 99.99, 'teen-pb': 79.99, 'worship-leaders-hb': 99.99, 'worship-leaders-pb': 79.99,
			'journaling-hb': 124.99, 'journaling-pb': 114.99,
			// General Audience — Regular Print (888pp).
			'general-regular-charcoal-pb': 79.99, 'general-regular-charcoal-hb': 99.99,
			'general-regular-plum-pb': 79.99, 'general-regular-plum-hb': 99.99,
			'general-regular-white-pb': 79.99, 'general-regular-white-hb': 99.99,
			// Large Print — three volumes and the set. The retired single-volume Large Print
			// SKUs (general-largeprint-*) are gone from here and from dvc-checkout.ts.
			'lp-vol1-pb': 99.99, 'lp-vol1-hb': 114.99,
			'lp-vol2-pb': 99.99, 'lp-vol2-hb': 114.99,
			'lp-vol3-pb': 79.99, 'lp-vol3-hb': 99.99,
			'lp-set-pb': 249.99, 'lp-set-hb': 299.99,
		};
		// HOW MANY BOOKS EACH SKU PUTS IN THE BUYER'S HANDS — what the ladder counts, and the
		// reason a set is not one line item's worth of progress toward a tier. Anything absent
		// is one book. MUST match the `books` field in functions/dvc-checkout.ts EDITIONS.
		// Every SKU weighs ONE product on the ladder, the set included (Kevin 2026-09-17:
		// "4 sets = 4 products"). Kept explicit rather than emptied so this map stays the
		// one place a future multi-item SKU would say otherwise — and so pricing-verify,
		// which reads this map as TEXT, keeps asserting it against the server's weights.
		const BOOKS = { 'lp-set-pb': 1, 'lp-set-hb': 1 };
		const TIERS = [
			{ min: 250, pct: 30 }, { min: 100, pct: 25 }, { min: 50, pct: 20 },
			{ min: 25, pct: 15 }, { min: 10, pct: 10 }, { min: 1, pct: 0 },
		];
		const tierFor = (t) => TIERS.find((x) => t >= x.min) || null;
		const fmt = (n) => '$' + Number(n).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
		const counts = {};
		Object.keys(PRICE).forEach((k) => (counts[k] = 0));

		const out = root.querySelector('[data-total-out]');
		const countEl = root.querySelector('[data-count]');
		const saveEl = root.querySelector('[data-save]');
		const msg = root.querySelector('[data-bulk-msg]');

		function render() {
			// Thresholds count BOOKS, not line items — the same rule the server applies, so
			// the tier shown here is the tier Stripe charges.
			const total = Object.entries(counts).reduce((a, [k, n]) => a + n * (BOOKS[k] || 1), 0);
			const tier = tierFor(total);
			const pct = tier ? tier.pct : 0;
			// Round the discounted UNIT to whole cents, then multiply — the exact order
			// functions/dvc-checkout.ts uses, because Stripe is charged a per-unit amount in
			// cents. Multiplying first and rounding once at the end drifts from what the
			// customer is actually charged: a 500-copy order of a $99.99 edition at 30% off
			// showed $34,996.50 here while Stripe billed $34,995.00.
			let cents = 0;
			for (const [k, n] of Object.entries(counts)) {
				cents += Math.round((PRICE[k] * 100 * (100 - pct)) / 100) * n;
			}
			const sum = cents / 100;
			countEl.textContent = total;
			saveEl.textContent = pct ? `save ${pct}%` : 'full price';
			out.textContent = fmt(sum);
			root.querySelectorAll('.tier-card').forEach((c) => {
				const on = tier && Number(c.dataset.tierMin) === tier.min;
				c.style.outline = on ? '2px solid #3f3f46' : 'none';
				c.style.outlineOffset = '2px';
			});
		}
		function bump(slug, d) {
			counts[slug] = Math.max(0, (counts[slug] || 0) + d);
			const input = root.querySelector(`.qty-in[data-slug="${slug}"]`);
			if (input) input.value = counts[slug];
			render();
		}
		root.querySelectorAll('.qty-step').forEach((b) =>
			b.addEventListener('click', () => bump(b.dataset.slug, Number(b.dataset.dir))));
		root.querySelectorAll('.qty-in').forEach((el) =>
			el.addEventListener('input', () => {
				counts[el.dataset.slug] = Math.max(0, Math.floor(Number(el.value) || 0));
				render();
			}));

		// "Direct from SMP" on a card adds one and scrolls to the order builder, so a single
		// copy and a bulk order go through the same checkout (Kevin 2026-08-23).
		document.querySelectorAll('[data-add]').forEach((b) =>
			b.addEventListener('click', () => {
				bump(b.dataset.add, 1);
				root.scrollIntoView({ behavior: 'smooth', block: 'center' });
			}));

		root.querySelector('[data-checkout]').addEventListener('click', async (ev) => {
			const btn = ev.currentTarget;
			const total = Object.values(counts).reduce((a, b) => a + b, 0);
			msg.style.display = 'block';
			if (total < 1) { msg.textContent = 'Choose at least one Bible to continue.'; return; }
			msg.textContent = 'Opening secure checkout…';
			btn.disabled = true;
			try {
				const r = await fetch('/dvc-checkout', {
					method: 'POST',
					headers: { 'content-type': 'application/json' },
					body: JSON.stringify({ counts }),
				});
				const d = await r.json();
				if (d.url) { window.location.href = d.url; return; }
				msg.textContent = d.disabled
					? 'Direct ordering opens shortly — please check back.'
					: 'Sorry, something went wrong. Please try again.';
			} catch {
				msg.textContent = 'Sorry, something went wrong. Please try again.';
			}
			btn.disabled = false;
		});

		render();
	})();
</script>


<script is:inline>
	(() => {
		const btn = document.querySelector('[data-ebook-buy]');
		if (!btn) return;
		const msg = document.querySelector('[data-ebook-msg]');
		btn.addEventListener('click', async () => {
			const label = btn.textContent;
			btn.disabled = true; btn.textContent = 'Starting checkout…';
			try {
				const r = await fetch('/ebook-checkout', { method: 'POST', headers: { 'content-type': 'application/json' }, body: '{}' });
				const d = await r.json();
				if (d.url) { window.location.href = d.url; return; }
				if (msg) { msg.style.display = 'block'; msg.textContent = d.disabled ? 'Direct download is opening soon — grab it on Amazon meanwhile.' : 'Sorry, something went wrong. Please try again.'; }
			} catch {
				if (msg) { msg.style.display = 'block'; msg.textContent = 'Network error — please try again.'; }
			}
			btn.disabled = false; btn.textContent = label;
		});
	})();
</script>
