};

// FHB scripture cards — the Father's voice from first page to last (text pulled
// from the reader content).
// DIVINE VOICE COLOR verses, straight from the locked canon with the same voice spans
// the printed book and /read use \u2014 fatherWords / sonWords / spiritWords. Nothing is
// retyped here, so a verse on this page cannot disagree with the Bible it advertises.
// One column per voice, each headed by the same colored block used at the top of the
// page \u2014 the demo repeated where the proof is. Two passages each, in that voice's color,
// straight from the canon's own spans.
const dvcVerses = [
	{
		key: 'father',
		label: 'FATHER',
		verses: [
			{
				ref: 'Genesis 1:3',
				href: '/read/genesis/1#v3',
				text: 'Then our Father said, "Let there be light," and there was light.',
				father: ['"Let there be light,"'],
				son: [],
				spirit: [],
			},
			{
				ref: 'Jeremiah 29:11',
				href: '/read/jeremiah/29#v11',
				text: 'For I know the plans I have for you, declares your Father — plans for peace, not disaster, to give you a future and hope.',
				father: [
					'For I know the plans I have for you,',
					'plans for peace, not disaster, to give you a future and hope.',
				],
				son: [],
				spirit: [],
			},
		],
	},
	{
		key: 'son',
		label: 'SON',
		verses: [
			{
				ref: 'Matthew 11:28',
				href: '/read/matthew/11#v28',
				text: 'Come to me, all you who are weary and burdened, and I will give you rest.',
				father: [],
				son: ['Come to me, all you who are weary and burdened, and I will give you rest.'],
				spirit: [],
			},
			{
				ref: 'John 14:6',
				href: '/read/john/14#v6',
				text: 'Jesus told him, "I am the way, and the truth, and the life. No one comes to the Father except through me."',
				father: [],
				son: [
					'"I am the way, and the truth, and the life. No one comes to the Father except through me."',
				],
				spirit: [],
			},
		],
	},
	{
		key: 'spirit',
		label: 'SPIRIT',
		verses: [
			{
				ref: 'Acts 8:29',
				href: '/read/acts/8#v29',
				text: 'And the Holy Spirit said to Philip, "Go over and catch up with that chariot."',
				father: [],
				son: [],
				spirit: ['"Go over and catch up with that chariot."'],
			},
			{
				ref: 'Acts 10:15',
				href: '/read/acts/10#v15',
				text: 'The voice came to him again, a second time: "What I have made clean, don\'t call common."',
				father: [],
				son: [],
				spirit: ['"What I have made clean, don\'t call common."'],
			},
		],
	},
];

// Wrap each voice's spans in its own color. Longest-first so a span that contains
// another cannot be half-replaced.
function markVoices(v: {
	text: string;
	father: string[];
	son: string[];
	spirit: string[];
}): string {
	let out = v.text;
	const spans: { s: string; c: string }[] = [
		...v.father.map((s) => ({ s, c: VOICE.father })),
		...v.son.map((s) => ({ s, c: VOICE.son })),
		...v.spirit.map((s) => ({ s, c: VOICE.spirit })),
	].sort((a, b) => b.s.length - a.s.length);
	for (const { s, c } of spans) {
		if (!s || !out.includes(s)) continue;
		out = out.replace(s, `<span style="color:${c};font-weight:600;">${s}</span>`);
	}
	return out;
}
