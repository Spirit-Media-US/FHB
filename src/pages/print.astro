			},
			{
				ref: 'Acts 10:15',
				href: '/read/acts/10#v15',
				text: 'The voice came to him again, a second time: "What I have made clean, don\'t call common."',
				father: [],
				son: [],
				spirit: ['"What I have made clean, don\'t call common."'],
			},
		],
	},
];

// Wrap each voice's spans in its own color. Longest-first so a span that contains
// another cannot be half-replaced.
function markVoices(v: {
	text: string;
	father: string[];
	son: string[];
	spirit: string[];
}): string {
	let out = v.text;
	const spans: { s: string; c: string }[] = [
		...v.father.map((s) => ({ s, c: VOICE.father })),
		...v.son.map((s) => ({ s, c: VOICE.son })),
		...v.spirit.map((s) => ({ s, c: VOICE.spirit })),
	].sort((a, b) => b.s.length - a.s.length);
	for (const { s, c } of spans) {
		if (!s || !out.includes(s)) continue;
		out = out.replace(s, `<span style="color:${c};font-weight:600;">${s}</span>`);
	}
	return out;
}
---

<Layout
	title="Now in Print — Father's Heart Bible™: An Intimate Translation"
	description="The Father's Heart Bible™ is now in print — a fresh translation that reveals God as your Father. Buy a single copy, or order in bulk for your church."
	image="https://assets.spiritmediapublishing.com/FHB/share/fhb-og-print-group.jpg"
	imageAlt="Eight friends holding the Father's Heart Bible™ print edition in three colors and two bindings"
	darkHero={true}
	jsonLd={[bookSchema, breadcrumbSchema, faqSchema]}
>
	<main>
		<!-- ═══════════════ HERO ═══════════════ (shared component — same size as other pages) -->
		<VideoHeroInner
			imageSrc="https://assets.spiritmediapublishing.com/FHB/print/print-hero-group.webp"
			imagePosition="center top"
			headingLift="0.5in"
			heading="Now in Print"
		/>

		<!-- ═══════════════ THE DVC LINE — 16 EDITIONS ═══════════════ -->
		<Section variant="light">
			<div class="text-center mb-3">
				<h2 style="font-family: var(--font-headline); color: var(--color-ink); font-size: 2.1rem; font-weight: 600; margin: 0;">Father’s Heart Bible™ + Divine Voice™ Color Bibles</h2>
			</div>
			<!-- THE COLOR DEMO. Kevin 2026-08-23: "if we were selling color tvs this is our color
			     tv demo." So the three voices are set large and are the ONLY saturated color on the
			     page — every button, tier and label below is neutral grey so nothing competes with
			     them or with the covers. -->
			<div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4 mb-5" aria-label="Father, Son and Spirit in Divine Voice Color">
				<span style={`font-family: var(--font-sans); font-weight: 800; font-size: 1.5rem; letter-spacing: 0.06em; color: ${VOICE.father}; background: #fff; border: 2px solid ${VOICE.father}; padding: 0.5rem 1.15rem; border-radius: 6px; line-height: 1;`}>FATHER</span>
				<span style={`font-family: var(--font-sans); font-weight: 800; font-size: 1.5rem; letter-spacing: 0.06em; color: ${VOICE.son}; background: #fff; border: 2px solid ${VOICE.son}; padding: 0.5rem 1.15rem; border-radius: 6px; line-height: 1;`}>SON</span>
				<span style={`font-family: var(--font-sans); font-weight: 800; font-size: 1.5rem; letter-spacing: 0.06em; color: ${VOICE.spirit}; background: #fff; border: 2px solid ${VOICE.spirit}; padding: 0.5rem 1.15rem; border-radius: 6px; line-height: 1;`}>SPIRIT</span>
			</div>
			<p class="text-center" style="font-family: var(--font-sans); color: var(--color-ink); font-size: 0.95rem; font-weight: 600; letter-spacing: 0.02em; margin: 0 0 0.35rem;">{DVC_TAIL}</p>
			<p class="text-center mb-10" style="font-family: var(--font-sans); color: var(--color-muted); font-size: 0.85rem; letter-spacing: 0.02em;">{DVC_TAIL2}</p>

			<div class="grid grid-cols-2 lg:grid-cols-4 gap-5 md:gap-7 max-w-6xl mx-auto">
				{dvcEditions.map((e) => (
					<div class="flex flex-col items-center text-center rounded-2xl p-4 md:p-5" style="background: var(--color-soft, #faf6f2); border: 1px solid var(--color-hairline);">
						<img
							src={`https://assets.spiritmediapublishing.com/FHB/print/dvc-${e.slug}-600.webp`}
							srcset={`https://assets.spiritmediapublishing.com/FHB/print/dvc-${e.slug}-600.webp 600w, https://assets.spiritmediapublishing.com/FHB/print/dvc-${e.slug}-1200.webp 1200w`}
							sizes="(min-width: 1024px) 260px, 44vw"
							alt={`Father's Heart Bible — ${e.title}, Divine Voice Color`}
							width="600" height="764" loading="lazy" decoding="async"
							class="block w-full h-auto" style="max-width: 220px;"
						/>
