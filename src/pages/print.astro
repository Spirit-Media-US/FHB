<style>
	/* FAQ accordion — native <details>, no JS. */
	.faq-item > summary {
		cursor: pointer;
		list-style: none;
	}
	.faq-item > summary::-webkit-details-marker {
		display: none;
	}
	.faq-chev {
		transition: transform 0.2s ease;
	}
	.faq-item[open] > summary .faq-chev {
		transform: rotate(180deg);
	}

	/* The bulk form's second line. SUBORDINATE ON PURPOSE (jonah): the form is 46 rows long
	   and the quantity steppers are what a buyer came to use — these links inform, they do
	   not compete. Smaller, muted until hover, tight under the title line. */
	.row-links {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		flex-wrap: wrap;
		margin-top: 0.15rem;
		font-family: var(--font-sans);
		font-size: 0.78rem;
	}
	/* BOTH LINKS UNBOLD AND THE SAME SIZE (Kevin 2026-09-18: "Full details (not bold) ·
	   Look inside (bold) unbold both"). They came from different places — the anchor is
	   written here, the trigger inside LookInside — and rendered 600 and 700 at two
	   different sizes. The trigger now reads its weight and size from tokens the component
	   exposes, set just below, so both are one declaration rather than an override war. */
	.row-links {
		--li-link-weight: 400;
		--li-link-size: 0.78rem;
	}
	.row-links a,
	.row-links :global(.li-trigger) {
		font-family: var(--font-sans);
		font-size: 0.78rem;
		font-weight: 400;
		color: #71717a;
		text-decoration: underline;
		text-underline-offset: 2px;
		background: none;
		border: 0;
		padding: 0;
		cursor: pointer;
	}
	.row-links a:hover,
	.row-links :global(.li-trigger):hover {
		color: var(--color-ink);
	}
	.row-dot {
		color: #a1a1aa;
	}

	/* PHONE LAYOUT (Kevin 2026-10-03, round 4: the order form "does not show well" on
	   mobile). Measured at 390px before this: the page scrolled sideways to 489px, the
	   steppers were cut off at the right edge and the titles squeezed into a ~70px column.
	   Below 640px the two counters now take their own full-width line under the thumbnail
	   and title, so nothing overflows; the 118px thumbnail is unchanged (Kevin 2026-09-18:
	   "The thumbnails can not be smaller"). The links get a 44px tap height. */
	@media (max-width: 640px) {
		.bulk-row {
			flex-wrap: wrap;
			row-gap: 0.5rem;
			/* With the counters on their own line, a hairline says which book they buy. */
			padding-bottom: 0.9rem;
			border-bottom: 1px solid var(--color-hairline);
		}
		.bulk-row .row-links a,
		.bulk-row .row-links :global(.li-trigger) {
			display: inline-flex;
			align-items: center;
			min-height: 44px;
		}
	}
</style>
<script is:inline>
	(() => {
		const btn = document.querySelector('[data-ebook-buy]');
		if (!btn) return;
		const msg = document.querySelector('[data-ebook-msg]');
		btn.addEventListener('click', async () => {
			const label = btn.textContent;
			btn.disabled = true; btn.textContent = 'Starting checkout…';
			try {
				const r = await fetch('/ebook-checkout', { method: 'POST', headers: { 'content-type': 'application/json' }, body: '{}' });
				const d = await r.json();
				if (d.url) { window.location.href = d.url; return; }
				if (msg) { msg.style.display = 'block'; msg.textContent = d.disabled ? 'Direct download is opening soon — grab it on Amazon meanwhile.' : 'Sorry, something went wrong. Please try again.'; }
			} catch {
				if (msg) { msg.style.display = 'block'; msg.textContent = 'Network error — please try again.'; }
			}
			btn.disabled = false; btn.textContent = label;
		});
	})();
</script>
