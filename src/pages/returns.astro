---
import Section from '../components/Section.astro';
import Layout from '../layouts/Layout.astro';
import { RETURN_DAYS } from '../lib/merchantReturnPolicy';
import { EXPEDITED_DISCLAIMER } from '../lib/order-pricing';
---

<Layout
  title="Return Policy | FHB — Father's Heart Bible™"
  description={`Return policy for Father's Heart Bible™ print Bibles and eBooks bought direct: ${RETURN_DAYS} days from delivery, full refund to your original payment method, no need to ship the book back.`}
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://fathersheartbible.com/" },
      { "@type": "ListItem", "position": 2, "name": "Return Policy", "item": "https://fathersheartbible.com/returns/" }
    ]
  }}
>

  <main id="main-content" style="margin-top: 80px;">
    <Section variant="soft">
      <div class="max-w-3xl mx-auto">
        <h1 class="text-4xl md:text-5xl font-light mb-8" style="font-family: var(--font-serif); color: var(--color-ink);">Return Policy</h1>
        <p class="text-sm mb-8" style="color: var(--color-muted); font-family: var(--font-sans);">Last updated: November 8, 2026</p>

        <div class="space-y-8" style="font-family: var(--font-sans); color: var(--color-muted);">

          <div>
            <h2 class="text-xl font-bold mb-3" style="font-family: var(--font-serif); color: var(--color-ink);">Our Promise</h2>
            <p class="leading-relaxed">If a Father's Heart Bible™ you bought directly from fathersheartbible.com is not right for you, tell us within <strong>{RETURN_DAYS} days of delivery</strong> and we will refund the full price you paid to your original payment method.</p>
          </div>

          <div>
            <h2 class="text-xl font-bold mb-3" style="font-family: var(--font-serif); color: var(--color-ink);">You Do Not Have to Send the Book Back</h2>
            <p class="leading-relaxed">Keep it, give it away, or destroy it. We do not ask you to ship the book back, so a return costs you nothing: no return shipping, no restocking fee, no fees of any kind.</p>
          </div>

          <div>
            <h2 class="text-xl font-bold mb-3" style="font-family: var(--font-serif); color: var(--color-ink);">Damaged or Misprinted Copies</h2>
            <p class="leading-relaxed">If your copy arrives damaged, or has a printing or binding defect, we will send a free replacement, or refund you in full if you prefer. Please include a photo of the problem in your message so we can make it right quickly.</p>
          </div>

          <div>
            <h2 class="text-xl font-bold mb-3" style="font-family: var(--font-serif); color: var(--color-ink);">eBooks</h2>
            <p class="leading-relaxed">If an eBook file cannot be opened, ask within {RETURN_DAYS} days of purchase and we will refund it in full.</p>
          </div>

          <div>
            <h2 class="text-xl font-bold mb-3" style="font-family: var(--font-serif); color: var(--color-ink);">How to Ask for a Refund</h2>
            <ol class="list-decimal pl-6 space-y-2 leading-relaxed">
              <li>Email <strong>hello@spiritmediapublishing.com</strong> with your order email and the edition you ordered.</li>
              <li>Tell us whether you want a refund or, for a damaged copy, a replacement.</li>
              <li>We confirm by email. Refunds go back to your original payment method; your bank typically posts them within 5 to 10 business days.</li>
            </ol>
          </div>

          <div>
            <h2 class="text-xl font-bold mb-3" style="font-family: var(--font-serif); color: var(--color-ink);">Delivery Times and Expedited Delivery</h2>
            <p class="leading-relaxed">{EXPEDITED_DISCLAIMER} Estimated delivery ranges are shown at checkout for your country.</p>
          </div>

          <div>
            <h2 class="text-xl font-bold mb-3" style="font-family: var(--font-serif); color: var(--color-ink);">What This Covers</h2>
            <p class="leading-relaxed">This policy covers print Bibles and eBooks bought directly from fathersheartbible.com and shipped within the United States. Copies bought from other retailers follow that retailer's return policy. Donations are described in our <a href="/terms/" style="color: var(--color-brand); font-weight: 600; text-decoration: none;">Terms of Use</a>.</p>
          </div>

          <div>
            <h2 class="text-xl font-bold mb-3" style="font-family: var(--font-serif); color: var(--color-ink);">Contact</h2>
            <p class="leading-relaxed">Questions? Email <strong>hello@spiritmediapublishing.com</strong> or write to:</p>
            <p class="leading-relaxed mt-2">Spirit Media Publishing<br/>205 Academy Street #3251<br/>Cary, NC 27519<br/>United States</p>
          </div>

        </div>
      </div>
    </Section>
  </main>

</Layout>
