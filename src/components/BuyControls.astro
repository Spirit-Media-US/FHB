---
// The buy controls every product card on /print carries, in one place.
//
// WHY A COMPONENT: the targeted cards, the General Audience colour cards and the Large Print
// volume cards had three separate copies of this markup, which is how they drifted into three
// different shapes — Kevin's round-3 review found the LP cards carrying a third button and the
// general cards carrying none (2026-09-17, "LP Editions need buttons formatted like all other
// buttons... No third button" / "General editions buttons"). One component means
// "formatted like all other buttons" is structurally true rather than re-checked by eye.
//
// THE SHAPE, fixed for every card:
//   Hardback $x.xx · Paperback $y.yy    ← our own FHB prices, plain text
//   Buy now                             ← this edition's own FHB order form
//   Store buttons, then Save 15% + Free Shipping on first order
//
// FHB is the seller (Kevin 2026-11-08): no third-party retailer button that points away from us
// except faith-aligned ones listed in the data once live. Unlisted stores render a faded pill.
//
// The fade is VISUAL ONLY. aria-disabled stays, because a screen reader gets no colour.
interface Props {
	/** Print prices, shown as plain text (our own FHB price list). Omit both on a card with no print binding. */
	hbPrice?: number;
	pbPrice?: number;
	/**
	 * Store buttons BEFORE Buy Direct (Kevin 2026-10-10:
	 * "all store buttons come before Buy Direct"). Same pill, logo first, then
	 * label + price. `ebookDirect` renders the direct eBook checkout
	 * button the page script binds to ([data-ebook-buy]) instead of a link.
	 */
	stores?: {
		logo?: 'google' | 'kobo' | 'spotify' | 'youtube' | 'applepodcasts';
		label: string;
		price: string;
		href?: string;
		ebookDirect?: boolean;
		/** Not live yet (Kevin 2026-10-30: "add that but fade it until live"): the same pill, FADED,
		 *  not a link, aria-disabled, and NO price. Goes live by itself once the listing is in the data. */
		off?: boolean;
		/** counting/test hook: data-store="<key>" on the pill */
		key?: string;
	}[];
	/** Where "Buy Direct" goes. */
	directHref?: string;
	/** Suppress the direct link where buying direct is not offered yet. */
	showDirect?: boolean;
	/**
	 * Shrink the direct link so it holds ONE line in a narrower content box (Kevin
	 * 2026-09-17: "make this fit on one line ... even if it has to be little smaller").
	 * Only the journaling card needs it: its 3px frame takes 4px off the inner width,
	 * which is exactly enough to wrap "Save 15% + Free Shipping on first order".
	 */
	tightDirect?: boolean;
	/** /print: the catalog id ("teen", "lang-es") the catalog order form pre-fills when the
	 *  direct link is followed (src/scripts/order-form.ts). */
	pick?: string;
	/** Compact pills that hold logo + label + price on ONE line (the General eBook/audiobook cards). */
	compact?: boolean;
	/** Pad the button set with invisible slots up to this many, so cards with fewer stores line up
	 *  with the rest (Kevin 2026-10-10: keep space for eBook + audiobook to be added later). */
	reserveSlots?: number;
	/** "Buy now" (Kevin 2026-10-22): this edition's OWN order form, /bibles/<slug>-bible/#order
	 *  (EditionOrder.astro). `null` = the card has no edition page yet: an invisible slot of the
	 *  same size keeps the row lined up. Omitted = no Buy now on this card at all. */
	buyNowHref?: string | null;
}
const {
	hbPrice,
	pbPrice,
	directHref = '#bulk-order',
	showDirect = true,
	tightDirect = false,
	pick,
	stores = [],
	compact = false,
	reserveSlots = 0,
	buyNowHref,
} = Astro.props;

// Store logos, self-hosted on R2 (never hotlinked). Google Play: Google's
// own horizontal lockup from gstatic (play_prism_hlock_2x.png), the same mark as the 2016 logo
// Kevin pointed at. Kobo: the "kobo" wordmark cut from Kobo Writing Life's own logo SVG
// (kobo.com bot-checks our servers). Sized by HEIGHT so the three marks sit level.
const LOGOS = {
	google: {
		src: 'https://assets.spiritmediapublishing.com/FHB/print/google-play-logo.webp',
		w: 288,
		h: 58,
	},
	kobo: { src: 'https://assets.spiritmediapublishing.com/FHB/print/kobo-logo.webp', w: 144, h: 58 },
	// Free listening (Kevin 2026-10-10): Spotify's full logo from its newsroom brand files,
	// YouTube's logo from YouTube's gstatic branding, Apple Podcasts' app icon from apple.com.
	spotify: {
		src: 'https://assets.spiritmediapublishing.com/FHB/print/spotify-logo.webp',
		w: 212,
		h: 58,
	},
	youtube: {
		src: 'https://assets.spiritmediapublishing.com/FHB/print/youtube-logo.webp',
		w: 258,
		h: 58,
	},
	applepodcasts: {
		src: 'https://assets.spiritmediapublishing.com/FHB/print/apple-podcasts-icon.webp',
		w: 58,
		h: 58,
	},
} as const;

const STORE_NAMES = {
	google: 'Google Play Books',
	kobo: 'Kobo',
	spotify: 'Listen on Spotify',
	youtube: 'Watch on YouTube',
	applepodcasts: 'Listen on Apple Podcasts',
} as const;

// Stacked, label left and price right (Kevin 2026-11-08). Prices come from the props (the data).
const priceRows = [
	hbPrice !== undefined ? { label: 'Hardback', price: `$${hbPrice.toFixed(2)}` } : null,
	pbPrice !== undefined ? { label: 'Paperback', price: `$${pbPrice.toFixed(2)}` } : null,
].filter((r): r is { label: string; price: string } => r !== null);
const btnClass = compact ? 'buy-btn buy-btn-compact' : 'buy-btn';
const spare = Math.max(0, reserveSlots - stores.length);
---

{/* LIGHT PINK on every button (Kevin 2026-09-17, "Turn all button light pink"), taken from
    the existing brand token --color-primary-fixed rather than a new colour invented for this
    page. Ink on light pink is a strong contrast; the disabled placeholder drops to a muted
    pink with grey text so it reads as unavailable without becoming pink-on-pink. */}
{
	priceRows.length > 0 && (
		<div class="buy-prices">
			{priceRows.map((r) => (
				<p class="buy-price-row">
					<span>{r.label}</span>
					<span>{r.price}</span>
				</p>
			))}
		</div>
	)
}
{
	buyNowHref ? (
		<a href={buyNowHref} class="buy-btn buy-now" style="text-decoration: none;" data-buy-now>
			<span>Buy now</span>
		</a>
	) : (
		buyNowHref === null && (
			<span class="buy-btn buy-btn-slot" aria-hidden="true">
				<span>&nbsp;</span>
			</span>
		)
	)
}
{
	stores.map((st) => {
		const logo = st.logo ? LOGOS[st.logo] : null;
		const inner = (
			<>
				{logo && (
					// A logo-only button (no label text) needs the store's name as its alt, or the link has no name (Lighthouse link-name).
					<img src={logo.src} alt={st.label || st.price ? '' : STORE_NAMES[st.logo as keyof typeof STORE_NAMES]} width={logo.w} height={logo.h} loading="lazy" decoding="async" class="store-logo" />
				)}
				{(st.label || st.price) && <span>{`${logo ? '· ' : ''}${[st.label, st.price].filter(Boolean).join(' ')}`}</span>}
			</>
		);
		if (st.off)
			return (
				<span class={`${btnClass} buy-btn-off`} aria-disabled="true" data-store={st.key} data-store-off>
					{logo && <img src={logo.src} alt={STORE_NAMES[st.logo as keyof typeof STORE_NAMES]} width={logo.w} height={logo.h} loading="lazy" decoding="async" class="store-logo store-logo-off" />}
					{st.label && <span>{`· ${st.label}`}</span>}
				</span>
			);
		return st.ebookDirect ? (
			<button type="button" data-ebook-buy class={btnClass}>{inner}</button>
		) : (
			<a href={st.href} target="_blank" rel="noopener" class={btnClass} style="text-decoration: none;" data-store={st.key}>{inner}</a>
		);
	})
}
{
	Array.from({ length: spare }, () => (
		<span class="buy-btn buy-btn-slot" aria-hidden="true">
			<span>&nbsp;</span>
		</span>
	))
}
{
	showDirect && (
		<a href={directHref} class={tightDirect ? 'buy-direct buy-direct-tight' : 'buy-direct'} data-pick-edition={pick}>
			Save 15% + Free Shipping on first order
		</a>
	)
}

<style>
	.buy-prices {
		font-family: var(--font-sans);
		font-size: 0.82rem;
		font-weight: 700;
		color: var(--color-ink);
		margin: 0;
	}
	.buy-price-row {
		display: flex;
		justify-content: space-between;
		gap: 0.5rem;
		margin: 0;
	}
	.buy-direct:hover {
		color: var(--color-ink);
	}
	/* NO `white-space: nowrap` HERE. It was the actual cause of the spill Kevin saw: the logo
	   plus "· Hardback $99.99" needs about 199px and a card is 133px wide at phone width, so
	   the label ran straight out of the pill — measured as scrollWidth > clientWidth on 32 of
	   44 buttons at 400px, while every button still reported a normal single-line HEIGHT. A
	   height check would have passed. Letting the content wrap keeps it inside the pill, and
	   the logo and type step down on narrow screens so it usually stays on one line anyway. */
	.buy-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.2rem 0.4rem;
		border-radius: 999px;
		font-weight: 600;
		font-family: var(--font-sans);
		background: var(--color-primary-fixed, #ffd9e0);
		color: var(--color-ink, #1a1c1c);
		border: 1.5px solid var(--color-primary, #b60057);
		padding: 0.5rem 0.75rem;
		font-size: 0.8rem;
		line-height: 1.25;
		cursor: pointer;
		text-align: center;
	}
	.buy-btn img {
		flex: none;
	}
	.buy-btn .store-logo {
		height: 16px;
		width: auto;
		display: block;
	}
	@media (max-width: 640px) {
		.buy-btn {
			padding: 0.45rem 0.55rem;
			font-size: 0.72rem;
		}
		.buy-btn img {
			width: 40px !important;
		}
		.buy-btn .store-logo {
			width: auto !important;
			height: 12px;
		}
	}
	/* One line: logo, label and price never break apart. */
	.buy-btn-compact {
		flex-wrap: nowrap;
		white-space: nowrap;
		padding: 0.4rem 0.6rem;
		font-size: 0.74rem;
		gap: 0.3rem;
	}
	.buy-btn-compact .store-logo {
		height: 13px;
	}
	/* From 641px up every pill holds logo + label + price on ONE line (Kevin 2026-10-10:
	   "Google Play logo + Audiobook $24.99 on one line") — a two-line pill also made one
	   card's controls taller than its neighbours'. Phones keep wrapping: a 133px card
	   cannot hold the line, and nowrap there spills out of the pill (the measured bug above). */
	@media (min-width: 641px) {
		.buy-btn {
			flex-wrap: nowrap;
			white-space: nowrap;
		}
	}
	/* A reserved, invisible slot: same box as a button, so every card's controls line up. */
	.buy-btn-slot {
		visibility: hidden;
	}
	/* Buy now: the one filled pill on the card, so the direct order reads as the primary action. */
	.buy-now {
		background: var(--color-primary, #b60057);
		color: #fff;
	}
	.buy-btn-off {
		background: #fdeef3;
		color: #9a8c90;
		border-color: #eccdd6;
		cursor: default;
	}
	/* A faded store pill is not a control at all until its listing is live: nothing to click. */
	.buy-btn-off[data-store-off] {
		pointer-events: none;
	}
	.buy-btn .store-logo-off {
		opacity: 0.45;
	}
	.buy-direct {
		font-family: var(--font-sans);
		font-size: 0.82rem;
		font-weight: 700;
		color: #3f3f46;
		text-decoration: underline;
		text-underline-offset: 2px;
		text-align: center;
		padding: 0.15rem 0;
	}
	/* ONE LINE FROM 641px UP, AND NOWHERE NARROWER — because narrower is not physically
	   possible, not because it was not asked for.
	   Kevin asked for this link to hold one line on the journaling card, "even if it has to
	   be little smaller". On a phone the targeted cards are two-across and the content box is
	   133px; "Save 15% + Free Shipping on first order" needs about 200px at 12px type, so one line
	   there means roughly an 8px font — unreadable, and below any sensible minimum. I shipped
	   `white-space: nowrap` unconditionally first and MEASURED the result: the link did not
	   shrink to fit, it ran straight out of the card and put a horizontal scrollbar on the
	   whole page at 400px. Exactly the .buy-btn spill again, one element over.
	   So: nowrap + a size step where the box can hold it, and ordinary wrapping below that. */
	@media (min-width: 641px) {
		/* Kevin 2026-11-08: every card link is ONE style, so no size step here; the link wraps. */
		.buy-direct-tight {
			white-space: normal;
		}
	}
</style>
