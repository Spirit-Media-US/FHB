---
// The buy controls every product card on /print carries, in one place.
//
// WHY A COMPONENT: the targeted cards, the General Audience colour cards and the Large Print
// volume cards had three separate copies of this markup, which is how they drifted into three
// different shapes — Kevin's round-3 review found the LP cards carrying a third button and the
// general cards carrying none (2026-09-17, "LP Editions need buttons formatted like all other
// buttons... No third button" / "General editions buttons need Amazon"). One component means
// "formatted like all other buttons" is structurally true rather than re-checked by eye.
//
// THE SHAPE, fixed for every card:
//   Amazon · Hardback  $x.xx        ← link, or a disabled PLACEHOLDER when unlisted
//   Amazon · Paperback $y.yy        ← link, or a disabled PLACEHOLDER when unlisted
//   Buy Direct & Save + Free Shipping   ← a LINK, never a button, to the bulk form
//
// PLACEHOLDERS RATHER THAN OMISSIONS (Kevin: "add placeholders for ALL buttons"): a binding
// with no Amazon listing still renders its button, disabled, in the same position — so every
// card has the same control set and the grid lines up instead of going ragged. Four bindings
// are genuinely unlisted (men's and Peace paperback, Recovery and Teen hardback) and a link is
// never invented to fill one (D184).
//
// A PLACEHOLDER CARRIES THE SAME LABEL AS A LIVE BUTTON — binding and price, nothing else
// (Kevin 2026-09-17: "remove 'coming soon' ... Do show the price and everything ready to be
// linked and activated"). The trailing phrase was spilling the label onto a second line, and
// it made activation a copy edit as well as a link change. Now the ONLY difference between a
// placeholder and a live button is the href and the fade, so turning one live when the listing
// appears is adding the URL and nothing else.
//
// The fade is VISUAL ONLY. aria-disabled stays, because a screen reader gets no colour.
interface Props {
	/** Amazon URLs per binding. Absent = no listing = a disabled placeholder. */
	hbHref?: string;
	pbHref?: string;
	/** Omit both prices on a card with no print binding (the eBook / audiobook cards). */
	hbPrice?: number;
	pbPrice?: number;
	/**
	 * Store buttons after the Amazon print buttons and BEFORE Buy Direct (Kevin 2026-10-10:
	 * "all store buttons come before Buy Direct & Save"). Same pill, logo first, then
	 * label + price — the Amazon shape. `ebookDirect` renders the direct eBook checkout
	 * button the page script binds to ([data-ebook-buy]) instead of a link.
	 */
	stores?: {
		logo?: 'amazon' | 'google' | 'kobo' | 'spotify' | 'youtube' | 'applepodcasts';
		label: string;
		price: string;
		href?: string;
		ebookDirect?: boolean;
	}[];
	/** Where "Buy Direct" goes. */
	directHref?: string;
	/** Suppress the direct link where buying direct is not offered yet. */
	showDirect?: boolean;
	/**
	 * Shrink the direct link so it holds ONE line in a narrower content box (Kevin
	 * 2026-09-17: "make this fit on one line ... even if it has to be little smaller").
	 * Only the journaling card needs it: its 3px frame takes 4px off the inner width,
	 * which is exactly enough to wrap "Buy Direct & Save + Free Shipping".
	 */
	tightDirect?: boolean;
	/** /print: the catalog id ("teen", "lang-es") the catalog order form pre-fills when the
	 *  direct link is followed (src/scripts/order-form.ts). */
	pick?: string;
	/** Compact pills that hold logo + label + price on ONE line (the General eBook/audiobook cards). */
	compact?: boolean;
	/** Pad the button set with invisible slots up to this many, so cards with fewer stores line up
	 *  with the rest (Kevin 2026-10-10: keep space for eBook + audiobook to be added later). */
	reserveSlots?: number;
	/** Barnes & Noble listing URLs per binding (src/data/bn-links.json — verified only). One
	 *  compact pill: the B&N mark, then a link per binding (Kevin 2026-10-10). */
	bn?: { hardback?: string; paperback?: string };
	/** Keep an invisible B&N-sized slot when this card has no verified B&N listing, so the
	 *  Buy Direct line still lines up across the row. */
	reserveBn?: boolean;
}
const {
	hbHref,
	pbHref,
	hbPrice,
	pbPrice,
	directHref = '#bulk-order',
	showDirect = true,
	tightDirect = false,
	pick,
	stores = [],
	compact = false,
	reserveSlots = 0,
	bn,
	reserveBn = false,
} = Astro.props;
const bnLinks = [
	{ label: 'Hardback', href: bn?.hardback },
	{ label: 'Paperback', href: bn?.paperback },
].filter((x) => x.href);

const AMAZON_LOGO = 'https://assets.spiritmediapublishing.com/FHB/print/amazon-logo.webp';
// Store logos, self-hosted on R2 like the Amazon one (never hotlinked). Google Play: Google's
// own horizontal lockup from gstatic (play_prism_hlock_2x.png), the same mark as the 2016 logo
// Kevin pointed at. Kobo: the "kobo" wordmark cut from Kobo Writing Life's own logo SVG
// (kobo.com bot-checks our servers). Sized by HEIGHT so the three marks sit level.
const LOGOS = {
	amazon: { src: AMAZON_LOGO, w: 192, h: 58 },
	google: {
		src: 'https://assets.spiritmediapublishing.com/FHB/print/google-play-logo.webp',
		w: 288,
		h: 58,
	},
	kobo: { src: 'https://assets.spiritmediapublishing.com/FHB/print/kobo-logo.webp', w: 144, h: 58 },
	// B&N's own "B&N" mark from barnesandnoble.com's CDN.
	bn: { src: 'https://assets.spiritmediapublishing.com/FHB/print/bn-logo.webp', w: 165, h: 58 },
	// Free listening (Kevin 2026-10-10): Spotify's full logo from its newsroom brand files,
	// YouTube's logo from YouTube's gstatic branding, Apple Podcasts' app icon from apple.com.
	spotify: {
		src: 'https://assets.spiritmediapublishing.com/FHB/print/spotify-logo.webp',
		w: 212,
		h: 58,
	},
	youtube: {
		src: 'https://assets.spiritmediapublishing.com/FHB/print/youtube-logo.webp',
		w: 258,
		h: 58,
	},
	applepodcasts: {
		src: 'https://assets.spiritmediapublishing.com/FHB/print/apple-podcasts-icon.webp',
		w: 58,
		h: 58,
	},
} as const;

const bindings = [
	{ label: 'Hardback', href: hbHref, price: hbPrice },
	{ label: 'Paperback', href: pbHref, price: pbPrice },
].filter((b) => b.price !== undefined) as { label: string; href?: string; price: number }[];
const btnClass = compact ? 'buy-btn buy-btn-compact' : 'buy-btn';
const spare = Math.max(0, reserveSlots - bindings.length - stores.length);
---

{/* LIGHT PINK on every button (Kevin 2026-09-17, "Turn all button light pink"), taken from
    the existing brand token --color-primary-fixed rather than a new colour invented for this
    page. Ink on light pink is a strong contrast; the disabled placeholder drops to a muted
    pink with grey text so it reads as unavailable without becoming pink-on-pink. */}
{
	bindings.map((b) =>
		b.href ? (
			<a
				href={b.href}
				target="_blank"
				rel="noopener"
				class="buy-btn"
				style="text-decoration: none;"
			>
				{/* Empty alt: the button text already says Amazon, so a second announcement is
				    noise to a screen reader. Explicit width/height so it cannot shift layout
				    (performance gate, trait 8). Served from OUR asset host — the logo Kevin
				    supplied was fetched, cleaned and uploaded to R2 rather than hotlinked. */}
				<img
					src={AMAZON_LOGO}
					alt=""
					width="64"
					height="19"
					loading="lazy"
					decoding="async"
					style="width: 52px; height: auto; display: block;"
				/>
				<span>· {b.label} ${b.price.toFixed(2)}</span>
			</a>
		) : (
			<span class="buy-btn buy-btn-off" aria-disabled="true">
				<img
					src={AMAZON_LOGO}
					alt=""
					width="64"
					height="19"
					loading="lazy"
					decoding="async"
					style="width: 52px; height: auto; display: block; opacity: 0.45;"
				/>
				<span>· {b.label} ${b.price.toFixed(2)}</span>
			</span>
		),
	)
}
{
	stores.map((st) => {
		const logo = st.logo ? LOGOS[st.logo] : null;
		const inner = (
			<>
				{logo && (
					<img src={logo.src} alt="" width={logo.w} height={logo.h} loading="lazy" decoding="async" class="store-logo" />
				)}
				{(st.label || st.price) && <span>{`${logo ? '· ' : ''}${[st.label, st.price].filter(Boolean).join(' ')}`}</span>}
			</>
		);
		return st.ebookDirect ? (
			<button type="button" data-ebook-buy class={btnClass}>{inner}</button>
		) : (
			<a href={st.href} target="_blank" rel="noopener" class={btnClass} style="text-decoration: none;">{inner}</a>
		);
	})
}
{
	Array.from({ length: spare }, () => (
		<span class="buy-btn buy-btn-slot" aria-hidden="true">
			<span>&nbsp;</span>
		</span>
	))
}
{
	bnLinks.length > 0 ? (
		<span class="buy-btn buy-btn-bn">
			<img src={LOGOS.bn.src} alt="Barnes & Noble" width={LOGOS.bn.w} height={LOGOS.bn.h} loading="lazy" decoding="async" class="store-logo" />
			{bnLinks.map((x) => (
				<>
					<span aria-hidden="true">·</span>
					<a href={x.href} target="_blank" rel="noopener" class="bn-link">
						{x.label}
					</a>
				</>
			))}
		</span>
	) : (
		reserveBn && (
			<span class="buy-btn buy-btn-slot" aria-hidden="true">
				<span>&nbsp;</span>
			</span>
		)
	)
}
{
	showDirect && (
		<a href={directHref} class={tightDirect ? 'buy-direct buy-direct-tight' : 'buy-direct'} data-pick-edition={pick}>
			Buy Direct &amp; Save + Free Shipping
		</a>
	)
}

<style>
	/* NO `white-space: nowrap` HERE. It was the actual cause of the spill Kevin saw: the logo
	   plus "· Hardback $99.99" needs about 199px and a card is 133px wide at phone width, so
	   the label ran straight out of the pill — measured as scrollWidth > clientWidth on 32 of
	   44 buttons at 400px, while every button still reported a normal single-line HEIGHT. A
	   height check would have passed. Letting the content wrap keeps it inside the pill, and
	   the logo and type step down on narrow screens so it usually stays on one line anyway. */
	.buy-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.2rem 0.4rem;
		border-radius: 999px;
		font-weight: 600;
		font-family: var(--font-sans);
		background: var(--color-primary-fixed, #ffd9e0);
		color: var(--color-ink, #1a1c1c);
		border: 1.5px solid var(--color-primary, #b60057);
		padding: 0.5rem 0.75rem;
		font-size: 0.8rem;
		line-height: 1.25;
		cursor: pointer;
		text-align: center;
	}
	.buy-btn img {
		flex: none;
	}
	.buy-btn .store-logo {
		height: 16px;
		width: auto;
		display: block;
	}
	@media (max-width: 640px) {
		.buy-btn {
			padding: 0.45rem 0.55rem;
			font-size: 0.72rem;
		}
		.buy-btn img {
			width: 40px !important;
		}
		.buy-btn .store-logo {
			width: auto !important;
			height: 12px;
		}
	}
	/* One line: logo, label and price never break apart. */
	.buy-btn-compact {
		flex-wrap: nowrap;
		white-space: nowrap;
		padding: 0.4rem 0.6rem;
		font-size: 0.74rem;
		gap: 0.3rem;
	}
	.buy-btn-compact .store-logo {
		height: 13px;
	}
	/* From 641px up every pill holds logo + label + price on ONE line (Kevin 2026-10-10:
	   "Google Play logo + Audiobook $24.99 on one line") — a two-line pill also made one
	   card's controls taller than its neighbours'. Phones keep wrapping: a 133px card
	   cannot hold the line, and nowrap there spills out of the pill (the measured bug above). */
	@media (min-width: 641px) {
		.buy-btn {
			flex-wrap: nowrap;
			white-space: nowrap;
		}
	}
	/* B&N: one pill, two links (a pill cannot be one link to two pages). */
	.buy-btn-bn {
		cursor: default;
		gap: 0.3rem;
	}
	.bn-link {
		color: inherit;
		text-decoration: underline;
		text-underline-offset: 2px;
	}
	/* A reserved, invisible slot: same box as a button, so every card's controls line up. */
	.buy-btn-slot {
		visibility: hidden;
	}
	.buy-btn-off {
		background: #fdeef3;
		color: #9a8c90;
		border-color: #eccdd6;
		cursor: default;
	}
	.buy-direct {
		font-family: var(--font-sans);
		font-size: 0.82rem;
		font-weight: 700;
		color: var(--color-primary, #b60057);
		text-decoration: underline;
		text-underline-offset: 3px;
		text-align: center;
		padding: 0.15rem 0;
	}
	/* ONE LINE FROM 641px UP, AND NOWHERE NARROWER — because narrower is not physically
	   possible, not because it was not asked for.
	   Kevin asked for this link to hold one line on the journaling card, "even if it has to
	   be little smaller". On a phone the targeted cards are two-across and the content box is
	   133px; "Buy Direct & Save + Free Shipping" needs about 200px at 12px type, so one line
	   there means roughly an 8px font — unreadable, and below any sensible minimum. I shipped
	   `white-space: nowrap` unconditionally first and MEASURED the result: the link did not
	   shrink to fit, it ran straight out of the card and put a horizontal scrollbar on the
	   whole page at 400px. Exactly the .buy-btn spill again, one element over.
	   So: nowrap + a size step where the box can hold it, and ordinary wrapping below that. */
	@media (min-width: 641px) {
		.buy-direct-tight {
			font-size: 0.72rem;
			white-space: nowrap;
		}
	}
</style>
