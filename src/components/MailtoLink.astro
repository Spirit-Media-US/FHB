---
/**
 * MailtoLink — email link that always does something.
 *
 * History: this component used to render href="#" and assemble the address in JS
 * on click (window.location = 'mailto:…') to keep the address out of the HTML
 * source. That silently broke for every visitor without a registered mail handler
 * — most webmail users — where setting location to a mailto: is a no-op. A
 * customer reported "I clicked CONTACT and nothing happens" on 2026-09-03.
 *
 * Now: a real mailto: href written at page load (works with a mail client, and
 * is right-click copyable without one), plus a clipboard fallback that surfaces
 * the address inline, after a click, when the mailto doesn't take the visitor anywhere.
 *
 * Usage:
 *   <MailtoLink email="info@spiritmedia.us" class="text-red hover:underline">
 *     Email us
 *   </MailtoLink>
 * The slot is WORDS, never the address (Kevin 2026-11-20).
 *
 * No default aria-label: the visible text names the link. A default "Email <address>" on a
 * link that READS "Contact" fails Lighthouse label-content-name-mismatch (voice users say
 * what they see). Pass aria-label only for a link whose slot has no text.
 */
interface Props {
	email: string;
	subject?: string;
	class?: string;
	'aria-label'?: string;
	[key: string]: any;
}

// Kevin 2026-11-20 RULE: "we DO NOT ever post emails directly on any of our websites ... I always says
// mailto: link." The address must not sit in the built HTML (no text, no href="mailto:addr", no data
// attribute holding it whole). It ships split (data-mu / data-md) and the script below writes the real
// mailto: href once the page loads, so the link still works like a normal mailto: (and stays
// right-click copyable) for every visitor. bin/no-visible-email-guard.py fails the deploy otherwise.
const { email, subject, class: className, 'aria-label': ariaLabel, ...rest } = Astro.props;
const [mu, md] = String(email).split('@');
---

<a
  href="#contact"
  class={className}
  data-mu={mu}
  data-md={md}
  data-ms={subject}
  aria-label={ariaLabel}
  {...rest}
><slot /></a>

<script>
  // Fallback: if the browser has no mail handler the click does nothing visible.
  // Detect that (the page is still here, unblurred, a moment later) and reveal
  // the address so the visitor can copy it instead of hitting a dead link.
  document.querySelectorAll<HTMLAnchorElement>('a[data-mu][data-md]').forEach((el) => {
    const addr = `${el.dataset.mu}@${el.dataset.md}`;
    el.href = `mailto:${addr}${el.dataset.ms ? `?subject=${encodeURIComponent(el.dataset.ms)}` : ''}`;
    el.addEventListener('click', () => {
      let left = false;
      const mark = () => { left = true; };
      window.addEventListener('blur', mark, { once: true });
      window.addEventListener('pagehide', mark, { once: true });
      setTimeout(() => {
        window.removeEventListener('blur', mark);
        if (left || document.hidden) return;
        navigator.clipboard?.writeText(addr).catch(() => {});
        const note = document.createElement('span');
        note.textContent = ` — ${addr} (copied)`;
        note.style.cssText = 'font-size:0.9em;opacity:0.85;';
        if (!el.nextElementSibling?.hasAttribute?.('data-mailto-note')) {
          note.setAttribute('data-mailto-note', '');
          el.insertAdjacentElement('afterend', note);
        }
      }, 800);
    });
  });
</script>
