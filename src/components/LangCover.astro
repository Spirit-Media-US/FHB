---
// A language edition's cover on /print and its /bibles page. The card art is cut from the
// edition's BUILT case press file (cover rule, Kevin 2026-10-06); until that case is built the
// edition shows this cover-pending tile in the same frame and size — its own title in its own
// script, never another edition's art and never a drawn cover (Kevin 2026-10-29: all 80 languages
// on /print, "with book covers" as each is built).
import { cardUrl, hasLangCard } from '../data/card-art';

interface Props {
	code: string;
	name: string;
	english: string;
	rtl?: boolean;
	/** 'card' = /print grid (lazy, 600/1200 srcset); 'page' = the edition page hero (1200, eager) */
	variant?: 'card' | 'page';
}
const { code, name, english, rtl, variant = 'card' } = Astro.props;
const has = hasLangCard(code);
const alt = `Father's Heart Bible (FHB) — ${name}, the ${english} edition`;
---
{has ? (
	variant === 'page' ? (
		<img id="cover-main" src={cardUrl(`lang-${code}`, 1200)} alt={`${name} — Father's Heart Bible (FHB) in Divine Voice™ Color`} width="1200" height="1528" fetchpriority="high" decoding="async" class="block w-full h-auto" />
	) : (
		<img
			src={cardUrl(`lang-${code}`)}
			srcset={`${cardUrl(`lang-${code}`)} 600w, ${cardUrl(`lang-${code}`, 1200)} 1200w`}
			sizes="(min-width: 1024px) 260px, 44vw"
			alt={alt}
			width="600" height="764" loading="lazy" decoding="async"
			class="block w-full h-auto" style="max-width: 220px;"
		/>
	)
) : (
	<div class={`lang-cover-pending ${variant === 'page' ? 'lang-cover-pending--page' : ''}`} role="img" aria-label={`${alt} — cover in production`}>
		<span class="lcp__brand">Father’s Heart Bible™</span>
		<span class="lcp__title" lang={code} dir={rtl ? 'rtl' : undefined}>{name}</span>
		<span class="lcp__english">{english}</span>
		<span class="lcp__note">Cover in production</span>
	</div>
)}
<style>
	.lang-cover-pending {
		width: 100%;
		max-width: 220px;
		aspect-ratio: 600 / 764;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		padding: 1.2rem 1rem;
		box-sizing: border-box;
		border-radius: 6px 10px 10px 6px;
		border: 1px solid var(--color-hairline, #e4e4e7);
		border-left: 6px solid #d4d4d8;
		background: #fff;
		text-align: center;
	}
	.lang-cover-pending--page { max-width: 340px; }
	.lcp__brand { font-family: var(--font-sans); font-size: 0.7rem; letter-spacing: 0.06em; color: #71717a; }
	.lcp__title { font-family: var(--font-headline); font-size: 1.15rem; font-weight: 600; line-height: 1.3; color: var(--color-ink); }
	.lang-cover-pending--page .lcp__title { font-size: 1.6rem; }
	.lcp__english { font-family: var(--font-sans); font-size: 0.78rem; font-weight: 600; color: var(--color-ink); }
	.lcp__note { font-family: var(--font-sans); font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #a1a1aa; margin-top: 0.6rem; }
</style>
