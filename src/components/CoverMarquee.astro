---
import { cardUrl } from '../data/card-art';
import { LANGUAGE_EDITION_TOTAL, langSlug, languageEditions } from '../data/language-editions';
// FHB cover marquee — Kevin 2026-09-24.
//
// "Scrolling marquee of 3D image thumbnails of all FHB covers as shown on /print",
// with the title above and the FATHER | SON | SPIRIT chips under it. The tagline
// moved below the homepage's two buttons 2026-09-24 (Kevin), so it closes the section
// (as on the SMP homepage's copy of this component). Kevin ruled 2026-09-24 that the
// block sits DIRECTLY BELOW THE FOLD, not above it, "so it doesn't affect the psi" — the hero above is untouched and
// stays the LCP element.
//
// Engineering constraints (rules/performance-gate.md, and the job brief):
//   • CSS transform animation only — no JS loop, nothing driving it per frame.
//   • Explicit width/height on every thumbnail so nothing shifts as it loads.
//   • Every thumbnail lazy-loaded: legitimate now that the block is below the fold.
//   • prefers-reduced-motion: reduce → no motion at all; the strip becomes a
//     normal horizontally-scrollable row.
//   • No vh/svh anywhere.
//
// The images are the SAME R2 keys /print serves, resolved through card-art.ts so a
// card swap there moves this strip too. No new art is rendered and nothing is
// uploaded — the marquee is a second consumer of what /print already shows.
import VoiceChips from './VoiceChips.astro';

// The twenty-three targeted DVC editions (the seven added 2026-09-29 included, Kevin
// 2026-10-02), then the three general colours, then the three
// Large Print volumes and the set — the same products /print lists, in its order.
const DVC = [
	['athletes', "Athlete's Bible"],
	['chosen', 'Chosen Bible'],
	['couples', "Couple's Bible"],
	['dads', "Dad's Bible"],
	['first-responders', "First Responder's Bible"],
	['graduates', "Graduate's Bible"],
	['grandparents', "Grandparent's Bible"],
	['intercessors', "Intercessor's Bible"],
	['mens', "Men's Bible"],
	['moms', "Mom's Bible"],
	['nurses', "Nurse's Bible"],
	['pastors', "Pastor's Bible"],
	['peace', 'Peace Bible'],
	['presidents', "President's Bible"],
	['recovery', 'Recovery Bible'],
	['seekers', "Seeker's Bible"],
	['seventeen', 'Seventeen Bible'],
	['soldiers', "Soldier's Bible"],
	['teachers', "Teacher's Bible"],
	['teen', 'Teen Bible'],
	['womens', "Women's Bible"],
	['worship-leaders', "Worship Leader's Bible"],
	['journaling', 'She Hears Her Father’s Voice Journaling Bible'],
];
const GENERAL = [
	['general-regular-charcoal', 'Charcoal edition'],
	['general-regular-plum', 'Plum edition'],
	['general-regular-white', 'White edition'],
];
const LARGE_PRINT = [
	['lp-vol1', 'Large Print Volume 1'],
	['lp-vol2', 'Large Print Volume 2'],
	['lp-vol3', 'Large Print Volume 3'],
	['lp-set', 'Large Print three-volume set'],
];

// Displayed box is 180 CSS px wide (1.5x the original 120 — Kevin 2026-09-24). The
// source cards are 600 wide, so even a 2x screen draws 360 of 600 available pixels.
// Every card is 600x764 except the 8x10 journaling card (600x725), so height is
// computed from each card's own ratio — a shared number would letterbox it and report
// the wrong aspect to the browser. width/height are the DISPLAY size (180x229 and
// 180x218), which is what protects CLS.
const W = 180;
const H = (key: string) => Math.round((W * (key === 'dvc-journaling' ? 725 : 764)) / 600);
const covers = [
	// Every cover links to ITS product page (Kevin 2026-10-03), not to /print.
	...DVC.map(([slug, name]) => ({ key: `dvc-${slug}`, name, href: `/bibles/${slug}-bible/` })),
	...GENERAL.map(([key, name]) => ({ key, name, href: '/bibles/fathers-heart-bible/' })),
	...LARGE_PRINT.map(([key, name]) => ({ key, name, href: `/bibles/${key}-bible/` })),
].map((c) => ({ ...c, src: cardUrl(c.key), h: H(c.key) }));

// SECOND ROW (Kevin 2026-10-02): every LANGUAGE edition, running the OPPOSITE way. Same
// card style, size, spacing and on-screen speed as the English row — it is the same strip
// markup with a direction flag, not a second implementation. Language cards are all 600x764.
// READ ORDER (Kevin 2026-10-03: "reads in REVERSE alphabetical order"). This row travels
// left-to-right, so covers ENTER from the left in reverse DOM order. Reversing the list here
// makes them arrive A→Z in the direction the row moves.
const langCovers = [...languageEditions].reverse().map((l) => ({
	key: `lang-${l.code}`,
	name: `${l.name} (${l.english})`,
	caption: l.english,
	href: `/bibles/${langSlug(l)}-bible/`,
	src: cardUrl(`lang-${l.code}`, 360),
	h: H(`lang-${l.code}`),
}));

// SPEED IS PER PIXEL, NOT PER LOOP. The loop travels one copy of the row, so its duration
// must scale with the row's length or a longer row runs faster. 100s was tuned (2026-09-24)
// for the 23-cover row of that day: 100/23 s per cover keeps that exact on-screen speed for
// any count, for both rows.
const SECONDS_PER_COVER = 100 / 23;
// Row titles (Kevin 2026-10-03). The audience figure is Kevin's count of targeted audience
// editions (the row also carries journaling, the general colours and Large Print). The
// language figure is Kevin's 26 (2026-10-03), counted from the edition list including the
// ones whose covers have not landed — see language-editions.ts.
const rows = [
	{ covers, reverse: false, href: '/print/', label: '22 Audience Editions' },
	{
		covers: langCovers,
		reverse: true,
		href: '/print/#language-editions',
		label: `${LANGUAGE_EDITION_TOTAL} Language Editions`,
	},
].filter((r) => r.covers.length > 0);
---

<section class="fhbm" aria-labelledby="fhbm-title">
	<h2 id="fhbm-title" class="fhbm-title">Father&rsquo;s Heart Bible™ + Divine Voice Color™ is Here</h2>

	<!-- The strip. The track holds the covers TWICE and travels exactly -50%, so the
	     second copy is under the cursor at the moment the first wraps — that is what
	     makes the loop seamless without any JS. aria-hidden on the duplicate so a
	     screen reader hears each cover once. -->
	{rows.map((row) => (
		<>
		<p class="fhbm-label">{row.label}</p>
		<div class="fhbm-viewport">
			<div
				class={row.reverse ? 'fhbm-track fhbm-track--reverse' : 'fhbm-track'}
				style={`animation-duration: ${(row.covers.length * SECONDS_PER_COVER).toFixed(1)}s;`}
			>
				{[0, 1].map((copy) => (
					<ul class="fhbm-row" aria-hidden={copy === 1 ? 'true' : undefined}>
						{row.covers.map((c) => (
							<li>
								<a href={c.href ?? row.href} tabindex={copy === 1 ? -1 : undefined}>
									<img
										src={c.src}
										alt={copy === 1 ? '' : `Father's Heart Bible — ${c.name}`}
										width={W}
										height={c.h}
										loading="lazy"
										decoding="async"
										fetchpriority={'caption' in c ? 'low' : undefined}
									/>
									{'caption' in c && <span class="fhbm-cap">{c.caption}</span>}
								</a>
							</li>
						))}
					</ul>
				))}
			</div>
		</div>
		</>
	))}

	<div class="fhbm-chips"><VoiceChips size="1.25rem" class="mb-0" /></div>
</section>

<style>
	.fhbm {
		background-color: var(--color-canvas, #faf7f2);
		padding: 3rem 0 0;
		overflow: hidden;
	}
	@media (min-width: 1024px) {
		.fhbm { padding-top: 4rem; }
	}
	.fhbm-title {
		font-family: var(--font-headline);
		color: var(--color-ink, #241b17);
		text-align: center;
		margin: 0 1.5rem 2rem;
		font-weight: 500;
		line-height: 1.25;
		letter-spacing: -0.01em;
		font-size: clamp(1.35rem, 3.4vw, 2.5rem);
	}
	/* "On one line" is a desktop requirement. Below 768px a forced single line would
	   shrink the type past legibility, so it wraps there instead (brief, §on one line). */
	@media (min-width: 768px) {
		.fhbm-title { white-space: nowrap; }
	}
	.fhbm-viewport { overflow: hidden; }
	.fhbm-track {
		display: flex;
		width: max-content;
		will-change: transform;
		/* 100s, not 70s: the 1.5x tiles make the track 200/140 as long, so the duration
		   scales with it to keep the same on-screen speed (~px per second). */
		animation: fhbm-scroll 100s linear infinite;
	}
	.fhbm-row {
		display: flex;
		align-items: flex-end;
		gap: 1.25rem;
		margin: 0;
		padding: 0 0.625rem;
		list-style: none;
	}
	.fhbm-row img {
		display: block;
		width: 180px;
		height: auto;
	}
	/* The language row runs the other way. Same keyframes played backwards, so it starts
	   at -50% and travels to 0 — the seamless-loop arithmetic is unchanged. */
	.fhbm-track--reverse { animation-direction: reverse; }
	/* Row title: the /print eyebrow style (General Audience / Language Editions), not a new design. */
	.fhbm-label {
		font-family: var(--font-sans);
		color: #71717a;
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		text-align: center;
		margin: 0 1.5rem 0.75rem;
	}
	.fhbm-viewport + .fhbm-label { margin-top: 1.75rem; }
	/* English name under each language cover (Kevin 2026-10-03); the /print card's sub style. */
	/* Centred under the FRONT COVER, not the whole mock-up (Kevin 2026-10-03, round 4). In
	   every 600px language card the front board runs x 24..466 (measured on all 26: opaque
	   face 16..466, spine fold at 24; build_general_cards FACE_X/FACE_W); the 3D shadow fills
	   the rest. So the caption box is that span as a fraction of the image width — it scales
	   with the image at any size and adds no height. */
	.fhbm-cap {
		display: block;
		margin-top: 0.4rem;
		margin-left: 4%;
		width: 73.67%;
		text-align: center;
		font-family: var(--font-body);
		color: var(--color-muted);
		font-size: 0.8rem;
		line-height: 1.3;
	}
	.fhbm-row a { display: block; text-decoration: none; }
	@keyframes fhbm-scroll {
		from { transform: translate3d(0, 0, 0); }
		to { transform: translate3d(-50%, 0, 0); }
	}
	/* No motion for anyone who asked for none: the strip stops and becomes a plain
	   scrollable row so every cover is still reachable. */
	@media (prefers-reduced-motion: reduce) {
		.fhbm-track { animation: none; }
		.fhbm-viewport { overflow-x: auto; }
	}
	.fhbm-chips { margin-top: 2rem; }
</style>
