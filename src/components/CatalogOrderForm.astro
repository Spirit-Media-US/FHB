---
/* THE CATALOG ORDER FORM (Kevin 2026-10-03, "1 yes"), as ONE component used on /print/order/ and
 * on /print (Kevin 2026-10-04: "On the print page please put the form showing on /print/order/ —
 * it does what we need").
 *
 * Every print edition we sell direct, ONE ROW PER EDITION with a binding toggle and one counter
 * (OrderRow), in category accordions that start CLOSED with their item counts, a search box
 * that opens the section holding a match, and a running summary (OrderSummary) that is sticky
 * beside the list on a desktop and a fixed bar on a phone. Every row keeps its own counts, so
 * a buyer builds the order edition by edition and nothing resets. One Checkout through the
 * existing /dvc-checkout; the volume ladder and the first-order 15% are src/lib/order-pricing.ts,
 * the same rule the server charges. Behaviour: src/scripts/order-form.ts. /print's cards
 * pre-fill a row here (BuyControls `pick`) without touching the others.
 *
 * The eBook is NOT here: it is a download sold through its own checkout (/ebook-checkout), and
 * a physical shipment basket cannot carry it.
 */
import { CATALOG_CATEGORIES, catalogPrices, catalogRows } from '../data/print-catalog';
import { PRINT_TIERS } from '../data/print-tiers';
import OrderRow from './OrderRow.astro';
import OrderSummary from './OrderSummary.astro';

interface Props {
	/** where a cancelled checkout returns */
	returnPath: string;
	/** a stable prefix for this form's element ids */
	idp?: string;
	/** heading level of the section and summary titles: 2 under a page h1, 3 under a section h2 */
	level?: 2 | 3;
}
const { returnPath, idp = 'cat', level = 2 } = Astro.props;
const H = `h${level}` as 'h2' | 'h3';

// Runtime consts (biome cannot see .astro template use; keep these lines).
const sections = CATALOG_CATEGORIES.map((c) => ({
	...c,
	rows: catalogRows.filter((r) => r.category === c.key),
}));
const tiers = PRINT_TIERS;
const config = JSON.stringify({
	prices: catalogPrices(),
	tiers: PRINT_TIERS,
	returnPath,
});
---
<div class="cat__form" data-order={config}>
	<div class="cat__grid">
		<div class="cat__list">
			<label class="cat__search-label" for={`${idp}-search`}>Find an edition</label>
			<input id={`${idp}-search`} class="cat__search" type="search" placeholder="Spanish, Nurses, Large Print…" autocomplete="off" enterkeyhint="search" data-search />
			<p class="cat__search-msg" data-search-msg aria-live="polite"></p>

			{sections.map((s) => (
				<section class="cat__sec" data-section>
					<H class="cat__h2">
						<button type="button" class="cat__acc" data-acc aria-expanded="false" aria-controls={`${idp}-${s.key}`}>
							<span>{s.label} <span class="cat__n">({s.rows.length})</span></span>
							<svg class="cat__chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
						</button>
					</H>
					<div id={`${idp}-${s.key}`} class="cat__panel" data-panel hidden>
						{s.rows.map((r) => (
							<OrderRow id={r.id} title={r.title} native={r.native} lang={r.lang} rtl={r.rtl} trim={r.trim} img={r.img} hb={r.hb} pb={r.pb} search={r.search} />
						))}
					</div>
				</section>
			))}
			<p class="cat__more">Need 500 or more? <a href="mailto:hello@spiritmediapublishing.com?subject=FHB%20bulk%20order%20(500%2B)">Contact us</a>.</p>
		</div>

		<aside class="cat__aside" aria-label="Order summary">
			<H class="cat__sumh">Your order</H>
			<OrderSummary tiers={tiers} idp={idp} />
		</aside>
	</div>

	{/* Phone: the running total stays on screen while the form is; its button brings up the
	    summary, which holds the email and the one Checkout button. */}
	<div class="cat__bar" data-bar data-away>
		<span class="cat__bar-text"><span data-sum-copies>0</span> <span data-sum-copies-word>copies</span> · <strong data-sum-total>$0.00</strong></span>
		<button type="button" class="cat__bar-btn" data-to-summary>Review order</button>
	</div>
</div>

<style>
	.cat__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
	.cat__search-label { display: block; font-family: var(--font-sans); font-size: 0.85rem; font-weight: 600; color: var(--color-ink); margin: 0 0 0.3rem; }
	.cat__search {
		box-sizing: border-box;
		width: 100%;
		min-height: 48px;
		padding: 0.6rem 0.9rem;
		border: 1.5px solid var(--color-hairline);
		border-radius: 0.7rem;
		font-family: var(--font-sans);
		font-size: 1rem;
		background: #fff;
	}
	.cat__search-msg { font-family: var(--font-sans); font-size: 0.85rem; color: var(--color-muted); margin: 0.4rem 0 0; min-height: 1.2em; }
	.cat__sec { background: #fff; border: 1px solid var(--color-hairline); border-radius: 0.9rem; margin-top: 0.75rem; }
	.cat__sec[hidden] { display: none; }
	.cat__h2 { margin: 0; }
	.cat__acc {
		width: 100%;
		min-height: 56px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.6rem 1rem;
		border: 0;
		background: none;
		font-family: var(--font-sans);
		font-size: 1.05rem;
		font-weight: 700;
		color: var(--color-ink);
		text-align: left;
		cursor: pointer;
	}
	.cat__n { font-weight: 400; color: var(--color-muted); }
	.cat__chev { flex: none; color: #71717a; transition: transform 0.2s ease; }
	.cat__acc[aria-expanded='true'] .cat__chev { transform: rotate(180deg); }
	.cat__panel { padding: 0 1rem 0.4rem; }
	.cat__panel :global([data-row]) { scroll-margin-top: 110px; }
	.cat__more { font-family: var(--font-sans); font-size: 0.85rem; color: var(--color-muted); margin: 1rem 0 0; }
	.cat__more a { color: #3f3f46; text-decoration: underline; }
	.cat__aside { background: #fff; border: 1px solid var(--color-hairline); border-radius: 0.9rem; padding: 1.1rem 1.1rem 1.2rem; scroll-margin-top: 90px; text-align: left; }
	.cat__sumh { font-family: var(--font-headline); color: var(--color-ink); font-size: 1.3rem; font-weight: 600; margin: 0 0 0.6rem; }
	.cat__bar {
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 40;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 0.6rem 1rem calc(0.6rem + env(safe-area-inset-bottom));
		background: #fff;
		border-top: 1px solid var(--color-hairline);
		box-shadow: 0 -4px 14px rgba(0, 0, 0, 0.06);
		font-family: var(--font-sans);
		color: var(--color-ink);
	}
	/* transform, not display: hiding it must not move anything else on the page */
	.cat__bar { transition: transform 0.2s ease; }
	.cat__bar[data-away] { transform: translateY(110%); }
	.cat__bar-text { font-size: 0.95rem; }
	.cat__bar-btn {
		min-height: 44px;
		padding: 0.5rem 1.2rem;
		border-radius: 999px;
		background: var(--color-primary-fixed, #ffd9e0);
		border: 1.5px solid var(--color-primary, #b60057);
		color: var(--color-ink);
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: 0.95rem;
		cursor: pointer;
	}
	@media (min-width: 1024px) {
		.cat__grid { grid-template-columns: minmax(0, 1fr) 22rem; align-items: start; }
		.cat__aside { position: sticky; top: 96px; }
		.cat__bar { display: none; }
	}
</style>
