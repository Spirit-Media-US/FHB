---
/* ONE LANGUAGE'S QUICK ORDER FORM, under the header of /bibles/<language>-bible/ (Kevin
 * 2026-10-03). Anchored #order so the reader's "Now in Print" card and popup land on it.
 *
 * Nothing here is new commerce: the counters are /print's BindingQty, the SKUs are the
 * lang-<code>-hb/pb pair dvc-checkout.ts already sells, the ladder is PRINT_TIERS (asserted
 * equal to the server's by pricing-verify), and the cents rule — round the discounted UNIT,
 * then multiply — is the one print.astro and dvc-checkout.ts use, so the total shown is the
 * total Stripe charges. The server stays authoritative either way.
 *
 * Since 2026-10-03 the summary, the first-order 15% and the behaviour are the shared order-form
 * family (OrderSummary + src/scripts/order-form.ts + src/lib/order-pricing.ts), the same as
 * the catalog order form on /print and /print/order/.
 */
import { PRINT_TIERS } from '../data/print-tiers';
import BindingQty from './BindingQty.astro';
import OrderSummary from './OrderSummary.astro';

interface Props {
	code: string;
	english: string;
	name: string;
	hb: number;
	pb: number;
	/** this page's path, so a cancelled checkout returns here rather than to /print */
	returnPath: string;
}
const { code, english, name, hb, pb, returnPath } = Astro.props;
const hbSlug = `lang-${code}-hb`;
const pbSlug = `lang-${code}-pb`;
// Runtime const: biome cannot see .astro template use (keep this line).
const tiers = PRINT_TIERS;
const config = JSON.stringify({
	prices: { [hbSlug]: hb, [pbSlug]: pb },
	tiers: PRINT_TIERS,
	returnPath,
});
---
<div id="order" class="lqo" data-order={config}>
	{/* Kevin 2026-10-04: the same line on every single-edition form, at its top. */}
	<p class="lqo__catalog"><a href="/print/order/">Need to order multiple editions? Use the catalog order form →</a></p>
	<p class="lqo__eyebrow">Order direct · free shipping</p>
	<h2 class="lqo__title">Order the {english} Edition</h2>
	<BindingQty hbSlug={hbSlug} pbSlug={pbSlug} hb={hb} pb={pb} label={`${name} (${english})`} />
	<div class="lqo__foot">
		<OrderSummary tiers={tiers} idp={`lqo-${code}`} />
	</div>
</div>

<style>
	.lqo {
		max-width: 34rem;
		margin: 2.2rem auto 0;
		padding: 1.25rem 1.25rem 1.1rem;
		background: #fff;
		border: 1px solid var(--color-hairline);
		border-radius: 1rem;
		scroll-margin-top: 90px;
	}
	.lqo__catalog { margin: -0.4rem 0 0.4rem; font-family: var(--font-sans); }
	.lqo__catalog a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		color: #3f3f46;
		font-size: 0.9rem;
		font-weight: 600;
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.lqo__eyebrow {
		font-family: var(--font-sans);
		color: #71717a;
		font-size: 0.72rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		margin: 0 0 0.25rem;
	}
	.lqo__title {
		font-family: var(--font-headline);
		color: var(--color-ink);
		font-size: 1.35rem;
		font-weight: 600;
		margin: 0 0 0.9rem;
	}
	.lqo__foot {
		margin-top: 0.9rem;
		padding-top: 0.9rem;
		border-top: 1px solid var(--color-hairline);
	}
	/* BindingQty right-aligns its counters for /print's rows; here they lead the card. */
	.lqo :global(.binding-qty__row) { justify-content: space-between; }
	@media (max-width: 640px) {
		.lqo { padding: 1rem 0.9rem 0.95rem; }
	}
</style>
