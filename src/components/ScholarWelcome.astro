---
// "For Bible Scholars and Partners" (Kevin 2026-10-27, addendum AR; was "Welcome, Bible Scholars") — ONE section shared by the homepage and the About page
// (/the-fathers-heart-bible/), Kevin D123 2026-10-26 items 1 + 8, so the two can never drift.
// Warm background: never matches Hear the Father (homepage) or its neighbours on About.
// Text only: no images, no animation. No "For Bible scholars" eyebrow, never "new".
import Section from './Section.astro';
---
<Section variant="warm">
	<div class="max-w-2xl mx-auto text-center">
		<h2
			class="text-3xl md:text-4xl font-light mb-6"
			style="font-family: var(--font-serif); color: var(--color-ink);"
		>
			For Bible Scholars and Partners
		</h2>
		<p class="leading-relaxed mb-8" style="font-family: var(--font-sans); color: var(--color-muted);">
			Father&rsquo;s Heart Bible&trade; is a complete translation from the original Hebrew, Aramaic and Greek, printed in
			Divine Voice&trade; Color. Independent scholars in India, Nepal, the UK, the USA and other countries have reviewed
			the text. The overview sets out our confession, our method, the base texts and all 160 translation rules.
		</p>
		<a
			href="/overview/"
			class="inline-flex items-center px-6 py-3 text-sm font-semibold no-underline"
			style="font-family: var(--font-sans); background-color: #FFD9E0; color: #4A4A4A;"
		>
			Read the overview →
		</a>
		<p class="mt-6 text-sm italic" style="font-family: var(--font-serif); color: var(--color-muted);">
			Kevin White, Editor
		</p>
	</div>
</Section>
