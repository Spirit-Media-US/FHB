---
// "Welcome, Bible Scholars" — ONE section shared by the homepage and the About page
// (/the-fathers-heart-bible/), Kevin D123 2026-10-26 items 1 + 8, so the two can never drift.
// Warm background: never matches Hear the Father (homepage) or its neighbours on About.
// Text only: no images, no animation. No "For Bible scholars" eyebrow, never "new".
import Section from './Section.astro';
---
<Section variant="warm">
	<div class="max-w-2xl mx-auto text-center">
		<h2
			class="text-3xl md:text-4xl font-light mb-2"
			style="font-family: var(--font-serif); color: var(--color-ink);"
		>
			Welcome, Bible Scholars
		</h2>
		<p class="text-lg italic mb-6" style="font-family: var(--font-serif); color: var(--color-muted);">
			An invitation to all Bible scholars
		</p>
		<p class="leading-relaxed mb-4" style="font-family: var(--font-sans); color: var(--color-muted);">
			The Father&rsquo;s Heart Bible&trade; is a faithful translation from the original Hebrew, Aramaic and Greek. We
			welcome it being examined by all people who know the original languages and love the Scriptures. Independent
			scholarly review is ongoing, with Bible scholars and United Bible Societies members in India, Nepal, the UK, the
			USA and other countries.
		</p>
		<p class="leading-relaxed mb-8" style="font-family: var(--font-sans); color: var(--color-muted);">
			This invitation is for every reader. Scholar or not, if you see a way a verse could be better, we want to hear it.
		</p>
		<a
			href="/scholars/"
			class="inline-flex items-center px-6 py-3 text-sm font-semibold no-underline"
			style="font-family: var(--font-sans); background-color: #FFD9E0; color: #4A4A4A;"
		>
			Read the invitation →
		</a>
		<p class="mt-6 text-sm italic" style="font-family: var(--font-serif); color: var(--color-muted);">
			Kevin White, Editor
		</p>
	</div>
</Section>
