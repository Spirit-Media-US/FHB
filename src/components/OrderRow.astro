---
/* ONE EDITION, ONE ROW (Kevin 2026-10-03, catalog order form): a Hardback/Paperback toggle and
 * one quantity counter. The counter edits whichever binding is pressed and each binding keeps
 * its own count, so a church can take 20 paperbacks and 5 hardbacks of the same edition on one
 * row; the toggle shows "× n" against any binding already in the order.
 * Behaviour: src/scripts/order-form.ts. Used by /print/order/ and /print's quick order box.
 *
 * Prices are shown plainly: the list price struck through and the first-order price beside it
 * (Kevin 2026-10-03, "price, not persuasion").
 */
import { firstOrderUnit } from '../lib/order-pricing';

interface Props {
	id: string;
	title: string;
	native?: string;
	lang?: string;
	rtl?: boolean;
	trim: string;
	img?: string;
	hb: number;
	pb: number;
	search?: string;
	/** quick box: the edition picker names the book, so the row is controls only */
	bare?: boolean;
}
const { id, title, native, lang, rtl, trim, img, hb, pb, search, bare = false } = Astro.props;
const money = (cents: number) => `$${(cents / 100).toFixed(2)}`;
const bindings = [
	{ key: 'hb', label: 'Hardback', cents: Math.round(hb * 100) },
	{ key: 'pb', label: 'Paperback', cents: Math.round(pb * 100) },
].map((b) => ({ ...b, first: firstOrderUnit(b.cents) }));
const name = native ? `${native} (${title})` : title;
---
<div class:list={['orow', { 'orow--bare': bare }]} data-row data-id={id} data-bind="hb" data-search={search}>
	{img && !bare && <img class="orow__img" src={img} alt="" width="360" height="458" loading="lazy" decoding="async" />}
	<div class="orow__main">
		{!bare && <p class="orow__title">
			{native && <span class="orow__native" lang={lang} dir={rtl ? 'rtl' : undefined}>{native}</span>}
			<span class="orow__name">{title}</span>
			<span class="orow__trim">{trim}</span>
		</p>}
		<div class="orow__ctl">
			<div class="orow__seg" role="group" aria-label={bare ? 'Binding' : `${name}: binding`}>
				{bindings.map((b) => (
					<button type="button" class="orow__bind" data-bind={b.key} aria-pressed={b.key === 'hb' ? 'true' : 'false'}>
						<span class="orow__bname">{b.label} <span class="orow__count" data-seg-count hidden></span></span>
						<span class="orow__price"><s data-list={b.key}>{money(b.cents)}</s> <b data-first={b.key}>{money(b.first)}</b></span>
					</button>
				))}
			</div>
			<div class="orow__qty">
				<button type="button" class="orow__step" data-step="-1" aria-label={bare ? 'Fewer' : `Fewer, ${name}, selected binding`}>−</button>
				<input class="orow__in" type="number" value="0" min="0" step="1" inputmode="numeric" data-qty aria-label={bare ? 'Quantity' : `Quantity, ${name}, selected binding`} />
				<button type="button" class="orow__step" data-step="1" aria-label={bare ? 'More' : `More, ${name}, selected binding`}>+</button>
			</div>
		</div>
	</div>
</div>

<style>
	.orow {
		display: flex;
		gap: 0.75rem;
		align-items: flex-start;
		padding: 0.8rem 0;
		border-top: 1px solid var(--color-hairline);
		font-family: var(--font-sans);
	}
	.orow[hidden] { display: none; }
	.orow--bare { border-top: 0; padding: 0; }
	.orow--bare .orow__ctl { margin-top: 0; }
	.orow__img { width: 56px; height: auto; aspect-ratio: 360 / 458; flex: none; }
	.orow__main { flex: 1; min-width: 0; }
	.orow__title { margin: 0; font-size: 0.95rem; line-height: 1.35; color: var(--color-ink); }
	.orow__native { font-weight: 600; margin-right: 0.35rem; }
	.orow__name { font-weight: 600; }
	.orow__native + .orow__name { font-weight: 400; color: var(--color-muted); }
	.orow__trim { color: var(--color-muted); font-size: 0.82rem; margin-left: 0.3rem; }
	.orow__ctl { display: flex; flex-wrap: wrap; gap: 0.5rem 0.75rem; align-items: center; margin-top: 0.5rem; }
	.orow__seg {
		display: inline-flex;
		border: 1.5px solid var(--color-hairline);
		border-radius: 0.7rem;
		overflow: hidden;
		flex: 1 1 15rem;
		max-width: 22rem;
	}
	.orow__bind {
		flex: 1 1 0;
		min-width: 0;
		min-height: 48px;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: center;
		gap: 0.05rem;
		padding: 0.35rem 0.6rem;
		border: 0;
		background: #fff;
		color: var(--color-ink);
		font: inherit;
		font-size: 0.82rem;
		text-align: left;
		cursor: pointer;
	}
	.orow__bind + .orow__bind { border-left: 1.5px solid var(--color-hairline); }
	.orow__bind[aria-pressed='true'] { background: var(--color-primary-fixed, #ffd9e0); box-shadow: inset 0 0 0 2px var(--color-primary, #b60057); }
	.orow__bname { font-weight: 600; }
	.orow__count { font-weight: 700; color: var(--color-primary, #b60057); }
	.orow__price { font-size: 0.8rem; white-space: nowrap; }
	.orow__price s { color: var(--color-muted); }
	.orow__qty {
		display: inline-flex;
		align-items: center;
		border: 1.5px solid var(--color-hairline);
		border-radius: 999px;
		overflow: hidden;
		flex: none;
	}
	.orow__step {
		width: 44px;
		height: 44px;
		border: 0;
		background: var(--color-primary-fixed, #ffd9e0);
		color: var(--color-ink);
		font-size: 1.2rem;
		cursor: pointer;
	}
	.orow__in {
		width: 3.4rem;
		height: 44px;
		border: 0;
		text-align: center;
		font: inherit;
		font-size: 1rem;
		background: #fff;
		color: var(--color-ink);
		-moz-appearance: textfield;
	}
	.orow__in::-webkit-outer-spin-button,
	.orow__in::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
</style>
