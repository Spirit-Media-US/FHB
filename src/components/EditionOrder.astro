---
/* THE ORDER FORM ON EVERY EDITION PAGE, under the header of /bibles/<slug>-bible/, anchored
 * #order so the hero's Order button, the reader's "Now in Print" card and its popup land on it.
 * Born as the language pages' quick order form (Kevin 2026-10-03); on EVERY edition since
 * 2026-10-05 (Kevin: "The custom check out page needs to be added to ALL edition pages").
 *
 * Nothing here is new commerce: the rows are print-catalog.ts's (the same records /print's
 * catalog form and dvc-checkout.ts sell), the counters are /print's BindingQty, the ladder is
 * PRINT_TIERS (asserted equal to the server's by pricing-verify), and the cents rule — round
 * the discounted UNIT, then multiply — is the one print.astro and dvc-checkout.ts use, so the
 * total shown is the total Stripe charges. The server stays authoritative either way.
 *
 * The summary, the first-order 15% and the behaviour are the shared order-form family
 * (OrderSummary + src/scripts/order-form.ts + src/lib/order-pricing.ts), the same as the
 * catalog order form on /print and /print/order/.
 *
 * THE BOX, MOBILE FIRST (Kevin 2026-11-14 store session: "house built by adding on... accordion... bulk discounts
 * behind accordion"; "1 and 2 Pull and use market science best practice."; "Do what data science says!"). Measured
 * before, grandparents-bible at 390px: box 1,124px tall, Checkout at 1,045px, every price shown twice, quantity 0,
 * free shipping 4x. Now: format = two tap buttons carrying the price (Baymard: buttons for variant choice), one
 * quantity at 1, the summary's Ship to / Total / Email / Checkout, and three CLOSED accordions under Checkout whose
 * headers carry the offer (collapsed headers need information scent). 0 of 67 paid orders ever held 2+ items, so
 * the quantity follows the chosen format (order-form.ts [data-pick]); mixed orders go to the catalog form.
 * New strings are English-first constants here (ORDER_STRINGS stays complete per language; no English stand-ins).
 */
import type { CatalogRow } from '../data/print-catalog';
import { PRINT_TIERS } from '../data/print-tiers';
import { handlingTable } from '../lib/marginGuard';
import {
	EXPEDITED_DISCLAIMER,
	FIRST_ORDER_FINE,
	FIRST_ORDER_PCT,
	firstOrderUnit,
} from '../lib/order-pricing';
import {
	formatUsd,
	ORDER_STRINGS,
	type OrderLang,
	orderLangFor,
	shipsText,
	tr,
} from '../lib/orderStrings';
import { LIVE_COUNTRIES, shipsLine, shipsParts, shipsToSentence } from '../lib/shipCountries';
import OrderSummary from './OrderSummary.astro';

interface Props {
	/** the edition's catalog row(s) — one, except the General edition, sold in three colours */
	rows: CatalogRow[];
	/** "the Spanish Edition", "Mom's Bible" — what the heading offers */
	heading: string;
	/** this page's path, so a cancelled checkout returns here rather than to /print */
	returnPath: string;
	/** one line under the price, e.g. a pre-order's "ships when published" (no ISBN yet, Kevin 2026-10-30) */
	note?: string;
	/** the page's language (src/lib/orderStrings.ts); English when absent or unsupported */
	lang?: string;
}
const { rows, heading, returnPath, note, lang: pageLang } = Astro.props;
const lang: OrderLang = orderLangFor(pageLang);
const S = ORDER_STRINGS[lang];
const t = (k: string, v?: Record<string, string | number>) => tr(S, k, v);
const multi = rows.length > 1;
// Runtime const: biome cannot see .astro template use (keep this line).
const tiers = PRINT_TIERS;
const skuPrices: Record<string, number> = Object.fromEntries(
	rows.flatMap((r) => [
		[`${r.id}-hb`, r.hb],
		[`${r.id}-pb`, r.pb],
	]),
);
const config = JSON.stringify({
	...(lang === 'en' ? {} : { lang, s: S }),
	prices: skuPrices,
	tiers: PRINT_TIERS,
	returnPath,
	// Far-band countries (unit 2kx): no volume ladder, and 10+ copies go to a bulk quote, not checkout.
	farBand: LIVE_COUNTRIES.filter((c) => c.farBand).map((c) => c.code),
	// International handling per country (Kevin 2026-11-08), shown beside each price before checkout.
	intl: handlingTable(
		Object.fromEntries(Object.entries(skuPrices).map(([k, v]) => [k, Math.round(v * 100)])),
		[FIRST_ORDER_PCT, ...PRINT_TIERS.map((t) => t.pct)],
	),
});
// THE PRICE LINE (Kevin 2026-10-05, B15): paperback first, then hardback, each at the
// first-order unit price with the regular price struck through. Read from the first row; the
// General colours share one price. pricing-verify reads data-line-sku and the two figures back
// out of the built page and checks them against the server.
const money = (cents: number) => formatUsd(lang, cents);
const lead = rows[0];
const priceLine = [
	{ binding: t('p.paperback'), sku: `${lead.id}-pb`, usd: lead.pb },
	{ binding: t('p.hardback'), sku: `${lead.id}-hb`, usd: lead.hb },
].map((l) => {
	const list = Math.round(l.usd * 100);
	return { ...l, first: money(firstOrderUnit(list)), reg: money(list) };
});
const idp = `eo-${lead.id}`;
// The new box's labels. English is written here; every other order language uses its own REVIEWED strings
// (src/data/order-strings/<lang>.json), never an English stand-in on a translated page.
const en = lang === 'en';
const ladder = PRINT_TIERS.filter((x) => x.pct > 0).sort((a, b) => a.min - b.min);
const topPct = Math.max(...ladder.map((x) => x.pct));
const BOX = en
	? {
			colour: 'Colour',
			first: `${FIRST_ORDER_PCT}% off your first order, applied at checkout`,
			accVolume: `Buying ${ladder[0].min} or more? Save up to ${topPct}%`,
			accVolumeBody: 'The discount is applied automatically when your quantity reaches a tier.',
			accMixed: 'Ordering more than one edition?',
			accMixedLink: t('o.catalogLink'),
			accShip: `International shipping: we ship to ${LIVE_COUNTRIES.length} countries`,
		}
	: {
			colour: '',
			first: t('p.firstOrder', { pct: FIRST_ORDER_PCT }),
			accVolume: `${t('s.volume')} ${ladder.map((x) => t('s.tier', { pct: x.pct, min: x.min })).join(' · ')}`,
			accVolumeBody: '',
			accMixed: t('o.catalogLink').replace(/\s*→\s*$/, ''),
			accMixedLink: `${t('c.h1')} →`,
			accShip: t('o.shipsSummary', { n: LIVE_COUNTRIES.length }),
		};
const shipsFull = en ? `${shipsLine()} ${shipsToSentence()}` : shipsText(lang, S, shipsParts());
---
<div id="order" class="lqo" data-order={config} data-lang={lang}>
	<h2 class="lqo__title">{t('o.title', { heading })}</h2>
	{/* Kevin 2026-11-14: "assure shoppers at the top that we ship to their country ... Show them choices at the
	    top for bulk quantity and catalog." Three closed choices lead the box; each opens on tap. */}
	<div class="eo-acc">
		<details class="eo-acc__item">
			<summary>{BOX.accShip}</summary>
			<div class="eo-acc__body">
				<p>{shipsFull}</p>
				{LIVE_COUNTRIES.length > 1 && <p data-fee-note data-t="s.feeNote">{t('s.feeNote')}</p>}
				{LIVE_COUNTRIES.length > 1 && <p data-expedited-note hidden><span data-t="s.expedited">{en ? EXPEDITED_DISCLAIMER : t('s.expedited')}</span> <span data-t="s.expeditedPrice">{t('s.expeditedPrice')}</span></p>}
			</div>
		</details>
		<details class="eo-acc__item">
			<summary>{BOX.accVolume}</summary>
			<div class="eo-acc__body">
				<p class="eo-tiers" data-tiers-line>
					{ladder.map((tier) => <span class="eo-tier" data-tier={tier.pct} data-min={tier.min}>{t('s.tier', { pct: tier.pct, min: tier.min })}</span>)}
				</p>
				<p>{BOX.accVolumeBody && `${BOX.accVolumeBody} `}<span data-t="s.fine">{en ? FIRST_ORDER_FINE : t('s.fine')}</span></p>
			</div>
		</details>
		<details class="eo-acc__item">
			<summary>{BOX.accMixed}</summary>
			<div class="eo-acc__body">
				<p><a href={en ? '/print/order/' : `/print/order/?lang=${lang}`}>{BOX.accMixedLink}</a></p>
			</div>
		</details>
	</div>
	<div class="eo-pick" data-pick data-id={lead.id}>
		{multi && (
			<fieldset class="eo-group">
				<legend class:list={['eo-legend', { 'eo-sr': !BOX.colour }]}>{BOX.colour || t('c.binding')}</legend>
				<div class="eo-colours">
					{rows.map((r, i) => (
						<button type="button" class="eo-chip" data-pick-id={r.id} aria-pressed={i === 0 ? 'true' : 'false'}>{r.title.replace(/^.*—\s*/, '')}</button>
					))}
				</div>
			</fieldset>
		)}
		{/* Kevin 2026-11-14: "Buyer wants 2 PB and 1 HB" - each format keeps its own quantity. */}
		<div class="eo-rows" data-price-line>
			{priceLine.map((l) => {
				const fmt = l.sku.endsWith('-pb') ? 'pb' : 'hb';
				return (
					<div class="eo-row" data-line-sku={l.sku}>
						<div class="eo-row__info">
							<span class="eo-row__binding">{l.binding}</span>
							<span class="eo-row__price"><b data-first>{l.first}</b> <span class="eo-row__reg">{t('p.reg')} <s data-reg>{l.reg}</s></span></span>
							<span class="eo-row__fee" data-fee-sku={l.sku} data-fee-full hidden></span>
						</div>
						<div class="eo-qty__ctl">
							<button type="button" class="eo-step" data-pick-step="-1" data-fmt={fmt} aria-label={t('a.fewer', { label: heading, binding: l.binding })}>−</button>
							<input class="eo-qty__in" type="number" value={fmt === 'pb' ? '1' : '0'} min="0" step="1" inputmode="numeric" data-pick-qty data-fmt={fmt} aria-label={t('a.qty', { label: heading, binding: l.binding })} />
							<button type="button" class="eo-step" data-pick-step="1" data-fmt={fmt} aria-label={t('a.more', { label: heading, binding: l.binding })}>+</button>
						</div>
					</div>
				);
			})}
		</div>
		{note && <p class="eo-note" data-preorder-note>{note}</p>}
	</div>
	<div class="lqo__foot">
		<OrderSummary tiers={tiers} idp={idp} lang={lang} variant="edition" firstLine={BOX.first} />
	</div>
</div>
{en && (
	<nav class="eo-shop" aria-label="Keep shopping">
		<span>Keep shopping:</span>
		<a href="/print/">All Bibles</a>
		<a href="/books/">Father’s Heart Books</a>
		<a href="https://spiritmediapublishing.com/bookstore/">All SMP Books</a>
	</nav>
)}

<style>
	/* MOBILE FIRST (Kevin 2026-11-14 "Do what data science says!"): base = phone; min-width widens. */
	.lqo {
		max-width: 34rem;
		margin: 2.2rem auto 0;
		padding: 1rem 0.9rem 0.95rem;
		background: #fff;
		border: 1px solid var(--color-hairline);
		border-radius: 1rem;
		scroll-margin-top: 90px;
		font-family: var(--font-sans);
		color: var(--color-ink);
	}
	.lqo__title {
		font-family: var(--font-headline);
		color: var(--color-ink);
		font-size: 1.35rem;
		font-weight: 600;
		margin: 0.4rem 0 0.9rem;
	}
	.eo-group { border: 0; margin: 0.9rem 0 0; padding: 0; min-width: 0; }
	.eo-legend { display: block; padding: 0; margin: 0 0 0.4rem; font-size: 0.85rem; font-weight: 600; }
	.eo-sr {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}
	.eo-colours { display: grid; grid-template-columns: repeat(auto-fit, minmax(6.5rem, 1fr)); gap: 0.6rem; }
	.eo-chip {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 48px;
		padding: 0.6rem 0.8rem;
		border: 1.5px solid var(--color-hairline);
		border-radius: 0.75rem;
		background: #fff;
		color: var(--color-ink);
		font: inherit;
		font-size: 0.9rem;
		font-weight: 600;
		cursor: pointer;
	}
	.eo-chip[aria-pressed='true'] { border-color: var(--color-ink); box-shadow: inset 0 0 0 1px var(--color-ink); }
	.eo-chip:focus-visible, .eo-step:focus-visible { outline: 2px solid var(--color-ink); outline-offset: 2px; }
	.eo-rows { display: grid; gap: 0.6rem; margin-top: 0.9rem; }
	.eo-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 0.7rem 0.8rem;
		border: 1.5px solid var(--color-hairline);
		border-radius: 0.75rem;
	}
	.eo-row__info { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; }
	.eo-row__binding { font-size: 0.95rem; font-weight: 600; }
	.eo-row__price b { font-size: 1.1rem; font-weight: 800; }
	.eo-row__reg { color: #71717a; font-size: 0.8rem; }
	.eo-row__fee { color: #3f3f46; font-size: 0.78rem; font-weight: 600; }
	.eo-row__fee[hidden] { display: none; }
	.eo-note { margin: 0 0 0.9rem; color: #3f3f46; font-size: 0.85rem; font-weight: 600; }
	.eo-qty__ctl { display: inline-flex; flex: none; align-items: center; gap: 0.35rem; }
	.eo-step {
		width: 44px;
		height: 44px;
		border: 1.5px solid var(--color-hairline);
		border-radius: 999px;
		background: #fff;
		color: var(--color-ink);
		font-size: 1.2rem;
		line-height: 1;
		cursor: pointer;
	}
	.eo-qty__in {
		width: 3.2rem;
		min-height: 44px;
		border: 1.5px solid var(--color-hairline);
		border-radius: 0.6rem;
		font: inherit;
		font-size: 1rem;
		text-align: center;
		-moz-appearance: textfield;
	}
	.eo-qty__in::-webkit-inner-spin-button, .eo-qty__in::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
	.lqo__foot { margin-top: 0.9rem; padding-top: 0.9rem; border-top: 1px solid var(--color-hairline); }
	.eo-acc { border-top: 1px solid var(--color-hairline); }
	.eo-acc__item { border-bottom: 1px solid var(--color-hairline); }
	.eo-acc__item > summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		min-height: 48px;
		padding: 0.5rem 0;
		font-size: 0.9rem;
		font-weight: 600;
		cursor: pointer;
		list-style: none;
	}
	.eo-acc__item > summary::-webkit-details-marker { display: none; }
	.eo-acc__item > summary::after { content: '+'; flex: none; font-size: 1.2rem; font-weight: 400; color: #71717a; }
	.eo-acc__item[open] > summary::after { content: '−'; }
	.eo-acc__body { padding: 0 0 0.8rem; color: #3f3f46; font-size: 0.85rem; line-height: 1.5; }
	.eo-acc__body p { margin: 0 0 0.5rem; }
	.eo-acc__body p[hidden] { display: none; }
	.eo-acc__body a { color: #3f3f46; font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
	.eo-tiers { display: flex; flex-wrap: wrap; gap: 0.25rem 0.8rem; }
	.eo-tier[data-on] { color: var(--color-ink); font-weight: 700; }
	.eo-shop {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.2rem 1rem;
		max-width: 34rem;
		margin: 0.9rem auto 0;
		font-family: var(--font-sans);
		font-size: 0.9rem;
		color: #3f3f46;
	}
	.eo-shop a { display: inline-flex; align-items: center; min-height: 44px; color: var(--color-ink); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
	.eo-shop span { display: inline-flex; align-items: center; min-height: 44px; }
	@media (min-width: 641px) {
		.lqo { padding: 1.25rem 1.25rem 1.1rem; }
	}
</style>
