---
/* THE ORDER FORM ON EVERY EDITION PAGE, under the header of /bibles/<slug>-bible/, anchored
 * #order so the hero's Order button, the reader's "Now in Print" card and its popup land on it.
 * Born as the language pages' quick order form (Kevin 2026-10-03); on EVERY edition since
 * 2026-10-05 (Kevin: "The custom check out page needs to be added to ALL edition pages").
 *
 * Nothing here is new commerce: the rows are print-catalog.ts's (the same records /print's
 * catalog form and dvc-checkout.ts sell), the counters are /print's BindingQty, the ladder is
 * PRINT_TIERS (asserted equal to the server's by pricing-verify), and the cents rule — round
 * the discounted UNIT, then multiply — is the one print.astro and dvc-checkout.ts use, so the
 * total shown is the total Stripe charges. The server stays authoritative either way.
 *
 * The summary, the first-order 15% and the behaviour are the shared order-form family
 * (OrderSummary + src/scripts/order-form.ts + src/lib/order-pricing.ts), the same as the
 * catalog order form on /print and /print/order/.
 */
import type { CatalogRow } from '../data/print-catalog';
import { PRINT_TIERS } from '../data/print-tiers';
import { handlingTable } from '../lib/marginGuard';
import { FIRST_ORDER_LABEL, FIRST_ORDER_PCT, firstOrderUnit } from '../lib/order-pricing';
import {
	formatCount,
	formatUsd,
	ORDER_STRINGS,
	type OrderLang,
	orderLangFor,
	shipsText,
	tr,
} from '../lib/orderStrings';
import {
	allFreeShipping,
	LIVE_COUNTRIES,
	shipsLine,
	shipsParts,
	shipsToSentence,
} from '../lib/shipCountries';
import BiblesBooksToggle from './BiblesBooksToggle.astro';
import BindingQty from './BindingQty.astro';
import OrderSummary from './OrderSummary.astro';
import ShipsDisclosure from './ShipsDisclosure.astro';

interface Props {
	/** the edition's catalog row(s) — one, except the General edition, sold in three colours */
	rows: CatalogRow[];
	/** "the Spanish Edition", "Mom's Bible" — what the heading offers */
	heading: string;
	/** this page's path, so a cancelled checkout returns here rather than to /print */
	returnPath: string;
	/** one line under the price, e.g. a pre-order's "ships when published" (no ISBN yet, Kevin 2026-10-30) */
	note?: string;
	/** the page's language (src/lib/orderStrings.ts); English when absent or unsupported */
	lang?: string;
}
const { rows, heading, returnPath, note, lang: pageLang } = Astro.props;
const lang: OrderLang = orderLangFor(pageLang);
const S = ORDER_STRINGS[lang];
const t = (k: string, v?: Record<string, string | number>) => tr(S, k, v);
const multi = rows.length > 1;
const freeShip = allFreeShipping();
// Runtime const: biome cannot see .astro template use (keep this line).
const tiers = PRINT_TIERS;
const skuPrices: Record<string, number> = Object.fromEntries(
	rows.flatMap((r) => [
		[`${r.id}-hb`, r.hb],
		[`${r.id}-pb`, r.pb],
	]),
);
const config = JSON.stringify({
	...(lang === 'en' ? {} : { lang, s: S }),
	prices: skuPrices,
	tiers: PRINT_TIERS,
	returnPath,
	// Far-band countries (unit 2kx): no volume ladder, and 10+ copies go to a bulk quote, not checkout.
	farBand: LIVE_COUNTRIES.filter((c) => c.farBand).map((c) => c.code),
	// International handling per country (Kevin 2026-11-08), shown beside each price before checkout.
	intl: handlingTable(
		Object.fromEntries(Object.entries(skuPrices).map(([k, v]) => [k, Math.round(v * 100)])),
		[FIRST_ORDER_PCT, ...PRINT_TIERS.map((t) => t.pct)],
	),
});
// THE PRICE LINE (Kevin 2026-10-05, B15): paperback first, then hardback, each at the
// first-order unit price with the regular price struck through. Read from the first row; the
// General colours share one price. pricing-verify reads data-line-sku and the two figures back
// out of the built page and checks them against the server.
const money = (cents: number) => formatUsd(lang, cents);
const lead = rows[0];
const priceLine = [
	{ binding: t('p.paperback'), sku: `${lead.id}-pb`, usd: lead.pb },
	{ binding: t('p.hardback'), sku: `${lead.id}-hb`, usd: lead.hb },
].map((l) => {
	const list = Math.round(l.usd * 100);
	return { ...l, first: money(firstOrderUnit(list)), reg: money(list) };
});
const idp = `eo-${lead.id}`;
---
<div id="order" class="lqo" data-order={config} data-lang={lang}>
	<BiblesBooksToggle current="bibles" lang={lang} />
	{/* Kevin 2026-10-04: the same line on every single-edition form, at its top. */}
	<p class="lqo__catalog"><a href={lang === 'en' ? '/print/order/' : `/print/order/?lang=${lang}`}>{t('o.catalogLink')}</a></p>
	<p class="lqo__eyebrow">{t('o.eyebrow')}{freeShip ? ` · ${t('o.freeShipping')}` : ''}</p>
	<h2 class="lqo__title">{t('o.title', { heading })}</h2>
	<div class="eo-price" data-price-line>
		{priceLine.map((l) => (
			<p class="eo-price__row" data-line-sku={l.sku}>
				<span class="eo-price__binding">{l.binding}</span> <b data-first>{l.first}</b> <span class="eo-price__reg">({t('p.reg')} <s data-reg>{l.reg}</s>)</span> <span class="eo-price__fee" data-fee-sku={l.sku} data-fee-full hidden></span>
			</p>
		))}
		<p class="eo-price__note">{lang === 'en' ? FIRST_ORDER_LABEL : t('p.firstOrder', { pct: FIRST_ORDER_PCT })}{freeShip ? ` · ${t('o.freeShipping')}` : ''}</p>
		{note && <p class="eo-price__note" data-preorder-note>{note}</p>}
		<p class="eo-price__note"><a href="/returns/">{t('p.returns')}</a></p>
		<ShipsDisclosure cls="eo-price__note" full={lang === 'en' ? `${shipsLine()} ${shipsToSentence()}` : shipsText(lang, S, shipsParts())} summary={t('o.shipsSummary', { n: formatCount(lang, LIVE_COUNTRIES.length) })} />
	</div>
	{rows.map((r) => (
		<div class={multi ? 'eo-variant' : undefined}>
			{multi && <p class="eo-variant__name">{r.title.replace(/^.*—\s*/, '')}</p>}
			<BindingQty hbSlug={`${r.id}-hb`} pbSlug={`${r.id}-pb`} hb={r.hb} pb={r.pb} label={r.native ? `${r.native} (${r.title})` : r.title} lang={lang} />
		</div>
	))}
	<div class="lqo__foot">
		<OrderSummary tiers={tiers} idp={idp} lang={lang} />
	</div>
</div>

<style>
	.eo-price { margin: 0 0 1rem; font-family: var(--font-sans); }
	.eo-price__row {
		margin: 0 0 0.15rem;
		font-size: 1.05rem;
		color: var(--color-ink);
	}
	.eo-price__binding { font-weight: 600; }
	.eo-price__row b { font-weight: 800; }
	.eo-price__reg { color: #71717a; font-size: 0.9rem; }
	.eo-price__fee { color: #3f3f46; font-size: 0.9rem; font-weight: 600; }
	.eo-price__fee[hidden] { display: none; }
	.eo-price__note,
	.eo-price :global(.ships-d--wide),
	.eo-price :global(.ships-d--narrow) {
		margin: 0.35rem 0 0;
		color: #3f3f46;
		font-size: 0.85rem;
		font-weight: 600;
	}
	.eo-variant + .eo-variant { margin-top: 0.7rem; }
	.eo-variant__name {
		margin: 0 0 0.25rem;
		font-family: var(--font-sans);
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--color-ink);
	}
	.lqo {
		max-width: 34rem;
		margin: 2.2rem auto 0;
		padding: 1.25rem 1.25rem 1.1rem;
		background: #fff;
		border: 1px solid var(--color-hairline);
		border-radius: 1rem;
		scroll-margin-top: 90px;
	}
	.lqo__catalog { margin: -0.4rem 0 0.4rem; font-family: var(--font-sans); }
	.lqo__catalog a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		color: #3f3f46;
		font-size: 0.9rem;
		font-weight: 600;
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.lqo__eyebrow {
		font-family: var(--font-sans);
		color: #71717a;
		font-size: 0.72rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		margin: 0 0 0.25rem;
	}
	.lqo__title {
		font-family: var(--font-headline);
		color: var(--color-ink);
		font-size: 1.35rem;
		font-weight: 600;
		margin: 0 0 0.9rem;
	}
	.lqo__foot {
		margin-top: 0.9rem;
		padding-top: 0.9rem;
		border-top: 1px solid var(--color-hairline);
	}
	/* BindingQty right-aligns its counters for /print's rows; here they lead the card. */
	.lqo :global(.binding-qty__row) { justify-content: space-between; }
	@media (max-width: 640px) {
		.lqo { padding: 1rem 0.9rem 0.95rem; }
	}
</style>
