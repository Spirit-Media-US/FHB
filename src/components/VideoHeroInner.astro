---
// VideoHeroInner — the VIDEO-SPLASH hero used by the top-level marketing pages:
// / (homepage), /review/, /print/, /the-fathers-heart-bible/, its /leadership/
// page, and /a-bible-for-the-whole-world/.
//
// DELIBERATE EXCEPTION to "no text over the hero image" (Kevin 2026-08-04).
// Content/article pages — /guides/*, /bible-for/*, /bible-in/* — must show the
// hero IMAGE ALONE with the title block below it on --color-surface-low, and
// they were all converted to that shape. This splash pattern is a distinct,
// intentional format for landing pages and KEEPS its overlaid heading. If an
// audit flags these 6 pages as "text over the hero", that is expected — do not
// "fix" them.
interface Props {
	videoSrc?: string;
	imageSrc?: string;
	// Non-Sanity (R2) heroes: a smaller file served below 1024px via <picture>, matching
	// Layout's media-gated preloadImageMobile/Desktop exactly (no DPR-driven srcset pick).
	imageSrcMobile?: string;
	imageWidth?: number;
	imageHeight?: number;
	// Phones (<768px) only: show the WHOLE image uncropped at its natural aspect ratio, with
	// the heading stacked BELOW it instead of overlaid. Tablet/desktop are unchanged. Opt-in
	// (/print, Kevin 2026-09-24: all 14 people must be visible on a phone); default off.
	// The image starts below the 72px fixed header: a wide photo drawn full-width is short
	// enough on a phone that the transparent header's logo would sit on the faces.
	stackOnMobile?: boolean;
	imagePosition?: string;
	// Opt-in dimming (0–1) over the dark section background; default 1 = true brightness
	// per the no-overlay rule below. Set on /the-fathers-heart-bible/ and /a-bible-for-the-whole-world/ (2026-09-25, pending Kevin).
	imageOpacity?: number;
	headingLift?: string;
	headingClass?: string;
	contentPad?: string;
	href?: string;
	linkLabel?: string;
	heading: string;
	subheading?: string;
	primaryCtaLabel?: string;
	primaryCtaHref?: string;
	secondaryCtaLabel?: string;
	secondaryCtaHref?: string;
}

const {
	videoSrc,
	imageSrc,
	imageSrcMobile,
	imageWidth = 1600,
	imageHeight = 900,
	stackOnMobile = false,
	imagePosition = 'center',
	imageOpacity = 1,
	headingLift = '0',
	headingClass = 'text-4xl md:text-6xl',
	contentPad = 'pb-10 md:pb-16 lg:pb-24',
	href,
	linkLabel = "See the Father's Heart Bible print editions",
	heading,
	subheading,
	primaryCtaLabel,
	primaryCtaHref,
	secondaryCtaLabel,
	secondaryCtaHref,
} = Astro.props;

// When there's no CTA (e.g. /partner), the subheading's bottom margin + the
// section's bottom padding would render as dead white space. Collapse them.
const hasCta = !!(primaryCtaLabel && primaryCtaHref);

// Responsive hero: derive mobile/desktop widths from the Sanity URL's w= param
// so phones don't download the full-width hero (e.g. /partner shipped a 1920w
// image to 390px screens → ~10s mobile LCP). 720w mobile, 1280w desktop.
const hasW = imageSrc && /[?&]w=\d+/.test(imageSrc);
const heroSrcset = hasW
	? `${imageSrc.replace(/([?&])w=\d+/, '$1w=720')} 720w, ${imageSrc.replace(/([?&])w=\d+/, '$1w=1280')} 1280w`
	: undefined;
// Only /print passes imageSrcMobile; every other caller keeps its bare <img> markup.
const HeroPicture = imageSrcMobile ? 'picture' : Fragment;
const heroSrcMain = hasW ? imageSrc.replace(/([?&])w=\d+/, '$1w=1280') : imageSrc;
---

<section
	class={stackOnMobile
		? 'relative flex flex-col md:flex-row md:items-end justify-center overflow-hidden pt-[72px] md:pt-0 md:min-h-[600px] lg:min-h-[calc(50vh_+_2in)]'
		: 'relative flex items-end justify-center overflow-hidden min-h-[600px] lg:min-h-[calc(50vh_+_2in)]'}
	style="background-color: var(--color-inverse-surface); margin-top: -1px;"
>
	{imageSrc ? (
		<HeroPicture {...(imageSrcMobile ? { class: 'contents' } : {})}>
			{imageSrcMobile && <source media="(max-width: 1023px)" srcset={imageSrcMobile} />}
			<img
				class={stackOnMobile
					? 'block w-full h-auto md:absolute md:inset-0 md:h-full md:object-cover'
					: 'absolute inset-0 w-full h-full object-cover'}
				src={heroSrcMain}
				srcset={heroSrcset}
				sizes="100vw"
				alt=""
				aria-hidden="true"
				width={imageWidth}
				height={imageHeight}
				fetchpriority="high"
				decoding="async"
				style={`opacity: ${imageOpacity}; object-position: ${imagePosition};`}
			/>
		</HeroPicture>
	) : (
		<video
			class="absolute inset-0 w-full h-full object-cover"
			src={videoSrc}
			autoplay
			muted
			loop
			playsinline
			aria-hidden="true"
			style="opacity: 1;"
		/>
	)}
	<!-- No image overlay (Kevin 2026-07-18): heroes show at true brightness.
	     The white heading keeps a soft text-shadow below for legibility over
	     bright imagery — the image itself is untouched. -->
	{href && (
		<a href={href} aria-label={linkLabel} class="absolute inset-0 z-[2]"></a>
	)}
	<div class={`relative z-10 text-center px-6 max-w-3xl mx-auto ${stackOnMobile ? `pt-6 ${contentPad} md:pt-0` : contentPad}`}>
		<h1
			class={`${headingClass} font-medium leading-snug tracking-tight`}
			style={`font-family: var(--font-headline); color: #FFFFFF; margin-bottom: ${headingLift}; text-shadow: 0 2px 18px rgba(0,0,0,0.55), 0 1px 3px rgba(0,0,0,0.45);`} data-hero-entrance
		>
			{heading}
		</h1>
	</div>
</section>

{(subheading || primaryCtaLabel) && (
	<section style="background-color: var(--color-canvas);" class={`px-4 md:px-6 ${hasCta ? 'py-8 md:py-12' : 'pt-8 md:pt-12 pb-0'}`}>
		<div class="max-w-2xl mx-auto text-center" data-reveal>
			{subheading && (
				<p
					class={`text-lg md:text-xl leading-relaxed ${hasCta ? 'mb-10' : 'mb-0'}`}
					style="font-family: var(--font-body); color: var(--color-muted);"
				>
					{subheading}
				</p>
			)}
			{primaryCtaLabel && primaryCtaHref && (
				<div class="flex flex-col sm:flex-row items-center justify-center gap-4">
					<a
						href={primaryCtaHref}
						class="inline-flex items-center px-8 py-3.5 text-base font-semibold no-underline transition-all duration-200"
						style="font-family: var(--font-body); background: #FFD9E0; color: #4A4A4A;"
						onmouseover="this.style.opacity='0.9'"
						onmouseout="this.style.opacity='1'"
					>
						{primaryCtaLabel}
					</a>
					{secondaryCtaLabel && secondaryCtaHref && (
						<a
							href={secondaryCtaHref}
							class="inline-flex items-center px-8 py-3.5 text-base font-medium no-underline transition-all duration-200"
							style="font-family: var(--font-body); background: #FFD9E0; color: #4A4A4A;"
							onmouseover="this.style.opacity='0.9';"
							onmouseout="this.style.opacity='1';"
						>
							{secondaryCtaLabel}
						</a>
					)}
				</div>
			)}
		</div>
	</section>
)}
