---
/**
 * The far-band line above the print options (Kevin 2026-11-08 "1 A"). Hidden until the buyer picks
 * a far-band country in the order summary (src/scripts/order-form.ts toggles [data-far-note]);
 * rendered only when at least one far-band country is live, so the committed US-only pages are
 * unchanged. Copy and links live in src/lib/farBandNote.ts.
 */
import { FAR_NOTE, FAR_NOTE_EBOOK_HREF, FAR_NOTE_READ_HREF } from '../lib/farBandNote';
import { LIVE_COUNTRIES } from '../lib/shipCountries';

const show = LIVE_COUNTRIES.some((c) => c.farBand);
---
{show && (
	<p class="farnote" data-far-note hidden>
		<a href={FAR_NOTE_READ_HREF}>{FAR_NOTE.readText}</a>{FAR_NOTE.middle}<a href={FAR_NOTE_EBOOK_HREF}>{FAR_NOTE.ebookText}</a>{FAR_NOTE.after}
	</p>
)}
<style>
	.farnote { font-family: var(--font-sans); font-size: 0.95rem; font-weight: 600; margin: 0 0 1rem; padding: 0.7rem 0.9rem; border: 1.5px solid var(--color-hairline); border-radius: 0.7rem; background: var(--color-soft, #faf6f2); color: var(--color-ink); }
	.farnote[hidden] { display: none; }
	.farnote a { text-decoration: underline; }
</style>
