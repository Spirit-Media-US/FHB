---
// Thin black "Now on YouVersion" announcement under the hero on every FHB page (Kevin 2026-11-06
// ~22:0xZ: "we need announcement banner like SMP to grab people's attention. Add this black banner
// under the hero on every page."). Same look as SMP's live one (spirit-media-publishing
// CoverMarquee .fhbm-yv). Layout renders it under the top bar; a page whose first section is a hero
// sets youversionBanner={false} on Layout and places this right after that hero.
//
// Counters (Kevin 2026-11-09: "The counters need to move but land on the current number. ALL need to
// fit on 1 row on desktop, stack on mobile. As concise as possible."). Numbers come from
// src/data/youversion-stats.json (YouVersion Connect, all-time, bible.com app excluded), are
// server-rendered, and the script only counts UP TO that same text. Refresh = edit the JSON + ship.
import stats from '../data/youversion-stats.json';

const YOUVERSION_URL = 'https://www.bible.com/organizations/89162c01-3892-4c7b-a462-239df0931522';
// 84,669 -> "84.7K", 1,623 -> "1.6K", 7,302 stays exact. Same rule runs in the script below.
const fmt = (n: number) =>
	n >= 10000
		? (n / 1000).toFixed(1).replace(/\.0$/, '') + 'K'
		: n >= 1000
			? n.toLocaleString('en-US')
			: String(n);
const items = [
	{ n: stats.people, label: 'people' },
	{ n: stats.languages, label: 'languages' },
	{ n: stats.countries, label: 'countries' },
	{ n: stats.chapters, label: 'chapters read' },
	{ n: stats.highlights, label: 'highlights' },
];
---

<div class="fhb-yv-wrap" data-yv-counters>
	<a class="fhb-yv-banner" href={YOUVERSION_URL} target="_blank" rel="noopener">
		<img src="https://assets.spiritmediapublishing.com/FHB/partners/youversion-icon-96.webp" alt="" width="20" height="20" decoding="async" loading="lazy" />
		<span>Now on YouVersion &mdash; read free in the Bible App <span aria-hidden="true">&rarr;</span></span>
	</a>
	<ul class="fhb-yv-stats" aria-label="FHB on YouVersion, all time">
		{items.map((i) => (
			<li><b data-to={i.n}>{fmt(i.n)}</b> {i.label}</li>
		))}
	</ul>
</div>

<script>
	// Count-up to the server-rendered value; never alters the final text.
	const fmt = (n: number) => (n >= 10000 ? (n / 1000).toFixed(1).replace(/\.0$/, '') + 'K' : n >= 1000 ? n.toLocaleString('en-US') : String(n));
	document.querySelectorAll<HTMLElement>('[data-yv-counters]').forEach((root) => {
		const els = [...root.querySelectorAll<HTMLElement>('b[data-to]')];
		if (!els.length || matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
		const finals = els.map((e) => e.textContent || '');
		const run = () => {
			const t0 = performance.now(), D = 1200;
			const tick = (now: number) => {
				const p = Math.min(1, (now - t0) / D), e = 1 - Math.pow(1 - p, 3);
				els.forEach((el, i) => { el.textContent = p >= 1 ? finals[i] : fmt(Math.round(Number(el.dataset.to) * e)); });
				if (p < 1) requestAnimationFrame(tick);
			};
			requestAnimationFrame(tick);
		};
		const io = new IntersectionObserver((en) => { if (en.some((x) => x.isIntersecting)) { io.disconnect(); run(); } }, { threshold: 0.6 });
		io.observe(root);
	});
</script>

<style>
	.fhb-yv-wrap { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; column-gap: 1.5rem; background: #1a1714; color: #f5f5f4; font-family: var(--font-body); font-size: 0.875rem; line-height: 1.25rem; }
	.fhb-yv-banner { display: flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 0.5rem 1rem; text-align: center; text-decoration: none; color: inherit; }
	.fhb-yv-banner:hover { color: #fff; }
	.fhb-yv-banner img { width: 20px; height: 20px; border-radius: 0.25rem; flex-shrink: 0; }
	.fhb-yv-stats { display: flex; flex-wrap: nowrap; gap: 1.25rem; margin: 0; padding: 0.5rem 1rem; list-style: none; white-space: nowrap; color: #d6d3d1; }
	.fhb-yv-stats b { font-weight: 700; color: #fff; font-variant-numeric: tabular-nums; display: inline-block; min-width: var(--w, 0); text-align: right; }
	.fhb-yv-stats li:nth-child(1) b { min-width: 4.2ch; } /* 7,302 */
	.fhb-yv-stats li:nth-child(2) b { min-width: 2ch; }
	.fhb-yv-stats li:nth-child(3) b { min-width: 3ch; }
	.fhb-yv-stats li:nth-child(4) b { min-width: 5ch; } /* 84.7K */
	.fhb-yv-stats li:nth-child(5) b { min-width: 4ch; }  /* 1.6K */
	/* Under 1100px the one-row layout would crowd: stack the stats under the link, then one per line on phones. */
	@media (max-width: 1100px) { .fhb-yv-wrap { flex-direction: column; } .fhb-yv-banner { padding-bottom: 0; } }
	@media (max-width: 640px) {
		.fhb-yv-stats { flex-direction: column; align-items: center; gap: 0.125rem; padding: 0.375rem 0.5rem 0.5rem; }
	}
	/* Stay one thin line on phones: at 14px it wrapped to two lines at 390px. */
	@media (max-width: 480px) {
		/* nowrap alone overflowed the page by 6px at 360/390px; clip the text instead. */
		.fhb-yv-banner { gap: 0.375rem; padding: 0.5rem 0.5rem 0; font-size: 0.71875rem; white-space: nowrap; overflow: hidden; max-width: 100%; }
		.fhb-yv-banner > span { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
		.fhb-yv-banner img { width: 18px; height: 18px; }
		.fhb-yv-stats { font-size: 0.8125rem; }
	}
</style>
