---
// LookInside.astro — an Amazon-style "Look inside" for one print edition.
//
// It reads like an ebook, not like a slide show (Kevin 2026-08-23). The sample
// pages are stacked in ONE vertical scroll column in reading order, so the reader
// moves through the book the way they move through a document. The page readout
// reports where they are; it is not a control that advances anything. The only
// control that moves you is the jump menu, for landing on a specific page in a
// fourteen-page sample.
//
// Driven entirely by `slug`: it reads src/data/lookinside.json, so a product page
// adopts the viewer with one tag and nothing else changes.
//
// PROTECTION: there is no PDF on the page, no link to one, and no download control.
// Only the sample page images exist as assets at all — that is the real protection.
// The contextmenu/dragstart/user-select suppression below is ordinary deterrence,
// scoped to the viewer only, exactly as Amazon does it. It cannot stop a screenshot,
// and it is not meant to.
import data from '../data/lookinside.json';

interface Props {
	slug: string;
	title: string;
}
const { slug, title } = Astro.props;

const ASSETS = 'https://assets.spiritmediapublishing.com/FHB/print/lookinside';

type Page = { file: string; label: string; w: number; h: number };
const entry = (data as Record<string, { count: number; pages: Page[] }>)[slug];
const pages: Page[] = entry?.pages ?? [];
const total = pages.length;

const items = pages.map((p, i) => ({
	src: `${ASSETS}/${slug}/${p.file}`,
	label: p.label,
	w: p.w,
	h: p.h,
	n: i + 1,
}));

// The chrome above and below the scroll column. Each page is sized to fit in what
// is left, so a page lands in the viewport whole and nobody has to zoom.
const CHROME = '7.5rem';
---

{
	total > 0 && (
		<div class="lookinside" data-lookinside>
			<button type="button" class="li-trigger" data-li-open aria-haspopup="dialog">
				<svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
					<path d="M12 6.5C10.5 5.2 8.6 4.5 6.5 4.5H3v14h3.5c2.1 0 4 .7 5.5 2 1.5-1.3 3.4-2 5.5-2H21v-14h-3.5c-2.1 0-4 .7-5.5 2Z" />
					<path d="M12 6.5v14" />
				</svg>
				<span>Look inside</span>
			</button>
			<p class="li-note">{total} sample pages from the printed edition.</p>

			<div class="li-modal" data-li-modal hidden role="dialog" aria-modal="true" aria-label={`Look inside — ${title}`}>
				<div class="li-bar">
					<div class="li-bar-text">
						<span class="li-title">{title}</span>
						<span class="li-readout" data-li-readout />
					</div>

					<div class="li-bar-tools">
						<label class="li-jump">
							<span class="li-jump-label">Jump to</span>
							<select data-li-jump aria-label="Jump to a page">
								{items.map((p) => (
									<option value={p.n}>{p.n}. {p.label}</option>
								))}
							</select>
						</label>
						<button type="button" class="li-close" data-li-close aria-label="Close the viewer">
							<svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
						</button>
					</div>
				</div>

				{/* The reading column. tabindex makes it the focus target on open, so
				    PageUp/PageDown, the arrows, space, Home and End all scroll it natively. */}
				<div class="li-scroll" data-li-scroll tabindex="0">
					{items.map((p) => (
						<figure
							class="li-page"
							data-li-page={p.n}
							style={`width: min(100%, calc((100dvh - ${CHROME}) * ${p.w} / ${p.h}));`}
						>
							{/* width/height reserve the box from the manifest, so nothing
							    shifts as the lazy pages arrive. */}
							<img
								src={p.src}
								alt={`${p.label} — sample page ${p.n} of ${total}`}
								width={p.w}
								height={p.h}
								loading={p.n <= 2 ? 'eager' : 'lazy'}
								decoding="async"
								draggable="false"
							/>
							<div class="li-shield" aria-hidden="true" />
						</figure>
					))}
					<p class="li-end">End of the sample — {total} of {entry.count} pages shown.</p>
				</div>
			</div>
		</div>
	)
}

<style>
	/* Neutral chrome throughout — greys and the site's ink/hairline tokens only.
	   The page images are the one colorful thing in this viewer, by instruction. */
	.lookinside {
		margin: 1rem 0 0;
		display: flex; flex-direction: column; align-items: center;
		/* The host page's absolutely-positioned back-cover image overhangs the cover
		   box; without this the trigger sits underneath it and cannot be clicked. */
		position: relative; z-index: 1;
	}

	.li-trigger {
		display: inline-flex; align-items: center; gap: 0.5rem;
		font-family: var(--font-sans); font-size: 0.9rem; font-weight: 600;
		color: #3f3f46; background: #fff;
		border: 1px solid var(--color-hairline); border-radius: 999px;
		padding: 0.55rem 1.1rem; cursor: pointer;
		transition: background 0.18s ease, border-color 0.18s ease;
	}
	.li-trigger:hover { background: #f3f3f3; border-color: #a1a1aa; }
	.li-trigger:focus-visible { outline: 2px solid #3f3f46; outline-offset: 2px; }

	.li-note {
		font-family: var(--font-sans); color: #71717a; font-size: 0.78rem;
		margin: 0.5rem 0 0;
	}

	.li-modal {
		position: fixed; inset: 0; z-index: 9999;
		display: flex; flex-direction: column;
		background: #1a1c1c;
		/* Deterrence, scoped to the viewer only — never the whole page. */
		-webkit-user-select: none; user-select: none;
		-webkit-touch-callout: none;
	}
	.li-modal[hidden] { display: none; }

	.li-bar {
		display: flex; align-items: center; justify-content: space-between; gap: 1rem;
		padding: 0.7rem 1rem; border-bottom: 1px solid #3f3f46; flex: none;
	}
	.li-bar-text { display: flex; flex-direction: column; min-width: 0; }
	.li-title {
		font-family: var(--font-sans); font-size: 0.72rem; font-weight: 700;
		letter-spacing: 0.12em; text-transform: uppercase; color: #a1a1aa;
		overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
	}
	.li-readout {
		font-family: var(--font-headline); font-size: 1rem; color: #f1f1f1;
		overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
	}

	.li-bar-tools { display: flex; align-items: center; gap: 0.6rem; flex: none; }

	.li-jump { display: flex; align-items: center; gap: 0.4rem; }
	.li-jump-label {
		font-family: var(--font-sans); font-size: 0.72rem; font-weight: 700;
		letter-spacing: 0.1em; text-transform: uppercase; color: #a1a1aa;
	}
	.li-jump select {
		font-family: var(--font-sans); font-size: 0.82rem;
		color: #f1f1f1; background: #2f3131;
		border: 1px solid #52525b; border-radius: 6px;
		padding: 0.45rem 0.5rem; max-width: 11rem; cursor: pointer;
	}
	.li-jump select:focus-visible { outline: 2px solid #f1f1f1; outline-offset: 2px; }

	.li-close {
		display: inline-flex; align-items: center; justify-content: center;
		width: 44px; height: 44px; border-radius: 999px;
		background: transparent; border: 1px solid #52525b; color: #f1f1f1; cursor: pointer;
	}
	.li-close:hover { background: #2f3131; }
	.li-close:focus-visible { outline: 2px solid #f1f1f1; outline-offset: 2px; }

	/* The reading column: one continuous scroll, no snapping — snapping is what
	   makes a scroller feel like a slide show. */
	.li-scroll {
		flex: 1 1 auto; min-height: 0;
		overflow-y: auto; overflow-x: hidden;
		-webkit-overflow-scrolling: touch;
		overscroll-behavior: contain;
		scroll-behavior: smooth;
		padding: 1rem 1rem 0;
	}
	.li-scroll:focus { outline: none; }
	.li-scroll:focus-visible { outline: 2px solid #52525b; outline-offset: -2px; }

	.li-page {
		margin: 0 auto 1rem;
		max-width: 100%;
		position: relative;
		background: #fff;
		box-shadow: 0 2px 18px rgba(0, 0, 0, 0.45);
	}
	.li-page img {
		display: block; width: 100%; height: auto;
		-webkit-user-drag: none;
		pointer-events: none; /* right-click lands on the shield, not the image */
	}
	.li-shield { position: absolute; inset: 0; }

	.li-end {
		font-family: var(--font-sans); font-size: 0.8rem; color: #a1a1aa;
		text-align: center; margin: 0; padding: 1rem 0 2rem;
	}

	@media (max-width: 640px) {
		.li-bar { padding: 0.6rem 0.75rem; gap: 0.6rem; }
		.li-jump-label { display: none; }
		.li-jump select { max-width: 7.5rem; }
		.li-scroll { padding: 0.75rem 0.75rem 0; }
		.li-page { margin-bottom: 0.75rem; }
	}

	@media (prefers-reduced-motion: reduce) {
		.li-trigger { transition: none; }
		.li-scroll { scroll-behavior: auto; }
	}
</style>

<script>
	document.querySelectorAll('[data-lookinside]').forEach((root) => {
		if (root.hasAttribute('data-li-ready')) return;
		root.setAttribute('data-li-ready', '');

		const modal = root.querySelector('[data-li-modal]');
		const scroll = root.querySelector('[data-li-scroll]');
		const readout = root.querySelector('[data-li-readout]');
		const jump = root.querySelector('[data-li-jump]');
		const figures = Array.from(root.querySelectorAll('[data-li-page]'));
		if (!modal || !figures.length) return;

		const total = figures.length;
		const labels = figures.map((f) => f.querySelector('img')?.getAttribute('alt') || '');
		let current = 0;
		let opener = null;
		let portalled = false;

		// The readout reports where the reader IS. It never moves them.
		function setCurrent(i) {
			if (i === current) return;
			current = i;
			const label = jump.options[i]?.textContent?.replace(/^\d+\.\s*/, '') || '';
			readout.textContent = `Page ${i + 1} of ${total} — ${label}`;
			// Keep the jump menu in step without firing its change handler.
			if (jump.selectedIndex !== i) jump.selectedIndex = i;
		}

		// Whichever page occupies the most of the column is the page you are on.
		const seen = new Map();
		const io = new IntersectionObserver(
			(entries) => {
				for (const e of entries) seen.set(e.target, e.intersectionRatio);
				let best = null, bestRatio = 0;
				for (const [el, ratio] of seen) {
					if (ratio > bestRatio) { bestRatio = ratio; best = el; }
				}
				if (best && bestRatio > 0) setCurrent(figures.indexOf(best));
			},
			{ root: scroll, threshold: [0, 0.1, 0.25, 0.5, 0.75, 1] }
		);

		function goTo(i, behavior) {
			const el = figures[Math.max(0, Math.min(total - 1, i))];
			if (!el) return;
			const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			el.scrollIntoView({ block: 'start', behavior: reduce ? 'auto' : behavior || 'smooth' });
		}

		function open() {
			opener = document.activeElement;
			if (!portalled) { document.body.appendChild(modal); portalled = true; }
			modal.hidden = false;
			document.body.style.overflow = 'hidden';
			scroll.scrollTop = 0;
			current = -1;
			setCurrent(0);
			figures.forEach((f) => io.observe(f));
			// Focus the column so PageUp/PageDown, arrows, space, Home and End
			// scroll it natively — the keyboard should feel like a reader.
			scroll.focus({ preventScroll: true });
			document.addEventListener('keydown', onKey, true);
		}

		function close() {
			modal.hidden = true;
			document.body.style.overflow = '';
			io.disconnect();
			seen.clear();
			document.removeEventListener('keydown', onKey, true);
			if (opener && opener.focus) opener.focus();
		}

		function onKey(e) {
			if (modal.hidden) return;
			if (e.key === 'Escape') { e.preventDefault(); close(); return; }
			// Home/End land on the first and last page. Everything else scrolls
			// natively, which is what makes it read like a document.
			if (e.key === 'Home' && e.target !== jump) { e.preventDefault(); goTo(0); }
			else if (e.key === 'End' && e.target !== jump) { e.preventDefault(); goTo(total - 1); }
		}

		root.querySelector('[data-li-open]')?.addEventListener('click', open);
		root.querySelector('[data-li-close]')?.addEventListener('click', close);
		jump.addEventListener('change', () => goTo(jump.selectedIndex));

		// Deterrence, scoped to the viewer. Anything the browser renders can be
		// captured; this only removes the convenient paths.
		modal.addEventListener('contextmenu', (e) => e.preventDefault());
		modal.addEventListener('dragstart', (e) => e.preventDefault());
	});
</script>
