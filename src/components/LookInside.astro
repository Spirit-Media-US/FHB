---
// LookInside.astro — an Amazon-style "Look inside" viewer for one print edition.
//
// Driven entirely by `slug`: it reads src/data/lookinside.json, finds that edition's
// sample pages, and renders a trigger plus a lightbox. Nothing else on the host page
// needs to change, so the other fifteen product pages get it by dropping in one tag.
//
// PROTECTION: there is no PDF on the page, no link to one, and no download control.
// Only the sample page images exist as assets at all — that is the real protection.
// The contextmenu/dragstart/user-select suppression below is ordinary deterrence,
// scoped to the viewer only, exactly as Amazon does it. It cannot stop a screenshot,
// and it is not meant to.
import data from '../data/lookinside.json';

interface Props {
	slug: string;
	title: string;
}
const { slug, title } = Astro.props;

const ASSETS = 'https://assets.spiritmediapublishing.com/FHB/print/lookinside';

type Page = { file: string; label: string; w: number; h: number };
const entry = (data as Record<string, { count: number; pages: Page[] }>)[slug];
const pages: Page[] = entry?.pages ?? [];
const total = pages.length;

// Every page carries its absolute URL so the client script never builds one.
const payload = pages.map((p) => ({
	src: `${ASSETS}/${slug}/${p.file}`,
	label: p.label,
	w: p.w,
	h: p.h,
}));
const uid = `li-${slug}`;
---

{
	total > 0 && (
		<div class="lookinside" id={uid} data-lookinside>
			<script
				type="application/json"
				data-li-pages
				set:html={JSON.stringify(payload)}
			/>

			<button type="button" class="li-trigger" data-li-open aria-haspopup="dialog">
				<svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
					<path d="M12 6.5C10.5 5.2 8.6 4.5 6.5 4.5H3v14h3.5c2.1 0 4 .7 5.5 2 1.5-1.3 3.4-2 5.5-2H21v-14h-3.5c-2.1 0-4 .7-5.5 2Z" />
					<path d="M12 6.5v14" />
				</svg>
				<span>Look inside</span>
			</button>
			<p class="li-note">{total} sample pages from the printed edition.</p>

			<div class="li-modal" data-li-modal hidden role="dialog" aria-modal="true" aria-label={`Look inside — ${title}`}>
				<div class="li-bar">
					<div class="li-bar-text">
						<span class="li-title">{title}</span>
						<span class="li-label" data-li-label />
					</div>
					<button type="button" class="li-close" data-li-close aria-label="Close the viewer">
						<svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
					</button>
				</div>

				<div class="li-stage" data-li-stage>
					<button type="button" class="li-nav li-prev" data-li-prev aria-label="Previous page">
						<svg aria-hidden="true" viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-8 7 8 7" /></svg>
					</button>

					<figure class="li-figure" data-li-figure>
						<img class="li-img" data-li-img alt="" draggable="false" decoding="async" />
						{/* A transparent shield sits over the image so a casual right-click or
						    long-press lands on an empty div rather than on the <img>. */}
						<div class="li-shield" aria-hidden="true" />
					</figure>

					<button type="button" class="li-nav li-next" data-li-next aria-label="Next page">
						<svg aria-hidden="true" viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l8 7-8 7" /></svg>
					</button>
				</div>

				<div class="li-foot">
					<p class="li-count" data-li-count aria-live="polite" />
					<div class="li-thumbs" data-li-thumbs>
						{payload.map((p, i) => (
							<button type="button" class="li-thumb" data-li-thumb={i} aria-label={`Page ${i + 1}: ${p.label}`}>
								<img src={p.src} alt="" width={p.w} height={p.h} loading="lazy" decoding="async" draggable="false" />
							</button>
						))}
					</div>
				</div>
			</div>
		</div>
	)
}

<style>
	/* Neutral chrome throughout — greys and the site's ink/hairline tokens only.
	   The page image is the one colourful thing in this viewer, by instruction. */
	.lookinside {
		margin: 1rem 0 0;
		display: flex; flex-direction: column; align-items: center;
		/* The host page's absolutely-positioned back-cover image overhangs the cover
		   box; without this the trigger sits underneath it and cannot be clicked. */
		position: relative; z-index: 1;
	}

	.li-trigger {
		display: inline-flex; align-items: center; gap: 0.5rem;
		font-family: var(--font-sans); font-size: 0.9rem; font-weight: 600;
		color: #3f3f46; background: #fff;
		border: 1px solid var(--color-hairline); border-radius: 999px;
		padding: 0.55rem 1.1rem; cursor: pointer;
		transition: background 0.18s ease, border-color 0.18s ease;
	}
	.li-trigger:hover { background: #f3f3f3; border-color: #a1a1aa; }
	.li-trigger:focus-visible { outline: 2px solid #3f3f46; outline-offset: 2px; }

	.li-note {
		font-family: var(--font-sans); color: #71717a; font-size: 0.78rem;
		margin: 0.5rem 0 0;
	}

	.li-modal {
		position: fixed; inset: 0; z-index: 9999;
		display: flex; flex-direction: column;
		background: #1a1c1c;
		/* Deterrence, scoped to the viewer only — never the whole page. */
		-webkit-user-select: none; user-select: none;
		-webkit-touch-callout: none;
	}
	.li-modal[hidden] { display: none; }

	.li-bar {
		display: flex; align-items: center; justify-content: space-between; gap: 1rem;
		padding: 0.75rem 1rem; border-bottom: 1px solid #3f3f46; flex: none;
	}
	.li-bar-text { display: flex; flex-direction: column; min-width: 0; }
	.li-title {
		font-family: var(--font-sans); font-size: 0.72rem; font-weight: 700;
		letter-spacing: 0.12em; text-transform: uppercase; color: #a1a1aa;
	}
	.li-label {
		font-family: var(--font-headline); font-size: 1rem; color: #f1f1f1;
		overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
	}
	.li-close {
		flex: none; display: inline-flex; align-items: center; justify-content: center;
		width: 44px; height: 44px; border-radius: 999px;
		background: transparent; border: 1px solid #52525b; color: #f1f1f1; cursor: pointer;
	}
	.li-close:hover { background: #2f3131; }
	.li-close:focus-visible { outline: 2px solid #f1f1f1; outline-offset: 2px; }

	.li-stage {
		position: relative;
		flex: 1 1 auto; min-height: 0;
		display: flex; align-items: center; justify-content: center; gap: 0.5rem;
		padding: 0.75rem;
	}
	.li-figure {
		margin: 0; position: relative;
		flex: 1 1 auto; min-width: 0; height: 100%;
		display: flex; align-items: center; justify-content: center;
	}
	.li-img {
		max-width: 100%; max-height: 100%;
		width: auto; height: auto;
		object-fit: contain;
		background: #fff;
		box-shadow: 0 2px 24px rgba(0, 0, 0, 0.5);
		-webkit-user-drag: none;
		pointer-events: none; /* right-click lands on the shield, not the image */
	}
	.li-shield { position: absolute; inset: 0; }

	.li-nav {
		flex: none; display: inline-flex; align-items: center; justify-content: center;
		width: 48px; height: 48px; border-radius: 999px;
		background: rgba(47, 49, 49, 0.9); border: 1px solid #52525b;
		color: #f1f1f1; cursor: pointer;
	}
	.li-nav:hover:not(:disabled) { background: #3f3f46; }
	.li-nav:disabled { opacity: 0.3; cursor: default; }
	.li-nav:focus-visible { outline: 2px solid #f1f1f1; outline-offset: 2px; }

	.li-foot { flex: none; padding: 0.5rem 1rem 0.9rem; border-top: 1px solid #3f3f46; }
	.li-count {
		font-family: var(--font-sans); font-size: 0.78rem; color: #a1a1aa;
		margin: 0 0 0.5rem; text-align: center;
	}
	.li-thumbs {
		display: flex; gap: 0.4rem; overflow-x: auto; padding-bottom: 0.25rem;
		justify-content: flex-start; scrollbar-width: thin;
	}
	.li-thumb {
		flex: none; width: 42px; height: 60px; padding: 0; cursor: pointer;
		background: #fff; border: 1px solid #52525b; border-radius: 3px;
		overflow: hidden; opacity: 0.55; transition: opacity 0.18s ease, border-color 0.18s ease;
	}
	.li-thumb img { width: 100%; height: 100%; object-fit: cover; object-position: top; pointer-events: none; }
	.li-thumb[aria-current='true'] { opacity: 1; border-color: #f1f1f1; }
	.li-thumb:hover { opacity: 1; }
	.li-thumb:focus-visible { outline: 2px solid #f1f1f1; outline-offset: 2px; }

	/* On a phone the two arrows in flow steal a third of the width from the page.
	   Float them over the stage instead; swipe is the primary gesture there anyway. */
	@media (max-width: 767px) {
		.li-nav {
			position: absolute; top: 50%; transform: translateY(-50%);
			background: rgba(26, 28, 28, 0.72);
		}
		.li-prev { left: 0.35rem; }
		.li-next { right: 0.35rem; }
		.li-stage { padding: 0.5rem; }
	}

	@media (min-width: 768px) {
		.li-thumbs { justify-content: center; }
		.li-thumb { width: 52px; height: 74px; }
		.li-stage { padding: 1rem 1.5rem; gap: 1rem; }
	}

	@media (prefers-reduced-motion: reduce) {
		.li-trigger, .li-thumb, .li-img { transition: none !important; }
	}
</style>

<script>
	// One initialiser per instance, so several editions could share a page.
	document.querySelectorAll('[data-lookinside]').forEach((root) => {
		if (root.hasAttribute('data-li-ready')) return;
		root.setAttribute('data-li-ready', '');

		const raw = root.querySelector('[data-li-pages]');
		let pages = [];
		try {
			pages = JSON.parse(raw?.textContent || '[]');
		} catch {
			return;
		}
		if (!pages.length) return;

		const modal = root.querySelector('[data-li-modal]');
		const img = root.querySelector('[data-li-img]');
		const label = root.querySelector('[data-li-label]');
		const count = root.querySelector('[data-li-count]');
		const prev = root.querySelector('[data-li-prev]');
		const next = root.querySelector('[data-li-next]');
		const stage = root.querySelector('[data-li-stage]');
		const thumbs = Array.from(root.querySelectorAll('[data-li-thumb]'));
		let index = 0;
		let opener = null;

		function show(i) {
			index = Math.max(0, Math.min(pages.length - 1, i));
			const p = pages[index];
			img.src = p.src;
			img.width = p.w;
			img.height = p.h;
			// The label already names the page; the image itself carries no extra meaning.
			img.alt = `${p.label} — sample page ${index + 1} of ${pages.length}`;
			label.textContent = p.label;
			count.textContent = `${index + 1} of ${pages.length}`;
			prev.disabled = index === 0;
			next.disabled = index === pages.length - 1;
			thumbs.forEach((t, n) => t.setAttribute('aria-current', n === index ? 'true' : 'false'));
			const active = thumbs[index];
			if (active && active.scrollIntoView)
				active.scrollIntoView({ block: 'nearest', inline: 'center' });
		}

		// The modal is portalled to <body> on first open. Inside the page it sits in
		// an ancestor stacking context and the site header paints over it.
		let portalled = false;

		function open(i) {
			opener = document.activeElement;
			if (!portalled) { document.body.appendChild(modal); portalled = true; }
			modal.hidden = false;
			document.body.style.overflow = 'hidden';
			show(i || 0);
			modal.querySelector('[data-li-close]')?.focus();
			document.addEventListener('keydown', onKey);
		}

		function close() {
			modal.hidden = true;
			document.body.style.overflow = '';
			document.removeEventListener('keydown', onKey);
			if (opener && opener.focus) opener.focus();
		}

		function onKey(e) {
			if (e.key === 'Escape') { e.preventDefault(); close(); }
			else if (e.key === 'ArrowRight') { e.preventDefault(); show(index + 1); }
			else if (e.key === 'ArrowLeft') { e.preventDefault(); show(index - 1); }
			else if (e.key === 'Home') { e.preventDefault(); show(0); }
			else if (e.key === 'End') { e.preventDefault(); show(pages.length - 1); }
		}

		root.querySelector('[data-li-open]')?.addEventListener('click', () => open(0));
		root.querySelector('[data-li-close]')?.addEventListener('click', close);
		prev.addEventListener('click', () => show(index - 1));
		next.addEventListener('click', () => show(index + 1));
		thumbs.forEach((t, n) => t.addEventListener('click', () => show(n)));

		// Deterrence, scoped to the viewer. Anything the browser renders can be
		// captured; this only removes the convenient paths.
		modal.addEventListener('contextmenu', (e) => e.preventDefault());
		modal.addEventListener('dragstart', (e) => e.preventDefault());

		// Phone: horizontal swipe moves a page.
		let x0 = null, y0 = null;
		stage.addEventListener('touchstart', (e) => {
			const t = e.changedTouches[0];
			x0 = t.clientX; y0 = t.clientY;
		}, { passive: true });
		stage.addEventListener('touchend', (e) => {
			if (x0 === null) return;
			const t = e.changedTouches[0];
			const dx = t.clientX - x0, dy = t.clientY - y0;
			if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy)) show(index + (dx < 0 ? 1 : -1));
			x0 = null; y0 = null;
		}, { passive: true });
	});
</script>
